m=logfilter;i=io:std.io;i=s:std.str;f=getsevlevel(sev:$str):$i64{if(sev="_"){<0};if(sev="_"){<1};if(sev="_"){<2};if(sev="_"){<3};<-1};f=main():$i64{let minsev=s.trim(io.readln());let minlevel=getsevlevel(minsev);lp(true){let line=io.readln();if(s.len(line)=0){br};let parts=s.split(line;"_");if(parts.len>=2){let sev=parts.get(1);let level=getsevlevel(sev);if(level>=minlevel){io.println(line)}}};<0}