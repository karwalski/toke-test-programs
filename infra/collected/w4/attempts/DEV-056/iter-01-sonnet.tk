m=logfilter;i=io:std.io;i=s:std.str;f=getsevlevel(sev:$str):$i64{if(sev="DEBUG"){<0};if(sev="INFO"){<1};if(sev="WARN"){<2};if(sev="ERROR"){<3};<-1};f=main():$i64{let minsev=s.trim(io.readln());let minlevel=getsevlevel(minsev);let line=mut.io.readln();lp(s.len(line)>0){let parts=s.split(line;" ");if(parts.len>=3){let sev=parts.get(2);let level=getsevlevel(sev);if(level>=minlevel){io.println(line)}};line=io.readln()};<0}