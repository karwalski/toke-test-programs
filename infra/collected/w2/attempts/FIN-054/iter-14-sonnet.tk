m=quadfit;i=io:std.io;i=s:std.str;f=solve(xvals:@($f64);yvals:@($f64)):@($f64){let n=xvals.len;let sumx=mut.0.0;let sumy=mut.0.0;let sumx2=mut.0.0;let sumx3=mut.0.0;let sumx4=mut.0.0;let sumxy=mut.0.0;let sumx2y=mut.0.0;lp(let k=0;k<n;k=k+1){let xi=xvals.get(k);let yi=yvals.get(k);sumx=sumx+xi;sumy=sumy+yi;sumx2=sumx2+xi*xi;sumx3=sumx3+xi*xi*xi;sumx4=sumx4+xi*xi*xi*xi;sumxy=sumxy+xi*yi;sumx2y=sumx2y+xi*xi*yi};let nval=n as$f64;let matrix11=nval;let matrix12=sumx;let matrix13=sumx2;let matrix21=sumx;let matrix22=sumx2;let matrix23=sumx3;let matrix31=sumx2;let matrix32=sumx3;let matrix33=sumx4;let det=matrix11*(matrix22*matrix33-matrix23*matrix32)-matrix12*(matrix21*matrix33-matrix23*matrix31)+matrix13*(matrix21*matrix32-matrix22*matrix31);let det1=sumy*(matrix22*matrix33-matrix23*matrix32)-matrix12*(sumxy*matrix33-matrix23*sumx2y)+matrix13*(sumxy*matrix32-matrix22*sumx2y);let det2=matrix11*(sumxy*matrix33-sumx2y*matrix32)-sumy*(matrix21*matrix33-sumx2y*matrix31)+matrix13*(matrix21*sumxy-sumxy*matrix31);let det3=matrix11*(matrix22*sumx2y-sumxy*matrix32)-matrix12*(matrix21*sumx2y-sumxy*matrix31)+sumy*(matrix21*matrix32-matrix22*matrix31);let aval=det1/det;let bval=det2/det;let cval=det3/det;<@(aval;bval;cval)};f=main():$i64{let xline=io.readln();let yline=io.readln();let xparts=s.split(xline;",");let yparts=s.split(yline;",");let xvals=mut.@();let yvals=mut.@();lp(let k=0;k<xparts.len;k=k+1){let xstr=s.trim(xparts.get(k));let xval=s.tofloat(xstr);xvals=xvals+@(xval)};lp(let k=0;k<yparts.len;k=k+1){let ystr=s.trim(yparts.get(k));let yval=s.tofloat(ystr);yvals=yvals+@(yval)};let result=solve(xvals;yvals);let astr=s.fromfloat(result.get(0));let bstr=s.fromfloat(result.get(1));let cstr=s.fromfloat(result.get(2));io.println(astr);io.println(bstr);io.println(cstr);<0}