m=quadfit;i=io:std.io;i=s:std.str;f=solve(xvals:@($f64);yvals:@($f64)):@($f64){let n=xvals.len;let sumx=mut.0.0;let sumy=mut.0.0;let sumx2=mut.0.0;let sumx3=mut.0.0;let sumx4=mut.0.0;let sumxy=mut.0.0;let sumx2y=mut.0.0;lp(let j=0;j<n;j=j+1){let xi=xvals.get(j);let yi=yvals.get(j);sumx=sumx+xi;sumy=sumy+yi;sumx2=sumx2+xi*xi;sumx3=sumx3+xi*xi*xi;sumx4=sumx4+xi*xi*xi*xi;sumxy=sumxy+xi*yi;sumx2y=sumx2y+xi*xi*yi};let nval=n as$f64;let m11=nval;let m12=sumx;let m13=sumx2;let m21=sumx;let m22=sumx2;let m23=sumx3;let m31=sumx2;let m32=sumx3;let m33=sumx4;let det=m11*(m22*m33-m23*m32)-m12*(m21*m33-m23*m31)+m13*(m21*m32-m22*m31);let det1=sumy*(m22*m33-m23*m32)-m12*(sumxy*m33-m23*sumx2y)+m13*(sumxy*m32-m22*sumx2y);let det2=m11*(sumxy*m33-sumx2y*m32)-sumy*(m21*m33-sumx2y*m31)+m13*(m21*sumxy-sumxy*m31);let det3=m11*(m22*sumx2y-sumxy*m32)-m12*(m21*sumx2y-sumxy*m31)+sumy*(m21*m32-m22*m31);let aval=det1/det;let bval=det2/det;let cval=det3/det;<@(aval;bval;cval)};f=main():$i64{let xline=io.readln();let yline=io.readln();let xparts=s.split(xline;",");let yparts=s.split(yline;",");let xvals=mut.@();let yvals=mut.@();lp(let j=0;j<xparts.len;j=j+1){let xstr=s.trim(xparts.get(j));let xval=s.tofloat(xstr);xvals=xvals+@(xval)};lp(let j=0;j<yparts.len;j=j+1){let ystr=s.trim(yparts.get(j));let yval=s.tofloat(ystr);yvals=yvals+@(yval)};let result=solve(xvals;yvals);let astr=s.fromfloat(result.get(0));let bstr=s.fromfloat(result.get(1));let cstr=s.fromfloat(result.get(2));io.println(astr);io.println(bstr);io.println(cstr);<0}