m=logparse;
i=io:std.io;
i=s:std.str;
f=parselogline(line:$str;pattern:$str):$str{
  let parts=s.split(line;" ");
  if(s.contains(pattern;"{user}")){
    if(parts.len>=4){
      let user=parts.get(1);
      let ip=parts.get(5);
      let result="{\"user\":\""+user+"\",\"ip\":\""+ip+"\"}";
      <result
    }
  }el{
    if(parts.len>=3){
      let timestamp=parts.get(0);
      let level=parts.get(1);
      let message=mut.parts.get(2);
      let idx=mut.3;
      lp(idx<parts.len){
        message=message+" "+parts.get(idx);
        idx=idx+1
      };
      let result="{\"timestamp\":\""+timestamp+"\",\"level\":\""+level+"\",\"message\":\""+message+"\"}";
      <result
    }
  };
  <""
};
f=main():$i64{
  let pattern=io.readln();
  lp(true){
    let line=io.readln();
    if(s.len(line)=0){br};
    let result=parselogline(line;pattern);
    io.println(result)
  };
  <0
}