m=logparse;
i=io:std.io;
i=s:std.str;
f=parselogline(line:$str;pattern:$str):$str{
  let parts=s.split(line;" ");
  if(s.contains(pattern;"user")){
    if(parts.len>=2){
      let user=parts.get(0);
      let ip=parts.get(1);
      let result="{\"user\":\""+user+"\",\"ip\":\""+ip+"\"}";
      <result
    }
  }el{
    if(parts.len>=3){
      let timestamp=parts.get(0);
      let level=parts.get(1);
      let message=mut.parts.get(2);
      let idx=mut.3;
      lp(idx<parts.len){
        message=message+" "+parts.get(idx);
        idx=idx+1
      };
      let result="{\"timestamp\":\""+timestamp+"\",\"level\":\""+level+"\",\"message\":\""+message+"\"}";
      <result
    }
  };
  <""
};
f=main():$i64{
  let input=io.readln();
  let parts=s.split(input;" ");
  if(parts.len>=1){
    let firstpart=parts.get(0);
    if(s.contains(firstpart;"{")){
      let pattern=firstpart;
      let line1=io.readln();
      let line2=io.readln();
      let result1=parselogline(line1;pattern);
      let result2=parselogline(line2;pattern);
      if(s.len(result1)>0){
        io.println(result1)
      };
      if(s.len(result2)>0){
        io.println(result2)
      }
    }el{
      let line=input;
      let pattern=io.readln();
      let result=parselogline(line;pattern);
      if(s.len(result)>0){
        io.println(result)
      }
    }
  };
  <0
}