m=gramschmidt;
i=math:std.math;
i=io:std.io;
i=s:std.str;
f=parseinput():@(@($f64)){
    let firstline=io.readln();
    let dims=s.split(firstline;" ");
    let rows=s.toint(dims.get(0));
    let cols=s.toint(dims.get(1));
    let matrix=mut.@();
    lp(let r=0;r<rows;r=r+1){
        let line=io.readln();
        let values=s.split(line;" ");
        let row=mut.@();
        lp(let c=0;c<cols;c=c+1){
            let val=s.tofloat(values.get(c));
            row=row.push(val);
        };
        matrix=matrix.push(row);
    };
    <matrix
};
f=dotproduct(a:@($f64);b:@($f64)):$f64{
    let sum=mut.0.0;
    lp(let i=0;i<a.len;i=i+1){
        sum=sum+a.get(i)*b.get(i);
    };
    <sum
};
f=vectornorm(v:@($f64)):$f64{
    let sum=mut.0.0;
    lp(let i=0;i<v.len;i=i+1){
        let val=v.get(i);
        sum=sum+val*val;
    };
    <math.sqrt(sum)
};
f=vectorscale(v:@($f64);scale:$f64):@($f64){
    let result=mut.@();
    lp(let i=0;i<v.len;i=i+1){
        result=result.push(v.get(i)*scale);
    };
    <result
};
f=vectorsub(a:@($f64);b:@($f64)):@($f64){
    let result=mut.@();
    lp(let i=0;i<a.len;i=i+1){
        result=result.push(a.get(i)-b.get(i));
    };
    <result
};
f=createzerom(rows:$i64;cols:$i64):@(@($f64)){
    let result=mut.@();
    lp(let i=0;i<rows;i=i+1){
        let row=mut.@();
        lp(let j=0;j<cols;j=j+1){
            row=row.push(0.0);
        };
        result=result.push(row);
    };
    <result
};
f=transposeq(qvecs:@(@($f64));rows:$i64):@(@($f64)){
    let result=mut.@();
    lp(let i=0;i<rows;i=i+1){
        let row=mut.@();
        lp(let j=0;j<qvecs.len;j=j+1){
            row=row.push(qvecs.get(j).get(i));
        };
        result=result.push(row);
    };
    <result
};
f=printmatrix(matrix:@(@($f64))):$void{
    lp(let i=0;i<matrix.len;i=i+1){
        let row=matrix.get(i);
        let line=mut."";
        lp(let j=0;j<row.len;j=j+1){
            if(j>0){line=line+" ";};
            let val=row.get(j);
            if(val<0.0000005){
                if(val>-0.0000005){
                    line=line+"0.000000";
                }el{
                    line=line+s.fromfloat(val);
                };
            }el{
                line=line+s.fromfloat(val);
            };
        };
        io.println(line);
    };
};
f=setrmatrix(rmat:@(@($f64));row:$i64;col:$i64;val:$f64):@(@($f64)){
    let newmat=mut.@();
    lp(let i=0;i<rmat.len;i=i+1){
        if(i=row){
            let oldrow=rmat.get(i);
            let newrow=mut.@();
            lp(let j=0;j<oldrow.len;j=j+1){
                if(j=col){
                    newrow=newrow.push(val);
                }el{
                    newrow=newrow.push(oldrow.get(j));
                };
            };
            newmat=newmat.push(newrow);
        }el{
            newmat=newmat.push(rmat.get(i));
        };
    };
    <newmat
};
f=main():$i64{
    let matrix=parseinput();
    let qvecs=mut.@();
    let rows=matrix.len;
    let cols=matrix.get(0).len;
    let rmat=mut.createzerom(cols;cols);
    lp(let j=0;j<cols;j=j+1){
        let col=mut.@();
        lp(let i=0;i<rows;i=i+1){
            col=col.push(matrix.get(i).get(j));
        };
        let u=mut.col;
        lp(let k=0;k<j;k=k+1){
            let qk=qvecs.get(k);
            let proj=dotproduct(col;qk);
            rmat=setrmatrix(rmat;k;j;proj);
            let scaled=vectorscale(qk;proj);
            u=vectorsub(u;scaled);
        };
        let norm=vectornorm(u);
        rmat=setrmatrix(rmat;j;j;norm);
        if(norm>0.0){
            let qj=vectorscale(u;1.0/norm);
            qvecs=qvecs.push(qj);
        }el{
            let zero=mut.@();
            lp(let i=0;i<rows;i=i+1){
                zero=zero.push(0.0);
            };
            qvecs=qvecs.push(zero);
        };
    };
    let q=transposeq(qvecs;rows);
    printmatrix(q);
    io.println("");
    printmatrix(rmat);
    <0
}