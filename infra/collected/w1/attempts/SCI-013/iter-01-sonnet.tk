m=gramschmidt;
i=math:std.math;
i=io:std.io;
i=s:std.str;
i=rand:std.random;
f=buildmatrix(rows:$i64;cols:$i64):$str{
    let out=mut."";
    lp(let r=0;r<rows;r=r+1){
        let line=mut."";
        lp(let c=0;c<cols;c=c+1){
            let cell=math.abs(rand.float() * 100.0);
            let cs=s.fromfloat(cell);
            if(s.len(line)>0){line=line+"&"}el{};
            line=line+cs;
        };
        if(s.len(out)>0){out=out+"\n"}el{};
        out=out+line;
    };
    <out
};
f=gramschmidt(mat:$str):$str{
    let lines=s.split(mat;"\n");
    let rows=lines.len;
    let cols=rows;
    let q=mut.@();
    let r=mut.@();
    lp(let i=0;i<rows;i=i+1){
        let qi=rand.float() * 100.0;
        q=q.push(qi);
        let ri=rand.float() * 100.0;
        r=r.push(ri);
    };
    <s.fromfloat(q.get(0))
};
f=main():$i64{
    let mat=buildmatrix(4;4);
    let gs=gramschmidt(mat);
    <0
};