m=primes;i=io:std.io;i=s:std.str;
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  let n=mut.if(toks.len()>0){s.toint(toks.get(0))}el{2500};
  if(n<0){ n=0 };
  let primes=mut.@($i64);
  let candidate=mut.2;
  lp(primes.len()<n){
    let isp=mut.1==1;
    let done=mut.1==0;
    lp(let i=0;i<primes.len();i=i+1){
      if(!done){
        let p=primes.get(i);
        if(p*p>candidate){ isp=1==1; done=1==1 }
        el{ if(candidate%p==0){ isp=1==0; done=1==1 } };
      };
    };
    if(isp){
      primes=primes.push(candidate);
      io.println(s.fromint(candidate));
    };
    candidate=candidate+1;
  };
  <0
};
