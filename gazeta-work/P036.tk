m=horner;i=io:std.io;i=s:std.str;
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  if(toks.len()==0){ <0 };
  let n=s.toint(toks.get(0));
  let idx=mut.1;
  let coeff=mut.@($i64);
  lp(let z=0;z<=n;z=z+1){ coeff=coeff.push(s.toint(toks.get(idx))); idx=idx+1 };
  let a=s.toint(toks.get(idx)); idx=idx+1;
  # c = coeff reversed (high->low)
  let c=mut.@($i64);
  lp(let z=n;z>=0;z=z-1){ c=c.push(coeff.get(z)) };
  let clen=mut.n+1;
  let taylor=mut.@($i64);
  lp(let z=0;z<=n;z=z+1){ taylor=taylor.push(0) };
  lp(let k=0;k<=n;k=k+1){
    let acc=mut.c.get(0);
    lp(let i=1;i<clen;i=i+1){
      c=c.set(i;c.get(i)+acc*a);
      acc=c.get(i);
    };
    taylor=taylor.set(k;acc);
    clen=clen-1;
  };
  let out=mut."";
  let fact=mut.1;
  lp(let k=0;k<=n;k=k+1){
    if(k>0){ fact=fact*k };
    if(k>0){ out=s.concat(out;"\n") };
    out=s.concat(out;s.fromint(fact*taylor.get(k)));
  };
  io.println(out);
  <0
};
