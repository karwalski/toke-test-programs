m=ratio;i=io:std.io;i=s:std.str;
f=fmt(x:f64):$str{
  let raw=s.format(x;"%.6f");
  let n=mut.s.len(raw);
  lp(n>0){ if(s.slice(raw;n-1;n)=="0"){n=n-1}el{br} };
  if(n>0){ if(s.slice(raw;n-1;n)=="."){n=n-1} };
  let r=mut.s.slice(raw;0;n);
  if(r==""){r="0"};
  if(r=="-0"){r="0"};
  <r
};
f=readall():$str{
  let all=mut.""; lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} }; <all
};
f=main():i64{
  let toks=s.fields(readall());
  let idx=mut.0; let n=mut.0; let found=mut.0;
  lp(idx<toks.len()){
    let v=s.tofloat(toks.get(idx));
    idx=idx+1;
    if(v>1.0){ let iv=(v as i64) as f64; if(v==iv){ n=v as i64; found=1; br } };
  };
  if(found==0){ <0 };
  let s1=mut.0.0; let s2=mut.0.0; let j=mut.0; let l=mut.0;
  lp(j<n){
    if(idx>=toks.len()){br};
    let a=s.tofloat(toks.get(idx));
    idx=idx+1; j=j+1;
    if(l==0){ s1=s1+a; l=1; }el{ s2=s2+a; l=0; }
  };
  if(s2==0.0){ io.println("NUMITORUL NUL"); }
  el{ io.println(s.concat("RAPORTUL ESTE : ";fmt(s1/s2))); };
  <0
};
