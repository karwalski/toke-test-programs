m=quad;i=io:std.io;i=s:std.str;
f=maskfor(idx:i64):i64{
  if(idx==0){<(1<<0)|(1<<1)|(1<<3)|(1<<4)};
  if(idx==2){<(1<<2)|(1<<1)|(1<<5)|(1<<4)};
  if(idx==6){<(1<<6)|(1<<3)|(1<<7)|(1<<4)};
  if(idx==8){<(1<<8)|(1<<5)|(1<<7)|(1<<4)};
  if(idx==1){<(1<<1)|(1<<0)|(1<<2)};
  if(idx==3){<(1<<3)|(1<<0)|(1<<6)};
  if(idx==5){<(1<<5)|(1<<2)|(1<<8)};
  if(idx==7){<(1<<7)|(1<<6)|(1<<8)};
  <(1<<4)|(1<<1)|(1<<3)|(1<<5)|(1<<7)
};
f=act(state:i64;idx:i64):i64{
  if(((state>>idx)&1)==1){<state};
  <state^maskfor(idx)
};
f=boardstr(state:i64):$str{
  let out=mut."";
  lp(let i=0;i<9;i=i+1){
    if(((state>>i)&1)==1){ out=s.concat(out;"1") }el{ out=s.concat(out;"0") };
  };
  <out
};
f=parseboard(x:$str):i64{
  let st=mut.0;
  lp(let i=0;i<9;i=i+1){
    if(s.slice(x;i;i+1)=="1"){ st=st|(1<<i) };
  };
  <st
};
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  let init=parseboard(toks.get(0));
  let mode=toks.get(1);
  if(mode=="SIM"){
    let state=mut.init;
    io.println(boardstr(state));
    let ntok=toks.len();
    lp(let k=2;k<ntok;k=k+1){
      let a=s.toint(toks.get(k));
      state=act(state;a);
      io.println(boardstr(state));
    };
  }el{
    let goal=parseboard(toks.get(2));
    if(init==goal){
      io.println("SOLUTION 0");
    }el{
      let visited=mut.@($i64);
      let parent=mut.@($i64);
      let paction=mut.@($i64);
      lp(let i=0;i<512;i=i+1){ visited=visited.push(0); parent=parent.push(-1); paction=paction.push(-1) };
      visited=visited.set(init;1);
      let queue=mut.@($i64);
      queue=queue.push(init);
      let head=mut.0;
      let found=mut.-1;
      lp(head<queue.len()&&found<0){
        let cur=queue.get(head);
        head=head+1;
        lp(let idx=0;idx<9;idx=idx+1){
          let t=act(cur;idx);
          if(visited.get(t)==0){
            visited=visited.set(t;1);
            parent=parent.set(t;cur);
            paction=paction.set(t;idx);
            queue=queue.push(t);
            if(t==goal){ found=t };
          };
        };
      };
      if(found<0){
        io.println("NONE");
      }el{
        let seq=mut.@($i64);
        let node=mut.goal;
        lp(node!=init){
          seq=seq.push(paction.get(node));
          node=parent.get(node);
        };
        let out=mut."SOLUTION";
        out=s.concat(out;s.concat(" ";s.fromint(seq.len())));
        let ln=seq.len();
        lp(let i=0;i<ln;i=i+1){
          out=s.concat(out;s.concat(" ";s.fromint(seq.get(ln-1-i))));
        };
        io.println(out);
      };
    };
  };
  <0
};
