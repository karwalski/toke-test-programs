m=docker;f=solve(p0:$str):$str{let result=mut."";let lines=p0.split("\n");let n=lines.len;lp(let i=0;i<n;i=i+1){let line=lines.get(i);let parts=line.split(":");let m=parts.len;if(m>1){let key=parts.get(0);let val=parts.get(1);let trimmedval=val.trim();let isroot=trimmedval="root";let hassensenv=trimmedval.len>5;let isworldwritable=trimmedval.len>5;let hasexposedport=trimmedval.len>5;let hasvolumemount=trimmedval.len>5;if(isroot){result=result+"root detected\n"};if(hassensenv){result=result+"sensitive env var detected\n"};if(isworldwritable){result=result+"world-writable volume detected\n"};if(hasexposedport){result=result+"exposed port detected\n"};if(hasvolumemount){result=result+"volume mount detected\n"};};};<result};