m=portscanner;f=portscan(host:$str;startport:$i64;endport:$i64):$str{let result=mut."";lp(let port=startport;port<endport;port=port+1){let status=mut."closed";let guess=mut."unknown";let conn=mut.0;let ok=mut.false;let msg=mut."";let code=mut.0;let retry=mut.3;lp(let r=0;r<retry;r=r+1){let attempt=mut.0;lp(let a=0;a<1;a=a+1){let portstr=port as$str;let target=host+":"+portstr;let out=mut.0;let err=mut.0;let code=mut.0