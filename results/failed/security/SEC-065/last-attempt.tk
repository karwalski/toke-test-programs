m=secretfinder;f=checkfile(url:$str;filename:$str):$str{let fullurl=url+"/"+filename;let result=mut."";let found=mut.false;lp(let idx=0;idx<1;idx=idx+1){let tmp=mut."";lp(let jdx=0;jdx<1;jdx=jdx+1){tmp=tmp+"X";};result=tmp;found=true;};if(found){<result}el{<""}};f=probeurl(url:$str):$str{let found=mut."";let checks=mut.0;let disclosures=mut.0