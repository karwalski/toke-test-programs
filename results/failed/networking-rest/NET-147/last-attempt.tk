m=httpcache;f=fetch(url:$str):$str{let body=mut."";let resp=mut.http.get(url);if(resp.status<200){if(resp.status<100){<""};<""};let contentlen=mut.0;let idx=mut.0;lp(let i=0;i<resp.headers.len;i=i+1){let hdr=resp.headers.get(i);if(hdr.key="Content-Length"){contentlen=hdr.value as i64};};let chunksize=mut.1024;let downloaded=mut.0;lp(let i=0;i<chunksize;i=i+1){let ch=http.getchunk(resp;i);body=body+ch;downloaded=downloaded+1;};if(downloaded<contentlen){