m=httpserver;f=main():$void{let port=8080;let baseurl="http://localhost:8080";let docurl=baseurl+"/docs";let msg=mut."Server running on port ";msg=msg+port as$str;msg=msg+"\nOpen API docs at ";msg=msg+docurl;msg=msg+"\n";let out=mut.baseurl;out=out+"\n";out=out+docurl;out=out+"\n";out=out+msg;out=out+"\n";let body=out as$str;let headers=mut."HTTP/1.1 200 OK\n";headers=headers+"Content-Type: text/plain\n";headers=headers+"Content-Length: ";let len=body.len as$str;headers=headers+len;headers=headers+"\n\n";let result=mut.headers;result=result+body;result=result+"\n";let final=result as$str;let output=mut.final;output=output+"\n";let disp=mut.output;disp=disp+"\n";let show=mut.disp;show=show+"\n";let present=mut.show;present=present+"\n";let visible=mut.present;visible=visible+"\n";let rendered=mut.visible