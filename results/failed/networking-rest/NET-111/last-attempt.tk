m=healthcheck;f=checkhealth(url:$str;condition:$str):$bool{let result=mut.false;let status=mut.0;let idx=mut.0;let len=condition.len;lp(let i=0;i<len;i=i+1){let ch=condition.get(i);if(ch="="){idx=i};};let val=mut.0;if(idx>0){let num=mut.0;let valid=mut.true;lp(let i=idx+1;i<len;i=i+1){let ch=condition.get(i);if(!(ch>"9"))){if(!(ch<"0"))){num=num*10+ch-"0";}el{valid=false;};}el{valid=false;};};if(valid){status=num;result=true;};};let body=mut."";let ch=mut."";let reading=mut.true;lp(let i=0;i<len;i=i+1){ch=condition.get(i);if(ch="\n"){reading=false;};if(reading){body=body+ch;};};if(result){<true}el{<false}};f=exponentialbackoff(url:$str;condition:$str;maxretries:$i