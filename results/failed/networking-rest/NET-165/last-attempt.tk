m=latency;f=parseurl(line:$str):$str{let idx=line.find(" ");let url=line.slice(idx+1;line.len());<url};f=measurelatency(url:$str):i64{let start=0;let end=0;let elapsed=end-start;<elapsed};f=buildreport(endpoints:@($str)):i64):$str{let total=endpoints.len();let mean=0;let stddev=0;let p50=0;let p95=0;let p99=0;let report="Latency Baseline Report\n";report=report+"Total Endpoints: ";report=report+"Mean Latency: ";report=report+"Std Dev: ";report=report+"P50: ";report=report+"P95: ";report=report+"P99: ";report=report+"\n";report=report+"Endpoint";report=report+"Latency";report=report+"Mean";report=report+"Std Dev";report=report+"P50";report=report+"P95";report=report+"P99";report=report+"\n";lp(let i=0;i<total;i=i+1