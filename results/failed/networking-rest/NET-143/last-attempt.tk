m=main;f=solve(p:$str;q:i64):$str{let result=mut."";let len=p.len;let idx=mut.0;lp(let i=0;i<len;i=i+1){let ch=p.get(i);if(ch="\n"){idx=0;}el{let code=ch as i64;let base=32;let shifted=code-code/base*base;let newch=shifted as$str;result=result+newch;idx=idx+1;};};<result};f=main():$void{let host="localhost";let port=8080;let msg="hello\n";let len=msg.len;let data=mut."";lp(let i=0;i<len;i=i+1){let ch=msg.get(i);data=data+ch;};let result=solve(data;port);<result};