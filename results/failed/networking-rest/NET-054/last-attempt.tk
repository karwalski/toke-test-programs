m=http2push;f=solve(p0:$str;p1:$str;p2:$str):$str{let html=mut.p0;let css=mut.p1;let js=mut.p2;let htmlstart="<html><head><title>";let htmlend="</title></head><body>";let csslink="<link rel=\"stylesheet\" href=\"styles.css\">";let jslink="<script src=\"script.js\"></script>";let htmlparts=htmlstart+htmlend;let htmlwithcss=htmlparts+csslink;let finalhtml=htmlwithcss+jslink;let result=mut."";let i=mut.0;let len=finalhtml.len;lp(let idx=0;idx<len;idx=idx+1){let ch=finalhtml.get(idx);result=result+ch;};<result};