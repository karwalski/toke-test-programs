m=post;f=getpost(id:$str):$str{let sql="select id,title,content,likes,comments from posts where id=?";let rows=mut.@();let params=@(id);let result=br.db.queryparams(sql;params);if(result.ok){rows=result.rows}el{rows=@()};let post=mut."";lp(let i=0;i<rows.len;i=i+1){let row=rows.get(i);post=row.id;post=post+" ";post=post+row.title;post=post+" ";post=post+row.content;post=post+" ";post=post+"likes:";post=post+row.likes;post=post+" ";post=post+"comments:";post=post+row.comments;post=post+" ";};<post};