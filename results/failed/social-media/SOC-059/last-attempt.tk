m=comment;f=comment(postid:$str;username:$str;commenttext:$str):$str{let result=mut."";result=result+"Comment: ";result=result+commenttext;result=result+"\n";result=result+"Posted by: ";result=result+username;result=result+" on ";result=result+postid;result=result+"\n";result=result+"---\n";<result};