m=warning;f=warn(user:$str;strike:$i64):$void{if(strike>2){let msg="WARNING: Strike 3. Immediate action required.";let action="BLOCK";let log="user:"+user+" strike:"+strike as$str+" action:"+action+" msg:"+msg;let out=mut.msg;let final=log;};let msg="WARNING: Strike 2. Next strike may result in action.";let action="WARN