m=warn;f=warnpost(id:$str;title:$str;content:$str;author:$str):$str{let w=mut."";if(content.len>100){w="WARNING: This post contains sensitive information. Please read carefully."};let r=mut."";r=r+w;r=r+"\n";r=r+title;r=r+"\n";r=r+content;r=r+"\n";r=r+author;<r};f=main():$void{let id="p1";let title="Test";let content="Hello world";let author="me";let out=warnpost(id;title;content;author);<out};