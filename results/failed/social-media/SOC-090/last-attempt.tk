m=search;f=search(verified:$bool;minfollowers:$i64;maxfollowers:$i64;location:$str):$str{let result=mut."";let vstr=mut."";if(verified){vstr="verified"}el{vstr="not verified"};let minstr=mut."";let maxstr=mut."";let minval=mut.minfollowers;let maxval=mut.maxfollowers;if(minval<0){minval=0};if(maxval<0){maxval=0};if(minval>maxval){let tmp=minval;minval=maxval;maxval=tmp};let minchars=mut.0;let maxchars=mut.0;if(minval<10){minchars=1}el{minchars=2};if(maxval<10){maxchars=1}el{maxchars=2