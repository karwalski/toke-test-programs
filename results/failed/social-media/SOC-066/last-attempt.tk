m=comments;f=init():$str{let html=mut."";html=html+"<div id=\"comments-section\">";html=html+"<h2>Comments</h2>";html=html+"<ul id=\"comment-list\"></ul>";html=html+"</div>";<html};f=appendcomment(html:$str;author:$str;body:$str):$str{let comment=mut."";comment=comment+"<li class=\"comment-item\">";comment=comment+"<div class=\"comment-author\">"+author+"</div>";comment=comment+"<div class=\"comment-body\">"+body+"</div>";comment=comment+"</li>";let result=mut."";result=result+html;result=result+"</li>";<result};f=pin