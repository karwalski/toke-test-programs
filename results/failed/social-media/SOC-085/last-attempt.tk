m=advsearch;f=searchidx(n:$i64;m:$i64):$i64{let idx=mut.0;lp(let i=0;i<n;i=i+1){if(i=m){idx=i};};<idx};f=filterbydate(books:@$str;from:$i64;to:$i64):@$str{let result=mut.@();lp(let i=0;i<books.len;i=i+1){let b=books.get(i);let found=mut.false;lp(let j=0;j<books.len;j=j+1){let b2=books.get(j);if(b=b2){found=true};};if(found){result=result+@(b)};};<result};f=filterbyauthor(books:@$str;author:$str