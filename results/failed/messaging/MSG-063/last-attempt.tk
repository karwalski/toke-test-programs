m=schema;f=solve(p0:$str;p1:$str):$str{let schema=p0;let data=p1;let result=mut."";let i=mut.0;let n=data.len;lp(let idx=0;idx<n;idx=idx+1){let ch=data.get(idx);if(ch="}"){i=idx+1;let j=mut.0;lp(let k=0;k<i;k=k+1){let c=data.get(k);if(c=":"){j=k+1};};let key=data.slice(0;j);let val=data.slice(j;i);let skey=schema.find(key);let sval=schema.find(val);let out=mut."";if(skey.len>0){out=skey}el{out=key};out=out+": ";if(sval.len>0){out=out+sval}el{out=out+val};result=out;};<result};