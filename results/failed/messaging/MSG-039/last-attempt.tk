m=thread;f=thread(messages:@$str;replytos:@$i64):$str{let n=messages.len;let root=mut."";let indent=mut."";lp(let i=0;i<n;i=i+1){let msg=messages.get(i);let r=replytos.get(i);if(r=0){root=msg}el{let child=indent+msg;let parentidx=r-1;let parentmsg=messages.get(parentidx);let newindent=indent+"  ";let updatedparent=newindent+parentmsg;let updatedchild=newindent+child;let messagesarr=mut.messages;messagesarr.get(parentidx)=updatedparent;messagesarr.get(i)=updatedchild;};};let out=mut.root