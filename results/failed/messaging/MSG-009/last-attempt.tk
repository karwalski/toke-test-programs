m=mac;f=solve(p:$str;q:$str):$str{let msg=p;let key=q;let msglen=msg.len;let keylen=key.len;let blocksize=64;let hashlen=32;let ipad=mut."";let opad=mut."";lp(let i=0;i<blocksize;i=i+1){let idx=i as u64;if(idx<keylen){ipad=ipad+key.sub(idx;idx+1));opad=opad+key.sub(idx;idx+1));}el{ipad=ipad+"0";opad=opad+"0";}};let ipadhash