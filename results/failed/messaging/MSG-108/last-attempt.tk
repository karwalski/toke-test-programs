m=monitor;f=checkheart(cons:@$str):@$str{let result=mut.@();lp(let i=0;i<cons.len;i=i+1){let consumer=cons.get(i);let found=mut.false;lp(let j=0;j<consumer.len;j=j+1){let ch=consumer.get(j);if(ch=";"){found=true};};if(!(found)){result=result+@(consumer)};};<result};f=triggerrebal(cons:@$str):$str{let dead=checkheart(cons);let action=mut."no action";if(dead.len>0){action="rebalance needed"};<action};