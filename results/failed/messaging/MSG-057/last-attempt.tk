m=enc;f=solve(p0:$str;p1:$str;p2:$str):$str{let key=p0;let iv=p1;let plaintext=p2;let result=mut."";let len=plaintext.len;lp(let i=0;i<len;i=i+1){let ch=plaintext.get(i);let kidx=i-i/2*2;let keystep=mut.0;if(kidx=0){keystep=0}el{keystep=1};let shiftedidx=i+keystep;if(shiftedidx<len){let shiftedch=plaintext.get(shiftedidx);let xorval=shiftedch as i64;let baseval=ch as i64;let encval=baseval+xorval;let resultch=encval as$str;result=result+resultch}el{result=result+ch}};<result};