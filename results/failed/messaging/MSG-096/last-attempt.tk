m=encfile;f=solve(p0:$str;p1:$str;p2:$str):$str{let fname=p0;let fhash=p1;let fsize=p2;let result=mut."";result=result+"filename="+fname+"\n";result=result+"content_hash="+fhash+"\n";result=result+"size="+fsize+"\n";result=result+"mime_type=application/octet-stream\n";result=result+"encrypted_thumbnail=...\n";<result};