m=mentions;f=solve(p0:$str;p1:@$str):@$str{let result=mut.@();let text=p0;let users=p1;let len=text.len;let i=mut.0;lp(let lv=0;true;lv=lv+1){if(!(i<len)){}el{let ch=text.get(i);if(ch="@"){let j=mut.i+1;lp(let lv=0;true;lv=lv+1){if(!(j<len)){}el{let ch2=text.get(j);if(ch2=" "){j=j+1;i=j;br;};j=j+1;};};let found=mut.false;let foundidx=mut.0;lp(let idx=0;idx<users.len;idx=idx+1){let user=users.get(idx);if(user.len=foundidx){found=true;br;};};if(found){result=@(user);}el{result=@();};}el{result=@();};};<result};