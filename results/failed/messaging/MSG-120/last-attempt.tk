m=history;f=loadhistory(n:$i64):$str{let out=mut."";lp(let i=0;i<n;i=i+1){let s="msg "+i as$str+": hello world\n";out=out+s;};<out};f=countmessages(s:$str):$i64{let lines=s.split("\n");let count=mut.0;lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let ismsg=line.find("msg ");if(!(ismsg=-1)){count=count+1;};};<count};f=findgaps(s:$str):$str{let total=countmessages(s);let result=mut."";lp(let i=0;i<total;i=i+1){let found=s.find("msg "+i as$str+":"));if(found=-1){let gapstr="gap "+i as$str+":\n";result=result+gapstr;};};<result};f=main():$i64{let history=loadhistory(10);let gaps=findgaps(history);let out=mut."";if(gaps.len=0){out="no gaps found\n";}el{out=gaps;