m=aggregate;f=process(source:$str;message:$str):$str{let prefix=source+": ";let result=prefix+message;<result};f=aggregate(messages:@$str;sources:@$str):$str{let inbox=mut."";let count=messages.len;lp(let idx=0;idx<count;idx=idx+1){let msg=messages.get(idx);let source=sources.get(idx);let entry=process(source;msg);inbox=inbox+entry+"\n";};<inbox};