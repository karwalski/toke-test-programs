m=broker;f=subscribe(topic:$str;subscriber:$str):$str{let result=mut."";result=result+subscriber+" subscribed to "+topic;let topicsub=topic+"@"+subscriber;result=result+"\n"+topicsub;let check=mut."";check=check+subscriber+" not subscribed to ";check=check+topic;let invalid=mut."";invalid=invalid+subscriber+" already subscribed to "+topic;if(!(subscriber+"@"+topic)as$str=check){<invalid};<result};f=un