m=aggreadreceipts;f=sortbyid(msgids:@$str;reads:@$str):@$str{let n=msgids.len;let sortedids=mut.@();lp(let i=0;i<n;i=i+1){sortedids=sortedids+@(msgids.get(i))};let result=mut.@();lp(let i=0;i<n;i=i+1){let minidx=mut.i;lp(let j=i+1;j<n;j=j+1){let cmp=sortedids.get(j).cmp(sortedids.get(minidx)));if(cmp<0){minidx=j};};result=result+@(sortedids.get(minidx)));};<result};f=aggreadreceipts(msgids:@$str;reads:@$str):$str{let sortedids=sortbyid(msgids;reads);let n=sortedids.len;let result=mut."";lp(let i=0;i<n;i=i+1){let id=sortedids.get(i);let readflag=mut."false";lp(let j=0;j<msgids.len;j=j+1){if(msgids.get(j)=id)){if(reads.get(j)="true")){readflag="true"};};};result=result