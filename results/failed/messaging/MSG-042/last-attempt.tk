m=chatexport;f=exportchat(sessionid:$str;messages:@$str):$str{let header="Chat Session Export\nSession ID: ";let footer="\nEnd of session.\n";let body=mut."";lp(let i=0;i<messages.len;i=i+1){let msg=messages.get(i);let isuser=i=0;let prefix=mut."";if(isuser){prefix="[User] ";}el{prefix="[Assistant] ";};body=body+prefix+msg+"\n";};let result=header+sessionid+"\n\n"+body+footer;<result;};