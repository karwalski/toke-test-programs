m=deliverystats;f=parsestatus(line:$str):$str{let idx=mut.0;lp(let i=0;i<line.len;i=i+1){if(line.get(i)as u8=58 as u8){idx=i+1}};let status=mut."";lp(let i=idx;i<line.len;i=i+1){status=status+line.get(i)as$str};<status};f=countstatus(lines:@$str;status:$str):$i64{let count=mut.0;lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let parsedstatus=parsestatus(line);if(parsedstatus=status){count=count+1}};<count};f=totalmessages(lines:@$str):$i64{let total