m=syncdirs;f=syncdirs(source:$str;dest:$str;delete:$bool):$bool{let files=mut.@();let i=io:std.io;let list=i:io.listdir(source);lp(let idx=0;idx<list.len;idx=idx+1){let fname=list.get(idx);let path=source+"/"+fname;let isdir=i:io.isdir(path);if(!(isdir)){files=files+@(fname)};};lp(let idx=0;idx<files.len;idx=idx+1){let fname=files.get(idx);let srcpath=source+"/"+fname;let destpath=dest+"/"+fname;let srcstat=i:io.stat(srcpath);let deststat=i:io.stat(destpath);let srcmtime=srcstat.mtime;let destmtime=deststat.mtime;if(!(srcmtime=destmtime)){i:io.copy(srcpath;destpath)};};if(delete){let destlist=i:io.listdir(dest);lp(let idx=0;idx<destlist.len;idx=idx+1){let fname=destlist.get(idx);let path=dest