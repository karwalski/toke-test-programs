m=zip;f=zip(files:@$str;outname:$str):$str{let result=mut."";lp(let i=0;i<files.len;i=i+1){let fname=files.get(i);let line=fname+"\n";result=result+line;};let outfname=outname+".zip";let finalline=outfname+"\n";result=result+finalline;<result};f=main():$void{let files=@("file1.txt";"file2.txt";"dir1"));let outname="archive";let zipresult=zip(files;outname);<zipresult};