m=logparse;f=parseapachelog(line:$str):$str{let parts=line.split(" ");let ip=parts.get(0);let csmethod=parts.get(3);let csuri=parts.get(4);let csprotocol=parts.get(5);let scstatus=parts.get(8);let bodybytes=parts.get(9);let referer=parts.get(11);let useragent=parts.get(12);let output=ip+" "+csmethod+" "+csuri+" "+scstatus+" "+bodybytes+" "+referer+" "+useragent;<output;};f=main():$void{let logline="192.168.1.1 - - [10/Oct/2000:13:55:36 -0700] \"GET /apache_pb.gif HTTP/1.0\" 200 2326 \"-\" \"Mozilla/4.05 [en-us] (Win95; IEMain)\"";let result=parseapachelog(logline);<result;};