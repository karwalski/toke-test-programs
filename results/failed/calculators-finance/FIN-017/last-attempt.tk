m=europeancall;i=io:std.io;i=s:std.str;i=math:std.math;f=normcdf(x:$f64):$f64{let a1=0.254829592;let a2=-0.284496736;let a3=1.421413741;let a4=-1.453152027;let a5=1.061405429;let p=0.3275911;let absx=mut.x;if(x<0.0){absx=0.0-x};let t=1.0/(1.0+p*absx);let poly=((((a5*t+a4)*t+a3)*t+a2)*t+a1)*t;let expval=math.exp(-0.5*absx*absx);let sqrtval=math.sqrt(2.0*3.141592653589793);let y=1.0-poly*expval/sqrtval;if(x<0.0){<1.0-y};<y};f=blackscholescall(s:$f64;k:$f64;t:$f64;r:$f64;sigma:$f64):$f64{if(t<=0.0){if(s>k){<s-k};<0.0};let d1=(math.ln(s/k)+(r+0.5*sigma*sigma)*t)/(sigma*math.sqrt(t));let d2=d1-sigma*math.sqrt(t);let nd1=normcdf(d1);let nd2=normcdf(d2);let result=s*nd1-k*math.exp(-r*t)*nd2;<result};f=main():$i64{let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=5){let spotprice=s.tofloat(parts.get(0));let strike=s.tofloat(parts.get(1));let timetoexp=s.tofloat(parts.get(2));let rate=s.tofloat(parts.get(3));let vol=s.tofloat(parts.get(4));let price=blackscholescall(spotprice;strike;timetoexp;rate;vol);io.println(s.format(price;"%.4f"))}el{io.println("0.0000")};<0}