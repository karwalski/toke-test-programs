m=loancompare;f=compare(loans:@($str;$i64;$i64;$i64)));f=printloan(name:$str;principal:$i64;rate:$i64;term:$i64){let total=principal+rate;let monthly=total/term;let out=mut."";out=out+name;out=out+" principal:";out=out+principal as$str;out=out+" rate:";out=out+rate as$str;out=out+" term:";out=out+term as$str;out=out+" total:";out=out+total as$str;out=out+" monthly:";out=out+monthly as$str;<out};