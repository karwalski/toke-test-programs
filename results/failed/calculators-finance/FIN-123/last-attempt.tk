m=golden;i=io:std.io;i=s:std.str;f=movingavg(prices:@($f64);start:$i64;window:$i64):$f64{let sum=mut.0.0;let idx=mut.start;lp(idx<start+window){sum=sum+prices.get(idx);idx=idx+1};<sum/(window as $f64)};f=buildarray(strarr:@($str)):@($f64){let result=mut.@();let idx=mut.0;lp(idx<strarr.len()){let val=s.tofloat(strarr.get(idx));result.push(val);idx=idx+1};<result};f=main():$i64{let line1=io.readln();let params=s.split(line1;" ");let short=s.toint(params.get(0));let long=s.toint(params.get(1));let line2=io.readln();let pricestr=s.split(line2;",");let prices=buildarray(pricestr);let prevshortma=mut.0.0;let prevlongma=mut.0.0;let pos=mut.long;let hascrossed=mut.0;lp(pos<prices.len()){let currshortma=movingavg(prices;pos-short+1;short);let currlongma=movingavg(prices;pos-long+1;long);if(pos>long){if(prevshortma<=prevlongma){if(currshortma>currlongma){io.println(s.concat(s.concat(s.fromint(pos+1);" ");"GOLDEN_CROSS"));hascrossed=1}}el{if(currshortma<currlongma){io.println(s.concat(s.concat(s.fromint(pos+1);" ");"DEATH_CROSS"));hascrossed=1}}};prevshortma=currshortma;prevlongma=currlongma;pos=pos+1};if(hascrossed=0){io.println("NO_CROSS")};<0}