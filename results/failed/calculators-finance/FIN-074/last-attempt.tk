m=invoice;f=calcprice(qty:$i64;price:$f64):$f64{let total=qty*price;let discount=total*0.1;if(discount>0.0){let final=total-discount;<final}el{<total}};f=invoice(items:@$str;qty:@$i64;price:@$f64):$f64{let total=mut.0.0;lp(let idx=0;idx<items.len;idx=idx+1){let item=items.get(idx);let q=qty.get(idx);let p=price.get(idx);let itemtotal=calcprice(q;p);total=total+itemtotal};<total};