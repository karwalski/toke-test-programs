m=zscore;f=zscore(arr:@f64):@f64{let n=arr.len;let m=mut.0;lp(let i=0;i<n;i=i+1){m=m+arr.get(i);};let avg=m/n as f64;let s=mut.0;lp(let i=0;i<n;i=i+1){let diff=arr.get(i)-avg;s=s+diff*diff;};let sd=sqrt(s/n as f64);let result=mut.@();lp(let i=0;i<n;i=i+1){let diff=arr.get(i)-avg;let z=diff/sd;result=result+@(z);};<result};f=sqrt(x:f64):f64{let guess=mut.x;lp(let i=0;i<10;i=i+1){let next=(guess+x/guess)/2;guess=next;};<guess};