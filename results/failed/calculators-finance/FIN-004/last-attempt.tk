m=bigint;f=add(first:$str;second:$str):$str{let len1=first.len;let len2=second.len;let maxlen=mut.len1;if(len2>maxlen){maxlen=len2};let result=mut."";let carry=mut.0;lp(let idx=0;idx<maxlen;idx=idx+1){let digit1=mut.0;let digit2=mut.0;if(idx<len1){digit1=first.get(idx)-48};if(idx<len2){digit2=second.get(idx)-48};let sum=digit1+digit2+carry;let digit=mut.sum;let tmp=mut.0;if(sum>9){tmp=sum/10;digit=sum-tmp*10;carry=tmp};if(idx=maxlen-1){if(carry>0){result=result+(carry as$str)}};let out=mut."";lp(let i=0;i<result.len;i=i+1){out=out+result.get(i)};if(out.len=0){<"0"};<out};f=main():$i64{let a="1234567890123