m=baseconv;f=baseconv(n:$i64;basefrom:$i64;baseto:$i64):$str{if(basefrom=baseto){<n as$str};let digits=mut."0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";let val=mut.n;let other=mut.basefrom;let result=mut."";if(val=0){<"0"};if(other<2){<"Invalid base"};lp(let idx=0;idx<1000;idx=idx+1){if(val=0){br};let digit=val-val/other*other;result=digits.get(digit as u64))+result;val=val/other};<result};