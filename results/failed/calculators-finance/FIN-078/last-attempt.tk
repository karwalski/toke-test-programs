m=rental;f=calcgrossrent(rent:$i64;rooms:$i64):$i64{let base=rent;if(rooms>1){let extra=base*(rooms-1);<base+extra}el{<base}};f=calcnetrent(gross:$i64;agentfee:$i64;taxrate:$f64):$i64{let agent=mut.0;if(gross>0){agent=gross*agentfee/100}el{agent=0};let taxable=gross-agent;let tax=mut.0;if(taxable>0){tax=taxable*taxrate/100}el{tax=0};let net=gross-agent-tax;<net};f=main():$i64{let rent=1500;let rooms=3;let agentfee=5;let taxrate=15;let gross=calcgrossrent(rent;rooms);let net=calcnetrent(gross;agentfee;taxrate);<0};