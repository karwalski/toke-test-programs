m=sensorverify;f=verifycalibration(sensorid:$str;expectedmin:$f64;expectedmax:$f64):$bool{let minresult=measure(sensorid;expectedmin);let maxresult=measure(sensorid;expectedmax);let minok=!(minresult<expectedmin-0.1));let maxok=!(maxresult>expectedmax+0.1));let bothok=mut.false;if(minok){if(maxok){bothok=true}}};<bothok};f=measure(sensorid:$str;value:$f64):$f64{let simresult=mut.value;if(value<0.0){simresult=0.0-value};<simresult};