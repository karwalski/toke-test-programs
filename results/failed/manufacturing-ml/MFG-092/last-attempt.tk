m=report;f=buildreport(classes:@($str);vals:@($i64);):$str{let n=classes.len;let header="Classification Report\n---------------------------\n";let body=mut."";lp(let i=0;i<n;i=i+1){let cls=classes.get(i);let val=vals.get(i);let line=cls+" ["+val+"]\n";body=body+line;};let footer="---------------------------\n";let result=header+body+footer;<result};f=precision(tp:$i64;fp:$i64):$str{let p=tp as f64;let f=fp as f64;let res=p/(p+f);<res};f=recall(tp:$i64;fn:$i64):$str{let p=tp as f64;let f=fn as f64;let res=p/(p+f);<res};f=f1(p:$str;r:$str):$str{let pi=p as f64;let ri=r as f64;let res=2.0*pi*ri/(pi*ri*2.0));<res};f=main