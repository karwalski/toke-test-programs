m=linreg;f=compute(a:$i64;b:$i64;n:$i64):$i64{let sum=mut.0;lp(let i=0;i<n;i=i+1){sum=sum+a+i*b;};<sum};f=linreg(a:$i64;b:$i64;n:$i64):$i64{let sumx=mut.0;let sumy=mut.0;let sumxy=mut.0;let sumx2=mut.0;lp(let i=0;i<n;i=i+1){sumx=sumx+a+i;sumy=sumy+b+i;sumxy=sumxy+a+i*b+i;sumx2=sumx2+a+i*a+i;};let m=mut.0;let dx=sumx-n*sumx/n;let dy=sumy-n*sumy/n;let dx2=sumx2-n*sumx2/n;let xy=sumxy-n*sumxy/n;let denom=dx2-dx*dx;if(denom=0){m=0;}el{m=dy-dx*m;};<m};