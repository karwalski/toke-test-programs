m=mcicap;f=correlation(x:$f64;y:$f64;n:$i64):$f64{let sumx=mut.0.0;let sumy=mut.0.0;let sumxy=mut.0.0;let sumx2=mut.0.0;let sumy2=mut.0.0;lp(let i=0;i<n;i=i+1){let xi=x;let yi=y;sumx=sumx+xi;sumy=sumy+yi;sumxy=sumxy+xi*yi;sumx2=sumx2+xi*xi;sumy2=sumy2+yi*yi};let nval=n as$f64;let meanx=sumx/nval;let meany=sumy/nval;let cov=mut.0.0;lp(let i=0;i<n;i=i+1){let xi=x;let yi=y;let meanx=meanx;let meany=meany;cov=cov+xi*yi;};let varx=sumx2/nval-meanx*meanx;let vary=sumy2/nval-meany*meany;let covar=cov