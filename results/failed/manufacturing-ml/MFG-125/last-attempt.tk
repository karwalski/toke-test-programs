m=reflow;f=profile(temp:$i64;tss:$i64;toil:$i64):$str{let label=mut."unknown";if(temp<tss){label="preheat"}el{if(temp>toil){label="overheat"}el{label="reflow"}};<label};f=checkprofile(temp:$i64;tss:$i64;toil:$i64):$bool{let label=profile(temp;tss;toil);let ok=mut.false;if(label="reflow"){ok=true};<ok};f=main():$i64{let tss=180;let toil=220;let temp=200;let ok=checkprofile(temp;tss;toil);if(ok){<0}el{<1}};