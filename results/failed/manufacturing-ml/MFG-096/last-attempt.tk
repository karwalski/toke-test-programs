m=changepoint;f=abs(x:$i64):$i64{if(x<0){<x*-1};<x};f=max2(x:$i64;y:$i64):$i64{if(x>y){<x};<y};f=min2(x:$i64;y:$i64):$i64{if(x<y){<x};<y};f=linearfit(x:$@i64;y:$@i64):$@i64{let n=x.len;let sumx=mut.0;let sumy=mut.0;let sumxy=mut.0;let sumx2=mut.0;lp(let i=0;i<n;i=i+1){sumx=sumx+x.get(i);sumy=sumy+y.get(i);sumxy=sumxy+x.get(i)*y.get(i);sumx2=sumx2+x.get(i)*x.get(i)};let m=(n*sumxy-sumx*sumy)/(n*sumx2-sumx*sumx));let c=(sumy-m*sumx)/n;<@(m;c)};f=pelt(x:$@i6