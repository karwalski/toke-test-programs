m=loadbalance;f=assignmachine(taskid:$str;totaltasks:$i64):$str{let idx=mut.0;let found=mut.false;lp(let i=0;i<totaltasks;i=i+1){if(i=taskid){idx=i;found=true}};if(found){<("machine_"as$str)+idx as$str}el{<""}};f=main():$void{let taskids=@(1;2;3;4;5));let totaltasks=taskids.len;let assigned=mut.@();lp(let i=0;i<totaltasks;i=i+1){let taskid=taskids.get(i);let result=assignmachine(taskid;totaltasks);assigned=assigned+@(result))};lp(let i=0;i<assigned.len;i=i+1){let a=assigned.get(i);let valid=mut.false;if(!(a.len=0))){valid=true};if(valid){<a}el{<""}}};