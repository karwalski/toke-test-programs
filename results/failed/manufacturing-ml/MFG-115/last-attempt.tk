m=optimaladjustment;f=calculateadjustment(currentpos:$i64;targetpos:$i64):$i64{let diff=targetpos-currentpos;let half=diff/2;let rem=diff-half*2;if(rem=0){<half}el{if(diff>0){<half+1}el{<half-1}}};f=applyadjustment(currentpos:$i64;adjustment:$i64):$i64{<currentpos+adjustment};f=main():$i64{let current=10;let target=20;let adj=calculateadjustment(current;target);let newpos=applyadjustment(current;adj);<0};