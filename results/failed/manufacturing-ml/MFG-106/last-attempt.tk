m=jobseq;f=sortjobs(jobs:@($i64;$i64))):@$i64{let n=jobs.len;let ids=mut.@();lp(let i=0;i<n;i=i+1){ids=ids+@(i)};let sortedids=mut.ids;lp(let i=0;i<n;i=i+1){let minidx=mut.sortedids.get(i);lp(let j=i+1;j<n;j=j+1){let curridx=sortedids.get(j);let currjob=jobs.get(curridx);let minjob=jobs.get(minidx);if(currjob<minjob){minidx=curridx};};sortedids.get(i)=minidx;};<sortedids};f=calcmakespan(jobs:@($i64;$i64));order:@($i64)):i64{let n=order.len;let total=mut.0;let current=mut.0;lp(let i=0;i<n;i=i+1){let idx=order.get(i);let job=jobs.get(idx);let duration=job;current=current+duration;total=total+current};<total};f=bruteopt