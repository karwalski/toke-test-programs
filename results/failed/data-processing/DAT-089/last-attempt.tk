m=stringdist;f=levenshtein(a:$str;b:$str):$i64{let alen=a.len;let blen=b.len;let rows=alen+1;let cols=blen+1;let dp=mut.@();lp(let i=0;i<rows;i=i+1){let row=mut.@();lp(let j=0;j<cols;j=j+1){let cell=mut.0;if(i=0){cell=j as i64}el{if(j=0){cell=i as i64}el{let ai=i-1;let bi=j-1;let cost=mut.0;if(a.get(ai)=b.get(bi))){cost=0}el{cost=1};let c1=dp.get(i).get(j-1);let c2=dp.get(i-1).get(j);let c3=dp.get(i-1).get(j-1));let minval=mut.c1;if(c2<minval){minval=c2};if(c3<minval){minval=c3};cell=minval+cost}};row.push(cell)}};dp.push(row)}};let result=dp.get(al