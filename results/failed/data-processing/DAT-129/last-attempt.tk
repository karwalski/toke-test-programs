m=formatter;f=formatinput(input:$str):$str{let lines=input.split("\n");let result=mut."";lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let trimmed=line.trim();if(!(trimmed.len=0))){let parts=trimmed.split(",");let namepart=parts.get(0);let name=namepart.trim();let valuepart=parts.get(1);let value=valuepart.trim();let jsonpart=mut."";if(!(i=0))){jsonpart=jsonpart+"\n"};jsonpart=jsonpart+"{\"name\":\""+name+"\",\"value\":\""+value+"\"}";result=result+jsonpart};<result};f=main():$void{let input="Alice,42\nBob,29";let output=formatinput(input);<output};