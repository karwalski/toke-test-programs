m=parser;f=solve(p0:$str;p1:$str):$str{let data=p0;let schema=p1;let result=mut."";let lines=data.split("\n");let header=lines.get(0);let hdrfields=header.split(",");let schfields=schema.split(",");let nfields=hdrfields.len;lp(let i=0;i<nfields;i=i+1){let hdr=hdrfields.get(i);let sch=schfields.get(i);let start=hdr.start;let width=hdr.width;let field=mut."";let j=mut.0;lp(let k=0;k<width;k=k+1){let idx=start+k;let ch=lines.get(1).charat(idx);field=field+ch;j=j+1};result=result+field;if(!(i=nfields-1)){result=result+"\n"};};<result};