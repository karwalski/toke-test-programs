m=httplog;f=extractfield(line:$str;field:$i64):$str{let parts=line.split(" ");let count=parts.len;if(field<count){<parts.get(field)}el{<""}};f=extractmethod(line:$str):$str{<extractfield(line;0)}};f=extracturl(line:$str):$str{<extractfield(line;1)}};f=extractstatus(line:$str):$str{<extractfield(line;2)}};f=extractbytes(line:$str):$str{<extractfield(line;3)}};f=extractreferrer(line:$str):$str{<extractfield(line;4)}};f=extractuseragent(line:$str):$str{<extractfield(line;5)}};f=extractall(line:$str):$str{<extractmethod(line)+","+extracturl(line)+","+extractstatus(line)+","+extractbytes(line)+","+extractreferrer(line)+","+extractuseragent(line)}};