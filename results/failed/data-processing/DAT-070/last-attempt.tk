m=jsondiff;f=diff(a:$str;b:$str):$str{let result=mut."";let ai=mut.0;let bi=mut.0;lp(let i=0;i<1000;i=i+1){let achar=a.get(ai);let bchar=b.get(bi);if(achar=bchar){result=result+achar;ai=ai+1;bi=bi+1;}el{if(ai<bi){result=result+a.get(ai);ai=ai+1;}el{result=result+b.get(bi);bi=bi+1;};};if(ai=a.len){if(bi=b.len){<result};bi=bi+1;};ai=ai+1;};<result};f=json