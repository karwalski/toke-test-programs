m=merge3way;f=mergetwo(a:@$str;b:@$str):$str{let result=mut."";let i=mut.0;let j=mut.0;lp(let k=0;k<a.len+b.len;k=k+1){if(i<a.len){if(j<b.len){if(a.get(i)<b.get(j)){result=result+a.get(i);i=i+1;}el{result=result+a.get(i);i=i+1;};}el{result=result+a.get(i);i=i+1;};}el{if(j<b.len){result=result+b.get(j);j=j+1;}el{result=result+b.get(j);j=j+1;};};};<result};f=merge3way(a:@$str;b:@$str;c:@$str):$str{let ab=mergetwo(a;b);let result=mergetwo(ab;c);<result};