m=apache;f=extracthour(ts:$str):$i64{let spacepos=ts.indexof(" ");let hourstart=ts.indexof(":",spacepos);let hourend=ts.indexof(" ",hourstart);let hourstr=ts.substring(hourstart;hourend);<hourstr.toi64()};f=extractstatus(line:$str):$i64{let spacepos=line.indexof(" ");let statusstart=spacepos;let statusend=statusstart+3;let statusstr=line.substring(statusstart;statusend);<statusstr.toi64()};f=countrequests(lines:@$str;hour:$i64):$i64{let count=mut.0;lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let spacepos=line.indexof(" ");let hourstr=line.substring(spacepos;spacepos+2);let extractedhour=hourstr.toi64();if(extractedhour=hour){count=count+1;};};<count};f=aggregatebyhourstatus(lines:@$str):@($str;$str;$str):void{let counts=mut.@($str;$str;$str));