m=csvtype;f=solve(p0:$str):$str{let lines=p0.split("\n");let n=lines.len;let result=mut."";lp(let i=0;i<n;i=i+1){let line=lines.get(i);let cols=line.split(",");let m=cols.len;lp(let j=0;j<m;j=j+1){let col=cols.get(j);let numcol=col.toi64();if(numcol=col){result=result+"i64,"}el{let boolcol=col.tobool();if(boolcol=col){result=result+"bool,"}el{result=result+"str,"}}};if(n>0){result=result.substr(0;result.len-1)};<result};