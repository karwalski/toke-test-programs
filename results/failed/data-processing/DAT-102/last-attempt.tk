m=changelog;f=extractversions(content:$str):@$str{let lines=content.split("\n");let versions=mut.@();let i=mut.0;lp(let idx=0;idx<lines.len;idx=idx+1){let line=lines.get(idx);let isversion=mut.false;if(line.len>0){let firstchar=line.get(0);if(firstchar="v"){isversion=true;};};if(isversion){let versionstr=line;versions=versions+@(versionstr);};};<versions};f=extractchange