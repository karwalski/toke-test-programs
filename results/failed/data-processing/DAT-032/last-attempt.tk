m=join;f=solve(left:$str;right:$str):$str{let leftrows=left.split("\n");let rightrows=right.split("\n");let header=leftrows.get(0);let keys=header.split(",");let result=mut."";lp(let i=0;i<rightrows.len;i=i+1){let row=rightrows.get(i);if(row.len=0){br};let cols=row.split(",");let keyval=cols.get(0);let found=mut.false;let matchedrow=mut."";lp(let j=0;j<leftrows.len;j=j+1){let lrow=leftrows.get(j);if(lrow.len=0){br};let lcols=lrow.split(",");let lkeyval=lcols.get(0);if(lkeyval=keyval){found=true;matchedrow=lrow;br};};if(found){result=result+matchedrow+"\n"};};<result};