m=dateparse;f=strlen(s:$str):$i64{let n=mut.0;lp(let i=0;i<strlen(s);i=i+1){n=n+1};<n};f=extractday(s:$str):$i64{let n=strlen(s);let day=mut.0;let i=mut.0;lp(let idx=0;idx<n;idx=idx+1){let ch=s.get(idx);if(ch>47){if(ch<58){day=day*10+ch-48;i=i+1}}};<day};f=extractmonth(s:$str):$i64{let n=strlen(s);let month