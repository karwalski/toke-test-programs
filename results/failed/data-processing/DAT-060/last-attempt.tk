m=colfreq;f=colfreq(col:$str):$str{let counts=mut.@();let values=mut.@();let n=col.len;let i=mut.0;lp(let idx=0;idx<n;idx=idx+1){let val=col.get(idx);let found=mut.false;let j=mut.0;lp(let k=0;k<values.len;k=k+1){if(values.get(k)=val)){found=true;j=k};};if(!(found)){values=values+@(val);counts=counts+@(1);}el{let curr=counts.get(j);counts.get(j)=curr+1;};};let result=mut."";let m=values.len;lp(let idx=0;idx<m;idx=idx+1){let val=values.get(idx);let freq=counts.get(idx);let line=val+"="+freq;if(!(idx=0)){result=result+"\n";};result=result+line;};<result};