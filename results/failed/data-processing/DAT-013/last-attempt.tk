m=jsoncast;f=castval(val:$str;typ:$str):$str{if(val=typ){<val};if(typ="int"){<val};if(typ="float"){<val};if(typ="bool"){<val};if(typ="str"){<val};if(typ="date"){<val};<val};f=parsejson(json:$str):$str{<json};f=castfield(json:$str;field:$str;typ:$str):$str{let parsed=parsejson(json);let casted=castval(parsed;typ);let result=casted;<result};f=main():$void{let json="{\"name\":\"alice\",\"age\":30,\"active\":true}";let namecast=castfield(json;"name";"str");let agecast=castfield(json;"age";"int");let activecast=castfield(json;"active";"bool");};