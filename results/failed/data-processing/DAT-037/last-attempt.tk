m=csvparse;f=parsefield(row:$str;col:i64):$str{let fields=row.split(",");if(col<fields.len as i64){<fields.get(col)}el{<""}};f=countmatches(rows:$str;col:i64;val:$str):i64{let count=mut.0;let lines=rows.split("\n");lp(let i=1;i<lines.len as i64;i=i+1){let row=lines.get(i);let field=parsefield(row;col);if(field=val){count=count+1};};<count};f=buildreport(rows:$str;col:i64;val:$str):$str{let counts=countmatches(rows;col;val);let total=countmatches(rows;col;"x");let pct=counts*100/total;<pct as$str>};f=main():$void{let data="name,age,city\nalice,30,ny\nbob,25,la\nalice,30,ny\n";let result=buildreport(data;0;"alice"));<result>};