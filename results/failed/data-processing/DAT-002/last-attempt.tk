m=csvtojson;f=csvtojson(csv:$str):$str{let lines=csv.split("\n");let headers=lines.get(0).split(",");let result=mut."[";let n=lines.len;lp(let i=1;i<n;i=i+1){let line=lines.get(i);let parts=line.split(",");let obj=mut."{";lp(let j=0;j<headers.len;j=j+1){let key=headers.get(j);let val=parts.get(j);let pair=key+":"+val;let sep=mut.",";if(j=0){sep=""};let part=sep+pair;obj=obj+part};obj=obj+"}";let comma=mut.",";if(i=n-1){comma=""};let item=comma+obj;result=result+item};result=result+"]";<result};