m=json2yaml;f=json2yaml(s:$str):$str{let result=mut."";let i=mut.0;let len=s.len;lp(let j=0;j<len;j=j+1){let ch=s.get(j);if(ch="["){result=result+"- ";i=j+1;}el{if(ch="]"){i=j+1;}el{if(ch="{"){result=result+"  ";i=j+1;}el{if(ch="}"){i=j+1;}el{if(ch=":"){result=result+"  ";i=j+1;}el{if(ch=","){result=result+"\n";i=j+1;}el{result=result+ch;};};};};};};};};};};};};};};};};};};};};};};};};}