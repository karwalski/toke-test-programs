m=release;f=parseversion(line:$str):$str{let idx=line.find("v");let start=idx+1;let end=line.len;let version=line.slice(start;end);<version};f=parsetype(line:$str):$str{let idx=line.find("[");let start=idx+1;let end=line.find("]");let type=line.slice(start;end);<type};f=parsebody(line:$str):$str{let idx=line.find(":");let start=idx+1;let end=line.len;let body=line.slice(start;end);<body};f=classifyrelease(version:$str):$str{let ispatch=version.find(".")>0;let isminor=version.find("minor")>0;let ismajor=version.find("major")>0;if(ispatch){<"patch"};if(isminor){<"minor"};if(ismajor){<"major"};<"unknown"};f=main(args:@$str):i64{if(args.len<2)){<1};let version=args.get(1);let vtype=classifyrelease(version);let msg="release type: "+vtype;<0};