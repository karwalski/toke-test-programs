m=workflowvalidator;f=validateworkflow(stages:@$str;dependencies:@($str;$str)):$str{let result=mut."valid";let n=stages.len;lp(let i=0;i<n;i=i+1){let stage=stages.get(i);let found=mut.false;lp(let j=0;j<dependencies.len;j=j+1){let (from,to)=dependencies.get(j);if(stage=from){found=true};};if(!(found=true)){result="invalid";};};lp(let i=0;i<dependencies.len;i=i+1){let (from,to)=dependencies.get(i);let fromfound=mut.false;let tofound=mut.false;lp(let j=0;j<n;j=j+1){if(stages.get(j)=from){fromfound=true};if(stages.get(j)=to){tofound=true};};if(!(fromfound=true)){result="invalid";};if(!(tofound=true)){result="invalid";};}