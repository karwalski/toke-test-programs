m=mem;f=extract(msg:$str):$str{let found=mut.false;let entity=mut."";lp(let i=0;i<msg.len;i=i+1){let ch=msg.get(i);if(ch=" "){if(found){<entity};entity="";found=false;}el{entity=entity+ch;if(!(found)){found=true;};};};if(found){<entity};<""};f=update(k:$str;v:$str):$str{let entry=k+"="+v;<entry};f=store(msg:$str):$str{let entity=extract(msg);let fact=update(entity;"stored");let out=store(fact);<out};f=main():$void{let msg="alice is a person";let out=store(msg);<out};