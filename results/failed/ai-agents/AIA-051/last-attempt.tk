m=extract;f=extractkeyval(text:$str):$str{let lines=text.split("\n");let result=mut."";lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let found=line.find("=");if(!(found<0)){let key=line.substr(0;found);let val=line.substr(found+1;line.len);let pair=key+"="+val;if(!(result.len=0)){result=result+"&";};result=result+pair;};};<result};