m=spamfilter;f=classifymsg(content:$str):$str{let len=content.len;let hasbang=mut.false;let hasat=mut.false;let hasdot=mut.false;lp(let i=0;i<len;i=i+1){let ch=content.get(i);if(ch="!"){hasbang=true};if(ch="@"){hasat=true};if(ch="."){hasdot=true};};let reasons=mut."";if(hasbang){reasons=reasons+"! detected ";};if(hasat){reasons=reasons+"@ detected ";};if(hasdot){reasons=reasons+"dot detected ";};if(!(hasbang)){if(!(hasat)){if(!(hasdot)){reasons=reasons+"no spam indicators ";};};};let finalreason=mut."";if(reasons.len>0){finalreason=reasons}el{finalreason="no spam indicators detected"};<finalreason};f=main():$void{let msg="hello world";let result=classifymsg(msg);<result};