m=resume;f=extractname(resume:$str):$str{let lines=resume.split("\n");let name=mut."";lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let hascolon=line.contains(":");if(!(hascolon)){let isname=line.len>0;let isnotempty=line.len>0;let isnotblank=line.len>0;let isnotempty2=line.len>0;if(isname){name=line}}}};<name};f=extractcontact