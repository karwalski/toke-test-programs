m=dedup;f=hashpassage(p:$str):$i64{let h=mut.0;lp(let i=0;i<p.len;i=i+1){let c=p.get(i);let x=h*33+c as i64;h=x-x/997*997;};<h};f=deduppassages(passages:@$str):@$str{let seen=mut.@($str:$i64));let result=mut.@();lp(let i=0;i<passages.len;i=i+1){let p=passages.get(i);let h=hashpassage(p);let key=h as$str;let found=mut.false;lp(let j=0;j<seen.len;j=j+1){let entry=seen.get(j);if(entry.key=key){found=true;};};if(!(found)){let entry=$str:$i64{key:h as$str;val:p};seen=seen+@(entry);result=result+@(p);};};<result};