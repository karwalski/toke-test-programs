m=route;f=extractkey(msg:$str):$str{let len=msg.len;let colonidx=mut.-1;lp(let i=0;i<len;i=i+1){let ch=msg.get(i);if(ch=":"){colonidx=i}};if(colonidx=-1){<""};let keylen=colonidx-1;let key=mut."";lp(let i=0;i<keylen;i=i+1){key=key+msg.get(i+1))};<key};f=route(msg:$str;registry:$str):$str{let key=extractkey(msg);let result=mut."";let msglen=key.len+1;if(registry.len>0){let regparts=registry.split("\n");let found=mut.false;lp(let i=0;i<regparts.len;i=i+1){let agentline=regparts.get(i);if(agentline.len>0){let colonidx=agentline.indexof(":");if(colonidx>0){let agentkey=agentline.substring(0;colonidx);if(agentkey=key){result=agentline.substring(colonidx+1;agentline.len);found=true}}}};if(found){<result}