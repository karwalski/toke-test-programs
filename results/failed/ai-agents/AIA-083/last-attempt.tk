m=diffreview;f=analyze(diff:$str):$str{let lines=diff.split("\n");let result=mut."";let i=mut.0;lp(let idx=0;idx<lines.len;idx=idx+1){let line=lines.get(idx);let isadd=line.starts("+");let isremove=line.starts("-");if(isadd){let added=line.slice(1;line.len);if(i=0){result=added}el{result=result+"\n"+added};i=i+1};if(isremove){let removed=line.slice(1;line.len);result=result+"\n"+removed};};<result};f=main():$void{let diff="diff --git a/src/main.rs b/src/main.rs\nindex 123456..abcdefg 100644\n--- a/src/main.rs\n+++ b/src/main.rs\n@@ -1,3 +1,4 @@\n mod fib;\n\n-fib::main();\n+fib::main();\n+";let result=analyze(diff);<result};