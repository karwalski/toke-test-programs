m=topictracker;f=extracttopic(last:$str;current:$str):$str{let lastwords=last.split(" ");let lastkey=lastwords.get(lastwords.len-1));if(current.contains(lastkey)){<lastkey};let currentwords=current.split(" ");let currentkey=currentwords.get(currentwords.len-1));if(last.contains(currentkey)){<currentkey};<""};f=topictracker(state:$str;current:$str):$str{let last=state;let topic=extracttopic(last;current);if(topic.len>0){<topic}el{<""}};