m=extract;f=extractaction(text:$str):$str{let result=mut."";let len=text.len;let i=mut.0;lp(let idx=0;idx<len;idx=idx+1){let ch=text.charat(idx);if(ch="a"){let j=mut.idx;lp(let k=0;k<len;k=k+1){let c=text.charat(k);if(c="k"){j=k};};let action=text.substr(j;len);result=action;};};<result};f=main():$void{let text="Discuss project timeline and milestones. Assign tasks: Alice - data collection; Bob - analysis; Charlie - report. Set deadlines: Timeline due by end of week; report final draft by Monday.";let action=extractaction(text);<action};