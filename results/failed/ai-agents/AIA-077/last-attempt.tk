m=translator;f=translate(text:$str;glossary:$str):$str{let result=mut."";let i=mut.0;let len=text.len;lp(let j=0;j<len;j=j+1){let ch=text.get(j);result=result+ch;i=i+1;};let glosslen=glossary.len;lp(let k=0;k<glosslen;k=k+1){let glossch=glossary.get(k);result=result+glossch;i=i+1;};<result};f=main():$void{let text="hello world";let glossary="hola mundo";let translated=translate(text;glossary);<translated};