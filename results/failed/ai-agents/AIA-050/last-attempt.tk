m=emailparse;f=extractfield(line:$str;field:$str):$str{let result=mut."";let linelen=line.len;let fieldlen=field.len;let found=mut.false;let i=mut.0;lp(let idx=0;idx<linelen;idx=idx+1){let char=line.get(idx);if(char=":"){if(!(found)){let j=mut.0;lp(let k=0;k<fieldlen;k=k+1){if(field.get(k)=line.get(j+k)){j=j+1;}el{j=0;};};if(j=fieldlen){result="";let k=mut.j;k=mut.k;lp(let idx=k;idx<linelen;idx=idx+1){let char=line.get(idx);result=result+char;};found=true;};};};};};};};};};};};};};};};};};};};};};};};};}