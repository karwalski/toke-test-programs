m=csvparse;f=processrow(row:$str):$str{let cols=row.split(",");let result=mut."";let first=mut.true;lp(let i=0;i<cols.len;i=i+1){let val=cols.get(i);if(first){first=false}el{result=result+" "};result=result+val};<result};f=main():$void{let input="name,age,city\nAlice,30,New York\nBob,25,Los Angeles\n";let lines=input.split("\n");let header=lines.get(0);let data=mut."";lp(let i=1;i<lines.len;i=i+1){let row=lines.get(i);let processed=processrow(row);if(i>1){data=data+"\n"};data=data+processed};<data};