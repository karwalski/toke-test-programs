m=summarise;f=summarise(text:$str;maxlen:$i64):$str{let sentences=mut.@();let current=mut."";let i=mut.0;lp(let idx=0;idx<text.len;idx=idx+1){let ch=text.get(idx);if(ch="."){sentences=sentences+@(current);current="";}el{current=current+ch;};};if(!(current.len=0 as u64))){sentences=sentences+@(current);};let totalsentences=sentences.len;let result=mut."";let added=mut.0;lp(let idx=0;idx<totalsentences;idx=idx+1){let sent=sentences.get(idx);let sentlen=sent.len;if(added+sentlen<maxlen){result=result+sent;added=added+sentlen;}el{if(!(result.len=0 as u64))){result=result+"...";};br;};};<result};