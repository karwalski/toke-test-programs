m=cosinesim;f=topkdocs(query:$str;docs:@$str;dim:i64;k:i64):@$str{let queryvec=querytovec(query;dim);let docsarr=mut.@();let scores=mut.@();lp(let i=0;i<docs.len;i=i+1){let doc=docs.get(i);let docvec=querytovec(doc;dim);let score=cosinesim(queryvec;docvec);scores=scores+@(score);docsarr=docsarr+@(doc);};lp(let i=0;i<docsarr.len;i=i+1){let minidx=mut.i;lp(let j=i+1;j<docsarr.len;j=j+1){if(scores.get(j)>scores.get(minidx))){minidx=j;};};let tmp=docsarr.get(i);docsarr.get(i)=docsarr.get(minidx);docsarr.get(minidx)=tmp;};let result=mut.@();lp(let i=0;i<k;i=i+1){if(i<docsarr.len){result=result+@(docsarr.get(i));};};<result};f=querytovec(query:$str;dim:i64):$str{let vec=mut