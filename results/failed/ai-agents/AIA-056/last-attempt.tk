m=dateextract;f=extractdate(s:$str):$str{let len=s.len;let ystart=mut.0;let yend=mut.0;let mstart=mut.0;let mend=mut.0;let dstart=mut.0;let dend=mut.0;let foundyear=mut.false;let foundmonth=mut.false;let foundday=mut.false;lp(let idx=0;idx<len;idx=idx+1){let ch=s.get(idx);if(ch>47){if(ch<58){if(!(foundyear)){ystart=idx;foundyear=true;};if(foundyear){yend=idx;};};};};if(foundyear){let yearpart=s.substring(ystart;yend+1);}