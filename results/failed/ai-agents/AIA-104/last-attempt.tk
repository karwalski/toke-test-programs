m=agenterror;f=handleerror(agentname:$str;errtype:$str):$str{let shouldretry=mut.false;let escalatetosupervisor=mut.false;let reportasfailure=mut.false;if(errtype="privacy"){shouldretry=true}el{if(errtype="timeout"){shouldretry=true}el{if(errtype="unavailable"){shouldretry=true}el{if(errtype="invalidinput"){shouldretry=true}el{if(errtype="logic"){escalatetosupervisor=true}el{if(errtype="privacysevere"){escalatetosupervisor=true}el{if(errtype="unknown"){reportasfailure=true}el{if(errtype="maxretries"){reportasfailure=true}el{}}}}}}};if(shouldretry){<agentname+"retry"}el{if(escalatetosupervisor){<agentname+"escalate"}el{if(reportasfailure){<agentname+"fail"}el{<agentname+"unknown"};}}}};