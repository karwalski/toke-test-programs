m=agentdispatcher;f=dispatch(agents:@$str;skill:$str):@$str{let result=mut.@();let len=agents.len;lp(let idx=0;idx<len;idx=idx+1){let agent=agents.get(idx);let matches=skillmatches(skill;agent);if(matches){result=result+@(agent)};};<result};f=skillmatches(skill:$str;agent:$str):$bool{let has=mut.false;let len=agent.len;lp(let idx=0;idx<len;idx=idx+1){let ch=agent.get(idx);if(ch=":"){has=true};};<has};