m=ragconfig;f=isvalidragconfig(cfg:$ragconfig):$bool{let valid=mut.true;if(cfg.chunksize<100){valid=false};if(cfg.overlap<0){valid=false};if(cfg.embeddingdims<300){valid=false};if(cfg.maxretries<0){valid=false};if(cfg.timeoutms<1000){valid=false};<valid};f=ragconfigfromjson(json:$str):$ragconfig{let cfg=mut.ragconfigdefault();let keys=json.keys();lp(let i=0;i<keys.len;i=i+1){let key=keys.get(i);let value=json.get(key);if(key="chunk_size"){cfg.chunksize=value as i64};if(key="overlap"){cfg.overlap=value as i64};if(key="embedding_dims"){cfg.embeddingdims=value as i64};if(key="max_retries"){cfg.maxretries=value as i64};if(key="timeout_ms"){cfg.timeoutms=value as i64};};<cfg};f=ragconfigdefault():$ragconfig{let cfg=mut.ragconfignew();cfg.chunksize=1000;cfg.overlap=200;cfg