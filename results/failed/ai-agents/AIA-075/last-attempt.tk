m=translator;f=translate(text:$str;fromlang:$str;tolang:$str):$str{let result=mut."";let i=mut.0;lp(let idx=0;idx<text.len;idx=idx+1){let ch=text.get(idx);if(ch=" "){result=result+" ";i=0;}el{if(i<fromlang.len){if(ch=fromlang.get(i)){let newch=tolang.get(i);result=result+newch;i=i+1;}el{i=i+1;};};};};<result};f=main():$void{let text="hello world";let fromlang="en";let tolang="fr";let result=translate(text;fromlang;tolang);<result};