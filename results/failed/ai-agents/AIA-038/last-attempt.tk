m=classify;f=classify(text:$str):$str{let len=text.len;let hasdollar=mut.false;let hasat=mut.false;let hascolon=mut.false;let hasand=mut.false;let short=mut.false;if(len<50){short=true};lp(let idx=0;idx<len;idx=idx+1){let ch=text.get(idx);if(ch="$"){hasdollar=true};if(ch="@"){hasat=true};if(ch=":"){hascolon=true};if(ch="&"){hasand=true};};let hasdate=mut.false;let hasname=mut.false;if(hasat){hasname=true};if(hascolon){hasdate=true};if(hasdollar){hasdate=true};if(hasand){hasname=true};let result=mut."unknown";if(hasname){if(short){result="letter"}el{result="namecard"}};if(hasdate){if(short){result="invoice"}el{result="receipt"}};if(hasname=false){if(hasdate=false){if(short){result="report"}el{result="unknown"}}}};<result};