m=validate;f=haswriteaction(actions:@$str):$bool{let found=mut.false;lp(let i=0;i<actions.len;i=i+1){let a=actions.get(i);if(a="s3:PutObject"){found=true};if(a="dynamodb:PutItem"){found=true};if(a="rds:DataManipulation"){found=true};if(a="elasticsearch:Index"){found=true};if(a="kinesis:PutRecord"){found=true};if(a="firehose:PutRecord"){found=true};if(a="sqs:SendMessage"){found=true};if(a="sns:Publish"){found=true};if(a="logs:PutLogEvents"){found=true};if(a="iam:CreatePolicy"){found=true};if(a="iam:CreateRole"){found=true};if(a="iam:AttachRolePolicy"){found=true};};if(found){<true};<false};f=hasdangerousresource