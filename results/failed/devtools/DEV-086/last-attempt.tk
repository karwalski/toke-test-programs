m=ffconfig;f=buildflag(name:$str;value:$str):$str{let out=mut."";out=out+name;out=out+"=";out=out+value;<out};f=generateconfig(flags:@$str):$str{let out=mut."";lp(let i=0;i<flags.len;i=i+1){let flag=flags.get(i);out=out+flag;out=out+"\n";};<out};f=main():$i64{let flags=@(buildflag("feature.a";"enabled");buildflag("feature.b";"disabled");buildflag("feature.x";"enabled");buildflag("feature.y";"disabled"))));let config=generateconfig(flags);let out=mut."";out=out+"Feature flags config:\n";out=out+config;<out};