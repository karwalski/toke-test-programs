m=healthdashboard;f=buildstatus(overall:$str;components:@$str):$str{let result=mut."Status: ";result=result+overall;if(overall="degraded"){let compcount=components.len;lp(let idx=0;idx<compcount;idx=idx+1){let comp=components.get(idx);result=result+"\n";result=result+comp;result=result+" degraded";};}el{if(overall="down"){let compcount=components.len;lp(let idx=0;idx<compcount;idx=idx+1){let comp=components.get(idx);result=result+"\n";result=result+comp;result=result+" down";};}el{