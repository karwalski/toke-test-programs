m=cfgval;f=solve(p0:$str;p1:$str):$str{let cfg=p0;let schema=p1;let lines=cfg.split("\n");let valid=mut.true;let errors=mut."";lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let trimmed=line.trim();let isblank=trimmed.len=0;if(!(isblank)){let parts=trimmed.split("=");let haskey=parts.len>0;let hasval=parts.len>1;if(!(haskey)){valid=false;errors=errors+"missing key: "+trimmed+"\n";};if(!(hasval)){valid=false;errors=errors+"missing value: "+trimmed+"\n";};};};if(valid){<""};<errors};