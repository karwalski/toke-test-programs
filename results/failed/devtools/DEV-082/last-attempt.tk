m=docker;f=largestlayersize(hist:$str):$str{let maxlayer=mut."";let maxsize=mut.0;let currentlayer=mut."";let currentsize=mut.0;let i=mut.0;lp(let idx=0;idx<hist.len;idx=idx+1){let c=hist.get(idx);if(c as u8=10 as u8){if(currentsize>maxsize){maxsize=currentsize;maxlayer=currentlayer};currentlayer="";currentsize=0;}el{currentlayer=currentlayer+c;let num=c as u8-48 as u8;if(num<10 as u8){currentsize=currentsize+num;};};}