m=semver;f=parseversion(v:$str):$i64{let parts=v.split(".");let major=parts.get(0);let minor=parts.get(1);let patch=parts.get(2);<major};f=compare(a:$str;b:$str):$i64{let ap=parseversion(a);let bp=parseversion(b);if(ap<bp){<1};if(ap>bp){<-1};<0};f=sortversions(versions:@$str):@$str{let n=versions.len;let sorted=mut.versions;lp(let i=0;i<n;i=i+1){lp(let j=0;j+1<n;j=j+1){let a=sorted.get(j);let b=sorted.get(j+1);if(compare(a;b)>0){let tmp=sorted.get(j);sorted.get(j)=sorted.get(j+1);sorted.get(j+1)=tmp;};};};<sorted};