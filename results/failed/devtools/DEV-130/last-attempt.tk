m=langdetect;f=extractlang(filename:$str):$str{let ext=mut.filename;let found=mut.false;lp(let i=0;i<filename.len;i=i+1){if(filename.get(i)as u8=46 as u8){found=true;ext=filename.sub(i+1;filename.len)};};if(found){<ext}el{<""}};f=countlang(langs:@$str):i64{let total=mut.0;lp(let i=0;i<langs.len;i=i+1){let lang=langs.get(i);let found=mut.false;lp(let j=0;j<langs.len;j=j+1){if(j=i){<};if(langs.get(j)=lang){found=true};};if(!(found)){total=total+1};};<total};f=generatestack(langs:@$str):$str{let total=langs.len;let found=mut.false;let frontend=mut."";let backend=mut."";let fullstack=mut.false