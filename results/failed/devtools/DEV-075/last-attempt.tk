m=jsonmock;f=solve(p0:$str):$str{let lines=p0.split("\n");let result=mut."";let inpath=mut.false;let inparams=mut.false;let inresponses=mut.false;lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let trimmed=line.trim();if(trimmed.len=0){<result};if(trimmed.startswith("path: ")){inpath=true;let pathpart=trimmed.substring(7;trimmed.len);result=result+pathpart;result=result+"/";<result};if(trimmed.startswith("params: ")){inparams=true;let paramspart=trimmed.substring(8;trimmed.len);result=result+params