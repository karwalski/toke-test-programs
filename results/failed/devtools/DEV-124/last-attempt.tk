m=synth;f=synthchecks(ep:$str;name:$str):$str{let out=mut."";let checks=mut.@("health";"metrics";"pii";"config"));lp(let i=0;i<checks.len;i=i+1){let ch=checks.get(i);let line="  - name: "+name+"_"+ch+"\n";line=line+"    endpoint: "+ep+"\n";line=line+"    method: GET\n";line=line+"    path: /"+ch+"\n";line=line+"    timeout_ms: 5000\n";line=line+"    assert_status: 200\n";line=line+"    assert_response_contains: []\n";out=out+line;};<out};