m=buildlog;f=extractphase(line:$str):$str{let idx=mut.0;lp(let i=0;i<line.len;i=i+1){let ch=line.get(i);if(ch=":"){idx=i};};let start=mut.0;lp(let i=0;i<idx;i=i+1){let ch=line.get(i);if(!(ch=" ")){start=i};};let end=mut.idx;lp(let i=end;i<line.len;i=i+1){let ch=line.get(i);if(!(ch=" ")){end=i};};let result=mut."";lp(let i=start;i<end;i=i+1){let ch=line.get(i);result=result+ch;};<result};f=extractduration