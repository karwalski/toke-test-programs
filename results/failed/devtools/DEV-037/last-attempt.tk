m=yamltojson;f=buildkey(parts:@$str):$str{let result=mut."";let n=parts.len;lp(let i=0;i<n;i=i+1){let part=parts.get(i);result=result+part;if(i<n-1){result=result+"."}};<result};f=quotejsonstr(s:$str):$str{let result=mut.s;result=result.replaceall("\\";"\\\\");result=result.replaceall("\n";"\\n");result=result.replaceall("\r";"\\r");result=result.replaceall("\"";"\\\"");<result};f=tojsonval(s:$str):$str{let trimmed=mut.s.trim();if(trimmed.len=0){<""};if(trimmed.get(0)as$str="\""){let inner=trimmed.slice(1;trimmed.len-1);<quotejsonstr(inner)};<trimmed};f=tojsonarr