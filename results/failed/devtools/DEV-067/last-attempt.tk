m=fileext;f=classify(ext:$str):$str{if(ext.len=0){<"unknown"};if(ext="txt"){<"text"};if(ext="jpg"){<"image"};if(ext="png"){<"image"};if(ext="gif"){<"image"};if(ext="mp3"){<"audio"};if(ext="wav"){<"audio"};if(ext="pdf"){<"document"};if(ext="zip"){<"archive"};if(ext="rar"){<"archive"};if(ext="mp4"){<"video"};if(ext="avi"){<"video"};if(ext="mkv"){<"video"};<"unknown"};f=compute(filecount:$i64;totalbytes:$i64):$str{if(filecount=0){<"no files"};let avg=totalbytes/filecount;let result=mut."";lp(let i=0;i<filecount;i=i+1){result=result+"*";};result=result+"\n";result=result+"files: ";result=result+filecount as$str;result=result+"\navg size: ";result=result+avg as$str;result=result+" bytes\n";result=result+"classification:\n";let exts=mut