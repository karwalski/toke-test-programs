m=versioncheck;f=checkversions(p:$str;q:$str):$str{let pparts=p.split(".");let qparts=q.split(".");let result=mut."";let maxlen=mut.0;if(pparts.len>qparts.len){maxlen=pparts.len}el{maxlen=qparts.len};lp(let idx=0;idx<maxlen;idx=idx+1){let pval=mut.0;let qval=mut.0;if(idx<pparts.len){pval=pparts.get(idx).parseint()};if(idx<qparts.len){qval=qparts.get(idx).parseint()};if(pval>qval){result=p};if(qval>pval){result=q};};<result};f=main():$void{let v1="1.2.3";let v2="1.2.4";let v3="1.3.0";let v4="2.0.0";let r1=checkversions(v1;v2);let r2=checkversions(v3;v4);let r3=checkversions(v1;v3);let r4=checkversions(v2;v4);