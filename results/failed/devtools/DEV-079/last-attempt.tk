m=webhook;f=validatepayload(payload:$str;expectedfields:@$str):$bool{let valid=mut.true;lp(let i=0;i<expectedfields.len;i=i+1){let field=expectedfields.get(i);let found=mut.false;lp(let j=0;j<payload.len;j=j+1){let char=payload.get(j);if(char="&"){let k=mut.j+1;let fieldname=mut."";lp(let z=k;z<payload.len;z=z+1){let c=payload.get(z);if(c="="){fieldname=fieldname+c;k=z+1;br;};fieldname=fieldname+c;};if(fieldname=field){found=true;br;};};if(!found){valid=false;br;};};<valid};