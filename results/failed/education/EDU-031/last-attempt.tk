m=essay;f=checkwordcount(essay:$str;minwords:$i64;maxwords:$i64):$str{let wordcount=essay.split(" ").len;let minok=mut.false;if(!(wordcount<minwords)){minok=true};let maxok=mut.false;if(!(wordcount>maxwords)){maxok=true};let result=mut."";if(minok){if(maxok){result="valid";}el{result="invalid";}}el{result="invalid";}};<result};f=main():$void{let essay="the quick brown fox jumps over the lazy dog";let minwords=50;let maxwords=100;let validation=checkwordcount(essay;minwords;maxwords);<validation};