m=studentreport;f=buildreport(name:$str;score:$i64;grade:$str):$str{let result=mut."";result=result+"Student Name: ";result=result+name;result=result+"\nScore: ";let scorestr=score as$str;result=result+scorestr;result=result+"\nGrade: ";result=result+grade;result=result+"\n";<result};f=main():$void{let name="Alice";let score=95;let grade="A";let report=buildreport(name;score;grade);<report};