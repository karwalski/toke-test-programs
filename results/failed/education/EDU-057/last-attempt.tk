m=abscount;f=countreasons(arr:@$str):$str{let counts=mut.@($str;$i64));lp(let i=0;i<arr.len;i=i+1){let found=mut.false;lp(let j=0;j<counts.len;j=j+1){if(counts.get(j).0)=arr.get(i){found=true;let newcount=counts.get(j).1+1;counts.get(j)=@(counts.get(j).0);counts.get(j)=@(counts.get(j).0);counts.get(j)=@(counts.get(j).0));counts.get(j)=@(counts.get(j).0)