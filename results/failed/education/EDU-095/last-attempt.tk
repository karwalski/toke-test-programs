m=plans;f=planfor(level:$str):$str{if(level="beginner"){<"learn basics"};if(level="intermediate"){<"practice problems"};if(level="advanced"){<"work on projects"};<"invalid level"};f=main():$void{let beginner=planfor("beginner");let intermediate=planfor("intermediate");let advanced=planfor("advanced");let invalid=planfor("expert");};