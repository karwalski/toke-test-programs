m=studyplan;f=plan(stages:i64;duration:i64):$str{let result=mut."";let stagecount=stages;let hours=duration;let minutes=0;let hstr=hours as$str;let mstr=minutes as$str;result=result+"Study Plan\n";result=result+"Stages: "+stagecount as$str+"\n";result=result+"Duration: "+hstr+" hours "+mstr+" minutes\n";result=result+"---\n";lp(let stage=1;stage<stagecount+1;stage=stage+1){let stagestr=stage as$str;result=result+"Stage "+stagestr+": Topic\n";result=result+"Work: 60 minutes\n";result=result+"Break: 5 minutes\n";result=result+"---\n";};<result};f=main():$i64{let plan=plan(5;6);<0};