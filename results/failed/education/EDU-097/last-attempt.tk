m=debate;f=assignpos(n:$i64):$str{let rem=n-n/2*2;if(rem=0){<"pro"}el{<"con"}};f=sortbyage(students:@$str;ages:@$i64):@$str{let n=ages.len;lp(let i=0;i<n;i=i+1){lp(let j=0;j+1<n;j=j+1){let a=ages.get(j);let b=ages.get(j+1);if(a>b){let tmp=ages.get(j);ages.get(j)=ages.get(j+1);ages.get(j+1)=tmp;let stmp=students.get(j);students.get(j)=students.get(j+1);students.get(j+1)=stmp;};};};<students};f=builddebat