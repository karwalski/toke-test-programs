m=report;f=buildreport(name:$str;score:$i64;grade:$str):$str{let header="Student Report\n---------------------\n";let body="Name: "+name+"\nScore: "+score as$str+"\nGrade: "+grade+"\n";let footer="---------------------\nEnd of Report";<header+body+footer};f=main():$void{let report=buildreport("Alice Johnson";95;"A");<report};