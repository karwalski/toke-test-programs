m=curriculum;i=io:std.io;i=s:std.str;f=parsestandards(line:$str):$str{let parts=s.split(line;":");if(parts.len()>=2){let idpart=parts.get(0);let descpart=parts.get(1);let idclean=s.split(idpart;"\"");if(idclean.len()>=4){let id=idclean.get(3);let descclean=s.split(descpart;"\"");if(descclean.len()>=2){let desc=descclean.get(1);<s.concat(id;s.concat(";";desc))}}};<""};f=parseactivities(line:$str):$str{let parts=s.split(line;":");if(parts.len()>=3){let namepart=parts.get(0);let stdpart=parts.get(2);let nameclean=s.split(namepart;"\"");if(nameclean.len()>=4){let name=nameclean.get(3);let stdclean=s.split(stdpart;"\"");if(stdclean.len()>=2){let stdid=stdclean.get(1);<s.concat(name;s.concat(";";stdid))}}};<""};f=main():$i64{let input=io.readln();let standards=mut."";let activities=mut."";let lines=s.split(input;"{");let idx=mut.0;lp(idx<lines.len()){let line=lines.get(idx);if(s.contains(line;"description")){let parsed=parsestandards(line);if(parsed!=""){standards=s.concat(standards;s.concat("|";parsed))}};if(s.contains(line;"standard_id")){let parsed=parseactivities(line);if(parsed!=""){activities=s.concat(activities;s.concat("|";parsed))}};idx=idx+1};let actparts=s.split(activities;"|");let actidx=mut.1;lp(actidx<actparts.len()){let activity=actparts.get(actidx);let actdata=s.split(activity;";");if(actdata.len()>=2){let actname=actdata.get(0);let actstd=actdata.get(1);let found=mut."";let stdparts=s.split(standards;"|");let stdidx=mut.1;lp(stdidx<stdparts.len()){let standard=stdparts.get(stdidx);let stddata=s.split(standard;";");if(stddata.len()>=2){let stdid=stddata.get(0);let stddesc=stddata.get(1);if(stdid=actstd){found=stddesc}};stdidx=stdidx+1};if(found=""){io.println(s.concat(actname;s.concat(": ";"UNALIGNED")))}el{io.println(s.concat(actname;s.concat(": ";found)))}};actidx=actidx+1};<0}