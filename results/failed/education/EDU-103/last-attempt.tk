m=examtips;f=absval(x:$i64):$i64{if(x<0){<0-x};<x};f=classifystress(stress:$i64):$str{if(stress<0){<"invalid"};if(stress<20){<"low"};if(stress<40){<"medium"};if(stress<60){<"high"};<"very high"};f=gentips(category:$str):$str{if(category="low"){<"get plenty of rest; eat well; start early"};if(category="medium"){<"plan your study time; take short breaks; focus on weak areas"};if(category="high"){<"prioritize your study; eliminate distractions; use memory techniques; get adequate rest"};if(category="very high"){<"focus on your strengths; delegate tasks; seek support; practice mindfulness"};<"unknown category"};f=main(stress:$i64):$str{let category=classifystress(stress);let tips=gentips(category);<tips};f=run():$void{let stress=75;let result=main(stress);<result};