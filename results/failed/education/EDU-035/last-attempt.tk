m=subset;f=buildsubset(qb:$str;n:$i64):$str{let result=mut."";let count=mut.0;let idx=mut.0;lp(let i=0;i<qb.len;i=i+1){let ch=qb.get(i);if(ch=","){let qlen=count-idx;let q=mut."";lp(let j=idx;j<count;j=j+1){q=q+qb.get(count+j);};if(!(result.len=0))){result=result+"\n";};result=result+q;idx=count;};count=count+1;};if(!(result.len=0))){result=result+"\n";}