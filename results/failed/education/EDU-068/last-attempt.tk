m=jigsaw;f=assign(topic:$str;group:$str):$str{if(topic="math"){<group+"-math"};if(topic="science"){<group+"-science"};if(topic="history"){<group+"-history"};if(topic="literature"){<group+"-literature"};if(topic="art"){<group+"-art"};if(topic="music"){<group+"-music"};if(topic="pe"){<group+"-pe"};if(topic="ict"){<group+"-ict"};if(topic="religion"){<group+"-religion"};if(topic="philosophy"){<group+"-philosophy"};if(topic="environment"){<group+"-environment"};if(topic="finance"){<group+"-finance"};if(topic="health"){<group+"-health"};if(topic="technology"){<group+"-technology"};if(topic="global"){<group+"-global"};if(topic="local"){<group+"-local"};if(topic="cross"){<group+"-cross"}};f=jigsaw(topic:$str;group:$str):$str{<assign(topic;group)};