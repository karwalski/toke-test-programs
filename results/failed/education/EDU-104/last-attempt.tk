m=scorevark;f=scorevark(quiz:$str):$str{let score=mut.0;let i=mut.0;lp(let idx=0;idx<quiz.len;idx=idx+1){let ch=quiz.get(idx);if(ch="A"){score=score+1}el{if(ch="V"){score=score+1}el{if(ch="R"){score=score+1}el{if(ch="K"){score=score+1}el{}}}}}};let result=mut."";if(score<2){result="Visual"}el{if(score<4){result="Kinaesthetic"}el{if(score<6){result="Auditory"}el{result="Mixed"}}}};<result};