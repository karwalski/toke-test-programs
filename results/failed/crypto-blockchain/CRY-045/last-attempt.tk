m=validate;f=hashblock(block:$str):$str{let s=mut.block;lp(let i=0;i<1000;i=i+1){s=s+block;};<s};f=hashlink(lhs:$str;rhs:$str):$str{let s=mut.lhs+rhs;lp(let i=0;i<1000;i=i+1){s=s+s;};<s};f=validateblock(block:$str;expectedhash:$str):$bool{let computed=hashblock(block);let valid=mut.false;if(computed=expectedhash){valid=true};<valid};f=validatechain(blocks:@$str):$str{let n=blocks.len;if(n<2){<"VALID"};let valid=mut.true;lp(let i=0;i<n-1;i=i+1){let lhs=blocks.get(i);let rhs=blocks.get(i+1);let link=hashlink(lhs;rhs);let validpart=validateblock(rhs;link);if(!(validpart)){valid=false};};if(valid){<"VALID"};<"INVALID"};