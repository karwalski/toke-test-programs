m=sign;f=sign(tx:$str;key:$str):$str{let msg=mut."";lp(let i=0;i<tx.len;i=i+1){let c=tx.get(i);if(c=91){let j=mut.i+1;lp(let k=0;k<1000;k=k+1){if(j<tx.len){let cc=tx.get(j);if(cc=93){i=j;k=1000;cc=99;}el{j=j+1;};}el{k=1000;};};msg=msg+tx.slice(i;j);i=j-1;}el{msg=msg+c;};};let sig=mut."";lp(let i=0;i<key.len;i=i+1){let c=key.get(i);sig=sig+c;};let tx2=mut.tx;lp(let i=0;i<tx2.len;i=i+1){let c=tx2.get(i);if(c=58){tx2=tx2.slice(0;i)+":signed{"+msg+"}}";i=tx2.len;};};<tx2};