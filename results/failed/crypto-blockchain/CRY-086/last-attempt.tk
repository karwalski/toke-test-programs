m=txbalance;f=solve(p0:$str):i64{let txs=mut.@();let len=p0.len;let start=mut.0;lp(let idx=0;idx<len;idx=idx+1){let c=p0.get(idx);if(c=";"){let tx=p0.slice(start;idx);txs=txs+@(tx);start=idx+1;};};let tx=p0.slice(start;len);txs=txs+@(tx);let bal=mut.0;lp(let i=0;i<txs.len;i=i+1){let tx=txs.get(i);let isin=mut.false;let j=mut.0;lp(let k=0;k<tx.len;k=k+1){let c=tx.get(k);if(c="i"){isin=true;j=k+1;lp(let m=j;m<tx.len;m=m+1){let cc=tx.get(m);if(cc=";"){isin=false;j=m+1;lp(let k=j;k<tx.len;k=k+1){let c=tx.get(k);if(c=";"){isin=false;j=k+1;};};isin=false;j=tx