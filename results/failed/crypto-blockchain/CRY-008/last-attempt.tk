m=hexconv;f=solve(p0:$str):$str{let result=mut."";let i=mut.0;lp(let idx=0;idx<p0.len;idx=idx+1){let ch=p0.get(idx);if(ch="\\"){let next=p0.get(idx+1);if(next="x"){let h1=p0.get(idx+2);let h2=p0.get(idx+3);let val=h1 as i64*16+h2 as i64;result=result+val as$str;idx=idx+3;}el{result=result+ch;};}el{result=result+ch;};};<result};