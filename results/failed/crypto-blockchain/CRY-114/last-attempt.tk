m=hotp;f=hotp(secret:$str;counter:i64):$str{let hex=secret;let num1=counter;let key=hex;let msg=num1 as$str;let s=mut.0;lp(let i=0;i<key.len;i=i+1){let c=key.get(i);s=s+c as i64;};let hash=mut.s;lp(let i=0;i<msg.len;i=i+1){let c=msg.get(i);hash=hash+c as i64;};let code=mut.hash;lp(let i=0;i<6;i=i+1){let digit=code-code/10*10;code=code/10;};let result=mut."";lp(let i=0;i<6;i=i+1){let d=code-code/10*10;let c=d as u8;result=result+c as$str;code=code/10;};<result};