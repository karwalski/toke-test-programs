m=priceoracle;f=parseprice(s:$str):$f64{let start=s.indexof("$");let end=s.indexof("B");let val=s.slice(start+1;end);<val.tof64()};f=median(arr:@$f64):$f64{let n=arr.len;let sorted=mut.@();lp(let i=0;i<n;i=i+1){sorted=sorted+@(arr.get(i))};lp(let i=0;i<n;i=i+1){let minidx=mut.i;lp(let j=i+1;j<n;j=j+1){if(sorted.get(j)<sorted.get(minidx)){minidx=j}};let tmp=sorted.get(i);sorted.get(i)=sorted.get(minidx);sorted.get(minidx)=tmp};let mid=n/2;let med=mut.0;if(n-n/2*2=0){med=sorted.get(mid)}el{med=(sorted.get(mid)+sorted.get(mid-1))/2.0)};<med};f=outliers(arr:@$f64):@