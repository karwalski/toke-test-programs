m=bib;f=formatentry(author:$str;year:i64;title:$str;source:$str):$str{let result=mut."";let authorpart=mut.author;if(!(authorpart.len=0 as u64))){result=result+authorpart;}el{result=result+"Anonymous";};result=result+", ";let yearpart=mut.year;if(!(yearpart=0))){result=result+yearpart as$str;}el{result=result+"n.d.";};result=result+". ";let titlepart=mut.title;if(!(titlepart.len=0 as u64))){result=result+titlepart;}el{result=result+"Untitled";};result=result+". ";let sourcepart=mut.source;if(!(sourcepart.len=0 as u64))){result=result+sourcepart;}el{result=result+"No source";};<result};f=main():$void{let entry=formatentry("Smith, John";2023;"The Great Gatsby";"Harper's Magazine"));<entry};