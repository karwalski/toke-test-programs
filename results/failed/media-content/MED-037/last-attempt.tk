m=extractlinks;f=extractlinks(text:$str):$str{let result=mut."";let i=mut.0;let len=text.len;lp(let idx=0;idx<len;idx=idx+1){let ch=text.get(idx);if(ch="_"){let nextidx=idx+1;if(nextidx<len){let nextch=text.get(nextidx);if(nextch="_"){let startidx=idx-1;let endidx=idx+1;let link=mut."";lp(let j=startidx;j<endidx;j=j+1){let ch2=text.get(j);link=link+ch2;};result=result+link+"\n";idx=endidx;};};};<result};