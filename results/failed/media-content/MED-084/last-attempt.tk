m=repeat;f=checkrepeat(text:$str):$str{let n=text.len;let m=mut.0;let found=mut.false;lp(let i=0;i<n-1;i=i+1){let w1=text.get(i);let w2=text.get(i+1);if(w1=w2){m=i;found=true;br;};};if(found){let start=m;let end=mut.n-1;lp(let i=start;i<end;i=i+1){let c1=text.get(i);let c2=text.get(i+1);if(c1=c2){end=i+1;};};let result=mut."";lp(let i=0;i<start;i=i+1){result=result+text.get(i);};result=result+"...";lp(let i=end+1;i<n;i=i+1){result=result+text.get(i);};<result}el{<""}};f=main():$void{let r1=checkrepeat("hello world hello");<r1};