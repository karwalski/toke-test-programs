m=sentencetask;f=sentencetask(p:$str):$str{let q=mut."";let capitalizenext=mut.false;lp(let idx=0;idx<p.len;idx=idx+1){let c=p.get(idx);if(capitalizenext){if(c>96){if(c<123){let upper=c-32;q=q+upper;capitalizenext=false;}el{q=q+$str(c);capitalizenext=false;};}el{q=q+$str(c);capitalizenext=false;};}el{q=q+$str(c);if(c=46){capitalizenext=true;}el{capitalizenext=false;};};};<q};