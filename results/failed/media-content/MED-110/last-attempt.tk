m=wordsearch;f=search(text:$str;word:$str;n:$i64):$str{let result=mut."";let len=mut.text.len;let wlen=mut.word.len;if(!(wlen>0)){}el{let found=mut.false;let pos=mut.0;lp(let i=0;i<len;i=i+1){let ch=mut.text.get(i);if(ch=word.get(pos)){if(pos=0){found=true;result=result+text.get(i);};pos=pos+1;if(pos=wlen){found=true;result=result+text.get(i);pos=0;};}el{pos=0;};};if(found){<result}el{<""}};