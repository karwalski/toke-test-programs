m=extractimages;f=extractimages(s:$str):@$str{let result=mut.@();let len=s.len;let i=mut.0;lp(let pos=0;pos<len;pos=pos+1){let ch=s.get(pos);if(ch="_"){let start=pos-1;let end=pos+1;let isvalid=mut.false;if(!(start<0)){let lhs=s.get(start);if(lhs="("){isvalid=true;};};if(!(end>len-1)){let rhs=s.get(end);if(rhs=")"){isvalid=true;};};if(isvalid){let extracted=s.slice(start;end+1);result=result+@(extracted);};};};<result};