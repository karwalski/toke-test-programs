m=csvfromjson;f=csvfromjson(jsonarr:$str):$str{let lines=mut.@();let i=mut.0;let len=jsonarr.len;lp(let idx=0;idx<len;idx=idx+1){let ch=jsonarr.get(idx);if(ch=","){let field=jsonarr.slice(i;idx);if(lines.len=0){let header=field;lines=lines+header;}el{let row=field;lines=lines+row;};i=idx+1;};};let lastfield=jsonarr.slice(i;len);let lastrow=lastfield;lines=lines+lastrow;let result=mut."";lp(let idx=0;idx<lines.len;idx=idx+1){let line=lines.get(idx);result=result+line;if(!(idx=(lines.len-1)))){result=result+"\n";};};<result};