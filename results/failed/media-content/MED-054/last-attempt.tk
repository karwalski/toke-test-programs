m=anagram;f=sortchars(val:$str):$str{let chars=val.chars;let n=chars.len;lp(let i=0;i<n;i=i+1){lp(let j=i+1;j<n;j=j+1){let c1=chars.get(i);let c2=chars.get(j);if(c1>c2){let tmp=chars.get(i);chars.get(i)=chars.get(j);chars.get(j)=tmp;};};};let sortedstr=mut."";lp(let i=0;i<n;i=i+1){sortedstr=sortedstr+chars.get(i);};<sortedstr};f=isanagram(val:$str;other:$str):bool{if(val=other){<true};let vlen=val.len;let olen=other.len;if(!(vlen=olen)){<false};let vsorted=sortchars(val);let osorted=sortchars(other);<vsorted=osorted};f=groupbycharfreq(p:$str):$str{let n=p.len;let result=mut."";let i=mut.0;lp(let idx=0;idx<n;idx=idx+1){let char=p.get(idx);let found=mut.false;