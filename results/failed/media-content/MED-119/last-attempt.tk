m=markdown;f=isempty(s:$str):$bool{let len=s.len;if(len=0){<true};<false};f=trim(s:$str):$str{let len=s.len;let start=mut.0;lp(let i=0;i<len;i=i+1){let ch=s.get(i);if(ch=32){start=start+1}el{br}};let end=mut.len;lp(let i=len-1;!(i<0);i=i-1){let ch=s.get(i);if(ch=32){end=end-1}el{br}};let result=mut."";lp(let i=start;i<end;i=i+1){result=result+s.get(i)};<result};f=tostr(n:$i64):$str{if(n=0){<"0"};let neg=mut.false;let num=mut.n;if(num<0){neg=true;num=-num};let result=mut."";lp(let i=0;i<10;i=i+1){let digit=num-num/10*10;result=tostr(digit)+result;num=num/10;if(num=0){br}};