m=lu;i=io:std.io;i=s:std.str;i=math:std.math;f=abs(x:$f64):$f64{if(x<0.0){<0.0-x};<x};f=main():$i64{let n=s.toint(io.readln());let matrix=mut.@();let idx=mut.0;lp(idx<n){let line=io.readln();let parts=s.split(line;" ");let row=mut.@();let j=mut.0;lp(j<n){if(j<parts.len()){row=row.push(s.tofloat(parts.get(j)))}el{row=row.push(0.0)};j=j+1};matrix=matrix.push(row);idx=idx+1};let l=mut.@();let u=mut.@();let p=mut.@();idx=0;lp(idx<n){let lrow=mut.@();let urow=mut.@();let j=mut.0;lp(j<n){lrow=lrow.push(0.0);urow=urow.push(0.0);j=j+1};l=l.push(lrow);u=u.push(urow);p=p.push(idx);idx=idx+1};let k=mut.0;lp(k<n){let maxrow=mut.k;let maxval=mut.abs(matrix.get(k).get(k));let ridx=mut.k;ridx=ridx+1;lp(ridx<n){let val=abs(matrix.get(ridx).get(k));if(val>maxval){maxval=val;maxrow=ridx};ridx=ridx+1};if(maxrow!=k){let temp=matrix.get(k);matrix=matrix.set(k;matrix.get(maxrow));matrix=matrix.set(maxrow;temp);let ptemp=p.get(k);p=p.set(k;p.get(maxrow));p=p.set(maxrow;ptemp)};ridx=k+1;lp(ridx<n){let factor=matrix.get(ridx).get(k)/matrix.get(k).get(k);l=l.set(ridx;l.get(ridx).set(k;factor));let jdx=mut.k;lp(jdx<n){matrix=matrix.set(ridx;matrix.get(ridx).set(jdx;matrix.get(ridx).get(jdx)-factor*matrix.get(k).get(jdx)));jdx=jdx+1};ridx=ridx+1};k=k+1};idx=0;lp(idx<n){l=l.set(idx;l.get(idx).set(idx;1.0));let j=mut.0;lp(j<n){u=u.set(idx;u.get(idx).set(j;matrix.get(idx).get(j)));j=j+1};idx=idx+1};idx=0;lp(idx<n){let j=mut.0;lp(j<n){if(j=0){io.println(s.format(l.get(idx).get(j);"%.6f"))}el{io.println(s.concat(" ";s.format(l.get(idx).get(j);"%.6f")))};j=j+1};io.println("");idx=idx+1};io.println("");idx=0;lp(idx<n){let j=mut.0;lp(j<n){if(j=0){io.println(s.format(u.get(idx).get(j);"%.6f"))}el{io.println(s.concat(" ";s.format(u.get(idx).get(j);"%.6f")))};j=j+1};io.println("");idx=idx+1};io.println("");idx=0;lp(idx<n){if(idx=0){io.println(s.fromint(p.get(idx)))}el{io.println(s.concat(" ";s.fromint(p.get(idx))))};idx=idx+1};<0}