m=selectionsort;f=selectionsort(arr:@$i64):@$i64{let n=arr.len;let result=mut.@();lp(let i=0;i<n;i=i+1){result=result+@(arr.get(i));};let comp=mut.0;let swp=mut.0;lp(let i=0;i<n;i=i+1){let minidx=mut.i;lp(let j=i+1;j<n;j=j+1){if(arr.get(j)<arr.get(minidx)){minidx=j;};};if(!(minidx=i)){swp=swp+1;let tmp=result.get(i);result.get(i)=result.get(minidx);result.get(minidx)=tmp;};};<result};