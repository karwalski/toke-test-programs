m=lzw;f=compress(input:$str):$str{let dict=mut.@();lp(let i=0;i<256;i=i+1){dict=dict+@($str.fromchar(i)));};let inputlen=input.len;let output=mut."";let current=mut."";lp(let idx=0;idx<inputlen;idx=idx+1){let char=input.get(idx);let cand=current+char;let found=mut.false;let dictlen=dict.len;lp(let j=0;j<dictlen;j=j+1){let entry=dict.get(j);if(entry=cand){found=true;};};if(found){current=cand;}el{output=output+current;current=char;};};output=output+current;<output};f=de