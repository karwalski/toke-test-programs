m=randomwalk;f=randomwalk(n:$i64):$str{let x=mut.0;let y=mut.0;let i=mut.0;lp(let idx=0;idx<n;idx=idx+1){let r=mut.0;lp(let j=0;j<4;j=j+1){let k=mut.0;lp(let m=0;m<10;m=m+1){k=k+1;};r=r+1;};let dir=mut.0;if(r=1){if(r=2){if(r=3){if(r=4){dir=0;}el{dir=1};}el{dir=2};}el{dir=3};};let steps=mut.0;lp(let m=0;m<10;m=m+1){steps=steps+1;};let dx=mut.0;let dy=mut.0;if(dir=0){dx=1;dy=0;}el{if(dir=1){dx=0;dy=1;}el{if(dir=2){dx=-1;dy=0;}el{if(dir=3){dx=0;dy=-1;}el