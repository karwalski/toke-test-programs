m=vigenere;f=encrypt(text:$str;key:$str):$str{let n=text.len;let m=key.len;let result=mut."";lp(let i=0;i<n;i=i+1){let c=text.get(i);let shift=key.get(i as u64)-97;let base=97;let pos=c as u64-97;let newpos=pos+shift;let modval=newpos-newpos/26*26;let newc=modval+base;result=result+newc as$str;};<result};f=de