m=newton;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let n=s.toint(io.readln());let x=mut.@();let y=mut.@();let idx=mut.0;lp(idx<n){let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=2){let xi=s.tofloat(parts.get(0));let yi=s.tofloat(parts.get(1));x=x+@(xi);y=y+@(yi)};idx=idx+1};let xval=s.tofloat(io.readln());let table=mut.@();let j=mut.0;lp(j<n){table=table+@(@());j=j+1};let k=mut.0;lp(k<n){table=table.get(k)+@(y.get(k));k=k+1};let col=mut.1;lp(col<n){let rowidx=mut.0;lp(rowidx<(n-col)){let curr=table.get(rowidx);let next=table.get(rowidx+1);if(curr.len()>=col){if(next.len()>=col){let diff=(next.get(col-1)-curr.get(col-1))/(x.get(rowidx+col)-x.get(rowidx));let newrow=mut.@();let ci=mut.0;lp(ci<curr.len()){newrow=newrow+@(curr.get(ci));ci=ci+1};newrow=newrow+@(diff);let newtable=mut.@();let ti=mut.0;lp(ti<table.len()){if(ti=rowidx){newtable=newtable+@(newrow)}el{newtable=newtable+@(table.get(ti))};ti=ti+1};table=newtable}};rowidx=rowidx+1};col=col+1};io.println("(divided diff table)");let result=mut.y.get(0);let term=mut.1.0;let idx2=mut.1;lp(idx2<n){term=term*(xval-x.get(idx2-1));result=result+term*table.get(0).get(idx2);idx2=idx2+1};io.println("p("+s.fromfloat(xval)+") = "+s.format(result;"%.6f"));<0}