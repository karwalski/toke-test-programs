m=radixsort;f=sortbylastdigit(arr:@$i64):@$i64{let n=arr.len;let sorted=mut.@();lp(let i=0;i<n;i=i+1){let elem=arr.get(i);let last=elem-(elem/10)*10;let pos=mut.0;lp(let j=0;j<sorted.len;j=j+1){let srt=sorted.get(j);let slast=srt-(srt/10)*10;if(!(last<slast)){pos=pos+1;};};sorted=sorted+@(elem);};<sorted};f=radixsor