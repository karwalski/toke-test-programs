m=haar;i=io:std.io;i=s:std.str;i=math:std.math;f=haarforward(signal:@$f64):@$f64{let n=signal.len();let result=mut.@();let idx=mut.0;lp(idx<n){result=result.push(signal.get(idx));idx=idx+1};let step=mut.n;lp(step>1){let idx=mut.0;lp(idx<step){if(idx+1<result.len()){let avg=(result.get(idx)+result.get(idx+1))/2.0;let diff=(result.get(idx)-result.get(idx+1))/2.0;let idx1=idx/2;let idx2=step/2+idx/2;result=result.set(idx1;avg);result=result.set(idx2;diff)};idx=idx+2};step=step/2};<result};f=haarinverse(signal:@$f64):@$f64{let n=signal.len();let result=mut.@();let idx=mut.0;lp(idx<n){result=result.push(signal.get(idx));idx=idx+1};let step=mut.2;lp(step<=n){let idx=mut.0;lp(idx<step/2){let avg=result.get(idx);let diff=result.get(step/2+idx);let idx1=2*idx;let idx2=2*idx+1;result=result.set(idx1;avg+diff);result=result.set(idx2;avg-diff);idx=idx+1};step=step*2};<result};f=main():$i64{let dir=s.trim(io.readln());let n=s.toint(io.readln());let parts=s.split(s.trim(io.readln());" ");let signal=mut.@();let idx=mut.0;lp(idx<n){if(idx<parts.len()){signal=signal.push(s.tofloat(parts.get(idx)))};idx=idx+1};let result=mut.@();if(dir="forward"){result=haarforward(signal)}el{result=haarinverse(signal)};let idx=mut.0;let output=mut."";lp(idx<result.len()){if(idx>0){output=output+" "};output=output+s.format(result.get(idx);"%.6f");idx=idx+1};io.println(output);<0}