m=checkout;f=checkout(score:$i64):$str{if(score<1){<"miss"};let d=score/20;let r=score-d*20;if(d>0){if(r=0){<d as$str+"D"};if(r>0){let u=d-1;if(r<20){<d as$str+"D"+r as$str};let s=r/5;let t=r-s*5;if(s>0){<d as$str+"D"+s as$str+"S"};if(t>0){<d as$str+"D"+s as$str+"S"+t as$str+"T"};};}el{if(r=0){<"single"};if(r>0){let s=r/5;let t=r-s*5;if(s>0){<"single"+s as$str+"S"};if(t>0){<"single"+s as$str+"S"+t as$str+"T"};};};};