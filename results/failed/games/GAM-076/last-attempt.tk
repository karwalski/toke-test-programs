m=markov;f=buildchain(text:$str):$str{let lines=text.split("\n");let chain=mut."";lp(let i=0;i<lines.len;i=i+1){let line=lines.get(i);let words=line.split(" ");lp(let j=0;j<words.len;j=j+1){let word=words.get(j);let nextidx=j+1;let nextword=mut."";if(nextidx<words.len){nextword=words.get(nextidx)};let entry=word+"->"+nextword+"\n";chain=chain+entry}};<chain};f=generate(chain:$str;n:$i64):$str{let lines=chain.split("\n");let words=mut.@()