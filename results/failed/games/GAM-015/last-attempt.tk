m=wordle;f=feedback(target:$str;guess:$str):$str{let result=mut."";let n=target.len;let i=mut.0;lp(let idx=0;idx<n;idx=idx+1){let tchar=target.get(idx);let gchar=guess.get(idx);if(tchar=gchar){result=result+"G";}el{let found=mut.false;lp(let jdx=0;jdx<n;jdx=jdx+1){let jchar=guess.get(jdx);if(tchar=jchar){found=true;};};if(found){result=result+"Y";}el{result=result+"B";};};};<result};