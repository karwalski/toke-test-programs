m=shortestladder;f=buildgraph(words:@$str):$str{let graph=mut."";let n=words.len;lp(let i=0;i<n;i=i+1){let word=words.get(i);let found=mut.false;let m=graph.len;lp(let j=0;j<m;j=j+1){if(graph.get(j)=word){found=true}};if(!(found)){graph=graph+word}};let result=mut."";let glen=graph.len;lp(let k=0;k<glen;k=k+1){let ch=graph.get(k);if(!(ch=" ")){result=result+ch}};<result};f=shortestladder(start:$str;end:$str;d:$str):$i64{let startlen=start.len;let endlen=end.len;if(!(startlen=endlen)){<0};let words=mut.@($str);let dlen=d.len;lp(let i=0;i<dlen;i=i+1){let ch=d.get(i);if(ch=" "){let word=d.substr(i+1;dlen-i-1);words=words+word;i=i+word.len}};let n=words.len;