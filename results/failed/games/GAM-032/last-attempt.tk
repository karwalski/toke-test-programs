m=gameoflife;f=neighborhood(x:$i64;y:$i64;grid:@$bool):i64{let count=mut.0;lp(let dx=0;dx<3;dx=dx+1){lp(let dy=0;dy<3;dy=dy+1){let gx=x+dx-1;let gy=y+dy-1;if(gx<0){}el{if(gy<0){}el{if(gy<grid.len){if(gx<grid.get(gy).len){if(!(gx=grid.get(gy).len))){if(!(gy=grid.len))){if(grid.get(gy).get(gx)){count=count+1;};};};};};};};};};};};};};};};};};};};};};};};};}