m=picross;f=solve(rows:$str;cols:$str):$str{let rowclues=rows.split(" ");let colclues=cols.split(" ");let n=rowclues.len;let m=colclues.len;let grid=mut.@();lp(let i=0;i<n;i=i+1){let row=mut.@();lp(let j=0;j<m;j=j+1){let cell=mut." ";if(i=0){cell="+"};if(j=0){cell="+"};row=row+@(cell);};grid=grid+@(row);};lp(let i=0;i<n;i=i+1){let row=grid.get(i);lp(let j=0;j<m;j=j+1){let cell=row.get(j);let shouldbe=mut." ";if(i=0){shouldbe="+"};if(j=0){shouldbe="+"};if(!(cell=shouldbe)){}el{cell=shouldbe};}