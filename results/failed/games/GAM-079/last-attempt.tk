m=liarsdice;f=evaluatebid(allhidden:$str;bid:$str):$bool{let allarr=allhidden.split(" ");let bidarr=bid.split(" ");let num1=bidarr.get(0);let num2=bidarr.get(1);let count1=mut.0;let count2=mut.0;lp(let i=0;i<allarr.len;i=i+1){let dice=allarr.get(i);if(dice=num1){count1=count1+1};if(dice=num2){count2=count2+1}};let total=count1+count2;let bidval=num1 as i64;if(bidval<total){<true};<false};