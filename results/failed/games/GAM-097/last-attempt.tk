m=poker;f=calculatepotodds(totalbets:$i64;calledbets:$i64):$str{let pot=totalbets+calledbets;let odds=pot-calledbets;let result=odds as$str+"/"+pot as$str;let final=result;<final};f=calculateequity(handrank:$i64;boardrank:$i64):$str{let handrankval=handrank as$str;let boardrankval=boardrank as$str;let equity=handrankval+"/"+boardrankval;let final=equity;<final};