m=anagram;f=sortchars(s:$str):$str{let arr=s.chars();let n=arr.len;lp(let i=0;i<n;i=i+1){lp(let j=0;j<n-1;j=j+1){let a=arr.get(j);let b=arr.get(j+1);if(a>b){arr.get(j)=b;arr.get(j+1)=a;};};};let result=arr.intostr();<result};f=isanagram(s:$str;t:$str):$bool{let ss=sortchars(s);let tt=sortchars(t);if(ss=tt){<true};<false};f=findanagrams(word:$str;dict:@$str):@$str{let result=mut.@();lp(let i=0;i<dict.len;i=i+1){let candidate=dict.get(i);if(isanagram(word;candidate))){result=result+@(candidate);};};<result};