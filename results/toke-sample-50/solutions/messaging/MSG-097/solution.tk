m=chatpermissions;i=io:std.io;i=s:std.str;i=j:std.json;f=hasperm(role:$json;perm:$str;roles:$json):$bool{let perms=role.get("perms");lp(let idx=0;idx<perms.len;idx=idx+1){let p=perms.get(idx);if(p.str==perm){<true};if(p.str=="all"){<true}};let inherit=role.get("inherits");if(inherit.type!="null"){let parentrole=roles.get(inherit.str);<hasperm(parentrole;perm;roles)};<false};f=main():$i64{let rolesdata=j.parse(io.readln());let userdata=j.parse(io.readln());let queryline=io.readln();let query=j.parse(s.concat(queryline;"]"));let users=query.get(0).get("users");lp(let idx=0;idx<users.len;idx=idx+1){let user=users.get(idx);let username=user.get("name").str;let action=user.get("action").str;let userrole=userdata.get(username).str;let roleobj=rolesdata.get(userrole);let allowed=hasperm(roleobj;action;rolesdata);if(allowed){io.println("\(username) \(action): ALLOWED (role: \(userrole), perm: \(action))")}el{io.println("\(username) \(action): DENIED (role: \(userrole), no matching perm)")}};<0}