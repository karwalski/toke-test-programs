m=scheduler;i=io:std.io;i=s:std.str;t=$job{name:$str;weight:$i64;deadline:$i64};f=main():$i64{let n=s.toint(io.readln());let jobs=mut.@($job);lp(let idx=0;idx<n;idx=idx+1){let line=io.readln();let parts=s.split(line;" ");if(parts.len>=3){let name=parts.get(0);let deadline=s.toint(parts.get(1));let weight=s.toint(parts.get(2));let j=$job{name:name;weight:weight;deadline:deadline};jobs=jobs+@(j)}};let sorted=mut.@($job);lp(let idx=0;idx<jobs.len;idx=idx+1){sorted=sorted+@(jobs.get(idx))};lp(let idx=0;idx<sorted.len;idx=idx+1){lp(let j=idx+1;j<sorted.len;j=j+1){let j1=sorted.get(idx);let j2=sorted.get(j);if(j1.weight<j2.weight){sorted=sorted.set(idx;j2);sorted=sorted.set(j;j1)}}};let scheduled=mut.@($job);let slots=mut.@($bool);lp(let idx=0;idx<n;idx=idx+1){slots=slots+@(false)};lp(let idx=0;idx<sorted.len;idx=idx+1){let job=sorted.get(idx);let slot=mut.job.deadline-1;if(slot>=n){slot=n-1};lp(slot>=0){if(!slots.get(slot)){slots=slots.set(slot;true);scheduled=scheduled+@(job);br};slot=slot-1}};let result=mut.@($job);lp(let idx=n-1;idx>=0;idx=idx-1){lp(let j=0;j<scheduled.len;j=j+1){let job=scheduled.get(j);let slot=mut.job.deadline-1;if(slot>=n){slot=n-1};let found=mut.false;lp(slot>=0&!found){if(slot==idx&slots.get(slot)){result=result+@(job);found=true};slot=slot-1}}};let totalweight=mut.0;let names=mut.@($str);lp(let idx=0;idx<result.len;idx=idx+1){let job=result.get(idx);names=names+@(job.name);totalweight=totalweight+job.weight};io.println(s.concat("Schedule: ";s.join(names;" ")));io.println(s.concat("Total weight: ";s.fromint(totalweight)));<0}