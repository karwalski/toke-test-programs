m=cagr;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=io.readln();let parts=s.split(line;"_");if(parts.len>=3){let beginning=s.tofloat(parts.get(0));let ending=s.tofloat(parts.get(1));let years=s.tofloat(parts.get(2));let ratio=ending/beginning;let exponent=1.0/years;let growth=math.pow(ratio;exponent)-1.0;let percent=growth*100.0;io.println(s.concat(s.format(percent;"_");"_"))};<0}