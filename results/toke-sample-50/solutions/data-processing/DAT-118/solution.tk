m=extract;
i=s:std.str;
i=io:std.io;
i=re:std.regex;
i=j:std.json;
f=extractgroups(line:$str;pattern:$str):$str{
  let pat=re.compile(pattern);
  let result=re.match(pat;line);
  if(result.success){
    let groups=result.groups;
    let obj=j.object();
    lp(let idx=0;idx<groups.len;idx=idx+1){
      let g=groups.get(idx);
      j.set(obj;g.name;g.value)
    };
    <j.stringify(obj)
  };
  <""
};
f=main():$i64{
  let pattern=io.readln();
  lp(true){
    let line=io.readln();
    if(s.len(line)==0){br};
    let result=extractgroups(line;pattern);
    if(s.len(result)>0){
      io.println(result)
    }
  };
  <0
}