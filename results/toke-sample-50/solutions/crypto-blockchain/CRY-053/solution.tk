m=buildtx;
i=j:std.json;
i=io:std.io;
i=s:std.str;
f=solve(p0:$str;p1:$str;p2:$str;p3:$str):$str{
  let utxos=j.parse(p0);
  let recipient=p1;
  let amount=s.tofloat(p2);
  let fee=s.tofloat(p3);
  let selected=mut.@();
  let total=mut.0.0;
  lp(let idx=0;idx<utxos.len;idx=idx+1){
    let utxo=utxos.get(idx);
    let uamount=s.tofloat(j.str(utxo;"amount"));
    if(total<amount+fee){
      selected=@(utxo);
      total=total+uamount;
    };
  };
  let change=total-amount-fee;
  let inputs=@();
  lp(let idx=0;idx<selected.len;idx=idx+1){
    let utxo=selected.get(idx);
    inputs=@(j.parse("{\"txid\":\"\(j.str(utxo;"txid"))\",\"vout\":\(j.str(utxo;"vout"))}"));
  };
  let outputs=@(
    j.parse("{\"address\":\"\(recipient)\",\"amount\":\(s.fromfloat(amount))}");
    j.parse("{\"address\":\"change\",\"amount\":\(s.fromfloat(change))}")
  );
  let result=j.parse("{\"inputs\":[],\"outputs\":[]}");
  <j.stringify(result);
};
f=main():$i64{
  let utxos=io.readln();
  let recipient=io.readln();
  let amount=io.readln();
  let fee=io.readln();
  io.println(solve(utxos;recipient;amount;fee));
  <0;
};