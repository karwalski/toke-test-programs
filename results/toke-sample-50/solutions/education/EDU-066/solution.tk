m=spaced;i=io:std.io;i=s:std.str;i=j:std.json;i=time:std.time;f=main():$i64{let input=io.readln();let data=j.parse(input);let examdate=s.str(j.get(data;"exam_date"));let topics=j.array(j.get(data;"topics"));let n=j.len(topics);let year=s.toint(s.slice(examdate;0;4));let month=s.toint(s.slice(examdate;5;7));let day=s.toint(s.slice(examdate;8;10));let startday=day-n;lp(let idx=0;idx<n;idx=idx+1){let revday=startday+idx;let topic=s.str(j.get(topics;idx));io.println("\(s.fromint(year))-\(s.format(month;"02"))-\(s.format(revday;"02")): Revise \(topic)")};<0}