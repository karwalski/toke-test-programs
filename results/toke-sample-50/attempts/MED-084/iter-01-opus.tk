m=repeat;i=io:std.io;i=s:std.str;f=main():$i64{let linenum=mut.1;lp(true){let line=io.readln();if(s.len(line)=0){br};let words=s.split(line;" ");let idx=mut.0;lp(idx<words.len-1){let w1=words.get(idx);let w2=words.get(idx+1);if(w1=w2){io.println("Line \(s.fromint(linenum)): repeated word \"\(w1)\"")};idx=idx+1};linenum=linenum+1};<0}