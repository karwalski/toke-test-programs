m=validate;
i=io:std.io;
i=s:std.str;
i=j:std.json;

f=main():$i64{
  let input=io.readln();
  let policy=j.parse(input);
  
  let statements=policy.get("Statement");
  if(statements.type!="array"){
    io.println("ERROR: No Statement array found");
    <1
  };
  
  lp(let idx=0;idx<statements.len;idx=idx+1){
    let stmt=statements.get(idx);
    let effect=stmt.get("Effect");
    let action=stmt.get("Action");
    let resource=stmt.get("Resource");
    
    if(action.type="string"){
      if(action.value="*"){
        io.println("RISK: Statement allows all actions (*)")
      }
    };
    
    if(resource.type="string"){
      if(resource.value="*"){
        io.println("RISK: Statement allows all resources (*)")
      }
    }
  };
  
  <0
}