m=hanoi;
i=io:std.io;
i=s:std.str;

f=hanoi(n:$i64;from:$str;to:$str;aux:$str):$void{
  if(n=1){
    io.println("Move disk 1 from peg \(from) to peg \(to)");
    <
  };
  hanoi(n-1;from;aux;to);
  io.println("Move disk \(s.fromint(n)) from peg \(from) to peg \(to)");
  hanoi(n-1;aux;to;from)
};

f=main():$i64{
  let n=s.toint(io.readln());
  hanoi(n;"A";"B";"C");
  <0
}