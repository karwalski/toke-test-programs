m=ludet;i=io:std.io;i=s:std.str;i=math:std.math;f=ludecomp(mat:@($f64);n:$i64):$f64{let det=mut.1.0;let a=mut.@();lp(let i=0;i<n*n;i=i+1){a=a+@(mat.get(i))};lp(let k=0;k<n;k=k+1){let pivot=mut.a.get(k*n+k);let pivotrow=mut.k;lp(let i=k+1;i<n;i=i+1){if(math.abs(a.get(i*n+k))>math.abs(pivot)){pivot=a.get(i*n+k);pivotrow=i}};if(pivotrow!=k){det=det*(-1.0);lp(let j=0;j<n;j=j+1){let temp=a.get(k*n+j);a=a.set(k*n+j;a.get(pivotrow*n+j));a=a.set(pivotrow*n+j;temp)}};if(pivot=0.0){<0.0};lp(let i=k+1;i<n;i=i+1){let factor=a.get(i*n+k)/a.get(k*n+k);lp(let j=k+1;j<n;j=j+1){a=a.set(i*n+j;a.get(i*n+j)-factor*a.get(k*n+j))}};det=det*a.get(k*n+k)};<det};f=main():$i64{let n=s.toint(io.readln());let mat=mut.@();lp(let i=0;i<n;i=i+1){let parts=s.split(io.readln();" ");lp(let j=0;j<n;j=j+1){mat=mat+@(s.tofloat(parts.get(j)))}};let det=ludecomp(mat;n);io.println("Determinant: \(s.format(det;"%.6f"))");<0}