m=throttle;
i=io:std.io;
i=s:std.str;
i=time:std.time;

f=main():$i64{
    let rate=s.toint(io.readln());
    if(rate<=0){
        io.println("ERROR: rate must be > 0");
        <1
    };
    
    let line=io.readln();
    let delay=1000.0/rate as$f64;
    
    let idx=mut.0;
    lp(idx<s.len(line)){
        io.println(s.slice(line;idx;idx+1));
        time.sleep(delay as$i64);
        idx=idx+1
    };
    
    <0
}