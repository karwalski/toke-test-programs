m=abs;
i=io:std.io;

f=abs(n:i64):i64{
  if(n<0){
    <0-n;
  };
  <n;
};

f=main():i64{
  if(abs(0-42)=42){
    io.println("abs(-42) = 42: PASS");
  }el{
    io.println("abs(-42) = 42: FAIL");
  };
  if(abs(7)=7){
    io.println("abs(7) = 7: PASS");
  }el{
