m=sumto;
i=io:std.io;

f=sumto(n:i64):i64{
  let total=mut.0;
  lp(let i=1;i<n+1;i=i+1){
    total=total+i;
  };
  <total;
};

f=main():i64{
  if(sumto(10)=55){
    io.println("sumto(10) = 55: PASS");
  }el{
    io.println("sumto(10) = 55: FAIL");
  };
  if(sumto(100)=5050){
    io.println("sumto(100) = 5050: PASS");
  }el{
    io.println("sumto(100) = 5050: FAIL");
  };
  if(sumto(0)=0){
    io.println("sumto(0) = 0: PASS");
  }el{
    io.println("sumto(0) = 0: FAIL");
  };
  <0;
};
