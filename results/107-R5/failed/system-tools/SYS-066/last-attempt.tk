m=csvtojson;i=io:std.io;i=s:std.str;f=main():$i64{let header=s.trim(io.readln());let headers=s.split(header;",");let n=headers.len();let order=mut.@();lp(let a=0;a<n;a=a+1){let best=mut.0-1;lp(let b=0;b<n;b=b+1){let used=mut.false;lp(let c=0;c<order.len();c=c+1){if(order.get(c)=b){used=true}};if(used=false){if(best<0){best=b}el{let kb=headers.get(b);let kbest=headers.get(best);if(kb<kbest){best=b}}}};order=order+@(best)};let output=mut."[";let first=mut.true;let done=mut.false;lp(done=false){let raw=io.readln();let line=s.trim(raw);if(s.len(line)<1){done=true}el{if(first=true){first=false}el{output=output+","};let vals=s.split(line;",");output=output+"{";lp(let i2=0;i2<n;i2=i2+1){if(i2>0){output=output+","};let idx=order.get(i2);let key=headers.get(idx);let val=mut."";if(idx<vals.len()){val=vals.get(idx)};output=output+"\""+key+"\":\""+val+"\""};output=output+"}"}};output=output+"]";io.println(output);<0}