m=scoreboard;i=io:std.io;i=s:std.str;f=main():$i64{let names=mut.@();let scores=mut.@();let count=mut.0;let line=mut.io.readln();lp(s.len(line)>0){let parts=s.split(line;" ");let cmd=parts.get(0);if(cmd="score"){let nm=parts.get(1);let sc=s.toint(parts.get(2));let found=mut.0;found=found-1;let i=mut.0;lp(i<count){if(names.get(i)=nm){found=i};i=i+1};if(found<0){names=names+@(nm);scores=scores+@(sc);count=count+1}el{let ns=mut.@();let j=mut.0;lp(j<count){if(j=found){ns=ns+@(sc)}el{ns=ns+@(scores.get(j))};j=j+1};scores=ns}};if(cmd="rank"){let nm=parts.get(1);let target=mut.0;let i=mut.0;lp(i<count){if(names.get(i)=nm){target=scores.get(i)};i=i+1};let rank=mut.1;let k=mut.0;lp(k<count){if(scores.get(k)>target){rank=rank+1};k=k+1};io.println(s.concat(s.concat(nm;" is rank ");s.fromint(rank)))};if(cmd="top"){let topn=s.toint(parts.get(1));let used=mut.@();let u=mut.0;lp(u<count){used=used+@(0);u=u+1};let picks=mut.0;lp(picks<topn){if(picks<count){let best=mut.0;best=best-1;let bestsc=mut.0;let bi=mut.0;lp(bi<count){if(used.get(bi)=0){if(best<0){best=bi;bestsc=scores.get(bi)}el{if(scores.get(bi)>bestsc){best=bi;bestsc=scores.get(bi)}}};bi=bi+1};if(best>=0){let nu=mut.@();let w=mut.0;lp(w<count){if(w=best){nu=nu+@(1)}el{nu=nu+@(used.get(w))};w=w+1};used=nu;let pos=picks+1;io.println(s.concat(s.concat(s.concat(s.fromint(pos);". ");s.concat(names.get(best);": "));s.fromint(scores.get(best))))}};picks=picks+1}};line=io.readln()};<0}