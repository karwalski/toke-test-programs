m=bingo;i=io:std.io;i=s:std.str;f=cellval(seed:$i64;idx:$i64):$i64{let h=mut.seed;h=h*1103515245+12345+idx*7919;let hm=mut.h-h/2147483647*2147483647;if(hm<0){hm=0-hm};let r=hm-hm/75*75;<r+1};f=main():$i64{let seedline=io.readln();let seed=s.toint(seedline);let callline=io.readln();let parts=s.split(callline;" ");let ncall=parts.len();let card=mut.@();let idx=mut.0;lp(idx<25){let v=cellval(seed;idx);card=card+@(v);idx=idx+1};let marked=mut.@();let j=mut.0;lp(j<25){marked=marked+@(0);j=j+1};let result=mut."No bingo";let found=mut.0;let c=mut.0;lp(c<ncall){if(found=0){let numstr=parts.get(c);let num=s.toint(numstr);let k=mut.0;lp(k<25){if(card.get(k)=num){marked=marked.set(k;1)};k=k+1};let row=mut.0;lp(row<5){if(found=0){let cnt=mut.0;let col=mut.0;lp(col<5){if(marked.get(row*5+col)=1){cnt=cnt+1};col=col+1};if(cnt=5){found=1;result=s.concat("Bingo! Row ";s.concat(s.fromint(row+1);s.concat(" complete after calling ";numstr)))}};row=row+1}};c=c+1};io.println(result);<0}