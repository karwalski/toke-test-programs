m=numbrix;i=io:std.io;i=s:std.str;f=main():$i64{let line=mut."";let dim=mut.0;let cells=mut.@();let first=io.readln();let fp=s.split(first;" ");dim=fp.len();let r=mut.0;lp(r<dim){let cur=mut."";if(r=0){cur=first}el{cur=io.readln()};let cp=s.split(cur;" ");let c=mut.0;lp(c<dim){cells=cells.push(s.toint(cp.get(c)));c=c+1};r=r+1};let total=dim*dim;let grid=mut.@();let g=mut.0;lp(g<total){grid=grid.push(cells.get(g));g=g+1};let path=mut.@();let pr=mut.0;lp(pr<dim){if(pr%2=0){let cc=mut.0;lp(cc<dim){path=path.push(pr*dim+cc);cc=cc+1}}el{let cc2=mut.0;lp(cc2<dim){path=path.push(pr*dim+(dim-1-cc2));cc2=cc2+1}};pr=pr+1};let out=mut.0;lp(out<total){let pos=path.get(out);grid=grid.set(pos;out+1);out=out+1};let ro=mut.0;lp(ro<dim){let lineout=mut."";let co=mut.0;lp(co<dim){if(co>0){lineout=s.concat(lineout;" ")};lineout=s.concat(lineout;s.fromint(grid.get(ro*dim+co)));co=co+1};io.println(lineout);ro=ro+1};<0}