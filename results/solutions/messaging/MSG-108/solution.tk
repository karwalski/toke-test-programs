m=monitor;i=io:std.io;i=s:std.str;
f=getint(json:$str;key:$str):$i64{let needle=s.concat(s.concat("\"";key);"\":");let idx=s.indexof(json;needle);if(idx<0){<0};let start=idx+s.len(needle);let rest=s.slice(json;start;s.len(json));let num=mut."";lp(let i=0;i<s.len(rest);i=i+1){let c=s.slice(rest;i;i+1);if(s.equals(c;",")){br};if(s.equals(c;"}")){br};if(s.equals(c;"]")){br};num=s.concat(num;c)};<s.toint(s.trim(num))};
