        let lenv=readv(bytes;pos);pos=pos+vlen(bytes;pos);
        let str=mut."";lp(let k=0;k<lenv;k=k+1){str=s.concat(str;chr(bytes.get(pos+k)))};pos=pos+lenv;
        outnames=outnames+@(fnames.get(fidx));outvals=outvals+@(s.concat(s.concat("\"";str);"\""))
