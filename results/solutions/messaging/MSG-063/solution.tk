        let v=readv(bytes;pos);pos=pos+vlen(bytes;pos);
        if(s.equals(typ;"bool")){let b=mut."false";if(!(v=0)){b="true"};outnames=outnames+@(fnames.get(fidx));outvals=outvals+@(b)}el{outnames=outnames+@(fnames.get(fidx));outvals=outvals+@(s.fromint(v))}
      }
    }
  };
  let out=mut."{";
  lp(let i=0;i<outnames.len();i=i+1){if(i>0){out=s.concat(out;",")};out=s.concat(out;"\"");out=s.concat(out;outnames.get(i));out=s.concat(out;"\":");out=s.concat(out;outvals.get(i))};
  out=s.concat(out;"}");
  io.println(out);
  <0
};
