    if(fidx<0){
      if(wire=0){let cc=mut.true;lp(cc){if(pos<bytes.len()){let bt=bytes.get(pos);pos=pos+1;if(bt<128){cc=false}}el{cc=false}}}el{if(wire=2){let ln2=readv(bytes;pos);pos=pos+vlen(bytes;pos)+ln2}}
    }el{
      let typ=ftypes.get(fidx);
