m=wsdecode;i=io:std.io;i=s:std.str;
f=ascii():$str{< " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"};
f=charat(strv:$str;i:$i64):$str{<s.slice(strv;i as $u64;(i+1) as $u64)};
f=hexval(c:$str):$i64{<s.indexof("0123456789abcdef";s.lower(c))};
f=hex2int(h:$str):$i64{<hexval(charat(h;0))*16+hexval(charat(h;1))};
f=bytechar(b:$i64):$str{
  let idx=b-32;
  if(idx<0){<""};
  if(idx>=s.len(ascii()) as $i64){<""};
  <charat(ascii();idx)
};
f=bxor8(a:$i64;b:$i64):$i64{
  let r=mut.0;
  let bit=mut.1;
  let x=mut.a;
  let y=mut.b;
  lp(let k=0;k<8;k=k+1){
    if((x%2)!=(y%2)){r=r+bit};
    x=x/2;y=y/2;bit=bit*2
  };
  <r
};
f=opcodename(op:$i64):$str{
  if(op==0){<"continuation"};
  if(op==1){<"text"};
  if(op==2){<"binary"};
  if(op==8){<"close"};
  if(op==9){<"ping"};
  if(op==10){<"pong"};
  <"unknown"
};
f=hexlow(b:$i64):$str{
  let digits="0123456789abcdef";
  <s.concat(charat(digits;b/16);charat(digits;b%16))
};
f=main():$i64{
  let line=s.trim(io.readln());
  let toks=s.split(line;" ");
  let bytes=mut.@($i64);
  lp(let i=0;i<toks.len();i=i+1){
    let t=s.trim(toks.get(i));
    if(s.len(t)>0){bytes=bytes+@(hex2int(t))}
  };
  let fb=bytes.get(0);
  let fin=fb/128;
  let rsv=(fb/16)%8;
  let opcode=fb%16;
  let sb=bytes.get(1);
  let maskbit=sb/128;
  let plen=mut.sb%128;
  let offset=mut.2;
  if(plen==126){plen=bytes.get(2)*256+bytes.get(3);offset=4};
  let maskkey=mut.@($i64);
  let maskstr=mut."no";
  let maskkeyhex=mut."";
  if(maskbit==1){
    maskstr="yes";
    lp(let i=0;i<4;i=i+1){maskkey=maskkey+@(bytes.get(offset+i))};
    offset=offset+4;
    lp(let i=0;i<4;i=i+1){maskkeyhex=s.concat(maskkeyhex;hexlow(maskkey.get(i)))}
  };
  let payload=mut."";
  lp(let i=0;i<plen;i=i+1){
    let pb=mut.bytes.get(offset+i);
    if(maskbit==1){pb=bxor8(pb;maskkey.get(i%4))};
    payload=s.concat(payload;bytechar(pb))
  };
  let rsvbits=mut."";
  rsvbits=s.concat(rsvbits;s.fromint((rsv/4)%2));
  rsvbits=s.concat(rsvbits;s.fromint((rsv/2)%2));
  rsvbits=s.concat(rsvbits;s.fromint(rsv%2));
  let out=mut."FIN=";
  out=s.concat(out;s.fromint(fin));
  out=s.concat(out;", RSV=");
  out=s.concat(out;rsvbits);
  out=s.concat(out;", opcode=");
  out=s.concat(out;opcodename(opcode));
  out=s.concat(out;"(0x");
  out=s.concat(out;s.fromint(opcode));
  out=s.concat(out;"), mask=");
  out=s.concat(out;maskstr);
  if(maskbit==1){
    out=s.concat(out;", mask_key=");
    out=s.concat(out;maskkeyhex)
  };
  out=s.concat(out;", length=");
  out=s.concat(out;s.fromint(plen));
  out=s.concat(out;", payload=\"");
  out=s.concat(out;payload);
  out=s.concat(out;"\"");
  io.println(out);
  <0
}
