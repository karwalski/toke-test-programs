m=onion;i=io:std.io;i=s:std.str;
f=relayname(elem:$str):$str{let u=s.indexof(elem;"_");if(u<0){<elem};<s.slice(elem;0;u)};
f=main():$i64{
let arrline=s.trim(io.readln());
let recipient=s.trim(io.readln());
let plaintext=s.trim(io.readln());
let inner=s.slice(arrline;1;s.len(arrline)-1);
let parts=s.split(inner;",");
let names=mut.@($str);
lp(let i=0;i<parts.len();i=i+1){
let p=s.trim(parts.get(i));
let q=mut.p;
if(s.startswith(p;"\"")){q=s.slice(p;1;s.len(p)-1)};
names=names+@(relayname(q));
};
let r=names.len();
lp(let li=r;li>0;li=li-1){
let i=r-li;
let nm=names.get(i);
let lbl=mut."";
if(li=r){lbl=s.concat("layer ";s.concat(s.fromint(li);s.concat(" (outermost, for ";s.concat(nm;"):"))))}el{lbl=s.concat("layer ";s.concat(s.fromint(li);s.concat(" (for ";s.concat(nm;"):"))))};
io.println(lbl);
let nexthop=mut."";
if(i+1<r){nexthop=names.get(i+1)}el{nexthop="recipient"};
io.println(s.concat("  next_hop: ";nexthop));
io.println("  encrypted: base64");
};
io.println("layer 0 (for recipient):");
io.println(s.concat("  plaintext: ";plaintext));
<0}
