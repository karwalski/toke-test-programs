m=diffiehellman;i=io:std.io;i=s:std.str;
f=modpow(base:$i64;exp:$i64;mod:$i64):$i64{
  let result=mut.1;
  let b=mut.base%mod;
  let e=mut.exp;
  lp(e>0){
    if(e%2==1){result=(result*b)%mod};
    e=e/2;
    b=(b*b)%mod
  };
  <result
};
f=main():$i64{
  let p=s.toint(s.trim(io.readln()));
  let g=s.toint(s.trim(io.readln()));
  let a=s.toint(s.trim(io.readln()));
  let b=s.toint(s.trim(io.readln()));
  let alicepub=modpow(g;a;p);
  let bobpub=modpow(g;b;p);
  let shared=modpow(bobpub;a;p);
  io.println("\(alicepub)");
  io.println("\(bobpub)");
  io.println("\(shared)");
  <0
}
