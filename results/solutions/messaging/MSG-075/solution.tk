m=certpin;
i=io:std.io;
i=s:std.str;
i=crypto:std.crypto;
i=enc:std.encoding;
(* strip [ ] and split a JSON string array into trimmed unquoted elements *)
f=splitjsonarr(raw:$str):@$str{
  let inner=mut.s.trim(raw);
  inner=s.replace(inner;"[";"");
  inner=s.replace(inner;"]";"");
  let parts=s.split(inner;",");
  let out=mut.@();
  lp(let i=0;i<parts.len;i=i+1){
    let p=mut.s.trim(parts.get(i));
    p=s.replace(p;"\"";"");
    if(s.len(p)>0){out=out+@(p)}
  };
  <out
};
(* compute the SPKI pin for a cert: sha256/<base64(sha256(cert-bytes))> *)
f=certpinval(cert:$str):$str{
  let h=crypto.sha256(s.bytes(cert));
  let b64=enc.b64encode(h);
  <s.concat("sha256/";b64)
};
f=certlabel(idx:$i64):$str{
  if(idx=0){<"leaf"};
  <"intermediate"
};
f=main():$i64{
  let pinsraw=io.readln();
  let chainraw=io.readln();
  let pins=splitjsonarr(pinsraw);
  let chain=splitjsonarr(chainraw);
  let matchidx=mut.0-1;
  (* check each cert in chain against all pins; report first match *)
  lp(let c=0;c<chain.len;c=c+1){
    if(matchidx<0){
      let pinval=certpinval(chain.get(c));
      lp(let p=0;p<pins.len;p=p+1){
        if(s.eq(pins.get(p);pinval)){
          if(matchidx<0){matchidx=c}
        }
      }
    }
  };
  if(matchidx>=0){
    let lbl=mut.certlabel(matchidx);
    let full=mut.s.concat(lbl;" certificate");
    let line=s.concat(s.concat(s.concat("VALID: pin matched at position ";s.fromint(matchidx));" (");full);
    io.println(s.concat(line;")"))
  }el{
    io.println("INVALID: no pin matched");
    (* report the leaf cert's actual computed pin *)
    if(chain.len>0){
      let pinval=certpinval(chain.get(0));
      io.println(s.concat("checked: leaf (";s.concat(pinval;")")))
    }
  };
  <0
};
