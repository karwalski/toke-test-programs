m=validateid;
i=io:std.io;
i=s:std.str;
f=joinpipe(sender:$str;recipient:$str;content:$str;timestamp:$str):$str{
  let a=s.concat(sender;"|");
  let b=s.concat(a;recipient);
  let c=s.concat(b;"|");
  let d=s.concat(c;content);
  let e=s.concat(d;"|");
  let f=s.concat(e;timestamp);
  <f
};
f=stripbracketsquotes(raw:$str):$str{
  let r=mut.raw;
  r=s.replace(r;"[";"");
  r=s.replace(r;"]";"");
  r=s.replace(r;"\"";"");
  <r
};
f=main():$i64{
  let operation=s.trim(io.readln());
  if(s.eq(operation;"generate")){
    let sender=s.trim(io.readln());
    let recipient=s.trim(io.readln());
    let content=s.trim(io.readln());
    let timestamp=s.trim(io.readln());
    let data=joinpipe(sender;recipient;content;timestamp);
    let line=s.concat(s.concat("key: sha256(";data);") = hex_hash");
    io.println(line)
  }el{
    if(s.eq(operation;"validate")){
      let key=s.trim(io.readln());
      let stored=s.trim(io.readln());
      let cleaned=stripbracketsquotes(stored);
      let keys=s.split(cleaned;",");
      let isdupe=mut.false;
      lp(let idx=0;idx<keys.len;idx=idx+1){
        let k=s.trim(keys.get(idx));
        if(s.eq(k;key)){isdupe=true}
      };
      if(isdupe){
        io.println("DUPLICATE (matches existing key)")
      }el{
        io.println("UNIQUE")
      }
    }el{
      io.println("INVALID")
    }
  };
  <0
};
