m=rotkey;i=io:std.io;i=s:std.str;i=enc:std.encoding;
f=xorcyc(p:@$i64;k:@$i64):@$i64{let r=mut.@();let kl=k.len();lp(let i=0;i<p.len();i=i+1){let kb=k.get(i-i/kl*kl);r=r+@(p.get(i)^kb)};<r};
f=getkey(js:$str;ver:$i64):$str{
  let tok=s.concat("\"version\":";s.fromint(ver));
  let vi=s.indexof(js;tok);
  let rest=s.slice(js;vi;s.len(js));
  let kmark=s.indexof(rest;"\"key\":\"");
  let after=s.slice(rest;kmark+7;s.len(rest));
  let endq=s.indexof(after;"\"");
  <s.slice(after;0;endq)
};
f=render(b:@$i64):$str{
  let out=mut.@();
  lp(let i=0;i<b.len();i=i+1){
    let c=b.get(i);
    if(c<32){out=out+@(63)}el{
      if(c<128){out=out+@(c)}el{out=out+@(239)+@(191)+@(189)}
    }
  };
  <s.frombytes(out)
};
f=main():$i64{
  let keyring=s.trim(io.readln());
  let active=s.toint(s.trim(io.readln()));
  let op=s.trim(io.readln());
  let payload=s.trim(io.readln());
  if(s.eq(op;"encrypt")){
    let kh=getkey(keyring;active);
    let kb=enc.hexdecode(kh);
    let pb=s.bytes(payload);
    let ct=xorcyc(pb;kb);
    let b64=enc.b64encode(ct);
    io.println(s.concat("v";s.concat(s.fromint(active);s.concat(":";b64))));
    <0
  };
  let ci=s.indexof(payload;":");
  let prefix=s.slice(payload;0;ci);
  let body=s.slice(payload;ci+1;s.len(payload));
  let ver=s.toint(s.slice(prefix;1;s.len(prefix)));
  let kh=getkey(keyring;ver);
  let kb=enc.hexdecode(kh);
  let ct=enc.b64decode(body);
  let pt=xorcyc(ct;kb);
  let txt=render(pt);
  io.println(s.concat(txt;s.concat(" (decrypted with key v";s.concat(s.fromint(ver);")"))));
  <0
};
