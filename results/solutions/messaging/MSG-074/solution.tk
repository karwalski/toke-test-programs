m=vclock;i=io:std.io;i=s:std.str;
f=findFrom(h:$str;needle:$str;start:$i64):$i64{let sub=s.slice(h;start;s.len(h));let r=s.indexof(sub;needle);if(r<0){<0-1};<start+r};
f=getStrField(seg:$str;key:$str):$str{let k=findFrom(seg;key;0);let q1=findFrom(seg;"\"";k+s.len(key));let q2=findFrom(seg;"\"";q1+1);<s.slice(seg;q1+1;q2)};
f=clockKeys(clk:$str):@$str{let keys=mut.@("x");keys=@();let pos=mut.0;lp(1=1){let q1=findFrom(clk;"\"";pos);if(q1<0){br};let q2=findFrom(clk;"\"";q1+1);keys=keys+@(s.slice(clk;q1+1;q2));let co=findFrom(clk;":";q2);pos=co+1};<keys};
f=clockVal(clk:$str;dev:$str):$i64{let key=s.concat("\"";s.concat(dev;"\""));let k=findFrom(clk;key;0);if(k<0){<0};let co=findFrom(clk;":";k+s.len(key));let start=co+1;let n=s.len(clk);let e=mut.start;lp(e<n){let ch=s.slice(clk;e;e+1);if(s.eq(ch;",")||s.eq(ch;"}")){br};e=e+1};<s.toint(s.trim(s.slice(clk;start;e)))};
f=fmtClock(clk:$str):$str{let keys=clockKeys(clk);let sorted=mut.@("x");sorted=@();lp(sorted.len()<keys.len()){let best=mut."";let have=mut.false;lp(let i=0;i<keys.len();i=i+1){let kk=keys.get(i);let used=mut.false;lp(let j=0;j<sorted.len();j=j+1){if(s.eq(sorted.get(j);kk)){used=true}};if(!used){if(!have){best=kk;have=true}el{if(s.indexof(s.concat(kk;"|");best)<0){let mn=mut.s.len(kk);if(s.len(best)<mn){mn=s.len(best)};let dec=mut.0;lp(let c=0;c<mn;c=c+1){if(dec=0){let ca=s.slice(kk;c;c+1);let cb=s.slice(best;c;c+1);if(!(s.eq(ca;cb))){if(s.indexof("abcdefghijklmnopqrstuvwxyz0123456789";ca)<s.indexof("abcdefghijklmnopqrstuvwxyz0123456789";cb)){dec=1}el{dec=0-1}}}};if(dec=0){if(s.len(kk)<s.len(best)){dec=1}};if(dec=1){best=kk}}}}};sorted=sorted+@(best)};let out=mut."{";lp(let i=0;i<sorted.len();i=i+1){if(i>0){out=s.concat(out;",")};out=s.concat(out;s.concat(sorted.get(i);s.concat(":";s.fromint(clockVal(clk;sorted.get(i))))))};out=s.concat(out;"}");<out};
f=clockSub(seg:$str):$str{let k=findFrom(seg;"\"clock\"";0);let open=findFrom(seg;"{";k);let close=findFrom(seg;"}";open);<s.slice(seg;open;close+1)};
f=splitEvents(evLine:$str):@$str{let segs=mut.@("x");segs=@();let depth=mut.0;let start=mut.0;let n=s.len(evLine);lp(let i=0;i<n;i=i+1){let ch=s.slice(evLine;i;i+1);if(s.eq(ch;"{")){if(depth=0){start=i};depth=depth+1}el{if(s.eq(ch;"}")){depth=depth-1;if(depth=0){segs=segs+@(s.slice(evLine;start;i+1))}}}};<segs};
f=allClockKeys(clkA:$str;clkB:$str):@$str{let ka=clockKeys(clkA);let kb=clockKeys(clkB);let allk=mut.@("x");allk=@();lp(let i=0;i<ka.len();i=i+1){allk=allk+@(ka.get(i))};lp(let i=0;i<kb.len();i=i+1){let kk=kb.get(i);let f=mut.false;lp(let j=0;j<allk.len();j=j+1){if(s.eq(allk.get(j);kk)){f=true}};if(!f){allk=allk+@(kk)}};<allk};
(* compare two clocks: returns 1 if A dominates, -1 if B dominates, 0 if concurrent, 2 if equal *)
f=compareClocks(clkA:$str;clkB:$str):$i64{let allk=allClockKeys(clkA;clkB);let gA=mut.false;let gB=mut.false;lp(let i=0;i<allk.len();i=i+1){let d=allk.get(i);let va=clockVal(clkA;d);let vb=clockVal(clkB;d);if(va>vb){gA=true};if(vb>va){gB=true}};if(gA){if(gB){<0}el{<1}}el{if(gB){<0-1}el{<2}}};
f=main():$i64{let devLine=s.trim(io.readln());let evLine=s.trim(io.readln());
let segs=splitEvents(evLine);
(* gather parallel event data *)
let devs=mut.@("x");devs=@();let acts=mut.@("x");acts=@();let clks=mut.@("x");clks=@();let msgs=mut.@("x");msgs=@();
lp(let i=0;i<segs.len();i=i+1){let seg=segs.get(i);devs=devs+@(getStrField(seg;"\"device\""));acts=acts+@(getStrField(seg;"\"action\""));clks=clks+@(clockSub(seg));msgs=msgs+@(getStrField(seg;"\"msg_id\""))};
(* pairwise scan: find first conflicting or ordering relationship *)
let ne=segs.len();
let foundConflict=mut.false;let ci=mut.0;let cj=mut.0;
lp(let a=0;a<ne;a=a+1){lp(let b=a+1;b<ne;b=b+1){if(!foundConflict){let cmp=compareClocks(clks.get(a);clks.get(b));if(cmp=0){if(!(s.eq(acts.get(a);acts.get(b)))){foundConflict=true;ci=a;cj=b}}}}};
if(foundConflict){let a=ci;let b=cj;io.println(s.concat("CONFLICT on ";s.concat(msgs.get(a);":")));io.println(s.concat("  ";s.concat(devs.get(a);s.concat(": ";s.concat(acts.get(a);s.concat(" ";fmtClock(clks.get(a))))))));io.println(s.concat("  ";s.concat(devs.get(b);s.concat(": ";s.concat(acts.get(b);s.concat(" ";fmtClock(clks.get(b))))))));io.println("resolution: keep both (concurrent)");<0};
(* no conflict: report causal ordering of the first pair *)
let a=0;let b=1;let cmp=compareClocks(clks.get(a);clks.get(b));
io.println(s.concat("NO CONFLICT on ";s.concat(msgs.get(a);":")));
if(cmp=0-1){io.println(s.concat("  ";s.concat(devs.get(b);s.concat(" supersedes ";s.concat(devs.get(a);" (causally ordered)")))));io.println(s.concat("final state: ";acts.get(b)))}el{io.println(s.concat("  ";s.concat(devs.get(a);s.concat(" supersedes ";s.concat(devs.get(b);" (causally ordered)")))));io.println(s.concat("final state: ";acts.get(a)))};<0}
