m=chatpermissions;
i=io:std.io;
i=s:std.str;

f=getstr(json:$str;key:$str):$str{
    let pat=s.concat(s.concat("_""_"\"_""_""_"\"_");
    if(endp<0){<rest};
    <s.slice(rest;0;endp)
};

f=roleblock(roles:$str;role:$str):$str{
    let pat=s.concat(s.concat("_""_"\"_");
    let p=s.indexof(roles;pat);
    if(p<0){<"_"};
    let start=p+s.len(pat);
    let rest=s.slice(roles;start;s.len(roles));
    let endp=s.indexof(rest;"_");
    if(endp<0){<rest};
    <s.slice(rest;0;endp)
};

f=getinherits(roles:$str;role:$str):$str{
    let block=roleblock(roles;role);
    let p=s.indexof(block;"_"inherits\"_");
    if(p<0){<"_"};
    let rest=s.slice(block;p+11;s.len(block));
    if(s.startswith(rest;"_")){<"_"};
    if(s.startswith(rest;"_""_"\"_");
        if(e<0){<r2};
        <s.slice(r2;0;e)
    };
    <"_"
};

f=getperms(roles:$str;role:$str):$str{
    let block=roleblock(roles;role);
    let p=s.indexof(block;"_"perms\"_");
    if(p<0){<"_"};
    let rest=s.slice(block;p+9;s.len(block));
    let e=s.indexof(rest;"_");
    if(e<0){<rest};
    <s.slice(rest;0;e)
};

f=permhas(perms:$str;action:$str):$bool{
    <s.contains(perms;s.concat(s.concat("_""_"\"_"))
};

f=main():$i64{
    let roles=io.readln();
    let userroles=io.readln();
    let checks=io.readln();

    let cursor=mut.checks;
    lp(true){
        let up=s.indexof(cursor;"_"user\"_""_"\"_");
        let user=s.slice(r1;0;ue);
        let r2=s.slice(r1;ue;s.len(r1));
        let ap=s.indexof(r2;"_"action\"_""_"\"_");
        let action=s.slice(r3;0;ae);

        let role=getstr(userroles;user);
        let line=mut.user;
        line=s.concat(line;"_");
        line=s.concat(line;action);
        if(s.len(role)=0){
            line=s.concat(line;"_")
        }el{
            let allowed=mut.false;
            let src=mut."_";
            let cur=mut.role;
            lp(s.len(cur)>0){
                let perms=getperms(roles;cur);
                if(permhas(perms;action)){allowed=true;src=action;cur="_"}el{
                if(permhas(perms;"_")){allowed=true;src="_";cur="_"}el{
                    cur=getinherits(roles;cur)
                }}
            };
            if(allowed){
                line=s.concat(line;"_");
                line=s.concat(line;role);
                line=s.concat(line;"_");
                line=s.concat(line;src);
                line=s.concat(line;"_")
            }el{
                line=s.concat(line;"_");
                line=s.concat(line;role);
                line=s.concat(line;"_")
            }
        };
        io.println(line);

        let nextp=s.indexof(r3;"_");
        if(nextp<0){br};
        cursor=s.slice(r3;nextp+1;s.len(r3))
    };
    <0
};
