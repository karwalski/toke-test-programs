m=attach;i=io:std.io;i=s:std.str;i=enc:std.encoding;i=cr:std.crypto;
f=xorb(p:@$i64;k:@$i64):@$i64{let r=mut.@();let kl=k.len();lp(let i=0;i<p.len();i=i+1){let kb=k.get(i-i/kl*kl);r=r+@(p.get(i)^kb)};<r};
f=main():$i64{
let filename=s.trim(io.readln());
let size=s.trim(io.readln());
let mime=s.trim(io.readln());
let chash=s.trim(io.readln());
let keyhex=s.trim(io.readln());
let key=enc.hexdecode(keyhex);
let plain=s.concat("{\"filename\":\"";s.concat(filename;s.concat("\",\"mime\":\"";s.concat(mime;"\"}"))));
let pb=s.bytes(plain);
let ct=xorb(pb;key);
let encb64=enc.b64encode(ct);
let khash=enc.hexencode(cr.sha256(key));
let out=s.concat("{\"content_hash\":\"";s.concat(chash;s.concat("\",\"encrypted_metadata\":\"";s.concat(encb64;s.concat("\",\"key_hash\":\"";s.concat(khash;s.concat("\",\"size\":";s.concat(size;"}"))))))));
io.println(out);
<0}
