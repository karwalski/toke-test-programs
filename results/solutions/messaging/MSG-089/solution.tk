m=reneg;i=io:std.io;i=s:std.str;
f=main():$i64{
  let lines=mut.@();
  lp(1=1){
    let line=io.readln();
    if(io.eof()){br};
    lines=lines+@(s.trim(line));
  };
  let pending=s.toint(lines.get(3));
  io.println("RENEGOTIATION:");
  io.println(s.concat(s.concat("1. Suspend message delivery (";s.fromint(pending));" pending)"));
  io.println("2. Generate new ephemeral key");
  io.println("3. Send renegotiation request");
  io.println("4. Await acknowledgement");
  io.println("5. Derive new session key");
  if(pending=0){
    io.println("6. No pending messages to re-encrypt");
  }el{
    io.println(s.concat(s.concat("6. Re-encrypt ";s.fromint(pending));" pending messages"));
  };
  io.println("7. Resume delivery");
  io.println("new_session: {key_hex, established_at}");
  <0;
};
