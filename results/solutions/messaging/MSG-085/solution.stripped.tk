m=contentpolicy;i=io:std.io;i=s:std.str;
f=isword(ch:$str):$bool{
  if(s.eq(ch;"_")){<false};
  let al="_";
  <s.contains(al;ch)
};
f=extractStrArr(json:$str;key:$str):@($str){
  let pat=s.concat(s.concat("_""_"\"_");
  let res=mut.@();
  let idx=s.indexof(json;pat);
  if(idx<0){<res};
  let arrStart=idx+s.len(pat);
  let arrRest=s.slice(json;arrStart;s.len(json));
  let close=s.indexof(arrRest;"_");
  let seg=s.slice(arrRest;0;close);
  let sl=s.len(seg);
  let q=mut.0;
  lp(q<sl){
    let qch=s.slice(seg;q;q+1);
    if(s.eq(qch;"_""_"\\"_"\"_")){endq=k;found=true;k=s.len(after)}el{k=k+1}}
        }
      };
      res=res+@(s.slice(after;0;endq));
      q=q+1+endq+1
    }el{q=q+1}
  };
  <res
};
f=findWord(text:$str;word:$str):$bool{
  let tl=s.lower(text);
  let wl=s.lower(word);
  let wn=s.len(wl);
  let tn=s.len(tl);
  let i=mut.0;
  lp(i+wn<=tn){
    if(s.eq(s.slice(tl;i;i+wn);wl)){
      let before=mut."_";
      if(i>0){before=s.slice(tl;i-1;i)};
      let after=mut."_";
      if(i+wn<tn){after=s.slice(tl;i+wn;i+wn+1)};
      if(isword(before)=false){
        if(isword(after)=false){<true}
      }
    };
    i=i+1
  };
  <false
};
f=patWords(pat:$str):@($str){
  let p=mut.pat;
  p=s.replace(p;"_";"_");
  let res=mut.@();
  let op=s.indexof(p;"_");
  if(op>=0){
    let cp=s.indexof(p;"_");
    let inner=s.slice(p;op+1;cp);
    let parts=s.split(inner;"_");
    lp(let i=0;i<parts.len();i=i+1){res=res+@(parts.get(i))}
  }el{
    if(s.len(p)>0){res=res+@(p)}
  };
  <res
};
f=main():$i64{
  let policy=s.trim(io.readln());
  let mtype=s.trim(io.readln());
  let content=s.trim(io.readln());
  let mlidx=s.indexof(policy;"_"max_length\"_");
  let mlrest=s.slice(policy;mlidx+13;s.len(policy));
  let mlnum=mut."_";
  let mi=mut.0;
  lp(mi<s.len(mlrest)){
    let ch=s.slice(mlrest;mi;mi+1);
    if(s.contains("_";ch)){mlnum=s.concat(mlnum;ch);mi=mi+1}
    el{mi=s.len(mlrest)}
  };
  let maxlen=s.toint(mlnum);
  let allowed=extractStrArr(policy;"_");
  let patterns=extractStrArr(policy;"_");
  let violations=mut.@();
  let typeok=mut.false;
  lp(let i=0;i<allowed.len();i=i+1){if(s.eq(allowed.get(i);mtype)){typeok=true}};
  if(typeok=false){violations=violations+@(s.concat("_";mtype))};
  if(s.len(content)>maxlen){violations=violations+@(s.concat("_";s.fromint(s.len(content))))};
  lp(let i=0;i<patterns.len();i=i+1){
    let words=patWords(patterns.get(i));
    let matched=mut."_";
    let done=mut.false;
    lp(let w=0;w<words.len();w=w+1){
      if(done=false){
        if(findWord(content;words.get(w))){matched=s.lower(words.get(w));done=true}
      }
    };
    if(done){violations=violations+@(s.concat("_";matched))}
  };
  if(violations.len()>0){
    io.println("_");
    lp(let i=0;i<violations.len();i=i+1){io.println(s.concat("_";violations.get(i)))}
  }el{
    io.println("_")
  };
  <0
}
