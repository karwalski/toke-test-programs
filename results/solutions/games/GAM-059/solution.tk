m=magic;i=io:std.io;i=s:std.str;f=main():$i64{let rows=mut.@();lp(1=1){let line=io.readln();if(s.len(line)=0){br};let t=s.trim(line);if(s.len(t)=0){br};let parts=s.split(t;" ");let row=mut.@();let j=mut.0;lp(j<parts.len()){let cell=s.trim(parts.get(j));if(s.len(cell)>0){row=row+@(s.toint(cell))};j=j+1};rows=rows+@(row)};let n=rows.len();let r0=rows.get(0);let target=mut.0;let c=mut.0;lp(c<r0.len()){target=target+r0.get(c);c=c+1};let magic=mut.1;let i=mut.0;lp(i<n){let row=rows.get(i);let sum=mut.0;let k=mut.0;lp(k<row.len()){sum=sum+row.get(k);k=k+1};if(sum!=target){magic=0};i=i+1};let cj=mut.0;lp(cj<n){let csum=mut.0;let ci=mut.0;lp(ci<n){let rr=rows.get(ci);csum=csum+rr.get(cj);ci=ci+1};if(csum!=target){magic=0};cj=cj+1};let d1=mut.0;let d2=mut.0;let di=mut.0;lp(di<n){let rr=rows.get(di);d1=d1+rr.get(di);d2=d2+rr.get(n-1-di);di=di+1};if(d1!=target){magic=0};if(d2!=target){magic=0};if(magic=1){io.println(s.concat("Magic square with sum ";s.fromint(target)))}el{io.println("Not a magic square")};<0}
