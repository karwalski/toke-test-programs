m=ecosys;i=io:std.io;i=s:std.str;i=math:std.math;
f=main():$i64{let line=s.trim(io.readln());let p=s.split(line;" ");
let x=mut.s.tofloat(p.get(0));let y=mut.s.tofloat(p.get(1));
let alpha=s.tofloat(p.get(2));let beta=s.tofloat(p.get(3));let gamma=s.tofloat(p.get(4));let delta=s.tofloat(p.get(5));let steps=s.toint(p.get(6));
io.println(s.concat(s.concat(s.concat("0 ";s.fromint(math.round(x) as $i64));" ");s.fromint(math.round(y) as $i64)));
lp(let i=1;i<=steps;i=i+1){let nx=x+(alpha*x-beta*x*y);let ny=y+(delta*x*y-gamma*y);x=nx;y=ny;
io.println(s.concat(s.concat(s.concat(s.concat(s.fromint(i);" ");s.fromint(math.round(x) as $i64));" ");s.fromint(math.round(y) as $i64)))};
<0}
