m=lightsout;
i=io:std.io;
i=s:std.str;
i=vec:std.vec;

f=main():i64{
  let lines=mut.@("");
  let done=mut.0;
  lp(done<1){
    let line=io.readln();
    if(io.eof()){done=1;br};
    if(s.len(line)=0){done=1;br};
    lines=lines.push(line)
  };
  let rows=(lines.len as i64)-1;
  if(rows<1){io.println("Unsolvable");<0};
  let cols=s.len(lines.get(1)) as i64;

  (* original grid flat, 1=on/0=off *)
  let orig=mut.vec.new();
  lp(let r=1;r<=rows;r=r+1){
    let b=s.bytes(lines.get(r));
    lp(let c=0;c<cols;c=c+1){
      orig=vec.push(orig;(b.get(c) as i64)-48)
    }
  };

  (* brute force first-row press masks; pick min presses *)
  let bestcount=mut.-1;
  let bestpress=mut.vec.new();   (* flat press grid of best solution *)
  lp(let i=0;i<rows*cols;i=i+1){bestpress=vec.push(bestpress;0)};

  let masks=1;
  let limit=mut.1;
  lp(let i=0;i<cols;i=i+1){limit=limit*2};

  lp(let mask=0;mask<limit;mask=mask+1){
    (* working grid copy *)
    let g=mut.vec.new();
    lp(let i=0;i<rows*cols;i=i+1){g=vec.push(g;vec.get(orig;i))};
    let press=mut.vec.new();
    lp(let i=0;i<rows*cols;i=i+1){press=vec.push(press;0)};

    (* apply first-row presses from mask *)
    lp(let c=0;c<cols;c=c+1){
      let bit=(mask/pw2(c))%2;
      if(bit=1){
        press=vec.set(press;c;1);
        g=toggle(g;rows;cols;0;c)
      }
    };

    (* chase down *)
    lp(let r=1;r<rows;r=r+1){
      lp(let c=0;c<cols;c=c+1){
        if(vec.get(g;(r-1)*cols+c)=1){
          press=vec.set(press;r*cols+c;1);
          g=toggle(g;rows;cols;r;c)
        }
      }
    };

    (* check bottom row all off *)
    let ok=mut.1;
    lp(let c=0;c<cols;c=c+1){
      if(vec.get(g;(rows-1)*cols+c)=1){ok=0}
    };

    if(ok=1){
      let cnt=mut.0;
      lp(let i=0;i<rows*cols;i=i+1){cnt=cnt+vec.get(press;i)};
      if(bestcount<0){
        bestcount=cnt;
        lp(let i=0;i<rows*cols;i=i+1){bestpress=vec.set(bestpress;i;vec.get(press;i))}
      }el{
        if(cnt<bestcount){
          bestcount=cnt;
          lp(let i=0;i<rows*cols;i=i+1){bestpress=vec.set(bestpress;i;vec.get(press;i))}
        }
      }
    }
  };

  if(bestcount<0){
    io.println("Unsolvable")
  }el{
    lp(let r=0;r<rows;r=r+1){
      lp(let c=0;c<cols;c=c+1){
        if(vec.get(bestpress;r*cols+c)=1){
          io.println(s.concat(s.concat(s.fromint(r);" ");s.fromint(c)))
        }
      }
    }
  };
  <0
};

(* 2^n *)
f=pw2(n:$i64):$i64{
  let r=mut.1;
  lp(let i=0;i<n;i=i+1){r=r*2};
  <r
};

(* toggle cell (r,c) and its 4 orthogonal neighbours *)
f=toggle(g:$vec;rows:$i64;cols:$i64;r:$i64;c:$i64):$vec{
  let res=mut.g;
  res=vec.set(res;r*cols+c;1-vec.get(res;r*cols+c));
  if(r>0){ let i=(r-1)*cols+c; res=vec.set(res;i;1-vec.get(res;i)) };
  if(r<rows-1){ let i=(r+1)*cols+c; res=vec.set(res;i;1-vec.get(res;i)) };
  if(c>0){ let i=r*cols+(c-1); res=vec.set(res;i;1-vec.get(res;i)) };
  if(c<cols-1){ let i=r*cols+(c+1); res=vec.set(res;i;1-vec.get(res;i)) };
  <res
}
