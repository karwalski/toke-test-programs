m=cardgame;
i=io:std.io;
i=s:std.str;
f=main():$i64{
  let sizeline=io.readln();
  let cardline=io.readln();
  let cards=s.split(cardline;" ");
  let score=mut.0;
  let nomatch=mut.0;
  lp(let i=0;i<100000;i=i+1){
    let line=io.readln();
    if(s.len(line)=0){br};
    let parts=s.split(line;" ");
    let a=mt s.toint(parts.get(0)){ $ok:v v; $err:e 0 };
    let b=mt s.toint(parts.get(1)){ $ok:v v; $err:e 0 };
    let ca=cards.get(a as u64);
    let cb=cards.get(b as u64);
    if(s.eq(ca;cb)){
      score=score+1;
    }el{
      nomatch=nomatch+1;
    };
  };
  let out=mut."Score: ";
  out=s.concat(out;s.fromint(score));
  out=s.concat(out;"\nRemaining: ");
  out=s.concat(out;s.fromint(nomatch));
  out=s.concat(out;"\n");
  io.print(out);
  <0
};
