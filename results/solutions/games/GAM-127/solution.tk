m=polynomial;i=io:std.io;i=s:std.str;i=math:std.math;f=evalp(coeffs:@$f64;x:$f64):$f64{let result=mut.0.0;lp(let i=0;i<coeffs.len;i=i+1){result=result*x+coeffs.get(i)};<result};f=evald(coeffs:@$f64;x:$f64):$f64{let n=coeffs.len;if(n<=1){<0.0};let deg=n-1;let dc=mut.@($f64);lp(let i=0;i<n-1;i=i+1){dc=dc+@(coeffs.get(i)*((deg-i)as$f64))};<evalp(dc;x)};f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let coeffs=mut.@($f64);lp(let q=0;q<parts.len;q=q+1){let tok=s.trim(parts.get(q));if(s.len(tok)>0){coeffs=coeffs+@(s.tofloat(tok))}};let roots=mut.@($f64);let nroots=mut.0;let total=41+81;lp(let si=0;si<total;si=si+1){let start=mut.0.0;if(si<41){start=(si-20)as$f64}el{start=((si-41)-40)as$f64*0.5};let x=mut.start;let found=mut.false;let valid=mut.true;lp(let it=0;it<100;it=it+1){let fx=evalp(coeffs;x);if(math.abs(fx)<0.0000000001){found=true;it=100}el{let fpx=evald(coeffs;x);if(math.abs(fpx)<0.0000000001){valid=false;it=100}el{let xnew=x-fx/fpx;if(math.abs(xnew-x)<0.0000000001){x=xnew;found=true;it=100}el{x=xnew}}}};if(found){if(valid){if(math.abs(evalp(coeffs;x))<0.00000001){let rx=(math.floor(x*1000000.0+0.5))as$f64/1000000.0;let dup=mut.false;lp(let r=0;r<nroots;r=r+1){if(math.abs(rx-roots.get(r))<0.0000005){dup=true}};if(dup=false){roots=roots+@(rx);nroots=nroots+1}}}}};lp(let a=0;a<nroots-1;a=a+1){lp(let b=0;b<nroots-1-a;b=b+1){if(roots.get(b)>roots.get(b+1)){let tv=roots.get(b);roots=roots.set(b;roots.get(b+1));roots=roots.set(b+1;tv)}}};if(nroots=0){io.println("No real roots")}el{lp(let r=0;r<nroots;r=r+1){io.println(s.format(roots.get(r);"%.4f"))}};<0}
