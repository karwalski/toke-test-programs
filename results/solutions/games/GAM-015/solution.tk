m=wordle;i=io:std.io;i=s:std.str;
f=ch(v:$str;i:$i64):$str{<s.substr(v;i;i+1)};
f=feedback(target:$str;guess:$str):$str{let n=s.len(target);
let res=mut.@($str);let avail=mut.@($str);
lp(let i=0;i<n;i=i+1){res=res+@("B");avail=avail+@(ch(target;i))};
lp(let i=0;i<n;i=i+1){let tc=ch(target;i);let gc=ch(guess;i);if(s.equals(tc;gc)){res=res.set(i;"G");avail=avail.set(i;"")}};
lp(let i=0;i<n;i=i+1){if(s.equals(res.get(i);"B")){let gc=ch(guess;i);let done=mut.false;lp(let j=0;j<n;j=j+1){if(!(done)){if(s.equals(avail.get(j);gc)){res=res.set(i;"Y");avail=avail.set(j;"");done=true}}}}};
let out=mut."";lp(let i=0;i<n;i=i+1){out=s.concat(out;res.get(i))};<out};
f=main():$i64{let target=s.trim(io.readln());let guess=s.trim(io.readln());io.println(feedback(target;guess));<0}
