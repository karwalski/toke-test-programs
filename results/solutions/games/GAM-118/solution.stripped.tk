m=numbrix;i=io:std.io;i=s:std.str;
f=padleft(str:$str;width:$i64):$str{
  let out=mut.str;
  lp(s.len(out)<width){out=s.concat("_";out)};
  <out
};
f=posOfVal(grid:@($i64);total:$i64;val:$i64):$i64{
  lp(let i=0;i<total;i=i+1){if(grid.get(i)=val){<i}};
  <0-1
};
f=hasAnchor(grid:@($i64);total:$i64;val:$i64):$bool{
  lp(let i=0;i<total;i=i+1){if(grid.get(i)=val){<true}};
  <false
};
f=backtrack(grid:@($i64);num:$i64;r:$i64;c:$i64;n:$i64;total:$i64):@($i64){
  if(num=total){<grid};
  let nxt=num+1;
  if(hasAnchor(grid;total;nxt)){
    let tp=posOfVal(grid;total;nxt);
    let tr=tp/n;
    let tc=tp-tr*n;
    let dr=mut.tr-r;
    if(dr<0){dr=0-dr};
    let dc=mut.tc-c;
    if(dc<0){dc=0-dc};
    if(dr+dc=1){
      let res=backtrack(grid;nxt;tr;tc;n;total);
      if(res.len()>0){<res}
    };
    <@()
  }el{
    let drs=@(0-1;1;0;0);
    let dcs=@(0;0;0-1;1);
    lp(let d=0;d<4;d=d+1){
      let nr=r+drs.get(d);
      let nc=c+dcs.get(d);
      if(nr>=0){if(nr<n){if(nc>=0){if(nc<n){
        let idx=nr*n+nc;
        if(grid.get(idx)=0){
          let g2=grid.set(idx;nxt);
          let res=backtrack(g2;nxt;nr;nc;n;total);
          if(res.len()>0){<res}
        }
      }}}}
    };
    <@()
  }
};
f=main():$i64{
  let first=s.trim(io.readln());
  let fp=s.split(first;"_");
  let n=fp.len();
  let grid=mut.@();
  lp(let c=0;c<n;c=c+1){grid=grid+@(s.toint(fp.get(c)))};
  lp(let r=1;r<n;r=r+1){
    let line=s.trim(io.readln());
    let parts=s.split(line;"_");
    lp(let c=0;c<n;c=c+1){grid=grid+@(s.toint(parts.get(c)))}
  };
  let total=n*n;
  let sol=mut.grid;
  if(hasAnchor(grid;total;1)){
    let p=posOfVal(grid;total;1);
    let r=p/n;
    let c=p-r*n;
    let res=backtrack(grid;1;r;c;n;total);
    if(res.len()>0){sol=res}
  }el{
    let found=mut.false;
    lp(let i=0;i<total;i=i+1){
      if(found=false){
        if(grid.get(i)=0){
          let g2=grid.set(i;1);
          let r=i/n;
          let c=i-r*n;
          let res=backtrack(g2;1;r;c;n;total);
          if(res.len()>0){sol=res;found=true}
        }
      }
    }
  };
  let w=s.len(s.fromint(total));
  lp(let r=0;r<n;r=r+1){
    let row=mut."_";
    lp(let c=0;c<n;c=c+1){
      if(c>0){row=s.concat(row;"_")};
      row=s.concat(row;padleft(s.fromint(sol.get(r*n+c));w))
    };
    io.println(row)
  };
  <0
}
