m=stockgame;
i=io:std.io;
i=s:std.str;
f=toi(x:$str):$i64{ let r=mt s.toint(x){ $ok:v v; $err:e 0 }; <r };
f=main():$i64{
  let priceline=io.readln();
  if(s.len(priceline)=0){ <0 };
  let parts=s.split(s.trim(priceline);" ");
  let cashline=io.readln();
  let cash=mut.toi(s.trim(cashline));
  let shares=mut.0;
  let day=mut.0;
  lp(let i=0;i<100000;i=i+1){
    if((day as i64)>=(parts.len as i64)){ br };
    let cmd=io.readln();
    if(s.len(cmd)=0){ br };
    let p=toi(s.trim(parts.get(day as u64)));
    let tc=s.trim(cmd);
    let toks=s.split(tc;" ");
    let op=s.trim(toks.get(0));
    if(s.eq(op;"buy")){
      let n=toi(s.trim(toks.get(1)));
      let cost=n*p;
      if(cost<=cash){ cash=cash-cost; shares=shares+n };
    };
    if(s.eq(op;"sell")){
      let n=toi(s.trim(toks.get(1)));
      if(n<=shares){ cash=cash+n*p; shares=shares-n };
    };
    let val=cash+shares*p;
    let dn=s.fromint((day as i64)+1);
    io.println(s.concat(s.concat(s.concat("Day ";dn);": $");s.concat(s.fromint(val);".00")));
    day=day+1;
  };
  <0
};
