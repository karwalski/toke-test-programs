m=snakesladders;
i=io:std.io;
i=s:std.str;
f=geti(arr:@$i64;idx:$i64):$i64{
  <arr.get(idx as u64)
};
f=lookup(froms:@$i64;tos:@$i64;pos:$i64):$i64{
  let n=froms.len as i64;
  let res=mut.0;
  let hit=mut.false;
  lp(let i=0;i<n;i=i+1){
    let f=geti(froms;i);
    if(f==pos){
      if(!(hit)){
        res=geti(tos;i);
        hit=true;
      };
    };
  };
  if(hit){<res};
  <0-1
};
f=main():$i64{
  let froms=mut.@();
  let tos=mut.@();
  lp(let i=0;i<100000;i=i+1){
    let line=io.readln();
    if(s.len(line)==0){br};
    let parts=s.split(line;":");
    let a=mt s.toint(parts.get(0)){ $ok:v v; $err:e 0 };
    let b=mt s.toint(parts.get(1)){ $ok:v v; $err:e 0 };
    froms=froms+@(a);
    tos=tos+@(b);
  };
  let rollline=io.readln();
  let rolls=s.split(rollline;" ");
  let nr=rolls.len as i64;
  let pos=mut.0;
  let out=mut."";
  let done=mut.false;
  lp(let r=0;r<nr;r=r+1){
    if(!(done)){
      let tok=rolls.get(r as u64);
      let roll=mt s.toint(tok){ $ok:v v; $err:e 0 };
      let cur=mut.(pos);
      let stop=mut.false;
      lp(let step=1;step<roll+1;step=step+1){
        if(!(stop)){
          let cand=pos+step;
          if(cand>100){
            cur=pos;
            stop=true;
          }el{
            let dest=lookup(froms;tos;cand);
            if(dest==0-1){
              cur=cand;
            }el{
              cur=dest;
              stop=true;
            };
          };
        };
      };
      pos=cur;
      out=s.concat(out;s.fromint(pos));
      out=s.concat(out;"\n");
      if(pos==100){done=true};
    };
  };
  io.print(out);
  <0
};
