m=countdown;
i=io:std.io;
i=str:std.str;
f=c2(a:$str;b:$str):$str{ <str.concat(a;b) };
f=c3(a:$str;b:$str;cc:$str):$str{ <str.concat(str.concat(a;b);cc) };
f=wrap(e:$str;p:$i64):$str{
  if(p>=2){<e};
  <c3("(";e;")")
};
f=search(vals:@$i64;exprs:@$str;precs:@$i64;target:$i64):$str{
  let n=vals.len as i64;
  lp(let i=0;i<n;i=i+1){
    if(vals.get(i)==target){ <exprs.get(i) };
  };
  lp(let i=0;i<n;i=i+1){
    lp(let j=i+1;j<n;j=j+1){
      let av=vals.get(i); let bv=vals.get(j);
      let ae=exprs.get(i); let be=exprs.get(j);
      let ap=precs.get(i); let bp=precs.get(j);
      let ax=wrap(ae;ap); let bx=wrap(be;bp);
      lp(let op=0;op<6;op=op+1){
        let valid=mut.false;
        let nv=mut.0;
        let ne=mut."";
        let np=mut.1;
        if(op==0){ valid=true; nv=av+bv; ne=c3(ae;" + ";be); np=1; };
        if(op==1){ valid=true; nv=av-bv; ne=c3(ae;" - ";be); np=1; };
        if(op==2){ valid=true; nv=bv-av; ne=c3(be;" - ";ae); np=1; };
        if(op==3){ valid=true; nv=av*bv; ne=c3(ax;" * ";bx); np=2; };
        if(op==4){ if(!(av==0)){ if(bv-bv/av*av==0){ valid=true; nv=bv/av; ne=c3(bx;" / ";ax); np=2; } } };
        if(op==5){ if(!(bv==0)){ if(av-av/bv*bv==0){ valid=true; nv=av/bv; ne=c3(ax;" / ";bx); np=2; } } };
        if(valid){
          if(nv==target){ <ne };
          let rv=mut.@(nv);
          let re=mut.@(ne);
          let rp=mut.@(np);
          lp(let k=0;k<n;k=k+1){
            if(!(k==i)){ if(!(k==j)){
              rv=rv+@(vals.get(k));
              re=re+@(exprs.get(k));
              rp=rp+@(precs.get(k));
            } };
          };
          let sub=search(rv;re;rp;target);
          if(!(str.eq(sub;""))){ <sub };
        };
      };
    };
  };
  <""
};
f=main():i64{
  let tline=io.readln();
  let target=mt str.toint(str.trim(tline)){ $ok:v v; $err:e 0 };
  let nline=io.readln();
  let parts=str.split(str.trim(nline);" ");
  let pn=parts.len as i64;
  let vals=mut.@();
  let exprs=mut.@();
  let precs=mut.@();
  lp(let i=0;i<pn;i=i+1){
    let p=parts.get(i);
    if(!(str.len(p)==0)){
      let v=mt str.toint(p){ $ok:x x; $err:e 0 };
      vals=vals+@(v);
      exprs=exprs+@(p);
      precs=precs+@(3);
    };
  };
  let res=search(vals;exprs;precs;target);
  if(str.eq(res;"")){
    io.println("No solution");
  }el{
    io.println(c3(res;" = ";str.fromint(target)));
  };
  <0
};
