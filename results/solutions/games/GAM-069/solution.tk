m=kalah;
i=io:std.io;
i=s:std.str;
f=toi(x:$str):$i64{ let r=mt s.toint(x){ $ok:v v; $err:e 0 }; <r };
f=arrset(a:@$i64;idx:$i64;v:$i64):@$i64{
  let out=mut.@();
  lp(let i=0;i<(a.len as i64);i=i+1){
    if(i==idx){ out=out+@(v) } el{ out=out+@(a.get(i as u64)) };
  };
  <out
};
f=joinints(a:@$i64;lo:$i64;hi:$i64):$str{
  let out=mut."";
  lp(let i=lo;i<hi;i=i+1){
    if(i>lo){ out=s.concat(out;" ") };
    out=s.concat(out;s.fromint(a.get(i as u64)));
  };
  <out
};
f=main():$i64{
  let l1=io.readln();
  if(s.len(l1)==0){ <0 };
  let l2=io.readln();
  let l3=io.readln();
  let l4=io.readln();
  let p1=s.split(s.trim(l1);" ");
  let p2=s.split(s.trim(l2);" ");
  let st=s.split(s.trim(l3);" ");
  let player=toi(s.trim(l4));
  let s1=toi(s.trim(st.get(0)));
  let s2=toi(s.trim(st.get(1)));
  let board=mut.@();
  lp(let i=0;i<6;i=i+1){ board=board+@(toi(s.trim(p1.get(i as u64)))) };
  board=board+@(s1);
  lp(let i=0;i<6;i=i+1){ board=board+@(toi(s.trim(p2.get(i as u64)))) };
  board=board+@(s2);
  let movenum=mut.0;
  lp(let pit=0;pit<6;pit=pit+1){
    let boardidx=mut.0;
    if(player==1){ boardidx=pit } el{ boardidx=pit+7 };
    let seeds=board.get(boardidx as u64);
    if(seeds>0){
      let nb=mut.arrset(board;boardidx;0);
      let pos=mut.boardidx;
      lp(let k=0;k<seeds;k=k+1){
        pos=pos+1;
        if(pos>13){ pos=0 };
        if(player==1){ if(pos==13){ pos=0 } } el{ if(pos==6){ pos=7 } };
        nb=arrset(nb;pos;nb.get(pos as u64)+1);
      };
      movenum=movenum+1;
      let line=mut.s.concat("Move ";s.fromint(pit+1));
      line=s.concat(line;": ");
      line=s.concat(line;joinints(nb;0;6));
      line=s.concat(line;" | ");
      line=s.concat(line;joinints(nb;7;13));
      line=s.concat(line;" | ");
      line=s.concat(line;s.fromint(nb.get(6 as u64)));
      line=s.concat(line;" ");
      line=s.concat(line;s.fromint(nb.get(13 as u64)));
      io.println(line);
    };
  };
  <0
};
