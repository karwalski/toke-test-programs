m=sudoku;i=io:std.io;i=s:std.str;f=groupok(g:@($i64);idxs:@($i64)):$i64{let mask=mut.0;let i=mut.0;lp(i<idxs.len()){let v=g.get(idxs.get(i));if(v<1||v>9){<0};let bit=1;let sh=mut.0;let b=mut.1;lp(sh<v-1){b=b*2;sh=sh+1};if(mask/b-(mask/b/2)*2==1){<0};mask=mask+b;i=i+1};if(mask==511){<1};<0};f=main():$i64{let g=mut.@($i64);let r=mut.0;lp(r<9){let line=s.trim(io.readln());let c=mut.0;lp(c<9){let ch=s.slice(line;c;c+1);g=g+@(s.charcode(ch;0)-48);c=c+1};r=r+1};let valid=mut.1;let row=mut.0;lp(row<9){let idxs=mut.@($i64);let c=mut.0;lp(c<9){idxs=idxs+@(row*9+c);c=c+1};if(groupok(g;idxs)==0){valid=0};row=row+1};let col=mut.0;lp(col<9){let idxs=mut.@($i64);let rr=mut.0;lp(rr<9){idxs=idxs+@(rr*9+col);rr=rr+1};if(groupok(g;idxs)==0){valid=0};col=col+1};let bx=mut.0;lp(bx<9){let bc=mut.0;lp(bc<9){let idxs=mut.@($i64);let dr=mut.0;lp(dr<3){let dc=mut.0;lp(dc<3){idxs=idxs+@((bx+dr)*9+(bc+dc));dc=dc+1};dr=dr+1};if(groupok(g;idxs)==0){valid=0};bc=bc+3};bx=bx+3};if(valid==1){io.println("Valid")}el{io.println("Invalid")};<0}
