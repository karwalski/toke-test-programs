m=chipstack;i=io:std.io;i=s:std.str;
f=main():$i64{
let first=io.readln();
let toks=s.split(s.trim(first);" ");
let nt=toks.len as $i64;
let denoms=mut.@();
let counts=mut.@();
lp(let i=0;i<nt;i=i+1){
let tk=s.trim(toks.get(i));
if(s.len(tk)>0){
let dc=s.split(tk;":");
denoms=denoms+@(s.toint(dc.get(0)));
counts=counts+@(s.toint(dc.get(1)));
};
};
let nd=denoms.len as $i64;
let total=mut.0;
lp(let i=0;i<nd;i=i+1){total=total+denoms.get(i)*counts.get(i)};
let done=mut.0;
lp(done<1){
let line=io.readln();
let t=s.trim(line);
if(s.len(t)=0){done=1}el{
let amt=s.toint(t);
if(amt>total){io.println("Cannot make amount")}el{
let rem=mut.amt;
let out=mut.s.concat(s.fromint(amt);":");
lp(let i=0;i<nd;i=i+1){
let d=denoms.get(i);
let use=rem/d;
if(use>0){
out=s.concat(out;s.concat(s.concat(s.concat(" ";s.fromint(use));"x");s.fromint(d)));
rem=rem-use*d;
};
};
if(rem!=0){io.println("Cannot make amount")}el{io.println(out)};
};
};
};
<0
};
