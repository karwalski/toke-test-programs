m=skyscraper;
i=io:std.io;
i=s:std.str;
i=vec:std.vec;

(* visible buildings scanning a column top->bottom for column c *)
f=visiblecol(g:$vec;n:$i64;c:$i64;rev:$i64):$i64{
  let mx=mut.0;
  let cnt=mut.0;
  lp(let k=0;k<n;k=k+1){
    let r=mut.k;
    if(rev==1){r=n-1-k};
    let h=vec.get(g;r*n+c);
    if(h>mx){mx=h;cnt=cnt+1}
  };
  <cnt
};

f=visiblerow(g:$vec;n:$i64;r:$i64;rev:$i64):$i64{
  let mx=mut.0;
  let cnt=mut.0;
  lp(let k=0;k<n;k=k+1){
    let c=mut.k;
    if(rev==1){c=n-1-k};
    let h=vec.get(g;r*n+c);
    if(h>mx){mx=h;cnt=cnt+1}
  };
  <cnt
};

(* recursive backtracking. returns solved grid vec on success, or empty vec on fail *)
f=bt(g:$vec;pos:$i64;n:$i64;top:$vec;bottom:$vec;left:$vec;right:$vec):$vec{
  if(pos>=n*n){<g};
  let r=pos/n;
  let c=pos-r*n;
  let res=mut.vec.new();
  let solved=mut.0;
  lp(let v=1;v<n+1;v=v+1){
    if(solved==0){
      (* check row uniqueness *)
      let ok=mut.1;
      lp(let cc=0;cc<c;cc=cc+1){
        if(vec.get(g;r*n+cc)==v){ok=0}
      };
      if(ok==1){
        lp(let rr=0;rr<r;rr=rr+1){
          if(vec.get(g;rr*n+c)==v){ok=0}
        }
      };
      if(ok==1){
        let g2=mut.vec.set(g;pos;v);
        (* if row complete, check left/right clues *)
        if(c==n-1){
          let lc=vec.get(left;r);
          let rc=vec.get(right;r);
          if(lc>0){if(visiblerow(g2;n;r;0)==lc){}el{ok=0}};
          if(rc>0){if(visiblerow(g2;n;r;1)==rc){}el{ok=0}}
        };
        (* if column complete (last row), check top/bottom clues *)
        if(r==n-1){
          if(ok==1){
            let tc=vec.get(top;c);
            let bc=vec.get(bottom;c);
            if(tc>0){if(visiblecol(g2;n;c;0)==tc){}el{ok=0}};
            if(bc>0){if(visiblecol(g2;n;c;1)==bc){}el{ok=0}}
          }
        };
        if(ok==1){
          let sub=bt(g2;pos+1;n;top;bottom;left;right);
          if(vec.len(sub)>0){res=sub;solved=1}
        }
      }
    }
  };
  if(solved==1){<res};
  <vec.new()
};

f=main():i64{
  let nline=io.readln();
  let n=s.toint(nline);

  (* read 4 clue lines: top bottom left right *)
  let topl=s.split(io.readln();" ");
  let botl=s.split(io.readln();" ");
  let leftl=s.split(io.readln();" ");
  let rightl=s.split(io.readln();" ");

  let top=mut.vec.new();
  let bottom=mut.vec.new();
  let left=mut.vec.new();
  let right=mut.vec.new();
  lp(let i=0;i<n;i=i+1){
    top=vec.push(top;s.toint(topl.get(i)));
    bottom=vec.push(bottom;s.toint(botl.get(i)));
    left=vec.push(left;s.toint(leftl.get(i)));
    right=vec.push(right;s.toint(rightl.get(i)))
  };

  let g=mut.vec.new();
  lp(let i=0;i<n*n;i=i+1){g=vec.push(g;0)};

  let sol=bt(g;0;n;top;bottom;left;right);

  if(vec.len(sol)>0){
    lp(let r=0;r<n;r=r+1){
      let line=mut."";
      lp(let c=0;c<n;c=c+1){
        if(c>0){line=s.concat(line;" ")};
        line=s.concat(line;s.fromint(vec.get(sol;r*n+c)))
      };
      io.println(line)
    }
  }el{
    io.println("No solution")
  };
  <0
}
