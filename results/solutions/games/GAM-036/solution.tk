m=scorecard;i=io:std.io;i=s:std.str;
f=main():$i64{let total=mut.0;let wickets=mut.0;let noballs=mut.0;let wides=mut.0;
let continuing=mut.true;
lp(continuing){let line=s.trim(io.readln());
if(s.len(line)==0){continuing=false}el{
if(line=="W"){wickets=wickets+1}el{
if(line=="nb"){noballs=noballs+1}el{
if(line=="wd"){wides=wides+1}el{
total=total+s.toint(line)}}}}};
io.println("\(total)/\(wickets)");
let extras=noballs+wides;
if(extras>0){io.println("Extras: \(extras) (\(noballs)nb \(wides)wd)")}el{io.println("Extras: 0")};
<0}
