m=hangman;
i=io:std.io;
i=s:std.str;
i=vec:std.vec;

(* 1 if byte b appears in string str *)
f=hasbyte(str:$str;b:$i64):$i64{
  let bs=s.bytes(str);
  let n=bs.len as i64;
  let r=mut.0;
  lp(let i=0;i<n;i=i+1){
    if((bs.get(i) as i64)=b){r=1}
  };
  <r
};

f=main():i64{
  let alpha="ABCDEFGHIJKLMNOPQRSTUVWXYZ";
  let maskraw=io.readln();
  let wrongraw=io.readln();
  let mask=s.upper(maskraw);
  let wrong=s.upper(wrongraw);

  let mb=s.bytes(mask);
  let masklen=mb.len as i64;

  (* known letters string (the non-underscore chars of mask) *)
  let known=mut."";
  lp(let i=0;i<masklen;i=i+1){
    let c=mb.get(i) as i64;
    if(c=95){}el{ known=s.concat(known;s.substr(mask;i;i+1)) }
  };

  (* wrong letters: split on space *)
  let wparts=s.split(wrong;" ");
  let wrongletters=mut."";
  lp(let i=0;i<wparts.len as i64;i=i+1){
    let p=wparts.get(i);
    if(s.len(p)=0){}el{ wrongletters=s.concat(wrongletters;p) }
  };

  (* read dictionary *)
  let words=mut.@("");
  let done=mut.0;
  lp(done<1){
    let line=io.readln();
    if(io.eof()){done=1;br};
    if(s.len(line)=0){}el{words=words.push(s.upper(line))}
  };
  let wc=(words.len as i64)-1;

  (* frequency for 26 letters A..Z *)
  let freq=mut.vec.new();
  lp(let i=0;i<26;i=i+1){ freq=vec.push(freq;0) };

  lp(let wi=1;wi<wc+1;wi=wi+1){
    let w=words.get(wi);
    let wb=s.bytes(w);
    let wl=wb.len as i64;
    (* candidate filter *)
    let ok=mut.1;
    if(wl=masklen){}el{ok=0};
    if(ok=1){
      (* known positions match *)
      lp(let i=0;i<masklen;i=i+1){
        let mc=mb.get(i) as i64;
        if(mc=95){}el{
          if((wb.get(i) as i64)=mc){}el{ok=0}
        }
      }
    };
    if(ok=1){
      (* contains no wrong letter *)
      lp(let i=0;i<wl;i=i+1){
        let c=wb.get(i) as i64;
        if(hasbyte(wrongletters;c)=1){ok=0}
      }
    };
    if(ok=1){
      (* accumulate frequency for letters not known *)
      lp(let i=0;i<wl;i=i+1){
        let c=wb.get(i) as i64;
        if(c>64){if(c<91){
          if(hasbyte(known;c)=1){}el{
            let idx=c-65;
            freq=vec.set(freq;idx;vec.get(freq;idx)+1)
          }
        }}
      }
    }
  };

  (* pick highest freq, tie -> alphabetical (lowest index) *)
  let bestidx=mut.-1;
  let bestcnt=mut.0;
  lp(let i=0;i<26;i=i+1){
    let f=vec.get(freq;i);
    if(f>bestcnt){bestcnt=f;bestidx=i}
  };

  if(bestidx>=0){
    io.println(s.substr(alpha;bestidx;bestidx+1))
  };
  <0
}
