m=aes256cbc;
i=io:std.io;
i=s:std.str;

f=bxor(a:$i64;b:$i64):$i64{
  let res=mut.0;
  let bit=mut.1;
  let x=mut.a;
  let y=mut.b;
  let k=mut.0;
  lp(k<8){
    let ba=x-(x/2)*2;
    let bb=y-(y/2)*2;
    let ob=ba+bb-(ba+bb)/2*2;
    res=res+ob*bit;
    bit=bit*2;
    x=x/2;
    y=y/2;
    k=k+1;
  };
  <res;
};

f=xtime(a:$i64):$i64{
  let shifted=(a*2)-((a*2)/256)*256;
  let h=a/128-(a/128/2)*2;
  if(h=1){<bxor(shifted;27)};
  <shifted;
};

f=hexval(c:$str):$i64{
  let tbl="_";
  let lc=s.lower(c);
  <s.indexof(tbl;lc);
};

f=hexdecode(hex:$str):@($i64){
  let out=mut.@();
  let i=mut.0;
  let n=s.len(hex);
  lp(i+1<n+1){
    if(i+2<=n){
      let hi=hexval(s.slice(hex;i;i+1));
      let lo=hexval(s.slice(hex;i+1;i+2));
      out=out+@(hi*16+lo);
    };
    i=i+2;
  };
  <out;
};

f=tohex(n:$i64):$str{
  let tbl="_";
  let hi=n/16;
  let lo=n-hi*16;
  <s.concat(s.slice(tbl;hi;hi+1);s.slice(tbl;lo;lo+1));
};

f=sboxat(idx:$i64):$i64{
  let sb=@(99;124;119;123;242;107;111;197;48;1;103;43;254;215;171;118;202;130;201;125;250;89;71;240;173;212;162;175;156;164;114;192;183;253;147;38;54;63;247;204;52;165;229;241;113;216;49;21;4;199;35;195;24;150;5;154;7;18;128;226;235;39;178;117;9;131;44;26;27;110;90;160;82;59;214;179;41;227;47;132;83;209;0;237;32;252;177;91;106;203;190;57;74;76;88;207;208;239;170;251;67;77;51;133;69;249;2;127;80;60;159;168;81;163;64;143;146;157;56;245;188;182;218;33;16;255;243;210;205;12;19;236;95;151;68;23;196;167;126;61;100;93;25;115;96;129;79;220;34;42;144;136;70;238;184;20;222;94;11;219;224;50;58;10;73;6;36;92;194;211;172;98;145;149;228;121;231;200;55;109;141;213;78;169;108;86;244;234;101;122;174;8;186;120;37;46;28;166;180;198;232;221;116;31;75;189;139;138;112;62;181;102;72;3;246;14;97;53;87;185;134;193;29;158;225;248;152;17;105;217;142;148;155;30;135;233;206;85;40;223;140;161;137;13;191;230;66;104;65;153;45;15;176;84;187;22);
  <sb.get(idx);
};

f=rconat(idx:$i64):$i64{
  let rc=@(0;1;2;4;8;16;32;64;128;27;54);
  <rc.get(idx);
};

f=keyexpand(key:@($i64)):@($i64){
  let w=mut.@();
  let i=mut.0;
  lp(i<32){w=w+@(key.get(i));i=i+1};
  let wi=mut.8;
  lp(wi<60){
    let t0=mut.w.get((wi-1)*4+0);
    let t1=mut.w.get((wi-1)*4+1);
    let t2=mut.w.get((wi-1)*4+2);
    let t3=mut.w.get((wi-1)*4+3);
    let mod=wi-(wi/8)*8;
    if(mod=0){
      let r0=t1;
      let r1=t2;
      let r2=t3;
      let r3=t0;
      t0=sboxat(r0);
      t1=sboxat(r1);
      t2=sboxat(r2);
      t3=sboxat(r3);
      t0=bxor(t0;rconat(wi/8));
    }el{
      if(mod=4){
        t0=sboxat(t0);
        t1=sboxat(t1);
        t2=sboxat(t2);
        t3=sboxat(t3);
      };
    };
    w=w+@(bxor(w.get((wi-8)*4+0);t0));
    w=w+@(bxor(w.get((wi-8)*4+1);t1));
    w=w+@(bxor(w.get((wi-8)*4+2);t2));
    w=w+@(bxor(w.get((wi-8)*4+3);t3));
    wi=wi+1;
  };
  <w;
};

f=encblock(block:@($i64);w:@($i64)):@($i64){
  let st=mut.@();
  let r=mut.0;
  lp(r<4){
    let c=mut.0;
    lp(c<4){st=st+@(block.get(c*4+r));c=c+1};
    r=r+1;
  };
  let rnd=mut.0;
  lp(rnd<15){
    if(rnd>0){
      if(rnd<14){
        let i=mut.0;
        lp(i<16){st=st.set(i;sboxat(st.get(i)));i=i+1};
        let nr=mut.1;
        lp(nr<4){
          let tmp=mut.@();
          let cc=mut.0;
          lp(cc<4){tmp=tmp+@(st.get(nr*4+((cc+nr)-((cc+nr)/4)*4)));cc=cc+1};
          let cc2=mut.0;
          lp(cc2<4){st=st.set(nr*4+cc2;tmp.get(cc2));cc2=cc2+1};
          nr=nr+1;
        };
        let col=mut.0;
        lp(col<4){
          let a0=st.get(0*4+col);
          let a1=st.get(1*4+col);
          let a2=st.get(2*4+col);
          let a3=st.get(3*4+col);
          let b0=xtime(a0);
          let b1=xtime(a1);
          let b2=xtime(a2);
          let b3=xtime(a3);
          st=st.set(0*4+col;bxor(bxor(b0;a1);bxor(b1;bxor(a2;a3))));
          st=st.set(1*4+col;bxor(bxor(a0;b1);bxor(a2;bxor(b2;a3))));
          st=st.set(2*4+col;bxor(bxor(a0;a1);bxor(b2;bxor(a3;b3))));
          st=st.set(3*4+col;bxor(bxor(a0;b0);bxor(a1;bxor(a2;b3))));
          col=col+1;
        };
      }el{
        let i=mut.0;
        lp(i<16){st=st.set(i;sboxat(st.get(i)));i=i+1};
        let nr=mut.1;
        lp(nr<4){
          let tmp=mut.@();
          let cc=mut.0;
          lp(cc<4){tmp=tmp+@(st.get(nr*4+((cc+nr)-((cc+nr)/4)*4)));cc=cc+1};
          let cc2=mut.0;
          lp(cc2<4){st=st.set(nr*4+cc2;tmp.get(cc2));cc2=cc2+1};
          nr=nr+1;
        };
      };
    };
    let rc=mut.0;
    lp(rc<4){
      let rr=mut.0;
      lp(rr<4){
        st=st.set(rr*4+rc;bxor(st.get(rr*4+rc);w.get((rnd*4+rc)*4+rr)));
        rr=rr+1;
      };
      rc=rc+1;
    };
    rnd=rnd+1;
  };
  let out=mut.@();
  let oc=mut.0;
  lp(oc<4){
    let or=mut.0;
    lp(or<4){out=out+@(st.get(or*4+oc));or=or+1};
    oc=oc+1;
  };
  <out;
};

f=main():$i64{
  let keyhex=s.trim(io.readln());
  let ivhex=s.trim(io.readln());
  let pt=mut.io.readln();
  let more=mut.io.readln();
  lp(s.len(more)>0){pt=s.concat(pt;s.concat("_";more));more=io.readln()};

  let key=hexdecode(keyhex);
  let iv=hexdecode(ivhex);
  let w=keyexpand(key);

  let ptbytes=mut.@();
  let pi=mut.0;
  lp(pi<s.len(pt)){ptbytes=ptbytes+@(s.charcode(s.slice(pt;pi;pi+1);0));pi=pi+1};

  let padlen=16-(ptbytes.len()-(ptbytes.len()/16)*16);
  let pad=mut.0;
  lp(pad<padlen){ptbytes=ptbytes+@(padlen);pad=pad+1};

  let prev=mut.@();
  let z=mut.0;
  lp(z<16){prev=prev+@(iv.get(z));z=z+1};

  let outhex=mut."_";
  let off=mut.0;
  lp(off<ptbytes.len()){
    let block=mut.@();
    let j=mut.0;
    lp(j<16){block=block+@(bxor(ptbytes.get(off+j);prev.get(j)));j=j+1};
    let enc=encblock(block;w);
    let e=mut.0;
    lp(e<16){outhex=s.concat(outhex;tohex(enc.get(e)));e=e+1};
    prev=@();
    let pp=mut.0;
    lp(pp<16){prev=prev+@(enc.get(pp));pp=pp+1};
    off=off+16;
  };
  io.println(outhex);
  <0;
}
