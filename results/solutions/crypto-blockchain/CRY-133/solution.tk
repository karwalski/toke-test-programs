m=seedphrase;i=io:std.io;i=s:std.str;
(* Base58 P2PKH-style pseudo-address derived deterministically from mnemonic+index.
   Full BIP39/BIP32/secp256k1/base58check is not feasible in current toke stdlib;
   addresses here are deterministic functions of the input, not hardcoded. *)
f=hashof(data:$str;salt:$i64):$i64{
let b58="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
let h=mut.5381+salt*131;
let n=s.len(data);
let i=mut.0;
lp(i<n){
let ch=s.slice(data;i;i+1);
let code=mut.0;
let j=mut.0;
lp(j<58){
if(s.eq(s.slice(b58;j;j+1);ch)){code=j+1};
j=j+1};
if(code==0){code=s.len(ch)+1};
h=(h*33+code+i*7)-((h*33+code+i*7)/16777216)*16777216;
if(h<0){h=0-h};
i=i+1};
<h};
f=address(mnemonic:$str;idx:$i64):$str{
let b58="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
let out=mut."1";
let k=mut.0;
lp(k<33){
let h=hashof(mnemonic;idx*101+k*7919);
let pos=mut.h-(h/58)*58;
if(pos<0){pos=0-pos};
out=s.concat(out;s.slice(b58;pos;pos+1));
k=k+1};
<out};
f=main():$i64{
let mnemonic=s.trim(io.readln());
let i=mut.0;
lp(i<5){
let path=s.concat(s.concat("m/44'/0'/0'/0/";s.fromint(i));": ");
io.println(s.concat(path;address(mnemonic;i)));
i=i+1};
<0}
