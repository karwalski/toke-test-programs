m=dsha;i=io:std.io;i=s:std.str;i=cr:std.crypto;f=hexval(ch:$str):$i64{let c=s.charcode(ch;0);if(c>=48&&c<=57){<c-48};if(c>=97&&c<=102){<c-87};if(c>=65&&c<=70){<c-55};<0};f=hexdecode(line:$str):$str{let buf=s.buf();let n=s.len(line);let idx=mut.0;lp(idx+1<n+1){if(idx+1<n){let v=hexval(s.slice(line;idx;idx+1))*16+hexval(s.slice(line;idx+1;idx+2));s.addbyte(buf;v);idx=idx+2}el{idx=n}};<s.done(buf)};f=main():$i64{let line=s.trim(io.readln());let raw=hexdecode(line);let h1=cr.sha256(s.bytes(raw));let h1hex=s.frombytes(h1);let raw2=hexdecode(h1hex);let h2=cr.sha256(s.bytes(raw2));io.println(s.frombytes(h2));<0}
