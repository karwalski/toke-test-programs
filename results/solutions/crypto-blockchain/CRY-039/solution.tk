m=entropy;
i=io:std.io;
i=s:std.str;
i=cr:std.crypto;
f=getbit(b:@byte;idx:$i64):$i64{
  let byteidx=idx/8;
  let bitidx=7-(idx-byteidx*8);
  let v=b.get(byteidx as u64) as i64;
  let shifted=v>>bitidx;
  <shifted&1
};
f=wordfor(idx:$i64):$str{
  <s.concat("w";s.fromint(idx))
};
f=main():$i64{
  let bits=s.toint(s.trim(io.readln()));
  let entbytes=bits/8;
  let ent=cr.randombytes(entbytes as u64);
  let hash=cr.sha256(ent);
  let csbits=bits/32;
  let totalbits=bits+csbits;
  let nwords=totalbits/11;
  let out=mut.s.buf();
  lp(let w=0;w<nwords;w=w+1){
    let val=mut.0;
    lp(let k=0;k<11;k=k+1){
      let globalbit=w*11+k;
      let bit=mut.0;
      if(globalbit<bits){
        bit=getbit(ent;globalbit)
      }el{
        bit=getbit(hash;globalbit-bits)
      };
      val=val*2+bit
    };
    if(w>0){s.add(out;" ")};
    s.add(out;wordfor(val))
  };
  io.println(s.done(out));
  <0
};
