m=vm;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let toks=s.split(line;" ");let n=toks.len();let stack=mut.@();let i=mut.0;lp(i<n){let op=toks.get(i);if(op=="PUSH"){i=i+1;let v=s.toint(toks.get(i));stack=stack+@(v)}el{if(op=="ADD"){let sl=stack.len();let b=stack.get(sl-1);let a=stack.get(sl-2);let ns=mut.@();let k=mut.0;lp(k<sl-2){ns=ns+@(stack.get(k));k=k+1};ns=ns+@(a+b);stack=ns}el{if(op=="SUB"){let sl=stack.len();let b=stack.get(sl-1);let a=stack.get(sl-2);let ns=mut.@();let k=mut.0;lp(k<sl-2){ns=ns+@(stack.get(k));k=k+1};ns=ns+@(a-b);stack=ns}el{if(op=="MUL"){let sl=stack.len();let b=stack.get(sl-1);let a=stack.get(sl-2);let ns=mut.@();let k=mut.0;lp(k<sl-2){ns=ns+@(stack.get(k));k=k+1};ns=ns+@(a*b);stack=ns}el{if(op=="DUP"){let sl=stack.len();stack=stack+@(stack.get(sl-1))}el{if(op=="SWAP"){let sl=stack.len();let b=stack.get(sl-1);let a=stack.get(sl-2);let ns=mut.@();let k=mut.0;lp(k<sl-2){ns=ns+@(stack.get(k));k=k+1};ns=ns+@(b);ns=ns+@(a);stack=ns}el{if(op=="POP"){let sl=stack.len();let ns=mut.@();let k=mut.0;lp(k<sl-1){ns=ns+@(stack.get(k));k=k+1};stack=ns}}}}}}};i=i+1};let out=mut."";let sl=stack.len();let j=mut.sl-1;lp(j>=0){if(s.len(out)>0){out=s.concat(out;" ")};out=s.concat(out;s.fromint(stack.get(j)));j=j-1};if(s.len(out)>0){io.println(out)};<0}
