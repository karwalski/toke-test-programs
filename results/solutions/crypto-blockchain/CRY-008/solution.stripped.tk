m=hexdecode;i=io:std.io;i=s:std.str;f=hexval(ch:$str):$i64{let c=s.charcode(ch;0);if(c>=48&&c<=57){<c-48};if(c>=97&&c<=102){<c-87};if(c>=65&&c<=70){<c-55};<0};f=main():$i64{let line=s.trim(io.readln());let n=s.len(line);let buf=s.buf();let idx=mut.0;lp(idx<n){let h1=s.slice(line;idx;idx+1);let h2=s.slice(line;idx+1;idx+2);let val=hexval(h1)*16+hexval(h2);s.addbyte(buf;val);idx=idx+2};io.println(s.done(buf));<0}
