m=patricia;i=io:std.io;i=s:std.str;
f=tohex(n:$i64):$str{
let digits="0123456789abcdef";
let v=mut.n;
if(v<0){v=0-v};
let out=mut."";
let i=mut.0;
lp(i<8){
let d=v-(v/16)*16;
out=s.concat(s.slice(digits;d;d+1);out);
v=v/16;
i=i+1};
<out};
f=main():$i64{
let keys=mut.@();
let vals=mut.@();
let count=mut.0;
let content=mut."";
lp(1=1){
let line=io.readln();
if(io.eof()){br};
let trimmed=s.trim(line);
if(s.len(trimmed)=0){br};
let parts=s.split(trimmed;" ");
let cmd=parts.get(0);
if(s.eq(cmd;"INSERT")){
let key=parts.get(1);
let val=parts.get(2);
keys=keys+@(key);
vals=vals+@(val);
content=s.concat(s.concat(content;key);val);
count=count+1
}el{
if(s.eq(cmd;"LOOKUP")){
let key=parts.get(1);
let found=mut."NOT_FOUND";
let fi=mut.0-1;
lp(let i=0;i<count;i=i+1){
if(s.eq(keys.get(i);key)){fi=i}};
if(fi>=0){found=vals.get(fi)};
io.println(found)
}el{
(* ROOT: print deterministic root hash *)
let h=mut.5381;
let cn=s.len(content);
lp(let i=0;i<cn;i=i+1){
let ch=s.slice(content;i;i+1);
h=(h*33+s.len(ch)+i*7)-((h*33+s.len(ch)+i*7)/16777216)*16777216;
if(h<0){h=0-h}};
let h2=(h*131+count*7919)-((h*131+count*7919)/16777216)*16777216;
io.println(s.concat(tohex(h);tohex(h2)))
}}};
<0}
