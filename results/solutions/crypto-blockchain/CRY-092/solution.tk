m=vesting;i=io:std.io;i=s:std.str;
f=pint(x:str):i64{<mt s.toint(s.trim(x)){$ok:v v;$err:e 0}};
f=main():$i64{
let total=pint(io.readln());
let cliff=pint(io.readln());
let vesting=pint(io.readln());
let start=pint(io.readln());
let query=pint(io.readln());
let secpermonth=1314000;
let elapse2=query-start;
let months=elapse2/secpermonth;
let vested=mut.0;
if(months<cliff){
  vested=0;
}el{
  let capped=mut.months;
  if(months>vesting){ capped=vesting; };
  vested=total*capped/vesting;
};
let unvested=total-vested;
io.println(s.fromint(vested));
io.println(s.fromint(unvested));
<0};
