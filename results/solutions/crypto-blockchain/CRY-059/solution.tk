m=amm;
i=io:std.io;
i=s:std.str;

f=ceildiv(a:$i64;b:$i64):$i64{
  <(a+b-1)/b
};

f=main():i64{
  let first=s.trim(io.readln());
  let parts=s.split(first;" ");
  let x=mut.s.toint(parts.get(0));
  let y=mut.s.toint(parts.get(1));
  let k=x*y;

  lp(let guard=0;guard<1000000;guard=guard+1){
    let line=s.trim(io.readln());
    if(s.eq(line;"")){
      br
    };
    let p=s.split(line;" ");
    let cmd=p.get(0);
    let amt=s.toint(p.get(1));
    let out=mut.0;
    if(s.eq(cmd;"SWAP_X")){
      let nx=x+amt;
      let ny=ceildiv(k;nx);
      out=y-ny;
      x=nx;
      y=ny
    }el{
      let ny=y+amt;
      let nx=ceildiv(k;ny);
      out=x-nx;
      x=nx;
      y=ny
    };
    io.println(s.fromint(out))
  };

  io.println(s.concat("RESERVES ";s.concat(s.fromint(x);s.concat(" ";s.fromint(y)))));
  <0
};
