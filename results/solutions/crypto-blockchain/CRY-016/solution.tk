m=pbkdf2;i=io:std.io;i=s:std.str;i=cr:std.crypto;i=enc:std.encoding;
f=xorbytes(a:@byte;b:@byte):@byte{let r=mut.@();let i=mut.0;lp(i<a.len()){r=r+@(a.get(i)^b.get(i));i=i+1};<r};
f=main():$i64{
let pwd=s.bytes(s.trim(io.readln()));
let salt=s.bytes(s.trim(io.readln()));
let iters=s.toint(s.trim(io.readln()));
let u=mut.cr.hmacsha256(pwd;salt+@(0;0;0;1));
let t=mut.u;
let j=mut.1;
lp(j<iters){u=cr.hmacsha256(pwd;u);t=xorbytes(t;u);j=j+1};
io.println(enc.hexencode(t));
<0}
