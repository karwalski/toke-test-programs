m=rsa;i=io:std.io;i=s:std.str;f=hexdig(c:$i64):$i64{if(c>=48){if(c<=57){<c-48}};if(c>=97){if(c<=102){<c-97+10}};if(c>=65){if(c<=70){<c-65+10}};<0};f=hex2int(hx:$str):$i64{let r=mut.0;let n=s.len(hx);lp(let i=0;i<n;i=i+1){r=r*16+hexdig(s.charat(hx;i))};<r};f=modpow(base:$i64;exp:$i64;modn:$i64):$i64{let result=mut.1;let b=mut.base-(base/modn)*modn;let e=mut.exp;lp(e>0){let half=e/2;let rem=e-half*2;if(rem==1){result=result*b;result=result-(result/modn)*modn};b=b*b;b=b-(b/modn)*modn;e=half};<result};f=main():$i64{let nhex=s.trim(io.readln());let dhex=s.trim(io.readln());let chex=s.trim(io.readln());let n=hex2int(nhex);let d=hex2int(dhex);let c=hex2int(chex);let m=modpow(c;d;n);io.println(s.fromint(m));<0}
