m=wif;i=io:std.io;i=s:std.str;i=enc:std.encoding;i=cr:std.crypto;
f=b58(data:@byte):$str{
let alphabet="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
let n=data.len();
let leadz=mut.0;let li=mut.0;lp(li<n){if(data.get(li)=0){leadz=leadz+1;li=li+1}el{li=n}};
let digits=mut.@();
let work=mut.data;
lp(work.len()>0){
let rem=mut.0;
let newwork=mut.@();
let i=mut.0;
lp(i<work.len()){let acc=rem*256+work.get(i);let q=acc/58;rem=acc%58;newwork=newwork+@(q);i=i+1};
digits=digits+@(rem);
let start=mut.0;lp(start<newwork.len()){if(newwork.get(start)=0){start=start+1}el{br}};
let tmp=mut.@();let j=mut.start;lp(j<newwork.len()){tmp=tmp+@(newwork.get(j));j=j+1};work=tmp;
};
let out=mut."";let z=mut.0;lp(z<leadz){out=s.concat(out;"1");z=z+1};
let k=mut.digits.len()-1;lp(k>=0){out=s.concat(out;s.slice(alphabet;digits.get(k);digits.get(k)+1));k=k-1};
<out};
f=cat(a:@byte;b:@byte):@byte{let r=mut.a;let i=mut.0;lp(i<b.len()){r=r+@(b.get(i));i=i+1};<r};
f=main():$i64{
let hex=s.lower(s.trim(io.readln()));
let key=enc.hexdecode(hex);
let ext=cat(@(128);key);
let h2=cr.sha256(cr.sha256(ext));
let cs=mut.@();let i=mut.0;lp(i<4){cs=cs+@(h2.get(i));i=i+1};
let final=cat(ext;cs);
io.println(b58(final));
<0}
