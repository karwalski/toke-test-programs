m=otp;i=io:std.io;i=s:std.str;i=enc:std.encoding;
f=rotl(x:$i64;n:$i64):$i64{let m=4294967295;<(((x<<n)&m)|((x&m)>>(32-n)))&m};
f=sha1(msg:@$i64):@$i64{
let m=4294967295;
let h0=mut.1732584193;let h1=mut.4023233417;let h2=mut.2562383102;let h3=mut.271733878;let h4=mut.3285377520;
let ml=msg.len();
let w8=mut.@();lp(let i=0;i<ml;i=i+1){w8=w8+@(msg.get(i))};
w8=w8+@(128);
lp((w8.len()-w8.len()/64*64)!=56){w8=w8+@(0)};
let bitlen=ml*8;
w8=w8+@((bitlen>>56)&255)+@((bitlen>>48)&255)+@((bitlen>>40)&255)+@((bitlen>>32)&255)+@((bitlen>>24)&255)+@((bitlen>>16)&255)+@((bitlen>>8)&255)+@(bitlen&255);
let nb=w8.len()/64;
lp(let blk=0;blk<nb;blk=blk+1){
let wd=mut.@();
lp(let t=0;t<16;t=t+1){let o=blk*64+t*4;let v=((w8.get(o)&255)<<24)|((w8.get(o+1)&255)<<16)|((w8.get(o+2)&255)<<8)|(w8.get(o+3)&255);wd=wd+@(v)};
lp(let t=16;t<80;t=t+1){let v=rotl(wd.get(t-3)^wd.get(t-8)^wd.get(t-14)^wd.get(t-16);1);wd=wd+@(v)};
let a=mut.h0;let b=mut.h1;let c=mut.h2;let d=mut.h3;let e=mut.h4;
lp(let t=0;t<80;t=t+1){
let fv=mut.0;let kc=mut.0;
if(t<20){fv=(b&c)|(((~b)&m)&d);kc=1518500249}
el{if(t<40){fv=b^c^d;kc=1859775393}
el{if(t<60){fv=(b&c)|(b&d)|(c&d);kc=2400959708}
el{fv=b^c^d;kc=3395469782}}};
let tmp=(rotl(a;5)+fv+e+kc+wd.get(t))&m;
e=d;d=c;c=rotl(b;30);b=a;a=tmp};
h0=(h0+a)&m;h1=(h1+b)&m;h2=(h2+c)&m;h3=(h3+d)&m;h4=(h4+e)&m};
let out=mut.@();
out=out+@((h0>>24)&255)+@((h0>>16)&255)+@((h0>>8)&255)+@(h0&255);
out=out+@((h1>>24)&255)+@((h1>>16)&255)+@((h1>>8)&255)+@(h1&255);
out=out+@((h2>>24)&255)+@((h2>>16)&255)+@((h2>>8)&255)+@(h2&255);
out=out+@((h3>>24)&255)+@((h3>>16)&255)+@((h3>>8)&255)+@(h3&255);
out=out+@((h4>>24)&255)+@((h4>>16)&255)+@((h4>>8)&255)+@(h4&255);
<out};
f=bcat(a:@$i64;b:@$i64):@$i64{let r=mut.a;lp(let i=0;i<b.len();i=i+1){r=r+@(b.get(i))};<r};
f=hmacsha1(key:@$i64;msg:@$i64):@$i64{
let k0=mut.@();
lp(let i=0;i<64;i=i+1){if(i<key.len()){k0=k0+@(key.get(i))}el{k0=k0+@(0)}};
let ipad=mut.@();let opad=mut.@();
lp(let i=0;i<64;i=i+1){ipad=ipad+@(k0.get(i)^54)};
lp(let i=0;i<64;i=i+1){opad=opad+@(k0.get(i)^92)};
let inner=sha1(bcat(ipad;msg));
<sha1(bcat(opad;inner))};
f=b32dec(secret:$str):@$i64{
let alpha="ABCDEFGHIJKLMNOPQRSTUVWXYZ234567";
let bits=mut.0;let acc=mut.0;
let out=mut.@();
let sl=s.len(secret);
lp(let i=0;i<sl;i=i+1){
let ch=s.slice(secret;i;i+1);
let idx=mut.0;
lp(let j=0;j<32;j=j+1){if(s.slice(alpha;j;j+1)==ch){idx=j}};
acc=(acc<<5)|idx;
bits=bits+5;
if(bits>=8){bits=bits-8;out=out+@((acc>>bits)&255)}};
<out};
f=main():$i64{
let secret=s.trim(io.readln());
let ts=s.toint(s.trim(io.readln()));
let counter=ts/30;
let cb=mut.@();
cb=cb+@((counter>>56)&255)+@((counter>>48)&255)+@((counter>>40)&255)+@((counter>>32)&255)+@((counter>>24)&255)+@((counter>>16)&255)+@((counter>>8)&255)+@(counter&255);
let key=b32dec(secret);
let dig=hmacsha1(key;cb);
let offset=dig.get(19)&15;
let code=((dig.get(offset)&127)<<24)|((dig.get(offset+1)&255)<<16)|((dig.get(offset+2)&255)<<8)|(dig.get(offset+3)&255);
let totp=code-code/1000000*1000000;
let st=mut.s.fromint(totp);
lp(s.len(st)<6){st=s.concat("0";st)};
io.println(st);
<0}
