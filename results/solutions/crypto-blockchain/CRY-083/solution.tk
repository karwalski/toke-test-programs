let ssb=s.bytes(s.fromint(signer));let si=mut.0;lp(si<ssb.len()){mseed=mseed+@(ssb.get(si));si=si+1};
let psb=s.bytes(privhex);let pii=mut.0;lp(pii<psb.len()){mseed=mseed+@(psb.get(pii));pii=pii+1};
cp=0;lp(cp<n){let pb=s.bytes(pubs.get(cp));let qi=mut.0;lp(qi<pb.len()){mseed=mseed+@(pb.get(qi));qi=qi+1};cp=cp+1};
let seed=cr.sha256(mseed);
