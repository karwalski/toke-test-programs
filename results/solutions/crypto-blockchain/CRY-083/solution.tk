let rawparts=s.split(inner;",");
let n=rawparts.len();
let pubs=mut.@();
let pi=mut.0;
lp(pi<n){let pstr=rawparts.get(pi);let trimmed=s.slice(pstr;1;s.len(pstr)-1);pubs=pubs+@(trimmed);pi=pi+1};
let kiacc=mut.@();
