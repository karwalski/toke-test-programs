let two=mut.zero16();two=two.set(0;2);
let lsigner=modexp(two;alpha);
let hpacc=mut.@();hpacc=hpart(hpacc;sb("HP"));hpacc=hpart(hpacc;digbytes(kibytes));hpacc=hpart(hpacc;sb(todec(alpha)));
