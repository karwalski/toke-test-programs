m=dh;i=io:std.io;i=s:std.str;f=modpow(base:$i64;exp:$i64;mod:$i64):$i64{let r=mut.1;let b=mut.base%mod;let e=mut.exp;lp(e>0){if(e%2==1){r=r*b%mod};e=e/2;b=b*b%mod};<r};f=main():$i64{let p=s.toint(s.trim(io.readln()));let g=s.toint(s.trim(io.readln()));let pa=s.toint(s.trim(io.readln()));let pb=s.toint(s.trim(io.readln()));let pubB=modpow(g;pb;p);let secret=modpow(pubB;pa;p);io.println(s.fromint(secret));<0}
