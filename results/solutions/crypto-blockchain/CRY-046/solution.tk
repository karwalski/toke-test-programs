m=mining;
i=io:std.io;
i=s:std.str;
i=cr:std.crypto;
f=sha256hex(msg:$str):$str{
  let h=cr.sha256(s.bytes(msg));
  <cr.tohex(h)
};
f=main():$void{
  let data=io.readln();
  let diffstr=io.readln();
  let difficulty=s.toint(s.trim(diffstr));
  let zeros=s.repeat("0";difficulty as u64);
  let nonce=mut.0;
  let answer=mut."";
  let found=mut.false;
  lp(let i=0;!(found);i=i+1){
    let candidate=s.concat(data;s.fromint(nonce));
    let hex=sha256hex(candidate);
    if(s.startswith(hex;zeros)){
      answer=hex;
      found=true;
    }el{
      nonce=nonce+1;
    };
  };
  io.println(s.fromint(nonce));
  io.println(answer);
};
