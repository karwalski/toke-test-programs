m=schnorr;
i=io:std.io;
i=s:std.str;
i=cr:std.crypto;
f=modpow(base:$i64;exp:$i64;modp:$i64):$i64{
  let result=mut.1;
  let b=mut.base-base/modp*modp;
  if(b<0){b=b+modp};
  let e=mut.exp;
  lp(let i=0;i<64;i=i+1){
    if(e==0){br};
    let bit=e-e/2*2;
    if(bit==1){result=result*b-result*b/modp*modp};
    e=e/2;
    b=b*b-b*b/modp*modp
  };
  <result
};
f=challenge(g:$i64;y:$i64;t:$i64;order:$i64):$i64{
  let str=s.concat(s.fromint(g);s.concat(",";s.concat(s.fromint(y);s.concat(",";s.fromint(t)))));
  let h=cr.sha256(s.bytes(str));
  let v=mut.0;
  lp(let i=0;i<4;i=i+1){
    v=v*256+(h.get(i as u64) as i64)
  };
  if(v<0){v=0-v};
  <v-v/order*order
};
f=main():$i64{
  let p=s.toint(s.trim(io.readln()));
  let g=s.toint(s.trim(io.readln()));
  let x=s.toint(s.trim(io.readln()));
  let mode=s.trim(io.readln());
  let order=p-1;
  if(s.eq(mode;"PROVE")){
    let rb=cr.randombytes(4 as u64);
    let r=mut.0;
    lp(let i=0;i<4;i=i+1){r=r*256+(rb.get(i as u64) as i64)};
    if(r<0){r=0-r};
    r=r-r/order*order;
    let y=modpow(g;x;p);
    let t=modpow(g;r;p);
    let e=challenge(g;y;t;order);
    let ex=(e*x)-(e*x)/order*order;
    let resp=(r+ex)-(r+ex)/order*order;
    io.println(s.concat(s.fromint(t);s.concat(",";s.concat(s.fromint(e);s.concat(",";s.fromint(resp))))));
  }el{
    let commitment=s.toint(s.trim(io.readln()));
    let chal=s.toint(s.trim(io.readln()));
    let response=s.toint(s.trim(io.readln()));
    let y=s.toint(s.trim(io.readln()));
    let lhs=modpow(g;response;p);
    let yterm=modpow(y;chal;p);
    let rcheck=commitment*yterm-commitment*yterm/p*p;
    if(lhs==rcheck){io.println("VALID")}el{io.println("INVALID")}
  };
  <0
};
