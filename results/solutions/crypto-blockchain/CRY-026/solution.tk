m=main;
i=io:std.io;
i=s:std.str;
i=enc:std.encoding;
f=main():$void{
  let kb=s.bytes(io.readln());
  let pb=s.bytes(io.readln());
  let keylen=kb.len as i64;
  let ptlen=pb.len as i64;
  let ob=mut.@($i64);
  lp(let i=0;i<ptlen;i=i+1){
    ob=ob+@((pb.get(i) as i64)^(kb.get(i%keylen) as i64));
  };
  io.println(enc.hexencode(ob));
};
