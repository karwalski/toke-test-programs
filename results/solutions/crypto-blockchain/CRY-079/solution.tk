m=commitreveal;
i=io:std.io;
i=s:std.str;
i=cr:std.crypto;
f=commitment(val:$str;nonce:$str):$str{
  let msg=s.concat(val;s.concat("||";nonce));
  let h=cr.sha256(s.bytes(msg));
  <cr.tohex(h)
};
f=main():$void{
  let line=io.readln();
  let parts=s.split(s.trim(line);" ");
  let op=parts.get(0);
  if(s.eq(op;"COMMIT")){
    let val=parts.get(1);
    let nonce=parts.get(2);
    io.println(commitment(val;nonce));
  }el{
    let val=parts.get(1);
    let nonce=parts.get(2);
    let given=parts.get(3);
    let computed=commitment(val;nonce);
    if(s.eq(computed;given)){io.println("VALID")}el{io.println("INVALID")};
  };
};
