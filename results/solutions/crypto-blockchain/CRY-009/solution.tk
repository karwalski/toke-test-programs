m=base58;
i=io:std.io;
i=s:std.str;

f=hexval(c:$i64):$i64{
  if(c>47){if(c<58){<c-48}};
  if(c>64){if(c<71){<c-55}};
  if(c>96){if(c<103){<c-87}};
  <0
};

f=main():i64{
  let alph=s.bytes("123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz");
  let line=s.trim(io.readln());
  let hb=s.bytes(line);
  let hlen=(hb.len as i64);
  let nbytes=hlen/2;

  let data=mut.@();
  lp(let i=0;i<nbytes;i=i+1){
    let hi=hexval(hb.get(i*2));
    let lo=hexval(hb.get(i*2+1));
    data=data.push(hi*16+lo)
  };

  let leadzeros=mut.0;
  let stop=mut.false;
  lp(let i=0;i<nbytes;i=i+1){
    if(!(stop)){
      if(data.get(i)=0){
        leadzeros=leadzeros+1
      }el{
        stop=true
      }
    }
  };

  let outdigits=mut.@();
  let len=mut.nbytes;
  lp(let guard=0;len>0;guard=guard+1){
    let rem=mut.0;
    let q=mut.@();
    let started=mut.false;
    lp(let i=0;i<len;i=i+1){
      let acc=rem*256+data.get(i);
      let d=acc/58;
      rem=acc-d*58;
      if(started){
        q=q.push(d)
      }el{
        if(d>0){
          started=true;
          q=q.push(d)
        }
      }
    };
    outdigits=outdigits.push(rem);
    data=q;
    len=(q.len as i64)
  };

  let buf=s.buf();
  lp(let i=0;i<leadzeros;i=i+1){
    s.addbyte(buf;alph.get(0))
  };
  let nd=(outdigits.len as i64);
  if(nd=0){
    if(leadzeros=0){
      s.addbyte(buf;alph.get(0))
    }
  }el{
    lp(let i=nd-1;i>=0;i=i-1){
      s.addbyte(buf;alph.get(outdigits.get(i)))
    }
  };
  io.println(s.done(buf));
  <0
};
