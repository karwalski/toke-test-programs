m=b58check;i=io:std.io;i=s:std.str;i=cr:std.crypto;
f=b58dec(str:$str):@byte{
let alphabet="123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz";
let n=s.len(str);
let num=mut.@();
let i=mut.0;
lp(i<n){
let ch=s.slice(str;i;i+1);
let val=s.indexof(alphabet;ch);
let carry=mut.val;
let j=mut.num.len()-1;
let out=mut.@();
lp(j>=0){let acc=num.get(j)*58+carry;out=@(acc&255)+out;carry=acc>>8;j=j-1};
lp(carry>0){out=@(carry&255)+out;carry=carry>>8};
num=out;
i=i+1};
let leadz=mut.0;let li=mut.0;lp(li<n){if(s.slice(str;li;li+1)=="1"){leadz=leadz+1;li=li+1}el{li=n}};
let res=mut.@();let z=mut.0;lp(z<leadz){res=res+@(0);z=z+1};
res=res+num;
<res};
f=main():$i64{
let addr=s.trim(io.readln());
let dec=b58dec(addr);
if(dec.len()!=25){io.println("INVALID: Invalid length");<0};
let payload=mut.@();let i=mut.0;lp(i<21){payload=payload+@(dec.get(i));i=i+1};
let h2=cr.sha256(cr.sha256(payload));
let ok=mut.1;let k=mut.0;lp(k<4){if(h2.get(k)!=dec.get(21+k)){ok=0};k=k+1};
if(ok==1){io.println("VALID")}el{io.println("INVALID: Checksum mismatch")};
<0}
