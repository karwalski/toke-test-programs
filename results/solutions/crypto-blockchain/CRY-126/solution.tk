m=metadata;
i=io:std.io;
i=s:std.str;

f=has(json:$str;key:$str):$bool{
    let pat=s.concat(s.concat("\"";key);"\":");
    <s.indexof(json;pat)>=0
};

f=getstr(json:$str;key:$str):$str{
    let pat=s.concat(s.concat("\"";key);"\":\"");
    let p=s.indexof(json;pat);
    if(p<0){<""};
    let start=p+s.len(pat);
    let rest=s.slice(json;start;s.len(json));
    let endp=s.indexof(rest;"\"");
    if(endp<0){<rest};
    <s.slice(rest;0;endp)
};

f=main():$i64{
    let input=mut."";
    lp(true){let line=io.readln();if(io.eof()){br};input=s.concat(input;line)};
    if(!has(input;"name")){io.println("INVALID: missing name");<0};
    if(!has(input;"description")){io.println("INVALID: missing description");<0};
    if(!has(input;"image")){io.println("INVALID: missing image");<0};
    io.println("VALID");
    let name=getstr(input;"name");
    let desc=mut.getstr(input;"description");
    let image=getstr(input;"image");
    if(s.len(desc)>50){desc=s.slice(desc;0;50)};
    let out=mut.name;
    out=s.concat(out;" | ");
    out=s.concat(out;desc);
    out=s.concat(out;" | ");
    out=s.concat(out;image);
    io.println(out);
    <0
};
