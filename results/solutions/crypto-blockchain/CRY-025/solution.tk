m=aead;i=io:std.io;i=s:std.str;i=enc:std.encoding;
f=m32(x:$i64):$i64{<x&4294967295};
f=rotl(x:$i64;n:$i64):$i64{let v=x&4294967295;<((v<<n)|((v>>(32-n))&((1<<n)-1)))&4294967295};
f=ld32le(b:@i64;o:$i64):$i64{<(b.get(o)|(b.get(o+1)<<8)|(b.get(o+2)<<16)|(b.get(o+3)<<24))&4294967295};
f=qr(st:@i64;a:$i64;b:$i64;c:$i64;d:$i64):@i64{
  let w=mut.st;
  w=w.set(a;m32(w.get(a)+w.get(b)));w=w.set(d;rotl(w.get(d)^w.get(a);16));
  w=w.set(c;m32(w.get(c)+w.get(d)));w=w.set(b;rotl(w.get(b)^w.get(c);12));
  w=w.set(a;m32(w.get(a)+w.get(b)));w=w.set(d;rotl(w.get(d)^w.get(a);8));
  w=w.set(c;m32(w.get(c)+w.get(d)));w=w.set(b;rotl(w.get(b)^w.get(c);7));
  <w};
f=chachablock(key:@i64;counter:$i64;nonce:@i64):@i64{
  let st=mut.@(1634760805;857760878;2036477234;1797285236);
  let i=mut.0;lp(i<8){st=st+@(ld32le(key;i*4));i=i+1};
  st=st+@(counter&4294967295);
  i=0;lp(i<3){st=st+@(ld32le(nonce;i*4));i=i+1};
  let work=mut.st;
  let r=mut.0;
  lp(r<10){
    work=qr(work;0;4;8;12);work=qr(work;1;5;9;13);work=qr(work;2;6;10;14);work=qr(work;3;7;11;15);
    work=qr(work;0;5;10;15);work=qr(work;1;6;11;12);work=qr(work;2;7;8;13);work=qr(work;3;4;9;14);
    r=r+1;
  };
  let out=mut.@();let k=mut.0;
  lp(k<16){let v=m32(work.get(k)+st.get(k));out=out+@(v&255;(v>>8)&255;(v>>16)&255;(v>>24)&255);k=k+1};
  <out};
f=chacha20enc(key:@i64;counter:$i64;nonce:@i64;pt:@i64):@i64{
  let out=mut.@();let plen=pt.len();let i=mut.0;
  lp(i<plen){
    let blk=chachablock(key;counter+i/64;nonce);
    let j=mut.0;
    lp((j<64)&&((i+j)<plen)){out=out+@(pt.get(i+j)^blk.get(j));j=j+1};
    i=i+64;
  };
  <out};
f=poly1305(msg:@i64;okey:@i64):@i64{
  let t0=ld32le(okey;0);let t1=ld32le(okey;4);let t2=ld32le(okey;8);let t3=ld32le(okey;12);
  let r0=t0&67108863;
  let r1=((t0>>26)|(t1<<6))&67108611;
  let r2=((t1>>20)|(t2<<12))&67092735;
  let r3=((t2>>14)|(t3<<18))&66076671;
  let r4=(t3>>8)&1048575;
  let s1=r1*5;let s2=r2*5;let s3=r3*5;let s4=r4*5;
  let h0=mut.0;let h1=mut.0;let h2=mut.0;let h3=mut.0;let h4=mut.0;
  let mlen=msg.len();
  let i=mut.0;
  lp(i<mlen){
    let blk=mut.@();let q=mut.0;
    lp((q<16)&&((i+q)<mlen)){blk=blk+@(msg.get(i+q));q=q+1};
    blk=blk+@(1);
    lp(blk.len()<17){blk=blk+@(0)};
    let b0=(blk.get(0)|(blk.get(1)<<8)|(blk.get(2)<<16)|(blk.get(3)<<24))&4294967295;
    let b1=(blk.get(4)|(blk.get(5)<<8)|(blk.get(6)<<16)|(blk.get(7)<<24))&4294967295;
    let b2=(blk.get(8)|(blk.get(9)<<8)|(blk.get(10)<<16)|(blk.get(11)<<24))&4294967295;
    let b3=(blk.get(12)|(blk.get(13)<<8)|(blk.get(14)<<16)|(blk.get(15)<<24))&4294967295;
    let topbit=blk.get(16)<<24;
    h0=h0+(b0&67108863);
    h1=h1+(((b0>>26)|(b1<<6))&67108863);
    h2=h2+(((b1>>20)|(b2<<12))&67108863);
    h3=h3+(((b2>>14)|(b3<<18))&67108863);
    h4=h4+(((b3>>8)&4294967295)|topbit);
    let d0=h0*r0+h1*s4+h2*s3+h3*s2+h4*s1;
    let d1=h0*r1+h1*r0+h2*s4+h3*s3+h4*s2;
    let d2=h0*r2+h1*r1+h2*r0+h3*s4+h4*s3;
    let d3=h0*r3+h1*r2+h2*r1+h3*r0+h4*s4;
    let d4=h0*r4+h1*r3+h2*r2+h3*r1+h4*r0;
    let c=mut.0;
    c=d0>>26;h0=d0&67108863;
    let dd1=d1+c;c=dd1>>26;h1=dd1&67108863;
    let dd2=d2+c;c=dd2>>26;h2=dd2&67108863;
    let dd3=d3+c;c=dd3>>26;h3=dd3&67108863;
    let dd4=d4+c;c=dd4>>26;h4=dd4&67108863;
    h0=h0+c*5;c=h0>>26;h0=h0&67108863;h1=h1+c;
    i=i+16;
  };
  let c=mut.h1>>26;h1=h1&67108863;h2=h2+c;
  c=h2>>26;h2=h2&67108863;h3=h3+c;
  c=h3>>26;h3=h3&67108863;h4=h4+c;
  c=h4>>26;h4=h4&67108863;h0=h0+c*5;
  c=h0>>26;h0=h0&67108863;h1=h1+c;
  let g0=h0+5;let cc0=g0>>26;let gg0=g0&67108863;
  let g1=h1+cc0;let cc1=g1>>26;let gg1=g1&67108863;
  let g2=h2+cc1;let cc2=g2>>26;let gg2=g2&67108863;
  let g3=h3+cc2;let cc3=g3>>26;let gg3=g3&67108863;
  let g4=h4+cc3-67108864;
  let mask=mut.0;
  if(g4<0){mask=0}el{mask=1};
  let fh0=mut.0;let fh1=mut.0;let fh2=mut.0;let fh3=mut.0;let fh4=mut.0;
  if(mask==1){fh0=gg0;fh1=gg1;fh2=gg2;fh3=gg3;fh4=g4&67108863}el{fh0=h0;fh1=h1;fh2=h2;fh3=h3;fh4=h4};
  let f0=(fh0|(fh1<<26))&4294967295;
  let f1=((fh1>>6)|(fh2<<20))&4294967295;
  let f2=((fh2>>12)|(fh3<<14))&4294967295;
  let f3=((fh3>>18)|(fh4<<8))&4294967295;
  let sk0=ld32le(okey;16);let sk1=ld32le(okey;20);let sk2=ld32le(okey;24);let sk3=ld32le(okey;28);
  let a0=f0+sk0;let car0=a0>>32;
  let a1=f1+sk1+car0;let car1=a1>>32;
  let a2=f2+sk2+car1;let car2=a2>>32;
  let a3=f3+sk3+car2;
  let out=mut.@();
  out=out+@(a0&255;(a0>>8)&255;(a0>>16)&255;(a0>>24)&255);
  out=out+@(a1&255;(a1>>8)&255;(a1>>16)&255;(a1>>24)&255);
  out=out+@(a2&255;(a2>>8)&255;(a2>>16)&255;(a2>>24)&255);
  out=out+@(a3&255;(a3>>8)&255;(a3>>16)&255;(a3>>24)&255);
  <out};
f=main():$i64{
let keyline=s.trim(io.readln());
let nonceline=s.trim(io.readln());
let ptline=io.readln();
let keyb=enc.hexdecode(keyline);
let nonceb=enc.hexdecode(nonceline);
let key=mut.@();let ki=mut.0;lp(ki<keyb.len()){key=key+@(keyb.get(ki));ki=ki+1};
let nonce=mut.@();let ni=mut.0;lp(ni<nonceb.len()){nonce=nonce+@(nonceb.get(ni));ni=ni+1};
let ptb=s.bytes(ptline);
let pt=mut.@();let pi=mut.0;lp(pi<ptb.len()){pt=pt+@(ptb.get(pi));pi=pi+1};
let otkfull=chachablock(key;0;nonce);
let otk=mut.@();let oi=mut.0;lp(oi<32){otk=otk+@(otkfull.get(oi));oi=oi+1};
let ct=chacha20enc(key;1;nonce;pt);
let ctlen=ct.len();
let macdata=mut.@();
let mi=mut.0;lp(mi<ctlen){macdata=macdata+@(ct.get(mi));mi=mi+1};
let padc=mut.0;if((ctlen-ctlen/16*16)!=0){padc=16-(ctlen-ctlen/16*16)};
let pp=mut.0;lp(pp<padc){macdata=macdata+@(0);pp=pp+1};
let aadlen=0;
macdata=macdata+@(aadlen&255;(aadlen>>8)&255;(aadlen>>16)&255;(aadlen>>24)&255;0;0;0;0);
macdata=macdata+@(ctlen&255;(ctlen>>8)&255;(ctlen>>16)&255;(ctlen>>24)&255;0;0;0;0);
let tag=poly1305(macdata;otk);
let result=mut.@();
let ri=mut.0;lp(ri<ctlen){result=result+@(ct.get(ri));ri=ri+1};
let ti=mut.0;lp(ti<16){result=result+@(tag.get(ti));ti=ti+1};
let outbytes=mut.@();let bo=mut.0;lp(bo<result.len()){outbytes=outbytes+@(result.get(bo));bo=bo+1};
io.println(enc.hexencode(outbytes));
<0}
