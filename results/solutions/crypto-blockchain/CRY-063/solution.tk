m=secretsharing;i=io:std.io;i=s:std.str;f=modnorm(a:$i64;m:$i64):$i64{let r=a%m;if(r<0){<r+m};<r};f=modinv(a0:$i64;m:$i64):$i64{let a=modnorm(a0;m);let t=mut.0;let newt=mut.1;let r=mut.m;let newr=mut.a;lp(newr!=0){let q=r/newr;let tmp1=newt;newt=t-q*newt;t=tmp1;let tmp2=newr;newr=r-q*newr;r=tmp2};if(t<0){t=t+m};<t};f=main():$i64{let prime=s.toint(s.trim(io.readln()));let xs=mut.@($i64);let ys=mut.@($i64);lp(1=1){if(io.eof()){br};let line=s.trim(io.readln());if(s.len(line)=0){}el{let p=s.split(line;",");xs=xs+@(s.toint(p.get(0)));ys=ys+@(s.toint(p.get(1)))}};let n=xs.len();let secret=mut.0;let i=mut.0;lp(i<n){let xi=xs.get(i);let yi=ys.get(i);let num=mut.1;let den=mut.1;let j=mut.0;lp(j<n){if(j=i){}el{let xj=xs.get(j);num=modnorm(num*modnorm(0-xj;prime);prime);den=modnorm(den*modnorm(xi-xj;prime);prime)};j=j+1};let dinv=modinv(den;prime);let term=modnorm(modnorm(modnorm(yi;prime)*num;prime)*dinv;prime);secret=modnorm(secret+term;prime);i=i+1};io.println(s.fromint(secret));<0}
