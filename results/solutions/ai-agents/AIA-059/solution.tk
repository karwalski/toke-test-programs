m=textextract;
i=io:std.io;
i=s:std.str;

f=charat(text:$str;i:$i64):$str{
  <(mt s.slice(text;i;i+1){ $ok:v v; $err:e "" })
};

f=isdigit(c:$str):$bool{
  if(!(s.len(c)=1)){<false};
  if(s.contains("0123456789";c)){<true};
  <false
};

f=isalnumdot(c:$str):$bool{
  if(!(s.len(c)=1)){<false};
  if(s.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._%+-";c)){<true};
  <false
};

f=isalnumhost(c:$str):$bool{
  if(!(s.len(c)=1)){<false};
  if(s.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789.-";c)){<true};
  <false
};

f=dotcount(tok:$str):$i64{
  let n=mut.0;
  lp(let i=0;i<(s.len(tok) as i64);i=i+1){
    if(charat(tok;i)="."){n=n+1}
  };
  <n
};

f=isdigitsdots(tok:$str):$bool{
  if(s.len(tok)=0){<false};
  lp(let i=0;i<(s.len(tok) as i64);i=i+1){
    let c=charat(tok;i);
    let ok=mut.false;
    if(isdigit(c)){ok=true};
    if(c="."){ok=true};
    if(!(ok)){<false}
  };
  <true
};

f=extractemails(text:$str):@$str{
  let res=mut.@();
  let n=s.len(text) as i64;
  lp(let i=0;i<n;i=i+1){
    if(charat(text;i)="@"){
      let lo=mut.i;
      lp(let k=i-1;k>=0;k=k-1){
        if(isalnumdot(charat(text;k))){lo=k}el{br}
      };
      let hi=mut.i+1;
      lp(let k=i+1;k<n;k=k+1){
        if(isalnumhost(charat(text;k))){hi=k+1}el{br}
      };
      lp(hi>i+1){
        if(charat(text;hi-1)="."){hi=hi-1}el{br}
      };
      if(lo<i){
        if(hi>i+1){
          let local=mt s.slice(text;lo;i){ $ok:v v; $err:e "" };
          let host=mt s.slice(text;i+1;hi){ $ok:v v; $err:e "" };
          if(s.contains(host;".")){
            res=res+@(s.concat(local;s.concat("@";host)))
          }
        }
      }
    }
  };
  <res
};

f=extracttokens(text:$str;wantversion:$bool):@$str{
  let res=mut.@();
  let n=s.len(text) as i64;
  let cur=mut."";
  lp(let i=0;i<=n;i=i+1){
    let c=mut."";
    if(i<n){c=charat(text;i)};
    let isbody=mut.false;
    if(i<n){
      if(isdigit(c)){isbody=true};
      if(c="."){isbody=true};
      if(wantversion){ if(c="v"){isbody=true} }
    };
    if(isbody){
      cur=s.concat(cur;c)
    }el{
      if(s.len(cur)>0){
        let tok=cur;
        if(wantversion){
          if(charat(tok;0)="v"){
            let rest=mt s.slice(tok;1;s.len(tok) as i64){ $ok:v v; $err:e "" };
            if(isdigitsdots(rest)){
              if(dotcount(rest)=2){
                res=res+@(tok)
              }
            }
          }
        }el{
          if(isdigitsdots(tok)){
            if(dotcount(tok)=3){
              res=res+@(tok)
            }
          }
        }
      };
      cur=""
    }
  };
  <res
};

f=gettext(line:$str):$str{
  let idx=s.indexof(line;"\"text\":\"");
  if(idx<0){<""};
  let start=idx+8;
  let rest=mt s.slice(line;start;s.len(line) as i64){ $ok:v v; $err:e "" };
  let endrel=s.indexof(rest;"\"");
  if(endrel<0){<rest};
  <(mt s.slice(rest;0;endrel){ $ok:v v; $err:e "" })
};

f=getpatterns(line:$str):$str{
  let idx=s.indexof(line;"\"patterns\":");
  if(idx<0){<""};
  let start=idx+11;
  <(mt s.slice(line;start;s.len(line) as i64){ $ok:v v; $err:e "" })
};

f=jsonarray(matches:@$str):$str{
  let out=mut."[";
  lp(let i=0;i<(matches.len as i64);i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;s.concat("\"";s.concat(matches.get(i);"\"")))
  };
  <s.concat(out;"]")
};

f=main():$i64{
  let line=io.readln();
  let text=gettext(line);
  let pats=getpatterns(line);

  let out=mut."{";
  let first=mut.true;
  let p=mut.pats;

  lp(let guard=0;guard<50;guard=guard+1){
    let kq=s.indexof(p;"\"");
    if(kq<0){br};
    let afterq=mt s.slice(p;kq+1;s.len(p) as i64){ $ok:v v; $err:e "" };
    let nameend=s.indexof(afterq;"\"");
    if(nameend<0){br};
    let name=mt s.slice(afterq;0;nameend){ $ok:v v; $err:e "" };
    let aftername=mt s.slice(afterq;nameend+1;s.len(afterq) as i64){ $ok:v v; $err:e "" };
    let vq=s.indexof(aftername;"\"");
    if(vq<0){br};
    let aftervq=mt s.slice(aftername;vq+1;s.len(aftername) as i64){ $ok:v v; $err:e "" };
    let valend=s.indexof(aftervq;"\"");
    if(valend<0){br};
    let regex=mt s.slice(aftervq;0;valend){ $ok:v v; $err:e "" };

    let matches=mut.@();
    if(s.contains(regex;"@")){
      matches=extractemails(text)
    }el{
      if(s.contains(regex;"v")){
        matches=extracttokens(text;true)
      }el{
        matches=extracttokens(text;false)
      }
    };

    if(!(first)){out=s.concat(out;",")};
    first=false;
    out=s.concat(out;s.concat("\"";s.concat(name;"\":")));
    out=s.concat(out;jsonarray(matches));

    p=mt s.slice(aftervq;valend+1;s.len(aftervq) as i64){ $ok:v v; $err:e "" }
  };

  out=s.concat(out;"}");
  io.println(out);
  <0
}
