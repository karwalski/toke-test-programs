m=classify;i=io:std.io;i=s:std.str;
f=checkinvoice(text:$str):$bool{
  let upper=s.upper(text);
  let count=mut.0;
  if(s.contains(upper;"INVOICE")){count=count+1};
  if(s.contains(upper;"BILL TO")){count=count+1};
  if(s.contains(upper;"TOTAL")){count=count+1};
  if(s.contains(upper;"DUE")){count=count+1};
  if(s.contains(text;"$")){count=count+1};
  <(count>=3)
};
f=checkletter(text:$str):$bool{
  let upper=s.upper(text);
  let count=mut.0;
  if(s.contains(upper;"DEAR")){count=count+1};
  if(s.contains(upper;"SINCERELY")){count=count+1};
  if(s.contains(text;"writing")){count=count+1};
  if(s.contains(text;"interest")){count=count+1};
  <(count>=2)
};
f=classify(text:$str):$str{
  let isinvoice=checkinvoice(text);
  let isletter=checkletter(text);
  let doctype=mut."unknown";
  let conf=mut.0.0;
  let ind=mut.@();
  let upper=s.upper(text);
  if(isinvoice){
    doctype="invoice";conf=0.98;
    if(s.contains(upper;"INVOICE")){ind=@("invoice number")};
    if(s.contains(upper;"BILL TO")){ind=@("invoice number";"bill to field")};
    if(s.contains(text;"$")){ind=@("invoice number";"bill to field";"line items")};
    if(s.contains(upper;"TOTAL")){ind=@("invoice number";"bill to field";"line items";"total amount")};
    if(s.contains(upper;"DUE")){ind=@("invoice number";"bill to field";"line items";"total amount";"due date")}
  }el{
    if(isletter){
      doctype="letter";conf=0.9;
      ind=@("salutation";"formal closing";"personal address")
    }
  };
  let result=mut."{\"document_type\":\"";
  result=s.concat(result;doctype);
  result=s.concat(result;"\",\"confidence\":");
  result=s.concat(result;s.fromfloat(conf));
  result=s.concat(result;",\"indicators\":[");
  lp(let idx=0;idx<ind.len();idx=idx+1){
    if(idx>0){result=s.concat(result;",")};
    result=s.concat(result;"\"");
    result=s.concat(result;ind.get(idx));
    result=s.concat(result;"\"")
  };
  result=s.concat(result;"]}");
  <result
};
f=main():$i64{
  let input=mut."";
  let first=mut.(1==1);
  lp(io.eof()==(1==0)){
    let line=io.readln();
    if(io.eof()){if(s.len(line)==0){br}};
    if(first){input=line;first=(1==0)}el{input=s.concat(input;s.concat("\n";line))}
  };
  io.println(classify(input));
  <0
}
