m=agenterror;i=io:std.io;i=s:std.str;i=j:std.json;
f=main():$i64{
  let input=mt j.dec(io.readln()){$ok:v v;$err:e j.obj("{}")};
  let error=j.getobj(input;"error");
  let errtype=j.getstr(error;"type");
  let attemptcount=j.geti64(error;"attempt_count");
  let maxretries=j.geti64(input;"max_retries");
  let rules=j.getobj(input;"escalation_rules");
  let rule=j.getstr(rules;errtype);
  let action=mut."";
  let reason=mut."";
  let nextagent=mut."null";
  if(s.eq(rule;"retry")){
    if(attemptcount<maxretries){
      action="retry";
      reason=s.concat("Timeout errors are retryable, attempt ";s.concat(s.fromint(attemptcount);s.concat(" of ";s.fromint(maxretries))));
    }el{
      action="fail";reason="Max retries exceeded";
    };
  }el{
    if(s.eq(rule;"escalate")){
      action="escalate";
      reason=s.concat(errtype;" errors require escalation");
      nextagent="\"supervisor\"";
    }el{
      action="fail";reason="Unknown error type";
    };
  };
  io.println(s.concat("{\"action\":\"";s.concat(action;s.concat("\",\"reason\":\"";s.concat(reason;s.concat("\",\"next_agent\":";s.concat(nextagent;"}")))))));
  <0}
