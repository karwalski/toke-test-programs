m=timeoutmanager;i=io:std.io;i=s:std.str;
f=parseint(t:$str):$i64{
  let n=s.len(t) as i64;let r=mut.0;let i=mut.0;let neg=mut.false;
  if(n>0){let c0=s.slice(t;0;1);if(s.eq(c0;"-")){neg=true;i=1}};
  lp(i<n){
    let ch=s.slice(t;i;i+1);
    let d=s.indexof("0123456789";ch);
    if(d>=0){r=r*10+d};
    i=i+1
  };
  if(neg){<0-r};
  <r
};
f=findnum(obj:$str;key:$str):$i64{
  let k=s.concat(s.concat("\"";key);"\":");
  let idx=s.indexof(obj;k);
  if(idx<0){<0};
  let start=idx+s.len(k) as i64;
  let rest=s.slice(obj;start;s.len(obj) as i64);
  let rl=s.len(rest) as i64;
  let j=mut.0;
  let buf=mut."";
  lp(j<rl){
    let ch=s.slice(rest;j;j+1);
    let isdig=s.indexof("0123456789-";ch);
    if(isdig>=0){buf=s.concat(buf;ch);j=j+1}el{j=rl}
  };
  <parseint(buf)
};
f=findstr(obj:$str;key:$str):$str{
  let k=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(obj;k);
  if(idx<0){<""};
  let start=idx+s.len(k) as i64;
  let rest=s.slice(obj;start;s.len(obj) as i64);
  let endq=s.indexof(rest;"\"");
  <s.slice(rest;0;endq)
};
f=main():$i64{
  let json=io.readln();
  let jn=s.len(json) as i64;
  let now=findnum(json;"now_ms");
  let key="\"running_steps\":[";
  let ki=s.indexof(json;key);
  let arrStart=ki+s.len(key) as i64;
  let arrRest=s.slice(json;arrStart;jn);
  let close=s.indexof(arrRest;"]");
  let seg=s.slice(arrRest;0;close);
  let sl=s.len(seg) as i64;
  let timedout=mut.@();
  let healthy=mut.@();
  let p=mut.0;
  lp(p<sl){
    let oc=s.slice(seg;p;p+1);
    if(s.eq(oc;"{")){
      let after=s.slice(seg;p+1;sl);
      let endb=s.indexof(after;"}");
      let objs=s.slice(after;0;endb);
      let id=findstr(objs;"id");
      let started=findnum(objs;"started_at_ms");
      let timeout=findnum(objs;"timeout_ms");
      let elapsed=now-started;
      if(elapsed>timeout){
        let exceeded=elapsed-timeout;
        let entry=s.concat(s.concat(s.concat(s.concat(s.concat(s.concat("{\"id\":\"";id);"\",\"elapsed_ms\":");s.fromint(elapsed));",\"exceeded_by_ms\":");s.fromint(exceeded));"}");
        timedout=timedout+@(entry)
      }el{
        healthy=healthy+@(id)
      };
      p=p+1+endb+1
    }el{p=p+1}
  };
  let out=mut."{\"timed_out\":[";
  lp(let i=0;i<timedout.len();i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;timedout.get(i))
  };
  out=s.concat(out;"],\"healthy\":[");
  lp(let i=0;i<healthy.len();i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(s.concat(s.concat(out;"\"");healthy.get(i));"\"")
  };
  out=s.concat(out;"]}");
  io.println(out);
  <0
}
