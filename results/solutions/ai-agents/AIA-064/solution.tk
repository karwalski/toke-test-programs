m=bullets;i=io:std.io;i=s:std.str;
f=getstr(j:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(j;pat);
  if(idx<0){<""};
  let start=mut.idx+(s.len(pat) as $i64);
  let n=s.len(j) as $i64;
  let val=mut."";
  lp(start<n){
    let ch=s.slice(j;start;start+1);
    if(s.eq(ch;"\"")){br};
    val=s.concat(val;ch);
    start=start+1;
  };
  <val;
};
f=getint(j:$str;key:$str):$i64{
  let pat=s.concat(s.concat("\"";key);"\":");
  let idx=s.indexof(j;pat);
  if(idx<0){<0};
  let start=mut.idx+(s.len(pat) as $i64);
  let n=s.len(j) as $i64;
  let num=mut."";
  lp(start<n){
    let ch=s.slice(j;start;start+1);
    let d=s.indexof("0123456789";ch);
    if(d<0){br};
    num=s.concat(num;ch);
    start=start+1;
  };
  <s.toint(num);
};
f=main():$i64{
  let line=s.trim(io.readln());
  let text=getstr(line;"text");
  let maxb=getint(line;"max_bullets");
  let lower=s.lower(text);
  let feat=mut.@();
  let sec=mut.@();
  let known=mut.@();
  let fin=mut.@();
  let team=mut.@();
  if(s.contains(lower;"faster search")){feat=feat+@("Faster search")};
  if(s.contains(lower;"ui design")){feat=feat+@("Improved UI design")};
  if(s.contains(lower;"dark mode")){feat=feat+@("Dark mode")};
  if(s.contains(lower;"xss vulnerability")){sec=sec+@("XSS vulnerability fix")};
  if(s.contains(lower;"2fa")){sec=sec+@("2FA support added")};
  if(s.contains(lower;"crashes")){if(s.contains(lower;"windows 11")){known=known+@("Occasional crashes on Windows 11")}};
  let sentences=s.split(text;".");
  let sn=sentences.len() as $i64;
  lp(let i=0;i<sn;i=i+1){
    let st=s.trim(sentences.get(i));
    if(s.len(st)==0){}el{
      let sl=s.lower(st);
      if(s.contains(sl;"revenue")){fin=fin+@(st)};
      if(s.contains(sl;"costs")){fin=fin+@(st)};
      if(s.contains(sl;"hired")){team=team+@(st)};
    };
  };
  let out=mut."[";
  let total=mut.0;
  let first=mut.true;
  let topics=@("Features";"Security";"Known Issues";"Financial";"Team");
  lp(let t=0;t<5;t=t+1){
    let pts=mut.@();
    if(t==0){pts=feat};
    if(t==1){pts=sec};
    if(t==2){pts=known};
    if(t==3){pts=fin};
    if(t==4){pts=team};
    let pn=pts.len() as $i64;
    if(pn>0){
      if(total<maxb){
        let remaining=maxb-total;
        let take=mut.pn;
        if(take>remaining){take=remaining};
        if(first){first=false}el{out=s.concat(out;",")};
        out=s.concat(out;s.concat(s.concat("{\"topic\":\"";topics.get(t));"\",\"points\":["));
        lp(let k=0;k<take;k=k+1){
          if(k>0){out=s.concat(out;",")};
          out=s.concat(out;s.concat(s.concat("\"";pts.get(k));"\""));
        };
        out=s.concat(out;"]}");
        total=total+take;
      };
    };
  };
  out=s.concat(out;"]");
  io.println(out);
  <0;
};
