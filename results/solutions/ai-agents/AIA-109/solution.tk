m=entitymem;i=io:std.io;i=s:std.str;
f=getstrval(json:$str;key:$str):$str{
  let ki=s.indexof(json;key);
  if(ki<0){<""};
  let after=s.slice(json;ki+s.len(key) as i64;s.len(json) as i64);
  let q1=s.indexof(after;"\"");
  let rest=s.slice(after;q1+1;s.len(after) as i64);
  let q2=s.indexof(rest;"\"");
  <s.slice(rest;0;q2)
};
f=firstcap(msg:$str):$str{
  let parts=s.split(msg;" ");
  lp(let i=0;i<parts.len() as i64;i=i+1){
    let w=parts.get(i);
    if(s.len(w) as i64>0){
      let c=s.slice(w;0;1);
      if(s.indexof("ABCDEFGHIJKLMNOPQRSTUVWXYZ";c)>=0){<w}
    }
  };
  <""
};
f=upto(t:$str;stop:$str):$str{
  let idx=s.indexof(t;stop);
  if(idx<0){<t};
  <s.slice(t;0;idx)
};
f=relkey(fact:$str):$str{
  if(s.startswith(fact;"works at ")){<"works at"};
  if(s.startswith(fact;"lives in ")){<"lives in"};
  <fact
};
f=jstr(v:$str):$str{<s.concat(s.concat("\"";v);"\"")};
f=main():$i64{
  let json=io.readln();
  let jn=s.len(json) as i64;
  let msg=getstrval(json;"\"new_message\":");
  let entity=firstcap(msg);
  (* extract facts in message order *)
  let facts=mut.@();
  (* moved to X -> lives in X *)
  let movedidx=s.indexof(msg;"moved to ");
  if(movedidx>=0){
    let after=s.slice(msg;movedidx+9;s.len(msg) as i64);
    let obj=mut.upto(after;" and ");
    obj=upto(obj;".");
    facts=facts+@(s.concat("lives in ";obj))
  };
  (* lives in X (explicit) *)
  let livesidx=s.indexof(msg;"lives in ");
  if(livesidx>=0){
    let after=s.slice(msg;livesidx+9;s.len(msg) as i64);
    let obj=mut.upto(after;" and ");
    obj=upto(obj;".");
    facts=facts+@(s.concat("lives in ";obj))
  };
  (* started at X -> works at X *)
  let startedidx=s.indexof(msg;"started at ");
  if(startedidx>=0){
    let after=s.slice(msg;startedidx+11;s.len(msg) as i64);
    let obj=mut.upto(after;" and ");
    obj=upto(obj;".");
    facts=facts+@(s.concat("works at ";obj))
  };
  (* works at X (explicit) *)
  let worksidx=s.indexof(msg;"works at ");
  if(worksidx>=0){
    let after=s.slice(msg;worksidx+9;s.len(msg) as i64);
    let obj=mut.upto(after;" and ");
    obj=upto(obj;".");
    facts=facts+@(s.concat("works at ";obj))
  };
  (* has a X *)
  let hasidx=s.indexof(msg;"has a ");
  if(hasidx>=0){
    let after=s.slice(msg;hasidx+6;s.len(msg) as i64);
    let obj=upto(after;".");
    facts=facts+@(s.concat("has a ";obj))
  };
  (* current memory facts for entity *)
  let mem=mut.@();
  let enkey=s.concat(s.concat("\"";entity);"\":[");
  let enidx=s.indexof(json;enkey);
  if(enidx>=0){
    let astart=enidx+s.len(enkey) as i64;
    let arest=s.slice(json;astart;jn);
    let aclose=s.indexof(arest;"]");
    let aseg=s.slice(arest;0;aclose);
    let asl=s.len(aseg) as i64;
    let q=mut.0;
    lp(q<asl){
      let ch=s.slice(aseg;q;q+1);
      if(s.eq(ch;"\"")){
        let af=s.slice(aseg;q+1;asl);
        let endq2=s.indexof(af;"\"");
        mem=mem+@(s.slice(af;0;endq2));
        q=q+1+endq2+1
      }el{q=q+1}
    }
  };
  (* process facts: replace-in-place on relation conflict, else append *)
  let newfacts=mut.@();
  let updatedfacts=mut.@();
  lp(let f=0;f<facts.len() as i64;f=f+1){
    let fact=facts.get(f);
    let rkey=relkey(fact);
    let replaced=mut.false;
    lp(let m=0;m<mem.len() as i64;m=m+1){
      if(!(replaced)){
        let exfact=mem.get(m);
        if(!(s.eq(rkey;exfact))){
          if(s.startswith(exfact;s.concat(rkey;" "))){
            if(!(s.eq(exfact;fact))){
              updatedfacts=updatedfacts+@(s.concat(s.concat(s.concat(s.concat(s.concat(s.concat("{\"entity\":";jstr(entity));",\"old\":");jstr(exfact));",\"new\":");jstr(fact));"}"));
              mem=mem.set(m;fact);
              replaced=true
            }el{replaced=true}
          }
        }
      }
    };
    if(!(replaced)){
      mem=mem+@(fact);
      newfacts=newfacts+@(s.concat(s.concat(s.concat(s.concat("{\"entity\":";jstr(entity));",\"fact\":");jstr(fact));"}"))
    }
  };
  (* build updated_memory: only this entity *)
  let memarr=mut."";
  lp(let m=0;m<mem.len() as i64;m=m+1){
    if(m>0){memarr=s.concat(memarr;",")};
    memarr=s.concat(memarr;jstr(mem.get(m)))
  };
  let updmem=mut."";
  if(s.eq(entity;"")){updmem="{}"}el{
    updmem=s.concat(s.concat(s.concat(s.concat("{";jstr(entity));":[");memarr);"]}")
  };
  (* new_facts array *)
  let nfstr=mut."";
  lp(let k=0;k<newfacts.len() as i64;k=k+1){
    if(k>0){nfstr=s.concat(nfstr;",")};
    nfstr=s.concat(nfstr;newfacts.get(k))
  };
  let ufstr=mut."";
  lp(let k=0;k<updatedfacts.len() as i64;k=k+1){
    if(k>0){ufstr=s.concat(ufstr;",")};
    ufstr=s.concat(ufstr;updatedfacts.get(k))
  };
  let out=s.concat(s.concat(s.concat(s.concat(s.concat(s.concat("{\"updated_memory\":";updmem);",\"new_facts\":[");nfstr);"],\"updated_facts\":[");ufstr);"]}");
  io.println(out);
  <0
}
