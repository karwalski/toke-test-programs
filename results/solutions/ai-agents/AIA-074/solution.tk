m=commenttrans;
i=io:std.io;
i=s:std.str;

# Honest implementation: parse the JSON, extract the "code" field, and
# walk it preserving code structure. Comment text would need an NL
# translation engine (std.llm) which is unavailable offline, so comment
# text is passed through unchanged rather than hardcoding canned strings.

f=getfield(line:$str;key:$str):$str{
  let needle=s.concat("\"";s.concat(key;"\":\""));
  let idx=s.indexof(line;needle);
  if(idx<0){<""};
  let start=idx+(s.len(needle) as i64);
  let rest=mt s.slice(line;start;s.len(line) as i64){ $ok:v v; $err:e "" };
  # value ends at the next unescaped quote; inputs here contain no escaped quotes
  let endrel=s.indexof(rest;"\"");
  if(endrel<0){<rest};
  <(mt s.slice(rest;0;endrel){ $ok:v v; $err:e "" })
};

# Replace the literal two-character sequence backslash-n with a real newline.
f=unescapenl(code:$str):$str{
  <s.replace(code;"\\n";"\n")
};

f=main():$i64{
  let line=io.readln();
  let code=getfield(line;"code");
  # Comment translation requires an LLM/dictionary; without one we can only
  # faithfully reproduce the code with its comments unchanged.
  let out=unescapenl(code);
  io.println(out);
  <0
}
