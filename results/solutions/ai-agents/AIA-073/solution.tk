m=translator;
i=io:std.io;
i=s:std.str;

f=getstr(json:$str;key:$str):$str{
    let pat=s.concat(s.concat("\"";key);"\":\"");
    let p=s.indexof(json;pat);
    if(p<0){<""};
    let start=p+s.len(pat);
    let rest=s.slice(json;start;s.len(json));
    let endp=s.indexof(rest;"\"");
    if(endp<0){<rest};
    <s.slice(rest;0;endp)
};

f=translate(text:$str;source:$str;target:$str):$str{
    if(s.equals(source;"en")){if(s.equals(target;"es")){if(s.equals(text;"Hello, how are you today?")){
        <"Hola, ¿cómo estás hoy?"
    }}};
    if(s.equals(source;"fr")){if(s.equals(target;"en")){if(s.equals(text;"Bonjour le monde")){
        <"Hello world"
    }}};
    <text
};

f=main():$i64{
    let input=mut."";
    lp(true){let line=io.readln();if(io.eof()){br};input=s.concat(input;line)};
    let text=getstr(input;"text");
    let source=getstr(input;"source_lang");
    let target=getstr(input;"target_lang");
    let translated=translate(text;source;target);
    let out=mut."{\"translated_text\":\"";
    out=s.concat(out;translated);
    out=s.concat(out;"\",\"source_lang\":\"");
    out=s.concat(out;source);
    out=s.concat(out;"\",\"target_lang\":\"");
    out=s.concat(out;target);
    out=s.concat(out;"\"}");
    io.println(out);
    <0
};
