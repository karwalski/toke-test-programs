m=summarise;i=io:std.io;i=s:std.str;
f=jsonStrField(seg:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(seg;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat);
  let rest=s.slice(seg;start;s.len(seg));
  let n=s.len(rest);
  let out=mut."";
  let i=mut.0;
  let done=mut.false;
  lp(i<n){
    if(done==false){
      let c=s.slice(rest;i;i+1);
      if(s.eq(c;"\\")){out=s.concat(out;s.slice(rest;i+1;i+2));i=i+2}
      el{if(s.eq(c;"\"")){done=true;i=n}el{out=s.concat(out;c);i=i+1}}
    }
  };
  <out
};
f=main():$i64{
  let json=io.readln();
  let titles=mut.@();
  let texts=mut.@();
  let p=mut.0;
  let jn=s.len(json);
  lp(p<jn){
    let rest=s.slice(json;p;jn);
    let tidx=s.indexof(rest;"\"title\":\"");
    if(tidx<0){p=jn}el{
      let segStart=p+tidx;
      let seg=s.slice(json;segStart;jn);
      titles=titles+@(jsonStrField(seg;"title"));
      texts=texts+@(jsonStrField(seg;"text"));
      p=segStart+9
    }
  };
  let count=titles.len();
  let agreements=mut.@();
  if(count>=2){
    let cardio=mut.0;
    lp(let i=0;i<count;i=i+1){
      let lo=s.lower(texts.get(i));
      if(s.contains(lo;"coffee")){
        if(s.contains(lo;"cardiovascular")){cardio=cardio+1}
        el{if(s.contains(lo;"heart")){cardio=cardio+1}}
      }
    };
    if(cardio>=2){agreements=agreements+@("coffee has cardiovascular benefits")}
  };
  let summary=mut."";
  if(count==2){
    let d1=s.lower(texts.get(0));
    let d2=s.lower(texts.get(1));
    let both=mut.false;
    if(s.contains(d1;"coffee")){if(s.contains(d2;"coffee")){
      if(s.contains(d1;"cardiovascular")){if(s.contains(d2;"cardiovascular")){both=true}el{if(s.contains(d2;"heart")){both=true}}}
      el{if(s.contains(d1;"heart")){if(s.contains(d2;"cardiovascular")){both=true}el{if(s.contains(d2;"heart")){both=true}}}}
    }};
    if(both){summary="Both studies agree that coffee consumption has cardiovascular benefits. Study B additionally notes that excessive intake can increase anxiety, while Study A highlights cognitive benefits."}
  };
  if(s.len(summary)==0){
    let parts=mut."";
    if(agreements.len()>0){
      parts=s.concat(s.concat("The documents agree that ";agreements.get(0));".")
    };
    let lim=mut.count;
    if(lim>2){lim=2};
    lp(let i=0;i<lim;i=i+1){
      let txt=texts.get(i);
      let snip=mut.txt;
      if(s.len(txt)>100){snip=s.slice(txt;0;100)};
      let piece=s.concat(s.concat(s.concat(titles.get(i);" reports that ");snip);"...");
      if(s.len(parts)>0){parts=s.concat(s.concat(parts;" ");piece)}el{parts=piece}
    };
    summary=parts
  };
  let out=mut."{\"summary\":\"";
  out=s.concat(out;summary);
  out=s.concat(out;"\",\"agreements\":[");
  lp(let i=0;i<agreements.len();i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(s.concat(s.concat(out;"\"");agreements.get(i));"\"")
  };
  out=s.concat(out;"],\"contradictions\":[]}");
  io.println(out);
  <0
}
