m=textchunker;
i=io:std.io;
i=str:std.str;

f=getint(obj:$str;key:$str):$i64{
  let pat=str.concat(str.concat("\"";key);"\":");
  let idx=str.indexof(obj;pat);
  if(idx<0){<0};
  let start=idx+(str.len(pat) as i64);
  let n=mut.0;
  let neg=mut.false;
  let bytes=str.bytes(obj);
  let i=mut.start;
  lp(let z=0;z<1000000;z=z+1){
    if(i>=(str.len(obj) as i64)){br};
    let b=bytes.get(i as u64);
    let c=(b as i64);
    if(c=45){neg=true;i=i+1}el{
      if(c>=48){if(c<=57){n=n*10+(c-48);i=i+1}el{br}}el{br}
    };
  };
  if(neg){<0-n};
  <n
};

f=getstr(obj:$str;key:$str):$str{
  let pat=str.concat(str.concat("\"";key);"\":\"");
  let idx=str.indexof(obj;pat);
  if(idx<0){<""};
  let start=idx+(str.len(pat) as i64);
  let rest=mt str.slice(obj;start as u64;str.len(obj)){ $ok:v v; $err:e "" };
  let q=str.indexof(rest;"\"");
  if(q<0){<rest};
  <mt str.slice(rest;0;q as u64){ $ok:v v; $err:e "" }
};

f=jsonesc(s:$str):$str{
  let bytes=str.bytes(s);
  let out=mut."";
  let n=str.len(s);
  lp(let i=0;i<(n as i64);i=i+1){
    let b=bytes.get(i as u64);
    let c=(b as i64);
    if(c=34){out=str.concat(out;"\\\"")}el{
      if(c=92){out=str.concat(out;"\\\\")}el{
        let ch=mt str.slice(s;i as u64;(i+1) as u64){ $ok:v v; $err:e "" };
        out=str.concat(out;ch)
      }
    };
  };
  <out
};

f=main():i64{
  let line=io.readln();
  let text=getstr(line;"text");
  let chunksize=getint(line;"chunk_size");
  let overlap=getint(line;"overlap");
  let len=(str.len(text) as i64);

  let out=mut."[";
  let chunkid=mut.0;
  let start=mut.0;
  let first=mut.true;
  lp(let z=0;z<1000000;z=z+1){
    if(start>=len){br};
    let end=mut.start+chunksize;
    if(end>len){end=len};
    let slice=mt str.slice(text;start as u64;end as u64){ $ok:v v; $err:e "" };
    if(!(first)){out=str.concat(out;",")};
    first=false;
    out=str.concat(out;"{\"chunk_id\":");
    out=str.concat(out;str.fromint(chunkid));
    out=str.concat(out;",\"text\":\"");
    out=str.concat(out;jsonesc(slice));
    out=str.concat(out;"\",\"start_offset\":");
    out=str.concat(out;str.fromint(start));
    out=str.concat(out;",\"end_offset\":");
    out=str.concat(out;str.fromint(end));
    out=str.concat(out;"}");
    chunkid=chunkid+1;
    if(end>=len){br};
    start=end-overlap;
  };
  out=str.concat(out;"]");
  io.println(out);
  <0
};
