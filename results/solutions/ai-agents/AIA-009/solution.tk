m=schedule;
i=io:std.io;
i=str:std.str;

f=streq(a:$str;b:$str):$bool{
  if(!(str.len(a)==str.len(b))){<false};
  if(str.len(a)==0){<true};
  let idx=str.indexof(a;b);
  if(idx==0){<true};
  <false
};

f=getintfrom(obj:$str;key:$str):$i64{
  let pat=str.concat(str.concat("\"";key);"\":");
  let idx=str.indexof(obj;pat);
  if(idx<0){<0};
  let start=idx+(str.len(pat) as i64);
  let n=mut.0;
  let bytes=str.bytes(obj);
  let i=mut.start;
  lp(let z=0;z<1000000;z=z+1){
    if(i>=(str.len(obj) as i64)){br};
    let c=(bytes.get(i as u64) as i64);
    if(c==32){i=i+1}el{
      if(c>=48){if(c<=57){n=n*10+(c-48);i=i+1}el{br}}el{br}
    };
  };
  <n
};

f=main():i64{
  let line=io.readln();

  let rlidx=str.indexof(line;"\"rate_limits\"");
  let rlpart=mut."";
  if(rlidx>=0){
    rlpart=mt str.slice(line;rlidx as u64;str.len(line)){ $ok:v v; $err:e "" };
  };

  let tools=mut.@();
  let cur=mut.line;
  lp(let z=0;z<100000;z=z+1){
    let oidx=str.indexof(cur;"{\"tool\":\"");
    if(oidx<0){br};
    let after=mt str.slice(cur;(oidx+9) as u64;str.len(cur)){ $ok:v v; $err:e "" };
    let q=str.indexof(after;"\"");
    if(q<0){br};
    let tool=mt str.slice(after;0;q as u64){ $ok:v v; $err:e "" };
    tools=tools+@(tool);
    cur=mt str.slice(after;q as u64;str.len(after)){ $ok:v v; $err:e "" };
  };

  let nc=(tools.len as i64);

  let exectimes=mut.@();
  lp(let i=0;i<nc;i=i+1){
    let tool=tools.get(i as u64);
    let count=mut.0;
    lp(let j=0;j<i;j=j+1){
      if(streq(tools.get(j as u64);tool)){count=count+1};
    };
    let rate=mut.getintfrom(rlpart;tool);
    if(rate<=0){rate=1};
    let win=count/rate;
    exectimes=exectimes+@(win*60000);
  };

  let order=mut.@();
  lp(let i=0;i<nc;i=i+1){order=order+@(i)};

  lp(let a=0;a<nc;a=a+1){
    lp(let b=0;b<(nc-a-1);b=b+1){
      let ia=order.get(b as u64);
      let ib=order.get((b+1) as u64);
      let ta=exectimes.get(ia as u64);
      let tb=exectimes.get(ib as u64);
      let swap=mut.false;
      if(ta>tb){swap=true}el{
        if(ta==tb){if(ia>ib){swap=true}};
      };
      if(swap){
        order=order.set(b as u64;ib);
        order=order.set((b+1) as u64;ia);
      };
    };
  };

  let out=mut."[";
  lp(let i=0;i<nc;i=i+1){
    let oi=order.get(i as u64);
    let tool=tools.get(oi as u64);
    let t=exectimes.get(oi as u64);
    if(i>0){out=str.concat(out;",")};
    out=str.concat(out;"{\"call\":{\"tool\":\"");
    out=str.concat(out;tool);
    out=str.concat(out;"\"},\"execute_at_ms\":");
    out=str.concat(out;str.fromint(t));
    out=str.concat(out;"}");
  };
  out=str.concat(out;"]");
  io.println(out);
  <0
};
