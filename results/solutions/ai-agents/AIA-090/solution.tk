m=depcheck;i=io:std.io;i=s:std.str;i=j:std.json;
f=compareversions(v1:$str;v2:$str):$i64{
  let p1=s.split(v1;".");let p2=s.split(v2;".");
  let idx=mut.0;
  lp(idx<p1.len()){
    if(idx>=p2.len()){<1};
    let n1=s.toint(p1.get(idx));let n2=s.toint(p2.get(idx));
    if(n1<n2){<0-1}el{if(n1>n2){<1}};
    idx=idx+1};
  if(p2.len()>p1.len()){<0-1};
  <0};
f=main():$i64{
  let input=mt j.dec(io.readln()){$ok:v v;$err:e j.obj("{}")};
  let imports=j.getarr(input;"imports");
  let vulns=j.getarr(input;"known_vulnerabilities");
  let nimp=j.arrlen(imports);
  let nvuln=j.arrlen(vulns);
  let issues=mut.@($str);
  let idx=mut.0;
  lp(idx<nimp){
    let imp=j.arrget(imports;idx);
    let name=j.getstr(imp;"name");
    let version=j.getstr(imp;"version");
    let usedin=j.getarr(imp;"used_in");
    let usedlen=mut.0;
    if(usedin!=0){usedlen=j.arrlen(usedin)};
    let found=mut.false;
    let vidx=mut.0;
    lp(vidx<nvuln){
      let vuln=j.arrget(vulns;vidx);
      let vname=j.getstr(vuln;"package");
      if(s.eq(vname;name)){
        let affected=j.getstr(vuln;"affected_versions");
        if(s.contains(affected;"<")){
          let minver=s.slice(affected;1;s.len(affected));
          if(compareversions(version;minver)<0){
            let issue=s.concat("{\"package\":\"";s.concat(name;s.concat("\",\"type\":\"vulnerability\",\"severity\":\"high\",\"detail\":\"Version ";s.concat(version;s.concat(" is affected, upgrade to ";s.concat(minver;"+\"}"))))));
            issues=issues+@(issue);
            found=true;
          };
        };
      };
      vidx=vidx+1};
    if(usedlen==0){
      if(found==false){
        let issue=s.concat("{\"package\":\"";s.concat(name;"\",\"type\":\"unused\",\"severity\":\"low\",\"detail\":\"Imported but not used in any file\"}"));
        issues=issues+@(issue);
      };
    };
    idx=idx+1};
  let out=mut."{\"issues\":[";
  let oi=mut.0;
  lp(oi<issues.len()){
    if(oi>0){out=s.concat(out;",")};
    out=s.concat(out;issues.get(oi));
    oi=oi+1};
  out=s.concat(out;"]}");
  io.println(out);
  <0}
