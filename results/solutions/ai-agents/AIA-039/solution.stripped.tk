  if(joym>0){let iv=mut.0.3+(joym as$f64)*0.2;if(iv>1.0){iv=1.0};if(s.contains(nt;"_")){if(iv<0.8){iv=0.8}}el{if(hasword(nt;"_")){if(iv<0.7){iv=0.7}}};labels=labels+@("_");intens=intens+@(iv)};
  let surm=mut.0;
  if(hasword(nt;"_")||hasword(nt;"_")){surm=surm+1};
  if(hasword(nt;"_")){surm=surm+1};
  if(hasword(nt;"_")){surm=surm+1};
