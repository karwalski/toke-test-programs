m=emo;i=io:std.io;i=s:std.str;
f=norm(t:$str):$str{let r=mut.s.lower(t);r=s.replace(r;"_";"_");r=s.replace(r;"_";"_");r=s.replace(r;"_";"_");r=s.replace(r;"_";"_");r=s.replace(r;"_";"_");<s.concat(s.concat("_";r);"_")};
f=hasword(t:$str;w:$str):$bool{<s.contains(t;s.concat(s.concat("_";w);"_"))};
f=fmt(x:$f64):$str{let scaled=mut.0;let i=mut.0;lp(i<10){let v=(i as$f64)/10.0;if(x>=v){scaled=i};i=i+1};let whole=scaled/10;let frac=scaled-whole*10;<s.concat(s.concat(s.fromint(whole);"_");s.fromint(frac))};
f=main():$i64{
  let text=s.trim(io.readln());
