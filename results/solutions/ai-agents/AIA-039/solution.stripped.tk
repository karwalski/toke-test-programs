  if(hasword(nt;"_")){surm=surm+1};
  if(surm>0){let iv=mut.0.3+(surm as$f64)*0.2;if(iv>1.0){iv=1.0};if(s.contains(nt;"_")&&hasword(nt;"_")){if(iv<0.7){iv=0.7}}el{if(hasword(nt;"_")){if(iv<0.6){iv=0.6}}};labels=labels+@("_");intens=intens+@(iv)};
  let n=labels.len();
  let idx=mut.@($i64);
  lp(let i=0;i<n;i=i+1){idx=idx+@(i)};
  lp(let a=0;a<n;a=a+1){lp(let b=0;b<n-1-a;b=b+1){let x=idx.get(b);let y=idx.get(b+1);if(intens.get(x)<intens.get(y)){idx=idx.set(b;y);idx=idx.set(b+1;x)}}};
  let out=mut."_"emotions\"_";
  lp(let i=0;i<n;i=i+1){if(i>0){out=s.concat(out;"_")};let k=idx.get(i);out=s.concat(out;"_"label\"_""_"\"_"intensity\"_");out=s.concat(out;fmt(intens.get(k)));out=s.concat(out;"_")};
  out=s.concat(out;"_");
  io.println(out);
