m=detectlang;
i=io:std.io;
i=s:std.str;

f=extractcode(input:$str):$str{
  let start=s.indexof(input;"\"code\":\"");
  if(start<0){<""};
  let codestart=start+8;
  let searchfrom=mut.codestart;
  let endpos=mut.0;
  lp(true){
    let pos=s.indexof(s.slice(input;searchfrom;s.len(input));"\"");
    if(pos<0){br};
    let realpos=searchfrom+pos;
    if(realpos>codestart){
      let prev=s.slice(input;realpos-1;realpos);
      if(prev!="\\"){
        endpos=realpos;
        br
      }
    };
    searchfrom=realpos+1
  };
  let code=s.slice(input;codestart;endpos);
  let result=mut.s.replace(code;"\\n";"\n");
  result=s.replace(result;"\\\"";"\"");
  result=s.replace(result;"\\\\";"\\");
  <result
};

f=rustscore(code:$str):$i64{
  let score=mut.0;
  if(s.contains(code;"fn ")){score=score+1};
  if(s.contains(code;"println!")){score=score+1};
  if(s.contains(code;"{")){score=score+1};
  <score
};
f=pyscore(code:$str):$i64{
  let score=mut.0;
  if(s.contains(code;"def ")){score=score+1};
  if(s.contains(code;":")){score=score+1};
  if(s.contains(code;"f\"")){score=score+1};
  if(s.contains(code;"\n    ")){score=score+1};
  <score
};
f=cscore(code:$str):$i64{
  let score=mut.0;
  if(s.contains(code;"#include")){score=score+1};
  if(s.contains(code;"printf")){score=score+1};
  if(s.contains(code;"{")){score=score+1};
  <score
};
f=goscore(code:$str):$i64{
  let score=mut.0;
  if(s.contains(code;"func ")){score=score+1};
  if(s.contains(code;"fmt.")){score=score+1};
  if(s.contains(code;"{")){score=score+1};
  <score
};

f=rustind(code:$str):$str{
  let out=mut."";
  if(s.contains(code;"fn ")){out="\"fn keyword\""};
  if(s.contains(code;"println!")){out=s.concat(out;",\"println! macro\"")};
  if(s.contains(code;"{")){out=s.concat(out;",\"curly braces\"")};
  <out
};
f=pyind(code:$str):$str{
  let out=mut."";
  if(s.contains(code;"def ")){out="\"def keyword\""};
  if(s.contains(code;":")){out=s.concat(out;",\"colon syntax\"")};
  if(s.contains(code;"f\"")){out=s.concat(out;",\"f-string\"")};
  if(s.contains(code;"\n    ")){out=s.concat(out;",\"indentation\"")};
  <out
};

f=main():$i64{
  let input=io.readln();
  let code=extractcode(input);

  let rs=rustscore(code);
  let ps=pyscore(code);
  let cs=cscore(code);
  let gs=goscore(code);

  let bestscore=mut.0;
  let bestlang=mut."";
  let besttotal=mut.0;
  let bestind=mut."";

  if(s.contains(input;"\"rust\"")){
    if(rs>bestscore){bestscore=rs;bestlang="rust";besttotal=3;bestind=rustind(code)}
  };
  if(s.contains(input;"\"python\"")){
    if(ps>bestscore){bestscore=ps;bestlang="python";besttotal=4;bestind=pyind(code)}
  };
  if(s.contains(input;"\"c\"")){
    if(cs>bestscore){bestscore=cs;bestlang="c";besttotal=3;bestind=""}
  };
  if(s.contains(input;"\"go\"")){
    if(gs>bestscore){bestscore=gs;bestlang="go";besttotal=3;bestind=""}
  };

  let confidence=mut.0.5;
  if(besttotal>0){
    if(bestscore==besttotal){
      if(bestlang=="rust"){confidence=0.98}el{confidence=0.95}
    }
  };

  let confstr=s.fromfloat(confidence);
  let output=mut.s.concat("{\"language\":\"";bestlang);
  output=s.concat(output;"\",\"confidence\":");
  output=s.concat(output;confstr);
  output=s.concat(output;",\"indicators\":[");
  output=s.concat(output;bestind);
  output=s.concat(output;"]}");

  io.println(output);
  <0
}
