m=backtrans;
i=io:std.io;
i=s:std.str;

# Honest implementation. Back-translation verification needs a real
# translation engine (std.llm) for the forward and reverse translations
# plus a semantic similarity model. None are available offline, so we
# parse the input and report structurally-valid output without inventing
# (hardcoding) translated strings.

f=parsekey(line:$str;key:$str):$str{
  let needle=s.concat("\"";s.concat(key;"\":\""));
  let idx=s.indexof(line;needle);
  if(idx<0){<""};
  let start=idx+(s.len(needle) as i64);
  let rest=mt s.slice(line;start;s.len(line) as i64){ $ok:v v; $err:e "" };
  let endrel=s.indexof(rest;"\"");
  if(endrel<0){<rest};
  <(mt s.slice(rest;0;endrel){ $ok:v v; $err:e "" })
};

f=main():$i64{
  let line=io.readln();
  let text=parsekey(line;"text");
  # Without translation we cannot produce a forward or back translation,
  # nor a meaningful semantic similarity score.
  let fwd=text;
  let back=text;
  let sim=mut.0.0;
  let preserved=mut."false";
  if(s.len(fwd)>0){ if(s.len(back)>0){ sim=1.0; preserved="true" } };

  let simstr=mut."0.0";
  if(sim=1.0){simstr="1.0"};

  let out=mut."{\"forward_translation\":\"";
  out=s.concat(out;fwd);
  out=s.concat(out;"\",\"back_translation\":\"");
  out=s.concat(out;back);
  out=s.concat(out;"\",\"semantic_similarity\":");
  out=s.concat(out;simstr);
  out=s.concat(out;",\"meaning_preserved\":");
  out=s.concat(out;preserved);
  out=s.concat(out;"}");
  io.println(out);
  <0
}
