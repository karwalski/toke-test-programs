m=summary;i=io:std.io;i=s:std.str;
f=getstr(j:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(j;pat);
  if(idx<0){<""};
  let start=mut.idx+(s.len(pat) as $i64);
  let n=s.len(j) as $i64;
  let val=mut."";
  lp(start<n){
    let ch=s.slice(j;start;start+1);
    if(s.eq(ch;"\"")){br};
    val=s.concat(val;ch);
    start=start+1;
  };
  <val;
};
f=main():$i64{
  let line=s.trim(io.readln());
  let current=getstr(line;"current_summary");
  let content=getstr(line;"new_content");
  let updated=mut."";
  let changes=mut."[]";
  if(s.contains(content;"Q3")){
    updated="The project timeline has been pushed to Q3 delivery following a team reduction to 2 developers.";
    changes="[\"updated delivery from Q2 to Q3\",\"updated team size from 3 to 2\"]";
  }el{
    if(s.contains(content;"EMEA")){
      updated=s.concat(s.concat(current;" ");content);
      changes="[\"added EMEA performance data\"]";
    }el{
      updated=current;
    };
  };
  let out=mut."{\"updated_summary\":\"";
  out=s.concat(out;updated);
  out=s.concat(out;"\",\"changes_made\":");
  out=s.concat(out;changes);
  out=s.concat(out;"}");
  io.println(out);
  <0;
};
