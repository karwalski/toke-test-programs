m=dispatch;i=io:std.io;i=s:std.str;i=json:std.json;
f=pdoc(x:$str):Json{<mt json.dec(x){$ok:d d;$err:e pdoc("{}")}};
f=setint(a:@($i64);idx:$i64;v:$i64):@($i64){
let r=mut.@(); let n=a.len(); let i=mut.0;
lp(i<n){ if(i=idx){r=r+@(v)}el{r=r+@(a.get(i))}; i=i+1; };
<r};
f=setstr(a:@($str);idx:$i64;v:$str):@($str){
let r=mut.@(); let n=a.len(); let i=mut.0;
lp(i<n){ if(i=idx){r=r+@(v)}el{r=r+@(a.get(i))}; i=i+1; };
<r};
f=main():$i64{
let line=io.readln();
let d=pdoc(line);
let items=json.getarr(d;"work_items");
let agents=json.getarr(d;"agents");
let na=agents.len();
let ni=items.len();
let loads=mut.@();
let caps=mut.@();
let listbufs=mut.@();
let ai=mut.0;
lp(ai<na){
loads=loads+@(0);
let ag=agents.get(ai);
caps=caps+@(json.getint(ag;"capacity"));
listbufs=listbufs+@("");
ai=ai+1;
};
let wi=mut.0;
lp(wi<ni){
let it=items.get(wi);
let itid=json.getstr(it;"id");
let itype="\(json.getstr(it;"type"))";
let cx=json.getint(it;"complexity");
let best=mut.0-1;
let bestload=mut.0;
let k=mut.0;
lp(k<na){
let ag=agents.get(k);
let specs=json.getarr(ag;"specialties");
let ns=specs.len();
let hit=mut.false;
let si=mut.0;
lp(si<ns){
let sp="\(specs.get(si).raw)";
if(sp=json.enc(itype)){hit=true};
si=si+1;
};
let curload=loads.get(k);
let cap=caps.get(k);
if(hit){
if((curload+cx)<=cap){
if(best<0){best=k;bestload=curload}el{if(curload<bestload){best=k;bestload=curload}};
};
};
k=k+1;
};
if(best>=0){
loads=setint(loads;best;loads.get(best)+cx);
let cur=listbufs.get(best);
let nv=mut."";
if(cur=""){nv=json.enc(itid)}el{nv="\(cur),\(json.enc(itid))"};
listbufs=setstr(listbufs;best;nv);
};
wi=wi+1;
};
let b=s.buf();
s.add(b;"{");
let first=mut.true;
let oi=mut.0;
lp(oi<na){
let ag=agents.get(oi);
let id=json.getstr(ag;"id");
if(first=false){s.add(b;",")};
first=false;
s.add(b;json.enc(id));
s.add(b;":[");
s.add(b;listbufs.get(oi));
s.add(b;"]");
oi=oi+1;
};
s.add(b;"}");
io.println(s.done(b));
<0};
