                  answer=s.concat("_";s.concat(id;"_"));
                  cite=id;
                };
              };
            };
            i=i+1;
          };
        };
      };
    };
  };

  let out=mut."_"answer\"_""_"\"_"cited_chunks\"_");
  if(s.equals(cite;"_")){
