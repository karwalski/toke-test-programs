  lp(s.len(line)>0){raw=s.concat(raw;line);line=io.readln()};
  let input=raw;
  let qlow=s.lower(jsonfield(input;"_"));

  let answer=mut."_";
  let cite=mut."_";

  if(s.contains(qlow;"_")){
