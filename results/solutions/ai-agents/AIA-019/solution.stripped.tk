            let id=jsonfield(part;"_");
            answer=s.concat("_";s.concat(id;"_"));
            cite=id;
          };
        };
        i=i+1;
      };
    };
  };

  if(s.equals(answer;"_")){
    if(s.contains(qlow;"_")){
      if(s.contains(qlow;"_")){
        if(s.contains(qlow;"_")){
          let chunks=s.split(input;"_");
          let i=mut.0;
