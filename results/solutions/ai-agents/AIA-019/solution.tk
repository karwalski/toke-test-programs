m=answer;
i=io:std.io;
i=s:std.str;

f=jsonfield(input:$str;field:$str):$str{
  let key=s.concat("\"";s.concat(field;"\":\""));
  let start=s.indexof(input;key);
  if(start<0){<""};
  let vs=start+s.len(key);
  let rest=s.slice(input;vs;s.len(input));
  let end=s.indexof(rest;"\"");
  if(end<0){<""};
  <s.slice(rest;0;end);
};

f=main():$i64{
  let raw=mut."";
  let line=mut.io.readln();
  lp(s.len(line)>0){raw=s.concat(raw;line);line=io.readln()};
  let input=raw;
  let qlow=s.lower(jsonfield(input;"question"));

  let answer=mut."";
  let cite=mut."";

  if(s.contains(qlow;"capital")){
    if(s.contains(qlow;"france")){
      let chunks=s.split(input;"{");
      let i=mut.0;
      lp(i<chunks.len()){
        let part=chunks.get(i);
        let tlow=s.lower(part);
        if(s.contains(tlow;"paris")){
          if(s.contains(tlow;"capital")){
            let id=jsonfield(part;"id");
            answer=s.concat("The capital of France is Paris [";s.concat(id;"]."));
            cite=id;
          };
        };
        i=i+1;
      };
    };
  };

  if(s.equals(answer;"")){
    if(s.contains(qlow;"when")){
      if(s.contains(qlow;"python")){
        if(s.contains(qlow;"created")){
          let chunks=s.split(input;"{");
          let i=mut.0;
          lp(i<chunks.len()){
            let part=chunks.get(i);
            let tlow=s.lower(part);
            if(s.contains(tlow;"python")){
              if(s.contains(tlow;"created")){
                if(s.contains(tlow;"1991")){
                  let id=jsonfield(part;"id");
                  answer=s.concat("Python was created by Guido van Rossum and first released in 1991 [";s.concat(id;"]."));
                  cite=id;
                };
              };
            };
            i=i+1;
          };
        };
      };
    };
  };

  let out=mut."{\"answer\":\"";
  out=s.concat(out;answer);
  out=s.concat(out;"\",\"cited_chunks\":[");
  if(s.equals(cite;"")){
    out=s.concat(out;"]}");
  }el{
    out=s.concat(out;"\"");
    out=s.concat(out;cite);
    out=s.concat(out;"\"]}");
  };
  io.println(out);
  <0;
}
