m=chunkopt;
i=io:std.io;
i=str:std.str;

f=getint(obj:$str;key:$str):$i64{
  let pat=str.concat(str.concat("\"";key);"\":");
  let idx=str.indexof(obj;pat);
  if(idx<0){<0};
  let start=idx+(str.len(pat) as i64);
  let n=mut.0;
  let bytes=str.bytes(obj);
  let i=mut.start;
  lp(let z=0;z<1000000;z=z+1){
    if(i>=(str.len(obj) as i64)){br};
    let c=(bytes.get(i as u64) as i64);
    if(c>=48){if(c<=57){n=n*10+(c-48);i=i+1}el{br}}el{br};
  };
  <n
};

f=getstr(obj:$str;key:$str):$str{
  let pat=str.concat(str.concat("\"";key);"\":\"");
  let idx=str.indexof(obj;pat);
  if(idx<0){<""};
  let start=idx+(str.len(pat) as i64);
  let rest=mt str.slice(obj;start as u64;str.len(obj)){ $ok:v v; $err:e "" };
  let q=str.indexof(rest;"\"");
  if(q<0){<rest};
  <mt str.slice(rest;0;q as u64){ $ok:v v; $err:e "" }
};

f=jsonesc(s:$str):$str{
  let bytes=str.bytes(s);
  let out=mut."";
  let n=str.len(s);
  lp(let i=0;i<(n as i64);i=i+1){
    let c=(bytes.get(i as u64) as i64);
    if(c==34){out=str.concat(out;"\\\"")}el{
      if(c==92){out=str.concat(out;"\\\\")}el{
        let ch=mt str.slice(s;i as u64;(i+1) as u64){ $ok:v v; $err:e "" };
        out=str.concat(out;ch)
      }
    };
  };
  <out
};

f=main():i64{
  let line=io.readln();
  let text=getstr(line;"text");
  let maxsize=getint(line;"max_chunk_size");

  let parts=str.split(text;". ");
  let np=(parts.len as i64);
  let sents=mut.@();
  lp(let i=0;i<np;i=i+1){
    let p=parts.get(i as u64);
    if(i<(np-1)){sents=sents+@(str.concat(p;"."))}el{sents=sents+@(p)};
  };

  let ns=(sents.len as i64);
  let chunks=mut.@();
  let cur=mut."";
  lp(let i=0;i<ns;i=i+1){
    let s=sents.get(i as u64);
    let cand=mut.s;
    if(!(str.len(cur)==0)){cand=str.concat(str.concat(cur;" ");s)};
    if((str.len(cand) as i64)<=maxsize){cur=cand}el{
      if(!(str.len(cur)==0)){chunks=chunks+@(cur)};
      cur=s;
    };
  };
  if(!(str.len(cur)==0)){chunks=chunks+@(cur)};

  let nc=(chunks.len as i64);
  let out=mut."[";
  lp(let i=0;i<nc;i=i+1){
    if(i>0){out=str.concat(out;",")};
    out=str.concat(out;"\"");
    out=str.concat(out;jsonesc(chunks.get(i as u64)));
    out=str.concat(out;"\"");
  };
  out=str.concat(out;"]");
  io.println(out);
  <0
};
