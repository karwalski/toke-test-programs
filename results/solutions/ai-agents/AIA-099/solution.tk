m=decompose;i=io:std.io;i=s:std.str;
f=countdigits(str:$str):i64{
  let n=s.len(str);
  let count=mut.0;
  lp(let i=0 as u64;i<n;i=i+1 as u64){
    let c=s.get(str;i) as i64;
    if(c>47){if(c<58){count=count+1}}
  };
  <count
};
f=main():i64{
  io.println(s.fromint(countdigits("hello123world456")));
  <0
};
