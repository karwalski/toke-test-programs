m=dispatcher;
i=io:std.io;
i=s:std.str;
f=stripend(w:$str):$str{
  let n=s.len(w);
  let out=mut.w;
  lp(s.len(out)>0){
    let last=s.slice(out;s.len(out)-1;s.len(out));
    if(s.eq(last;"?")||s.eq(last;".")||s.eq(last;",")||s.eq(last;"!")){
      out=s.slice(out;0;s.len(out)-1)
    }el{
      br
    }
  };
  <out
};
f=titlecase(w:$str):$str{
  if(s.len(w)==0){<w};
  let first=s.upper(s.slice(w;0;1));
  let rest=s.lower(s.slice(w;1;s.len(w)));
  <s.concat(first;rest)
};
f=wordafter(query:$str;marker:$str):$str{
  let words=s.split(query;" ");
  let found=mut.false;
  let res=mut."";
  lp(let idx=0;idx<words.len();idx=idx+1){
    let word=words.get(idx);
    if(found){
      res=stripend(word);
      br
    };
    if(s.eq(s.lower(word);marker)){
      found=true
    }
  };
  <res
};
f=parsestr(line:$str;key:$str):$str{
  let pat=s.concat("\"";s.concat(key;"\":\""));
  let idx=s.indexof(line;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat);
  let after=s.slice(line;start;s.len(line));
  let cl=s.indexof(after;"\"");
  if(cl<0){<after};
  <s.slice(after;0;cl)
};
f=main():$i64{
  let line=s.trim(io.readln());
  let input=parsestr(line;"query");
  let lowerquery=s.lower(input);
  if(s.contains(lowerquery;"weather")){
    let city=mut.wordafter(input;"in");
    if(s.len(city)==0){city=wordafter(input;"for")};
    let tc=titlecase(city);
    io.println("{\"tool\":\"weather\",\"arguments\":{\"city\":\"\(tc)\"}}")
  }el{
    if(s.contains(lowerquery;"schedule")||s.contains(lowerquery;"calendar")){
      let date=mut.wordafter(input;"for");
      if(s.len(date)==0){date=wordafter(input;"on")};
      io.println("{\"tool\":\"calendar\",\"arguments\":{\"date\":\"\(date)\"}}")
    }el{
      io.println("{\"tool\":null,\"arguments\":{}}")
    }
  };
  <0
}
