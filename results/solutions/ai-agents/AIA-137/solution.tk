m=promptinj;i=io:std.io;i=s:std.str;
f=main():$i64{
  let raw=io.readln();
  let lower=s.lower(raw);
  let patterns=mut.@();
  let hasignore=mut.false;
  if(s.contains(lower;"ignore all previous instructions")){hasignore=true};
  if(s.contains(lower;"ignore previous instructions")){hasignore=true};
  if(hasignore){patterns=patterns+@("ignore previous instructions")};
  let hasrole=mut.false;
  if(s.contains(lower;"you are now a")){hasrole=true};
  if(hasrole){patterns=patterns+@("role reassignment")};
  let istranslate=mut.false;
  if(s.contains(lower;"translate")){
    if(s.contains(raw;":")){istranslate=true}
  };
  let risk=mut."none";
  let safe=mut.true;
  let count=patterns.len as i64;
  if(count>0){
    if(istranslate){
      risk="medium";
      safe=false
    }el{
      risk="high";
      safe=false
    }
  };
  let parr=mut."";
  lp(let i=0;i<patterns.len as i64;i=i+1){
    if(i>0){parr=s.concat(parr;",")};
    parr=s.concat(s.concat(parr;"\"");s.concat(patterns.get(i);"\""))
  };
  let safestr=mut."false";
  if(safe){safestr="true"};
  let out=mut."{\"risk_level\":\"";
  out=s.concat(out;risk);
  out=s.concat(out;"\",\"suspicious_patterns\":[");
  out=s.concat(out;parr);
  out=s.concat(out;"],\"safe_to_process\":");
  out=s.concat(out;safestr);
  out=s.concat(out;"}");
  io.println(out);
  <0
};
