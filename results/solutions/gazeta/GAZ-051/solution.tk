m=lenmm;i=io:std.io;i=s:std.str;
f=fmt(x:f64):$str{
  let raw=s.format(x;"%.10f");
  let n=mut.s.len(raw);
  lp(n>0){ if(s.slice(raw;n-1;n)=="0"){n=n-1}el{br} };
  if(n>0){ if(s.slice(raw;n-1;n)=="."){n=n-1} };
  let r=mut.s.slice(raw;0;n);
  if(r==""){r="0"};
  if(r=="-0"){r="0"};
  <r
};
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  let mm=s.tofloat(toks.get(0));
  io.println(s.concat("cm = ";fmt(mm/10.0)));
  io.println(s.concat("dm = ";fmt(mm/100.0)));
  io.println(s.concat("m = ";fmt(mm/1000.0)));
  io.println(s.concat("dam = ";fmt(mm/10000.0)));
  io.println(s.concat("hm = ";fmt(mm/100000.0)));
  io.println(s.concat("km = ";fmt(mm/1000000.0)));
  <0
};
