m=perfect;i=io:std.io;i=s:std.str;
f=isperfect(n:i64):bool{
  if(n<2){<false};
  let total=mut.1;
  let d=mut.2;
  lp(d*d<=n){
    if(n%d==0){
      total=total+d;
      let q=n/d;
      if(q!=d){total=total+q};
    };
    d=d+1;
  };
  <total==n
};
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  if(toks.len()==0){<0};
  let limit=s.toint(toks.get(0));
  let out=mut."";
  let first=mut.true;
  lp(let n=1;n<=limit;n=n+1){
    if(isperfect(n)){
      if(first){first=false}el{out=s.concat(out;", ")};
      out=s.concat(out;s.fromint(n));
    };
  };
  io.println(out);
  <0
};
