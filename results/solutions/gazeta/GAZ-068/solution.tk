m=answertable;i=io:std.io;i=s:std.str;
f=readall():$str{
  let all=mut."";
  lp(1==1){ let ln=io.readln(); all=s.concat(all;s.concat(ln;" ")); if(io.eof()){br} };
  <all
};
f=main():i64{
  let toks=s.fields(readall());
  if(toks.len()==0){<0};
  let idx=mut.0;
  let m=s.toint(toks.get(idx)); idx=idx+1;
  let q=s.toint(toks.get(idx)); idx=idx+1;
  let cell=mut.@($str);
  lp(let r=0;r<=m;r=r+1){
    lp(let jc=0;jc<q;jc=jc+1){
      cell=cell.push(toks.get(idx)); idx=idx+1;
    };
  };
  let q0=s.toint(toks.get(idx)); idx=idx+1;
  let allcorrect=mut.0;
  lp(let r=1;r<=m;r=r+1){
    let same=mut.true;
    lp(let jc=0;jc<q;jc=jc+1){
      if(cell.get(r*q+jc)!=cell.get(jc)){same=false};
    };
    if(same){allcorrect=allcorrect+1};
  };
  let out=mut."";
  out=s.concat(out;s.concat("all correct: ";s.fromint(allcorrect)));
  if(q0<0||q0>=q){
    out=s.concat(out;s.concat("\ninvalid question index: ";s.fromint(q0)));
  }el{
    let wrong=mut."";
    let first=mut.true;
    lp(let r=1;r<=m;r=r+1){
      if(cell.get(r*q+q0)!=cell.get(q0)){
        if(first){first=false}el{wrong=s.concat(wrong;" ")};
        wrong=s.concat(wrong;s.fromint(r));
      };
    };
    if(first){
      out=s.concat(out;s.concat(s.concat("\nwrong on question ";s.fromint(q0));": (none)"));
    }el{
      out=s.concat(out;s.concat(s.concat(s.concat("\nwrong on question ";s.fromint(q0));": ");wrong));
    };
  };
  io.println(out);
  <0
};
