m=comments;i=io:std.io;i=s:std.str;
f=main():i64{
  # read lines, stopping at first '.' (truncate that line before the dot)
  let lines=mut.@($str);
  let stop=mut.1==0;
  lp(1==1){
    let ln=io.readln();
    let eof=io.eof();
    if(!stop){
      # find '.' in ln
      let dot=mut.0-1;
      lp(let i=0;i<s.len(ln);i=i+1){
        if(dot<0){ if(s.slice(ln;i;i+1)=="."){ dot=i } };
      };
      if(dot>=0){
        let pre=s.slice(ln;0;dot);
        if(s.len(pre)>0){ lines=lines.push(pre) };
        stop=1==1;
      }el{
        lines=lines.push(ln);
      };
    };
    if(eof){ br };
  };
  # part 1: validate balance
  let depth=mut.0;
  let ok=mut.1==1;
  lp(let li=0;li<lines.len();li=li+1){
    let line=lines.get(li);
    lp(let ci=0;ci<s.len(line);ci=ci+1){
      let ch=s.slice(line;ci;ci+1);
      if(ch=="{"){ depth=depth+1 }
      el{ if(ch=="}"){ depth=depth-1; if(depth<0){ ok=1==0 } } };
    };
  };
  if(depth!=0){ ok=1==0 };
  if(!ok){ io.println("Part 1: NOT matched"); <0 };
  let out=mut."Part 1: matched";
  out=s.concat(out;"\nPart 2:");
  # part 2
  let d2=mut.0;
  lp(let li=0;li<lines.len();li=li+1){
    let line=lines.get(li);
    let run=mut."";
    lp(let ci=0;ci<s.len(line);ci=ci+1){
      let ch=s.slice(line;ci;ci+1);
      if(ch=="{"){ d2=d2+1 }
      el{ if(ch=="}"){ d2=d2-1 }
      el{ if(d2%2==0){ run=s.concat(run;ch) } } };
    };
    if(s.len(run)>0){ out=s.concat(out;s.concat("\n";run)) };
  };
  out=s.concat(out;"\nPart 3:");
  # part 3
  let d3=mut.0;
  lp(let li=0;li<lines.len();li=li+1){
    let line=lines.get(li);
    let run=mut."";
    let curlvl=mut.d3/2;
    lp(let ci=0;ci<s.len(line);ci=ci+1){
      let ch=s.slice(line;ci;ci+1);
      if(ch=="{"){ d3=d3+1 }
      el{ if(ch=="}"){ d3=d3-1 }
      el{ if(d3%2==0){
        let lvl=d3/2;
        if(lvl!=curlvl&&s.len(run)>0){
          let ind=mut."";
          lp(let x=0;x<curlvl;x=x+1){ ind=s.concat(ind;"  ") };
          out=s.concat(out;s.concat("\n";s.concat(ind;run)));
          run="";
        };
        curlvl=lvl;
        run=s.concat(run;ch);
      } } };
    };
    if(s.len(run)>0){
      let ind=mut."";
      lp(let x=0;x<curlvl;x=x+1){ ind=s.concat(ind;"  ") };
      out=s.concat(out;s.concat("\n";s.concat(ind;run)));
    };
  };
  io.println(out);
  <0
};
