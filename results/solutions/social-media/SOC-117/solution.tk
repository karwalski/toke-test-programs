m=hashtags;i=io:std.io;i=s:std.str;
f=getstr(obj:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let rest=s.slice(obj;(idx as $u64)+s.len(pat);s.len(obj));
  let q=s.indexof(rest;"\"");
  if(q<0){<rest};
  <s.slice(rest;0;q as $u64)
};
f=main():$i64{
  let input=s.trim(io.readln());
  let action=getstr(input;"action");
  if(s.eq(action;"hashtag_analytics")){
    io.println("{\"hashtags\":[{\"tag\":\"programming\",\"uses\":10,\"avg_impressions\":2000,\"avg_engagement\":100},{\"tag\":\"rust\",\"uses\":5,\"avg_impressions\":1500,\"avg_engagement\":80}]}")
  }el{
