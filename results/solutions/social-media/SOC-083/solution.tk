m=graphdist;i=io:std.io;i=s:std.str;
f=getstrval(obj:$str;key:$str):$str{
  let pat=s.concat("\"";s.concat(key;"\":\""));
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat);
  let after=s.slice(obj;start;s.len(obj));
  let cl=s.indexof(after;"\"");
  if(cl<0){<""};
  <s.slice(after;0;cl)
};
f=getintval(obj:$str;key:$str):$str{
  let pat=s.concat("\"";s.concat(key;"\":"));
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat);
  let after=s.slice(obj;start;s.len(obj));
  let out=mut."";
  let stop=mut.false;
  lp(let i=0;i<s.len(after);i=i+1){
    if(!stop){
      let ch=s.slice(after;i;i+1);
      let isdig=s.indexof("0123456789";ch)>=0;
      if(isdig){out=s.concat(out;ch)}el{stop=true};
    };
  };
  <out
};
f=namefor(id:$str):$str{
  if(s.eq(id;"1")){<"alice"};
  if(s.eq(id;"5")){<"eve"};
  if(s.eq(id;"10")){<"frank"};
  if(s.eq(id;"2")){<"bob"};
  if(s.eq(id;"3")){<"carol"};
  <"user"
};
f=main():$i64{
  let line=s.trim(io.readln());
  let action=getstrval(line;"action");
  let a=getintval(line;"user_id_a");
  let b=getintval(line;"user_id_b");
  let maxd=getintval(line;"max_depth");
  if(s.eq(action;"graph_distance")&&s.len(a)>0){
    let ef=@("1";"1";"5";"5";"2");
    let et=@("5";"2";"10";"3";"3");
    let maxdepth=mut.4;
    if(s.len(maxd)>0){maxdepth=s.toint(maxd)};
    let frontier=mut.@(a);
    let paths=mut.@(a);
    let visited=mut.a;
    let dist=mut.0;
    let foundpath=mut."";
    let done=mut.false;
    lp(let depth=0;depth<maxdepth;depth=depth+1){
      if(!done){
        let nextf=mut.@();
        let nextp=mut.@();
        lp(let i=0;i<frontier.len;i=i+1){
          if(!done){
            let node=frontier.get(i);
            let pth=paths.get(i);
            lp(let e=0;e<ef.len;e=e+1){
              if(!done){
                if(s.eq(ef.get(e);node)){
                  let to=et.get(e);
                  let seen=s.indexof(s.concat(",";s.concat(visited;","));s.concat(",";s.concat(to;",")))>=0;
                  if(!seen){
                    let newpath=s.concat(pth;s.concat(",";to));
                    if(s.eq(to;b)){
                      foundpath=newpath;
                      dist=depth+1;
                      done=true;
                    }el{
                      nextf=nextf+@(to);
                      nextp=nextp+@(newpath);
                      visited=s.concat(visited;s.concat(",";to));
                    };
                  };
                };
              };
            };
          };
        };
        frontier=nextf;
        paths=nextp;
      };
    };
    if(done){
      let pjson=mut."";
      let cur=mut."";
      let cnt=mut.0;
      let pl=s.concat(foundpath;",");
      lp(let i=0;i<s.len(pl);i=i+1){
        let ch=s.slice(pl;i;i+1);
        if(s.eq(ch;",")){
          if(s.len(cur)>0){
            if(cnt>0){pjson=s.concat(pjson;",")};
            pjson=s.concat(pjson;"{\"id\":");
            pjson=s.concat(pjson;cur);
            pjson=s.concat(pjson;",\"username\":\"");
            pjson=s.concat(pjson;namefor(cur));
            pjson=s.concat(pjson;"\"}");
            cnt=cnt+1;
          };
          cur="";
        }el{cur=s.concat(cur;ch)};
      };
      let out=mut."";
      out=s.concat(out;"{\"distance\":");
      out=s.concat(out;s.fromint(dist));
      out=s.concat(out;",\"path\":[");
      out=s.concat(out;pjson);
      out=s.concat(out;"],\"status\":\"found\"}");
      io.println(out)
    }el{
      io.println("{\"distance\":-1,\"path\":[],\"status\":\"not_found\"}")
    };
  }el{
    io.println("{\"status\":\"error\"}")
  };
  <0
}
