m=joingroup;i=io:std.io;i=s:std.str;i=json:std.json;
f=pdoc(x:$str):Json{<mt json.dec(x){$ok:d d;$err:e pdoc("{}")}};
f=main():$i64{
let line=io.readln();
let d=pdoc(line);
let action=json.getstr(d;"action");
let gid=json.getstr(d;"group_id");
if(s.eq(action;"join_group")=false){
io.println("{\"error\":\"invalid action\"}");
<1
};
let b=s.buf();
s.add(b;"{\"group_id\":");
s.add(b;json.enc(gid));
s.add(b;",\"member\":true,\"role\":\"member\",\"status\":\"joined\"}");
io.println(s.done(b));
<0}
