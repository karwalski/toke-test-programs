m=addmember;i=io:std.io;i=s:std.str;
f=getstr(obj:$str;key:$str):$str{
  let pat="\"\(key)\":\"";
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let rest=s.slice(obj;(idx as $u64)+s.len(pat);s.len(obj));
  let q=s.indexof(rest;"\"");
  if(q<0){<rest};
  <s.slice(rest;0;q as $u64)
};
f=getint(obj:$str;key:$str):$i64{
  let pat="\"\(key)\":";
  let p=s.indexof(obj;pat);
  if(p<0){<0};
  let st=(p as $u64)+s.len(pat);
  let n=s.len(obj);
  let en=mut.st;
  lp(let e=st;e<n;e=e+1){if(!s.contains("0123456789";s.slice(obj;e;e+1))){en=e;e=n}};
  <s.toint(s.slice(obj;st;en))
};
f=main():$i64{
  let input=s.trim(io.readln());
  let action=getstr(input;"action");
  let lid=getstr(input;"list_id");
  let uid=getint(input;"user_id");
  if(action=="add_to_list"){
    io.println("{\"list_id\":\"\(lid)\",\"user_id\":\(uid),\"member_count\":1,\"status\":\"added\"}")
  }el{
    io.println("{\"status\":\"invalid_action\"}")
  };
  <0
};
