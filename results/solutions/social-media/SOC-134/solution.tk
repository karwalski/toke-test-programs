m=dmshare;i=io:std.io;i=s:std.str;
f=getstr(obj:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let rest=s.slice(obj;(idx as $u64)+s.len(pat);s.len(obj));
  let q=s.indexof(rest;"\"");
  if(q<0){<rest};
  <s.slice(rest;0;q as $u64)
};
f=getint(obj:$str;key:$str):$i64{
  let pat=s.concat(s.concat("\"";key);"\":");
  let p=s.indexof(obj;pat);
  if(p<0){<0};
  let st=(p as $u64)+s.len(pat);
  let n=s.len(obj);
  let en=mut.st;
  lp(let e=st;e<n;e=e+1){let c=s.slice(obj;e;e+1);let isdig=s.contains("0123456789";c);if(!(isdig)){en=e;e=n}};
  <s.toint(s.slice(obj;st;en))
};
f=main():$i64{
  let input=s.trim(io.readln());
  let action=getstr(input;"action");
  let pid=getint(input;"post_id");
  let message=getstr(input;"message");
  if(s.eq(action;"share_to_dm")){
    let out=mut."{\"message_id\":\"msg_3\",\"type\":\"shared_post\",\"post_id\":";
    out=s.concat(out;s.fromint(pid));
    out=s.concat(out;",\"message\":\"");
