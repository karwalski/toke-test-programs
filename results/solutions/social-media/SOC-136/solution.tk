m=createlist;i=io:std.io;i=s:std.str;
f=getstr(obj:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let rest=s.slice(obj;(idx as $u64)+s.len(pat);s.len(obj));
  let q=s.indexof(rest;"\"");
  if(q<0){<rest};
  <s.slice(rest;0;q as $u64)
};
f=getbool(obj:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":");
  let p=s.indexof(obj;pat);
  if(p<0){<"false"};
  let st=(p as $u64)+s.len(pat);
  let rest=s.slice(obj;st;s.len(obj));
  if(s.indexof(rest;"true")=0){<"true"};
  <"false"
};
f=main():$i64{
  let input=s.trim(io.readln());
  let action=getstr(input;"action");
  let name=getstr(input;"name");
  let desc=getstr(input;"description");
  let priv=getbool(input;"private");
  if(s.eq(action;"create_list")){
    let out=mut."{\"list_id\":\"lst_1\",\"name\":\"";
    out=s.concat(out;name);
