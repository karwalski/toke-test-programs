m=creategroup;i=io:std.io;i=s:std.str;i=json:std.json;
f=pdoc(x:$str):Json{<mt json.dec(x){$ok:d d;$err:e pdoc("{}")}};
f=main():$i64{
let d=pdoc(io.readln());
let action=json.getstr(d;"action");
let name=json.getstr(d;"name");
let desc=json.getstr(d;"description");
if(action!="create_group"){
io.println("{\"error\":\"invalid action\"}");
<1
};
let b=s.buf();
s.add(b;"{\"group_id\":\"grp_1\",\"name\":");
s.add(b;json.enc(name));
s.add(b;",\"description\":");
s.add(b;json.enc(desc));
s.add(b;",\"member_count\":1,\"status\":\"created\"}");
io.println(s.done(b));
<0}
