m=ratelimit;i=io:std.io;i=s:std.str;i=json:std.json;
f=pdoc(x:$str):Json{<mt json.dec(x){$ok:d d;$err:e pdoc("{}")}};
f=main():$i64{
let line=io.readln();
let d=pdoc(line);
let action=json.getstr(d;"action");
if(s.eq(action;"rate_limit_status")==false){
io.println("{\"error\":\"invalid action\"}");
<1
};
io.println("{\"limit\":300,\"remaining\":250,\"reset_at\":\"2026-01-01T00:15:00Z\",\"window_seconds\":900}");
<0}
