m=privacy;
i=io:std.io;
i=s:std.str;

f=main():$i64{
  let raw=mut."";
  let line=mut.io.readln();
  lp(s.len(line)>0){raw=s.concat(raw;line);line=io.readln()};
  let input=raw;

  let key="\"settings\":";
  let ks=s.indexof(input;key);
  let settings=mut."{}";
  if(ks>=0){
    let vs=ks+s.len(key);
    let rest=s.slice(input;vs;s.len(input));
    let depth=mut.0;
    let i=mut.0;
    let started=mut.0;
    let endpos=mut.0;
    let done=mut.0;
    lp(i<s.len(rest)){
      if(done=0){
        let c=s.slice(rest;i;i+1);
        if(s.equals(c;"{")){depth=depth+1;started=1};
        if(s.equals(c;"}")){depth=depth-1;if(depth=0){if(started=1){endpos=i+1;done=1}}};
      };
      i=i+1;
    };
    settings=s.slice(rest;0;endpos);
  };

  let out=mut."{\"settings\":";
  out=s.concat(out;settings);
  out=s.concat(out;",\"status\":\"updated\"}");
  io.println(out);
  <0;
}
