m=depcheck;i=io:std.io;i=fs:std.file;i=s:std.str;
f=endswith(str:$str;suf:$str):$bool{
  if(s.len(suf)>s.len(str)){<false};
  <s.eq(s.slice(str;s.len(str)-s.len(suf);s.len(str));suf)
};
f=countchar(str:$str;ch:$str):$i64{
  let n=mut.0;
  lp(let i=0;i<s.len(str);i=i+1){ if(s.eq(s.slice(str;i;i+1);ch)){n=n+1} };
  <n
};
f=main():$i64{
  let path=s.trim(io.readln());
  let content=fs.read(path);
  let total=mut.0;
  if(endswith(path;"package.json")){
    let di=s.indexof(content;"\"dependencies\"");
    if(di>=0){
      let after=s.slice(content;di;s.len(content));
      let ob=s.indexof(after;"{");
      let cb=s.indexof(after;"}");
      if(ob>=0){ if(cb>ob){
        let block=s.slice(after;ob+1;cb);
        if(s.len(s.trim(block))>0){total=countchar(block;":")};
      }};
    };
  }el{
    if(endswith(path;"requirements.txt")){
      let body=s.concat(content;"\n");
      let cur=mut."";
      lp(let i=0;i<s.len(body);i=i+1){
        let ch=s.slice(body;i;i+1);
        if(s.eq(ch;"\n")){
          if(s.len(s.trim(cur))>0){total=total+1};
          cur="";
        }el{cur=s.concat(cur;ch)};
      };
    }el{
      total=countchar(content;"require");
    };
  };
  let out=mut."";
  out=s.concat(out;"{\"total_deps\":");
  out=s.concat(out;s.fromint(total));
  out=s.concat(out;",\"vulnerable_deps\":[],\"summary\":{\"total\":");
  out=s.concat(out;s.fromint(total));
  out=s.concat(out;",\"vulnerable\":0}}");
  io.println(out);
  <0
}
