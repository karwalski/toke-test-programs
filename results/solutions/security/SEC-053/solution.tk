(* SEC-053 — XML External Entity (XXE) tester, mock-endpoint form (114.28).
 * Reads the target URL and the mock endpoint's recorded response to each of
 * the two DOCTYPE SYSTEM probes, and reports SAFE / VULNERABLE per probe with
 * the leaked fragment as evidence. *)
m=xxe;
i=io:std.io;
i=s:std.str;

(* true when the character code is [A-Za-z0-9_]. *)
f=isword(c:i64):bool{
  <(c>=97&&c<=122)||(c>=65&&c<=90)||(c>=48&&c<=57)||c==95
};

(* the leaked /etc/passwd root entry, or "" when there is none. *)
f=passwdev(body:str):str{
  let n=s.len(body) as i64;
  let at=mut.s.indexof(body;"root:");
  lp(at>=0){
    let ok=if(at==0){true}el{!isword(s.charat(body;at-1))};
    if(ok){
      let e=mut.at;
      let stop=mut.false;
      lp(!stop&&e<n){
        let c=s.charat(body;e);
        if(c==32||c==9||c==60){stop=true}el{e=e+1}
      };
      <mt s.slice(body;at as u64;e as u64){$ok:v v;$err:x ""}
    };
    at=s.indexfrom(body;"root:";at+1)
  };
  <""
};

(* "127.0.0.1 localhost" when the loopback hosts entry leaked, else "". *)
f=hostsev(body:str):str{
  let n=s.len(body) as i64;
  let at=mut.s.indexof(body;"127.0.0.1");
  lp(at>=0){
    let j=at+9;
    let k=mut.j;
    lp(k<n&&(s.charat(body;k)==32||s.charat(body;k)==9)){k=k+1};
    if(k>j){
      let rest=mt s.slice(body;k as u64;s.len(body)){$ok:v v;$err:x ""};
      if(s.startswith(rest;"localhost")){<"127.0.0.1 localhost"}
    };
    at=s.indexfrom(body;"127.0.0.1";at+1)
  };
  <""
};

f=report(probe:str;ev:str):bool{
  if(s.len(ev)==0){
    io.println("probe \(probe): SAFE");
    <false
  };
  io.println("probe \(probe): VULNERABLE (\(ev))");
  <true
};

f=main():i64{
  let url=s.trim(io.readln());
  let ok=(s.startswith(url;"http://")&&s.len(url)>7)||(s.startswith(url;"https://")&&s.len(url)>8);
  if(!ok){
    io.println("ERROR: not an http(s) URL: \(url)");
    <0
  };
  let r1=s.trim(io.readln());
  let r2=s.trim(io.readln());
  io.println("target: \(url)");
  let v1=report("file:///etc/passwd";passwdev(r1));
  let v2=report("file:///etc/hosts";hostsev(r2));
  let verdict=if(v1||v2){"VULNERABLE"}el{"SAFE"};
  io.println("result: \(verdict)");
  <0
};
