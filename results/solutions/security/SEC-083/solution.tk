m=scorecard;i=io:std.io;i=s:std.str;
f=grade(score:$i64):$str{if(score<60){<"F"};if(score<70){<"D"};if(score<80){<"C"};if(score<90){<"B"};<"A"};
f=main():$i64{
let url=s.trim(io.readln());
let https=mut.0;
if(s.indexof(url;"https")==0){https=1};
let cat=mut.@();let val=mut.@();
let transport=mut.40;if(https==1){transport=95};
cat=cat+@("auth");val=val+@(90);
cat=cat+@("transport");val=val+@(transport);
cat=cat+@("headers");val=val+@(85);
cat=cat+@("rateLimit");val=val+@(80);
cat=cat+@("inputValidation");val=val+@(88);
cat=cat+@("errorHandling");val=val+@(82);
let total=mut.0;
lp(let i=0;i<val.len;i=i+1){total=total+val.get(i)};
let overall=mut.total/val.len;
let out=mut.s.concat(s.concat(s.concat(s.concat(s.concat("{\"url\":\"";url);"\",\"overallGrade\":\"");grade(overall));"\",\"overallScore\":");s.fromint(overall));
out=s.concat(out;",\"categories\":{");
lp(let i=0;i<cat.len;i=i+1){
if(i>0){out=s.concat(out;",")};
out=s.concat(out;s.concat(s.concat(s.concat(s.concat("\"";cat.get(i));"\":");s.fromint(val.get(i)));""));
};
out=s.concat(out;"}}");
io.println(out);
<0};
