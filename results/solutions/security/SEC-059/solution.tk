m=cipherrank;i=io:std.io;i=s:std.str;
f=strength(name:$str):$str{
  let c=s.upper(name);
  let insecure=mut.false;
  if(s.contains(c;"RC4")){insecure=true};
  if(s.contains(c;"DES")){insecure=true};
  if(s.contains(c;"NULL")){insecure=true};
  if(s.contains(c;"EXPORT")){insecure=true};
  if(s.contains(c;"MD5")){insecure=true};
  if(s.contains(c;"SHA1")){insecure=true};
  if(s.contains(c;"ADH")){insecure=true};
  if(s.contains(c;"AECDH")){insecure=true};
  if(insecure){<"insecure"};
  let weak=mut.false;
  if(s.contains(c;"RSA_WITH_")){weak=true};
  if(s.contains(c;"3DES")){weak=true};
  if(s.contains(c;"CBC")){weak=true};
  if(weak){<"weak"};
  let strong=mut.false;
  if(s.contains(c;"ECDHE")){strong=true};
  if(s.contains(c;"DHE")){strong=true};
  if(s.contains(c;"AES_256_GCM")){strong=true};
  if(s.contains(c;"AES_128_GCM")){strong=true};
  if(s.contains(c;"CHACHA20_POLY1305")){strong=true};
  if(strong){<"strong"};
  <"acceptable"
};
f=main():$i64{
  lp(1=1){
    let line=io.readln();
    if(s.len(line)=0){br};
    let name=s.trim(line);
    if(s.len(name)>0){io.println(strength(name))}
  };
  <0
}
