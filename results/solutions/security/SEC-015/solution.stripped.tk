i=s:std.str;

f=main():$i64{
  let input=s.trim(io.readln());
  let inner=s.trim(s.slice(input;1;s.len(input)-1));
  if(s.len(inner)=0){io.println("_");<0};
  let low=s.lower(input);
  if(s.contains(low;"_"severity\"_"high\"_")){io.println("_");<0};
  if(s.contains(low;"_"severity\"_"high\"_")){io.println("_");<0};
  if(s.contains(low;"_"severity\"_"medium\"_")){io.println("_");<0};
  if(s.contains(low;"_"severity\"_"medium\"_")){io.println("_");<0};
  io.println("_");
  <0
}
