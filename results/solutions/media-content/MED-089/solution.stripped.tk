m=fmtcols;i=io:std.io;i=s:std.str;f=ljust(t:$str;w:$i64):$str{let r=mut.t;lp(s.len(r)<w){r=s.concat(r;"_")};<r};f=rstrip(t:$str):$str{let e=mut.s.len(t);lp(1=1){if(e<=0){br};let c=s.slice(t;e-1;e);if(s.eq(c;"_")){e=e-1}el{br}};<s.slice(t;0;e)};f=main():$i64{let n=s.toint(s.trim(io.readln()));let items=mut.@();lp(1=1){let l=io.readln();if(s.len(l)=0){br};items=items+@(l)};let cnt=items.len;let rows=(cnt+n-1)/n;let widths=mut.@();lp(let c=0;c<n;c=c+1){let w=mut.0;lp(let r=0;r<rows;r=r+1){let idx=r*n+c;if(idx<cnt){let il=s.len(items.get(idx));if(il>w){w=il}}};widths=widths+@(w)};lp(let r=0;r<rows;r=r+1){let line=mut."_";lp(let c=0;c<n;c=c+1){let idx=r*n+c;if(idx<cnt){if(c>0){line=s.concat(line;"_")};if(c=n-1){line=s.concat(line;items.get(idx))}el{line=s.concat(line;ljust(items.get(idx);widths.get(c)))}}};io.println(rstrip(line))};<0}
