m=runlenenc;
i=io:std.io;
i=s:std.str;
f=encode(str:$str):$str{
  let n=s.len(str);
  if(n=0){<""};
  let b=s.bytes(str);
  let result=mut."";
  let idx=mut.0;
  lp(idx<n){
    let cur=b.get(idx);
    let count=mut.1;
    let j=mut.idx+1;
    lp(j<n){
      let nxt=b.get(j);
      if(nxt=cur){count=count+1;j=j+1}el{br};
    };
    result=s.concat(result;s.fromint(count));
    result=s.concat(result;s.substr(str;idx;idx+1));
    idx=j;
  };
  <result
};
f=main():$i64{
  let line=io.readln();
  io.println(encode(line));
  <0
};
