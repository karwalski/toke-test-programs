m=ellipsis;i=io:std.io;i=s:std.str;
f=ellipsis(text:$str;maxlen:$i64):$str{
  let len=s.len(text) as $i64;
  if(len<=maxlen){<text};
  let trunclen=mut.maxlen-3;
  if(trunclen<0){trunclen=0};
  let truncated=s.slice(text;0;trunclen as $u64);
  <s.concat(truncated;"_")
};
f=main():$i64{
  let maxlen=s.toint(io.readln());
  lp(1=1){
    let line=io.readln();
    if(s.len(line)=0){br};
    io.println(ellipsis(line;maxlen))
  };
  <0
}
