m=ellipsis;i=io:std.io;i=s:std.str;
f=ellipsis(text:$str;maxlen:$i64):$str{
  if(s.len(text) as $i64<=maxlen){<text};
  let trunclen=if(maxlen-3<0){0}el{maxlen-3};
  <s.concat(s.slice(text;0;trunclen as $u64);"...")
};
f=main():$i64{
  let maxlen=s.toint(io.readln());
  lp(true){
    let line=io.readln();
    if(s.len(line)==0){br};
    io.println(ellipsis(line;maxlen))
  };
  <0
}
