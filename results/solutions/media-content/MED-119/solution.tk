m=markdown;
i=io:std.io;
i=s:std.str;

f=isallcaps(line:$str):$bool{
  let b=s.bytes(line);
  let n=b.len;
  let hasletter=mut.false;
  let ok=mut.true;
  lp(let i=0;i<n;i=i+1){
    let c=b.get(i);
    if(c>=65&&c<=90){hasletter=true};
    if(c>=97&&c<=122){ok=false};
  };
  if(!hasletter){<false};
  <ok
};

f=main():$i64{
  lp(!io.eof()){
    let line=io.readln();
    if(io.eof()&&s.len(line)==0){br};
    let out=mut.line;
    if(s.len(line)>0){
      if(isallcaps(line)){
        out=s.concat("# ";line);
      };
    };
    io.println(out);
  };
  <0
};
