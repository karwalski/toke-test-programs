m=phoneformat;
i=io:std.io;
i=s:std.str;

f=isdigit(c:$str):$bool{
    if(s.equals(c;"0")){<true};
    if(s.equals(c;"1")){<true};
    if(s.equals(c;"2")){<true};
    if(s.equals(c;"3")){<true};
    if(s.equals(c;"4")){<true};
    if(s.equals(c;"5")){<true};
    if(s.equals(c;"6")){<true};
    if(s.equals(c;"7")){<true};
    if(s.equals(c;"8")){<true};
    if(s.equals(c;"9")){<true};
    <false
};

f=formatphone(phone:$str):$str{
    let orig=s.trim(phone);
    let digits=mut."";
    let i=mut.0;
    lp(i<s.len(orig)){
        let c=s.slice(orig;i;i+1);
        if(isdigit(c)){digits=s.concat(digits;c)};
        i=i+1
    };
    let n=s.len(digits);
    if(n=11){
        if(s.equals(s.slice(digits;0;1);"1")){
            let area=s.slice(digits;1;4);
            let exch=s.slice(digits;4;7);
            let num=s.slice(digits;7;11);
            <s.concat(s.concat(s.concat(s.concat(s.concat("+1 (";area);") ");exch);"-");num)
        }
    };
    if(n=10){
        let area=s.slice(digits;0;3);
        let exch=s.slice(digits;3;6);
        let num=s.slice(digits;6;10);
        <s.concat(s.concat(s.concat(s.concat(s.concat("+1 (";area);") ");exch);"-");num)
    };
    <orig
};

f=main():$i64{
    let phone=io.readln();
    io.println(formatphone(phone));
    <0
};
