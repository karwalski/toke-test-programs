m=spellcheck;i=io:std.io;i=s:std.str;f=inlist(lst:@($str);w:$str):$i64{let n=lst.len;let i=mut.0;lp(i<n){if(lst.get(i)==w){<1};i=i+1};<0};f=main():$i64{let dictline=io.readln();let dict=s.split(s.trim(dictline);",");let seen=mut.@();lp(true){let line=io.readln();if(s.len(line)==0){br};let words=s.fields(s.trim(line));let wi=mut.0;lp(wi<words.len){let w=words.get(wi);if(inlist(dict;w)==0&&inlist(seen;w)==0){seen=seen+@(w);io.println(w)};wi=wi+1}};<0}
