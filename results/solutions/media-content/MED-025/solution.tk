m=trigram;
i=io:std.io;
i=s:std.str;

f=main():$i64{
  let raw=s.buf();
  let first=mut.true;
  let line=mut.io.readln();
  lp(s.len(line)>0){
    if(first){first=false}el{s.add(raw;" ")};
    s.add(raw;s.trim(line));
    line=io.readln();
  };
  let text=s.trim(s.done(raw));
  let words=s.split(text;" ");
  let n=words.len();

  let uniq=mut.@();
  let cnts=mut.@();

  if(n>=3){
    let i=mut.0;
    lp(i<n-2){
      let tg="\(words.get(i)) \(words.get(i+1)) \(words.get(i+2))";
      let found=mut.0-1;
      let j=mut.0;
      lp(j<uniq.len()){
        if(uniq.get(j)==tg){found=j};
        j=j+1;
      };
      if(found<0){
        uniq=uniq+@(tg);
        cnts=cnts+@(1);
      }el{
        cnts=cnts.set(found;cnts.get(found)+1);
      };
      i=i+1;
    };
  };

  if(uniq.len()>0){
    let besti=mut.0;
    let k=mut.1;
    lp(k<uniq.len()){
      let bc=cnts.get(besti);
      let cc=cnts.get(k);
      if(cc>bc){
        besti=k;
      }el{
        if(cc==bc){
          if(uniq.get(k)<uniq.get(besti)){besti=k};
        };
      };
      k=k+1;
    };
    io.println(s.concat("\"";s.concat(uniq.get(besti);s.concat("\": ";s.fromint(cnts.get(besti))))));
  };
  <0;
}
