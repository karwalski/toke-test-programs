m=longsent;
i=io:std.io;
i=s:std.str;

f=trim(str:$str):$str{
  let n=s.len(str);
  let b=s.bytes(str);
  let start=mut.0;
  let end=mut.n;
  lp(start<end){
    let c=b.get(start);
    if(c==32||c==9||c==10||c==13){start=start+1}el{br};
  };
  lp(end>start){
    let c=b.get(end-1);
    if(c==32||c==9||c==10||c==13){end=end-1}el{br};
  };
  <s.substr(str;start;end)
};

f=countwords(str:$str):$i64{
  let n=s.len(str);
  let b=s.bytes(str);
  let count=mut.0;
  let inword=mut.false;
  lp(let i=0;i<n;i=i+1){
    let c=b.get(i);
    let isspace=(c==32||c==9||c==10||c==13);
    if(isspace){
      inword=false;
    }el{
      if(!inword){count=count+1};
      inword=true;
    };
  };
  <count
};

f=main():$i64{
  let tline=io.readln();
  let threshold=s.toint(trim(tline));

  let all=mut."";
  let firstl=mut.true;
  lp(!io.eof()){
    let line=io.readln();
    if(io.eof()&&s.len(line)==0){br};
    if(!firstl){all=s.concat(all;"\n")};
    all=s.concat(all;line);
    firstl=false;
  };
  let text=all;

  let n=s.len(text);
  let b=s.bytes(text);
  let sentences=mut.@();
  let cur=mut.0;
  lp(let i=0;i<n;i=i+1){
    let c=b.get(i);
    if(c==46||c==63||c==33){
      let piece=s.substr(text;cur;i);
      let t=trim(piece);
      if(s.len(t)>0){
        sentences=sentences+@(s.concat(t;s.substr(text;i;i+1)));
      };
      cur=i+1;
    };
  };
  if(cur<n){
    let t=trim(s.substr(text;cur;n));
    if(s.len(t)>0){sentences=sentences+@(t)};
  };

  let num=mut.0;
  lp(let i=0;i<sentences.len;i=i+1){
    num=num+1;
    let sent=sentences.get(i);
    let bare=mut.trim(sent);
    let nbare=s.len(bare);
    if(nbare>0){
      let lastc=s.bytes(bare).get(nbare-1);
      if(lastc==46||lastc==63||lastc==33){bare=trim(s.substr(bare;0;nbare-1))};
    };
    let wc=countwords(bare);
    if(wc>threshold){
      let out=mut.s.concat("Sentence ";s.fromint(num));
      out=s.concat(out;" (");
      out=s.concat(out;s.fromint(wc));
      out=s.concat(out;" words): ");
      out=s.concat(out;sent);
      io.println(out);
    };
  };
  <0
};
