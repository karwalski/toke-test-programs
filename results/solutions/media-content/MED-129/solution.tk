m=admonition;
i=io:std.io;
i=s:std.str;

f=stripprefix(line:$str;plen:$i64):$str{
  let n=s.len(line);
  let start=mut.plen;
  let b=s.bytes(line);
  lp(start<n){
    let c=b.get(start);
    if(c==32){start=start+1}el{br};
  };
  <s.substr(line;start;n)
};

f=main():$i64{
  let all=mut."";
  let first=mut.true;
  lp(!io.eof()){
    let line=io.readln();
    if(io.eof()&&s.len(line)==0){br};
    if(!first){all=s.concat(all;"\n")};
    all=s.concat(all;line);
    first=false;
  };
  let label=mut."";
  let plen=mut.0;
  let matched=mut.true;
  if(s.eq(s.substr(all;0;5);"NOTE:")){label="note";plen=5}el{
  if(s.eq(s.substr(all;0;8);"WARNING:")){label="warning";plen=8}el{
  if(s.eq(s.substr(all;0;4);"TIP:")){label="tip";plen=4}el{
  if(s.eq(s.substr(all;0;5);"INFO:")){label="info";plen=5}el{
    matched=false;
  }}}};
  if(!matched){io.println(all);<0};
  let body=stripprefix(all;plen);
  let out=mut.s.concat("```";label);
  out=s.concat(out;"\n");
  out=s.concat(out;body);
  out=s.concat(out;"\n```");
  io.println(out);
  <0
};
