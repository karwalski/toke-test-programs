m=acronym;i=io:std.io;i=s:std.str;f=acronym(line:$str):$str{let parts=s.split(line;" ");let result=mut."";lp(let idx=0;idx<parts.len();idx=idx+1){let word=parts.get(idx);if(s.len(word)>=1){result=s.concat(result;s.toupper(s.slice(word;0;1)))}};<result};f=main():$i64{let phrase=mut.io.readln();lp(phrase!=""){io.println(acronym(phrase));phrase=io.readln()};<0}