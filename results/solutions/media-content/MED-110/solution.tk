m=wordcontext;
i=io:std.io;
i=s:std.str;
f=main():$i64{
  let header=io.readln();
  let hparts=s.split(header;" ");
  if(hparts.len<2){<0};
  let word=hparts.get(0);
  let nstr=hparts.get(1);
  let n=s.parseint(nstr);
  let text=mut."";
  let first=mut.true;
  lp(!io.eof()){
    let line=io.readln();
    if(io.eof()&&s.len(line)=0){br};
    if(!first){text=s.concat(text;" ")};
    text=s.concat(text;line);
    first=false;
  };
  let words=s.split(text;" ");
  let wcount=words.len;
  let lword=s.lower(word);
  lp(let p=0;p<wcount;p=p+1){
    let cw=s.lower(words.get(p));
    if(s.eq(cw;lword)){
      let out=mut."...";
      let li=mut.p-n;
      let leftfirst=mut.true;
      lp(li<p){
        if(li<0){
          if(leftfirst){out=s.concat(out;"<START>");leftfirst=false}el{out=s.concat(out;" <START>")};
        }el{
          if(leftfirst){out=s.concat(out;words.get(li));leftfirst=false}el{out=s.concat(out;s.concat(" ";words.get(li)))};
        };
        li=li+1;
      };
      out=s.concat(out;" [");
      out=s.concat(out;words.get(p));
      out=s.concat(out;"] ");
      let ri=mut.p+1;
      let rightfirst=mut.true;
      lp(ri<=p+n){
        if(ri>=wcount){
          if(rightfirst){out=s.concat(out;"<END>");rightfirst=false}el{out=s.concat(out;" <END>")};
        }el{
          if(rightfirst){out=s.concat(out;words.get(ri));rightfirst=false}el{out=s.concat(out;s.concat(" ";words.get(ri)))};
        };
        ri=ri+1;
      };
      out=s.concat(out;"...");
      io.println(out);
    };
  };
  <0
};
