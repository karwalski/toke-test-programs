m=classroomrules;
i=io:std.io;
i=str:std.str;

f=main():i64{
  let border="========================";
  let name=io.readln();
  let title=str.concat(str.concat("   RULES FOR ";str.upper(name));"   ");
  io.println(border);
  io.println(title);
  io.println(border);
  let n=mut.0;
  lp(let i=0;i<100000;i=i+1){
    let line=io.readln();
    if(str.len(line)=0){br};
    n=n+1;
    let num=str.concat(str.fromint(n);". ");
    io.println(str.concat(num;line));
  };
  io.println(border);
  <0
};
