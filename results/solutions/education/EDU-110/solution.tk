m=rewrite;
i=io:std.io;
i=s:std.str;

f=getstr(json:$str;key:$str):$str{
    let pat=s.concat(s.concat("\"";key);"\":\"");
    let p=s.indexof(json;pat);
    if(p<0){<""};
    let start=p+s.len(pat);
    let rest=s.slice(json;start;s.len(json));
    let endp=s.indexof(rest;"\"");
    if(endp<0){<rest};
    <s.slice(rest;0;endp)
};

f=collapsespaces(t:$str):$str{
    let r=mut.t;
    lp(s.contains(r;"  ")){r=s.replace(r;"  ";" ")};
    <s.trim(r)
};

f=improve(question:$str;issue:$str):$str{
    if(s.equals(issue;"negative_stem")){
        let improved=mut.question;
        if(s.contains(improved;"NOT")){improved=s.replace(improved;"NOT";"")}el{
        if(s.contains(improved;"not")){improved=s.replace(improved;"not";"")}el{
        if(s.contains(improved;"NEVER")){improved=s.replace(improved;"NEVER";"")}el{
        if(s.contains(improved;"never")){improved=s.replace(improved;"never";"")}el{
        if(s.contains(improved;"INCORRECT")){improved=s.replace(improved;"INCORRECT";"")}el{
        if(s.contains(improved;"incorrect")){improved=s.replace(improved;"incorrect";"")}}}}}};
        improved=collapsespaces(improved);
        if(s.endswith(improved;"is ?")){improved=s.replace(improved;"is ?";"is correct?")}el{
        if(s.endswith(improved;"is?")){improved=s.replace(improved;"is?";"is correct?")}el{
        if(!s.contains(improved;"correct?")){
            if(s.endswith(improved;"?")){improved=s.concat(s.slice(improved;0;s.len(improved)-1);" correct?")}
            el{improved=s.concat(improved;" correct?")}
        }}};
        <improved
    };
    <question
};

f=reason(issue:$str):$str{
    if(s.equals(issue;"negative_stem")){<"Avoid negative stems — they increase reading difficulty."};
    <"No improvement needed"
};

f=main():$i64{
    let input=mut."";
    lp(true){let line=io.readln();if(io.eof()){br};input=s.concat(input;line)};
    let id=getstr(input;"id");
    let question=getstr(input;"question");
    let issue=getstr(input;"issue");
    let improved=improve(question;issue);
    io.println(s.concat(s.concat(id;" Original: ");question));
    io.println(s.concat(s.concat(id;" Improved: ");improved));
    io.println(s.concat("Reason: ";reason(issue)));
    <0
};
