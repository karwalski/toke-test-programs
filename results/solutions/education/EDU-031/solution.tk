m=wordcount;i=io:std.io;i=s:std.str;f=main():$i64{let line1=io.readln();let parts1=s.split(line1;" ");let min=s.toint(parts1.get(0));let max=s.toint(parts1.get(1));let essay=io.readln();let words=s.split(essay;" ");let count=words.len();if(count>=min&&count<=max){io.println("PASS: \(count) words")}el{io.println("FAIL: \(count) words (min \(min), max \(max))")};<0}