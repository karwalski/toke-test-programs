m=mathdrill;i=io:std.io;i=s:std.str;f=evalexpr(e:$str):$i64{let t=s.trim(e);let pp=s.indexof(t;"+");if(pp>0){let a=s.toint(s.trim(s.slice(t;0;pp)));let b=s.toint(s.trim(s.slice(t;pp+1;s.len(t) as $i64)));<a+b};let mp=s.indexof(t;"*");if(mp>0){let a=s.toint(s.trim(s.slice(t;0;mp)));let b=s.toint(s.trim(s.slice(t;mp+1;s.len(t) as $i64)));<a*b};let sp=s.indexof(t;"-");if(sp>0){let a=s.toint(s.trim(s.slice(t;0;sp)));let b=s.toint(s.trim(s.slice(t;sp+1;s.len(t) as $i64)));<a-b};<0};f=main():$i64{let elapsed=s.toint(s.trim(io.readln()));let correct=mut.0;let total=mut.0;lp(1=1){let line=io.readln();if(s.len(line)=0){br};let t=s.trim(line);if(s.len(t)>0){let parts=s.split(t;"=");if(parts.len=2){total=total+1;let prob=s.trim(parts.get(0));let given=s.trim(parts.get(1));let res=evalexpr(prob);if(s.eq(s.fromint(res);given)){correct=correct+1}}}};let ppm=((total*60) as $f64)/(elapsed as $f64);let ppmstr=mut.s.fromfloat(ppm);if(s.contains(ppmstr;".")=false){ppmstr=s.concat(ppmstr;".0")};io.println(s.concat("correct: ";s.fromint(correct)));io.println(s.concat("total: ";s.fromint(total)));io.println(s.concat("ppm: ";ppmstr));<0}
