m=groupgen;
i=io:std.io;
i=str:std.str;

f=main():i64{
  let seedline=io.readln();
  let seed=mt str.toint(str.trim(seedline)){ $ok:v v; $err:e 0 };
  let gsline=io.readln();
  let groupsize=mt str.toint(str.trim(gsline)){ $ok:v v; $err:e 1 };

  let names=mut.@();
  lp(let i=0;i<100000;i=i+1){
    let line=io.readln();
    if(str.len(line)==0){br};
    names=names+@(line);
  };
  let n=names.len as i64;

  let a=65539;
  let c=0;
  let m=2147483647;

  let keys=mut.@();
  let state=mut.seed;
  lp(let i=0;i<n;i=i+1){
    state=(a*state+c)%m;
    keys=keys+@(state);
  };

  let order=mut.@();
  lp(let i=0;i<n;i=i+1){order=order+@(i)};
  lp(let i=0;i<n;i=i+1){
    lp(let j=0;j<n-1-i;j=j+1){
      let ia=order.get(j);
      let ib=order.get(j+1);
      let ka=keys.get(ia);
      let kb=keys.get(ib);
      let swap=mut.false;
      if(ka>kb){swap=true};
      if(ka==kb){
        if(ia>ib){swap=true};
      };
      if(swap){
        order=order.set(j;ib);
        order=order.set(j+1;ia);
      };
    };
  };

  let groupnum=mut.0;
  let pos=mut.0;
  lp(let g=0;g<n;g=g+1){
    if(pos<n){
      groupnum=groupnum+1;
      let grpline=mut."";
      grpline=str.concat(str.concat("Group ";str.fromint(groupnum));": ");
      let cnt=mut.0;
      lp(let k=0;k<groupsize;k=k+1){
        if(pos<n){
          let idx=order.get(pos);
          let nm=names.get(idx);
          let sep=mut."";
          if(cnt>0){sep=", "};
          grpline=str.concat(str.concat(grpline;sep);nm);
          cnt=cnt+1;
          pos=pos+1;
        };
      };
      io.println(grpline);
    };
  };
  <0
};
