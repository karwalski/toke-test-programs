m=groupgen;
i=io:std.io;
i=str:std.str;

f=main():i64{
  let seed=mt str.toint(str.trim(io.readln())){ $ok:v v; $err:e 0 };
  let groupsize=mt str.toint(str.trim(io.readln())){ $ok:v v; $err:e 1 };

  let names=mut.@();
  lp(let i=0;i<100000;i=i+1){
    let line=io.readln();
    if(str.len(line)==0){br};
    names=names+@(line);
  };
  let n=names.len as i64;

  let a=65539;
  let c=0;
  let m=2147483647;

  let keys=mut.@();
  let state=mut.seed;
  lp(let i=0;i<n;i=i+1){
    state=(a*state+c)%m;
    keys=keys+@(state);
  };

  let order=mut.@();
  lp(let i=0;i<n;i=i+1){order=order+@(i)};
  lp(let i=0;i<n;i=i+1){
    lp(let j=0;j<n-1-i;j=j+1){
      let ia=order.get(j);
      let ib=order.get(j+1);
      let ka=keys.get(ia);
      let kb=keys.get(ib);
      if(ka>kb||(ka==kb&&ia>ib)){
        order=order.set(j;ib);
        order=order.set(j+1;ia);
      };
    };
  };

  let groupnum=mut.0;
  let pos=mut.0;
  lp(let g=0;g<n;g=g+1){
    if(pos<n){
      groupnum=groupnum+1;
      let grpline=mut."Group \(groupnum): ";
      let cnt=mut.0;
      lp(let k=0;k<groupsize;k=k+1){
        if(pos<n){
          let nm=names.get(order.get(pos));
          let sep=if(cnt>0){", "}el{""};
          grpline=str.concat(str.concat(grpline;sep);nm);
          cnt=cnt+1;
          pos=pos+1;
        };
      };
      io.println(grpline);
    };
  };
  <0
};
