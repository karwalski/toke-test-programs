m=tracker;
i=io:std.io;
i=s:std.str;

f=bar(filled:$i64):$str{
  let b=mut."_";
  let i=mut.0;
  lp(i<10){
    if(i<filled){b=s.concat(b;"_")}el{b=s.concat(b;"_")};
    i=i+1
  };
  <s.concat(b;"_")
};

f=label(name:$str):$str{
  let base=s.concat(name;"_");
  let out=mut.base;
  lp(s.len(out)<8){out=s.concat(out;"_")};
  <s.concat(out;"_")
};

f=main():$i64{
  let input=s.trim(io.readln());
  let inner=s.slice(input;1;s.len(input)-1);
  let objs=s.split(inner;"_");
  let total=mut.0;
  let completed=mut.0;
  let i=mut.0;
  lp(i<objs.len()){
    let raw=objs.get(i);
    let nmark=s.indexof(raw;"_"objective\"_""_"\"_");
    let name=s.slice(aftern;0;q as $u64);
    let cmark=s.indexof(raw;"_"completed\"_");
    let afterc=s.slice(raw;(cmark as $u64)+12;s.len(raw));
    let isdone=s.startswith(s.trim(afterc);"_");
    total=total+1;
    let pct=mut.0;
    let fill=mut.0;
    if(isdone){pct=100;fill=10;completed=completed+1};
    io.println(s.concat(s.concat(label(name);bar(fill));s.concat("_";s.concat(s.fromint(pct);"_"))));
    i=i+1
  };
  let overall=mut.0;
  let ofill=mut.0;
  if(total>0){
    overall=(completed*100)/total;
    ofill=(completed*10)/total
  };
  io.println(s.concat(s.concat(label("_");bar(ofill));s.concat("_";s.concat(s.fromint(overall);"_"))));
  <0
}
