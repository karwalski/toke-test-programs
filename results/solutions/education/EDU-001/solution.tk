m=quiz;i=io:std.io;i=s:std.str;
f=extractarr(text:$str;key:$str):$str{
  let pat=s.concat("\"";s.concat(key;"\":["));
  let idx=s.indexof(text;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat)-1;
  let depth=mut.0;
  let i=mut.start;
  let n=s.len(text);
  let inq=mut.false;
  lp(i<n){
    let c=s.slice(text;i;i+1);
    if(inq){
      if(s.eq(c;"\"")){inq=false}
    }el{
      if(s.eq(c;"\"")){inq=true};
      if(s.eq(c;"[")){depth=depth+1};
      if(s.eq(c;"]")){depth=depth-1;if(depth==0){<s.slice(text;start+1;i)}}
    };
    i=i+1
  };
  <""
};
f=getstrval(obj:$str;key:$str):$str{
  let pat=s.concat("\"";s.concat(key;"\":\""));
  let idx=s.indexof(obj;pat);
  if(idx<0){<""};
  let start=idx+s.len(pat);
  let after=s.slice(obj;start;s.len(obj));
  let cl=s.indexof(after;"\"");
  if(cl<0){<""};
  <s.slice(after;0;cl)
};
f=splitstrlist(arr:$str):@($str){
  let out=mut.@();
  let n=s.len(arr);
  let i=mut.0;
  let cur=mut."";
  let inq=mut.false;
  lp(i<n){
    let ch=s.slice(arr;i;i+1);
    if(s.eq(ch;"\"")){
      if(inq){out=out+@(cur);cur="";inq=false}el{inq=true}
    }el{
      if(inq){cur=s.concat(cur;ch)}
    };
    i=i+1
  };
  <out
};
f=splitobjects(arr:$str):@($str){
  let out=mut.@();
  let n=s.len(arr);
  let i=mut.0;
  let depth=mut.0;
  let start=mut.0;
  let inq=mut.false;
  lp(i<n){
    let c=s.slice(arr;i;i+1);
    if(inq){
      if(s.eq(c;"\"")){inq=false}
    }el{
      if(s.eq(c;"\"")){inq=true};
      if(s.eq(c;"{")){if(depth==0){start=i};depth=depth+1};
      if(s.eq(c;"}")){depth=depth-1;if(depth==0){out=out+@(s.slice(arr;start;i+1))}}
    };
    i=i+1
  };
  <out
};
f=main():$i64{
  let json=io.readln();
  let qarr=extractarr(json;"questions");
  let questions=splitobjects(qarr);
  let total=questions.len();
  let correct=mut.0;
  lp(let qi=0;qi<total;qi=qi+1){
    let qobj=questions.get(qi);
    let qtext=getstrval(qobj;"q");
    io.println(s.join("";@("Q";s.fromint(qi+1);": ";qtext)));
    let optarr=extractarr(qobj;"options");
    let opts=splitstrlist(optarr);
    lp(let oi=0;oi<opts.len();oi=oi+1){
      io.println(opts.get(oi))
    };
    let answer=getstrval(qobj;"answer");
    let user=s.trim(io.readln());
    if(s.eq(user;answer)){
      io.println("Correct!");
      correct=correct+1
    }el{
      io.println(s.concat("Incorrect. Answer: ";answer))
    }
  };
  io.println(s.join("";@("Score: ";s.fromint(correct);"/";s.fromint(total);" (";s.fromint(correct*100/total);"%)")));
  <0
}
