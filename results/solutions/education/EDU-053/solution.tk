m=quiz;i=io:std.io;i=s:std.str;
f=extractanswers(input:$str):@($str){
  let result=mut.@();
  let parts=s.split(input;"\"answer\":\"");
  let idx=mut.1;
  lp(idx<parts.len()){
    let endp=s.split(parts.get(idx);"\"");
    if(endp.len()>=1){
      result=result.push(endp.get(0))
    };
    idx=idx+1
  };
  <result
};
f=extractstudents(input:$str):@($str){
  let result=mut.@();
  let parts=s.split(input;"\"student_answers\":[");
  if(parts.len()<2){<result};
  let endp=s.split(parts.get(1);"]");
  let items=s.split(endp.get(0);",");
  let idx=mut.0;
  lp(idx<items.len()){
    let inner=s.split(s.trim(items.get(idx));"\"");
    if(inner.len()>=2){
      result=result.push(inner.get(1))
    };
    idx=idx+1
  };
  <result
};
f=main():$i64{
  let input=io.readln();
  let answers=extractanswers(input);
  let students=extractstudents(input);
  let total=answers.len();
  let correct=mut.0;
  let qidx=mut.0;
  lp(qidx<total){
    let expected=answers.get(qidx);
    let student=if(qidx<students.len()){students.get(qidx)}el{""};
    let qn=s.fromint((qidx+1) as $i64);
    if(s.lower(s.trim(expected))==s.lower(s.trim(student))){
      io.println(s.join("";@("Q";qn;": Correct")));
      correct=correct+1
    }el{
      io.println(s.join("";@("Q";qn;": Incorrect. Answer: ";expected)))
    };
    qidx=qidx+1
  };
  let percent=if(total>0){(correct*100)/(total as $i64)}el{0};
  io.println(s.join("";@("Score: ";s.fromint(correct as $i64);"/";s.fromint(total as $i64);" (";s.fromint(percent);"%)")));
  <0
}
