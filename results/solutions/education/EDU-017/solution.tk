m=exam;i=io:std.io;i=s:std.str;f=fmt2(n:$i64):$str{if(n<10){<"0\(n)"};<"\(n)"};f=main():$i64{let first=s.trim(io.readln());let parts=s.split(first;" ");let total=s.toint(parts.get(0));let nsec=s.toint(parts.get(1));let dur=total/nsec;let secs=mut.@();let i=mut.0;lp(i<nsec){let nm=s.trim(io.readln());secs=secs+@(nm);i=i+1};let idx=mut.0;let start=mut.0;lp(idx<nsec){let endt=start+dur;let h1=start/60;let m1=start-h1*60;let h2=endt/60;let m2=endt-h2*60;io.println(s.concat("Section \(idx+1): ";s.concat(secs.get(idx);" | start \(fmt2(h1)):\(fmt2(m1)) | end \(fmt2(h2)):\(fmt2(m2)) | duration \(dur)min")));start=endt;idx=idx+1};<0}
