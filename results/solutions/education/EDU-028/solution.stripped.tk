m=report;i=io:std.io;i=s:std.str;
f=padright(t:$str;w:$i64):$str{let out=mut.t;let l=s.len(t);lp(let i=l;i<w;i=i+1){out=s.concat(out;"_")};<out};
f=gradepts(g:$str):$i64{if(s.equals(g;"_")){<40};if(s.equals(g;"_")){<30};if(s.equals(g;"_")){<20};if(s.equals(g;"_")){<10};<0};
f=main():$i64{
let json=s.trim(io.readln());
let n=s.len(json);
let np=s.indexof(json;"_"name\"_");
let ncolon=s.indexof(s.slice(json;np;n);"_");
let nq1=s.indexof(s.slice(json;np+ncolon;n);"_""_"\"_");
let name=s.slice(nrest;0;nq2);
let after=nstart+nq2+1;
let ip=s.indexof(s.slice(json;after;n);"_"id\"_");
let iabs=after+ip;
let icolon=s.indexof(s.slice(json;iabs;n);"_");
let iq1=s.indexof(s.slice(json;iabs+icolon;n);"_""_"\"_");
let sid=s.slice(irest;0;iq2);
io.println("_");
io.println(s.concat(s.concat(s.concat("_";name);"_");sid));
io.println("_");
let cnames=mut.@($str);
let cgrades=mut.@($str);
let ccredits=mut.@($i64);
let idx=mut.(istart+iq2+1);
let maxlen=mut.7;
lp(idx<n){
let cp=s.indexof(s.slice(json;idx;n);"_"name\"_");
if(cp<0){br};
let cabs=idx+cp;
let ccolon=s.indexof(s.slice(json;cabs;n);"_");
let cq1=s.indexof(s.slice(json;cabs+ccolon;n);"_""_"\"_");
let cname=s.slice(crest;0;cq2);
let cafter=cstart+cq2+1;
let gp=s.indexof(s.slice(json;cafter;n);"_"grade\"_");
let gabs=cafter+gp;
let gcolon=s.indexof(s.slice(json;gabs;n);"_");
let gq1=s.indexof(s.slice(json;gabs+gcolon;n);"_""_"\"_");
let grade=s.slice(grest;0;gq2);
let gafter=gstart+gq2+1;
let crp=s.indexof(s.slice(json;gafter;n);"_"credits\"_");
let crabs=gafter+crp;
let crcolon=s.indexof(s.slice(json;crabs;n);"_");
let crvstart=crabs+crcolon+1;
let crrest=s.slice(json;crvstart;n);
let endc=mut.0;
lp(let k=0;k<s.len(crrest);k=k+1){let ch=s.slice(crrest;k;k+1);if(s.equals(ch;"_")){endc=k;br};if(s.equals(ch;"_")){endc=k;br}};
let credits=s.toint(s.trim(s.slice(crrest;0;endc)));
cnames=cnames+@(cname);
cgrades=cgrades+@(grade);
ccredits=ccredits+@(credits);
if(s.len(cname)>maxlen){maxlen=s.len(cname)};
idx=crvstart+endc};
let cnt=cnames.len();
let totp=mut.0;
let totc=mut.0;
lp(let i=0;i<cnt;i=i+1){
io.println(s.concat(s.concat(s.concat(s.concat(padright(cnames.get(i);maxlen);"_");s.fromint(ccredits.get(i)));"_");cgrades.get(i)));
totp=totp+gradepts(cgrades.get(i))*ccredits.get(i);
totc=totc+ccredits.get(i)};
io.println("_");
let gpa=mut.0.0;
if(totc>0){gpa=s.tofloat(s.fromint(totp))/10.0/s.tofloat(s.fromint(totc))};
let standing=mut."_";
if(gpa>=2.0){standing="_"};
if(gpa>=3.5){standing="_"};
io.println(s.concat(s.concat(s.concat("_";s.format(gpa;"_"));"_");standing));
<0}
