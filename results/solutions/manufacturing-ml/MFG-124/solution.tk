m=yieldcalc;
i=io:std.io;
i=s:std.str;
f=jfloat2(x:$f64):$str{
  let neg=mut.false; let v=mut.0.0; v=x;
  if(v<0.0){neg=true; v=0.0-v};
  let prod=mut.0.0; prod=v*100.0+0.5;
  let scaled=prod as$i64;
  let whole=scaled/100; let frac=scaled-whole*100;
  let out=mut.s.fromint(whole);
  out=s.concat(out;".");
  if(frac=0){
    out=s.concat(out;"0")
  }el{
    let tens=frac/10; let ones=frac-tens*10;
    if(ones=0){
      out=s.concat(out;s.fromint(tens))
    }el{
      let fs=mut.s.fromint(frac);
      if(frac<10){fs=s.concat("0";fs)};
      out=s.concat(out;fs)
    }
  };
  if(neg){out=s.concat("-";out)};
  <out
};
f=round2(x:$f64):$f64{
  let prod=mut.0.0; prod=x*100.0+0.5;
  let scaled=prod as$i64;
  let res=mut.0.0; res=scaled as$f64/100.0;
  <res
};
f=parsef(str:$str):$f64{
  let v=mt s.tofloat(s.trim(str)){$ok:v v;$err:e 0.0};
  let w=mut.0.0; w=v; <w
};
f=main():$i64{
  let names=mut.@();
  let yields=mut.@();
  let rawyields=mut.@();
  let first=mut.true;
  lp(1=1){
    let line=io.readln();
    if(io.eof()){br};
    let l=s.trim(line);
    if(s.len(l)<1){
      first=first
    }el{
      if(first){
        first=false
      }el{
        let parts=s.split(l;",");
        if(parts.len<3){
          first=first
        }el{
          let name=s.trim(parts.get(0));
          let inq=parsef(parts.get(1));
          let outq=parsef(parts.get(2));
          let y=mut.0.0;
          if(inq>0.0){y=outq/inq};
          let yv=mut.0.0; yv=y;
          names=names+@(name);
          yields=yields+@(round2(yv));
          rawyields=rawyields+@(yv)
        }
      }
    }
  };
  let n=yields.len;
  let cum=mut.1.0;
  lp(let i=0;i<n;i=i+1){
    let yi=mut.0.0; yi=rawyields.get(i);
    cum=cum*yi
  };
  let cumr=round2(cum);
  let bestidx=mut.0;
  let bestval=mut.2.0;
  lp(let i=0;i<n;i=i+1){
    let yi=mut.0.0; yi=yields.get(i);
    if(yi<bestval){bestval=yi; bestidx=i}
  };
  let out=mut."{\"stage_yields\":[";
  lp(let i=0;i<n;i=i+1){
    let yi=mut.0.0; yi=yields.get(i);
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;jfloat2(yi))
  };
  out=s.concat(out;"],\"cumulative_yield\":");
  out=s.concat(out;jfloat2(cumr));
  out=s.concat(out;",\"bottleneck_stage\":\"");
  out=s.concat(out;names.get(bestidx));
  out=s.concat(out;"\"}");
  io.println(out);
  <0
};
