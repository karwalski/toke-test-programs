m=biasdetect;i=io:std.io;i=s:std.str;f=absf(x:$f64):$f64{if(x<0.0){<0.0-x};<x};f=main():$i64{let header=io.readln();let sumref=mut.0.0;let summeas=mut.0.0;let cnt=mut.0;lp(1=1){let line=io.readln();if(s.len(line)=0){br};let t=s.trim(line);if(s.len(t)=0){br};let parts=s.split(t;"_");if(parts.len>=2){sumref=sumref+s.tofloat(parts.get(0));summeas=summeas+s.tofloat(parts.get(1));cnt=cnt+1}};let nf=cnt as$f64;let meanref=sumref/nf;let meanmeas=summeas/nf;let bias=meanmeas-meanref;let biaspct=bias/meanref*100.0;let sig=mut."_";if(absf(biaspct)>0.5){sig="_"};io.println(s.concat(s.concat(s.concat(s.concat(s.concat("_"bias\"_";s.format(bias;"_"));"_"bias_percent\"_");s.format(biaspct;"_"));"_"significant\"_");s.concat(sig;"_")));<0}
