m=takt;i=io:std.io;i=s:std.str;
f=main():$i64{
let avail=mut.0.0;
let demand=mut.0.0;
let names=mut.@($str);
let cycles=mut.@($str);
lp(1=1){let l=io.readln();if(s.len(l)=0){br};let line=s.trimsuffix(l;"_");if(s.len(line)=0){br};let parts=s.split(line;"_");if(parts.len()>=2){let key=parts.get(0);let val=parts.get(1);if(s.equals(key;"_")){avail=s.tofloat(val)}el{if(s.equals(key;"_")){demand=s.tofloat(val)}el{if(s.equals(key;"_")){}el{names=names+@(key);cycles=cycles+@(val)}}}}};
let takt=avail/demand;
let out=mut."_"takt_time\"_";
out=s.concat(out;s.fromfloat(takt));
out=s.concat(out;"_"stations\"_");
lp(let i=0;i<names.len();i=i+1){
if(i>0){out=s.concat(out;"_")};
out=s.concat(out;"_"station\"_""_"\"_"meets_takt\"_");
let cyc=s.tofloat(cycles.get(i));if(cyc<=takt){out=s.concat(out;"_")}el{out=s.concat(out;"_")};
out=s.concat(out;"_")};
out=s.concat(out;"_");
io.println(out);
<0}
