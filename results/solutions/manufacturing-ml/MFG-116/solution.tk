m=healthcheck;
i=io:std.io;
i=s:std.str;
f=parsef(str:$str):$f64{
  let v=mt s.tofloat(s.trim(str)){$ok:v v;$err:e 0.0};
  let w=mut.0.0; w=v; <w
};
f=clamp(x:$f64):$f64{
  let v=mut.0.0; v=x;
  if(v<0.0){v=0.0};
  if(v>100.0){v=100.0};
  <v
};
f=main():$i64{
  let ids=mut.@();
  let scores=mut.@();
  let first=mut.true;
  lp(1=1){
    let line=io.readln();
    if(io.eof()){br};
    let l=s.trim(line);
    if(s.len(l)<1){
      first=first
    }el{
      if(first){
        first=false
      }el{
        let parts=s.split(l;",");
        if(parts.len<4){
          first=first
        }el{
          let sid=s.trim(parts.get(0));
          let noise=parsef(parts.get(1));
          let drift=parsef(parts.get(2));
          let dropout=parsef(parts.get(3));
          let sn=mut.0.0; sn=clamp(100.0-noise*300.0);
          let sd=mut.0.0; sd=clamp(100.0-drift*400.0);
          let sdo=mut.0.0; sdo=clamp(100.0-dropout*15.0);
          let h=mut.0.0; h=0.3*sn+0.4*sd+0.3*sdo;
          let hi=mut.0; hi=(h+0.5) as$i64;
          ids=ids+@(sid);
          scores=scores+@(hi)
        }
      }
    }
  };
  let n=ids.len;
  let out=mut."{\"sensors\":[";
  lp(let i=0;i<n;i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;"{\"sensor_id\":\"");
    out=s.concat(out;ids.get(i));
    out=s.concat(out;"\",\"health_score\":");
    out=s.concat(out;s.fromint(scores.get(i)));
    out=s.concat(out;"}")
  };
  out=s.concat(out;"],\"priority\":[");
  let order=mut.@();
  lp(let k=0;k<n;k=k+1){
    let bestidx=mut.0-1;
    let bestval=mut.0;
    lp(let i=0;i<n;i=i+1){
      let isused=mut.false;
      lp(let j=0;j<order.len;j=j+1){
        if(order.get(j)=i){isused=true}
      };
      if(!(isused)){
        if(bestidx<0){
          bestidx=i; bestval=scores.get(i)
        }el{
          if(scores.get(i)<bestval){
            bestidx=i; bestval=scores.get(i)
          }
        }
      }
    };
    order=order+@(bestidx)
  };
  lp(let k=0;k<n;k=k+1){
    if(k>0){out=s.concat(out;",")};
    out=s.concat(out;"\"");
    out=s.concat(out;ids.get(order.get(k)));
    out=s.concat(out;"\"")
  };
  out=s.concat(out;"]}");
  io.println(out);
  <0
};
