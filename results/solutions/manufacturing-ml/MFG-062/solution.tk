m=roc;
i=io:std.io;
i=s:std.str;

f=fmt1(x:$f64):$str{
  let v=mut.x;
  if(v<0.0){if(v>-0.000001){v=0.0}};
  <s.format(v;"%.1f")
};

f=main():$i64{
  let lines=mut.@("");
  lines=@();
  let done=mut.0;
  lp(done<1){
    let line=io.readln();
    if(s.len(line)=0){done=1}el{
      let tl=s.trim(line);
      if(s.len(tl)>0){lines=lines+@(tl)}
    }
  };

  let nlines=lines.len();
  if(nlines<2){io.println("{}");<0};

  // parse rows (skip header line 0)
  let nrows=nlines-1;
  let act=mut.@(0.0);
  act=@();
  let prob=mut.@(0.0);
  prob=@();
  lp(let r=0;r<nrows;r=r+1){
    let parts=s.split(lines.get(r+1);",");
    act=act+@(s.tofloat(parts.get(0)));
    prob=prob+@(s.tofloat(parts.get(1)))
  };

  // count positives/negatives
  let np=mut.0.0;
  let nn=mut.0.0;
  lp(let r=0;r<nrows;r=r+1){
    if(act.get(r)>0.5){np=np+1.0}el{nn=nn+1.0}
  };
  if(np<0.5){np=1.0};
  if(nn<0.5){nn=1.0};

  // sort indices by probability descending (selection sort)
  let idx=mut.@(0);
  idx=@();
  lp(let r=0;r<nrows;r=r+1){idx=idx+@(r)};
  lp(let i=0;i<nrows;i=i+1){
    let best=mut.i;
    lp(let j=i+1;j<nrows;j=j+1){
      if(prob.get(idx.get(j))>prob.get(idx.get(best))){best=j}
    };
    if(best>i){
      let tmp=idx.get(i);
      let bi=idx.get(best);
      // rebuild idx with swap
      let ni=mut.@(0);
      ni=@();
      lp(let k=0;k<nrows;k=k+1){
        if(k=i){ni=ni+@(bi)}el{
          if(k=best){ni=ni+@(tmp)}el{ni=ni+@(idx.get(k))}
        }
      };
      idx=ni
    }
  };

  // sweep building full ROC curve: fpr[], tpr[]
  let fx=mut.@(0.0);
  fx=@();
  let ty=mut.@(0.0);
  ty=@();
  fx=fx+@(0.0);
  ty=ty+@(0.0);
  let tp=mut.0.0;
  let fp=mut.0.0;
  lp(let r=0;r<nrows;r=r+1){
    let a=act.get(idx.get(r));
    if(a>0.5){tp=tp+1.0}el{fp=fp+1.0};
    fx=fx+@(fp/nn);
    ty=ty+@(tp/np)
  };

  let npts=fx.len();

  // AUC via trapezoidal rule over full curve
  let auc=mut.0.0;
  lp(let i=1;i<npts;i=i+1){
    let dx=fx.get(i)-fx.get(i-1);
    let avgy=(ty.get(i)+ty.get(i-1))/2.0;
    auc=auc+dx*avgy
  };

  // drop collinear intermediate points (drop_intermediate)
  let kx=mut.@(0.0);
  kx=@();
  let ky=mut.@(0.0);
  ky=@();
  lp(let i=0;i<npts;i=i+1){
    let keep=mut.0;
    if(i=0){keep=1};
    if(i=npts-1){keep=1};
    if(i>0){if(i<npts-1){
      // check collinearity with neighbors via cross product
      let x0=fx.get(i-1);let y0=ty.get(i-1);
      let x1=fx.get(i);let y1=ty.get(i);
      let x2=fx.get(i+1);let y2=ty.get(i+1);
      let cross=(x1-x0)*(y2-y0)-(y1-y0)*(x2-x0);
      let ac=mut.cross;
      if(ac<0.0){ac=0.0-ac};
      if(ac>0.0000001){keep=1}
    }};
    if(keep=1){
      kx=kx+@(fx.get(i));
      ky=ky+@(ty.get(i))
    }
  };

  let nk=kx.len();
  let out=mut."{\"auc\":";
  out=s.concat(out;fmt1(auc));
  out=s.concat(out;",\"roc_points\":[");
  lp(let i=0;i<nk;i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;"{\"fpr\":");
    out=s.concat(out;fmt1(kx.get(i)));
    out=s.concat(out;",\"tpr\":");
    out=s.concat(out;fmt1(ky.get(i)));
    out=s.concat(out;"}")
  };
  out=s.concat(out;"]}");
  io.println(out);
  <0
};
