m=stddev;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;"_");let n=parts.len();let sum=mut.0.0;lp(let i=0;i<n;i=i+1){sum=sum+s.tofloat(s.trim(parts.get(i)))};let mean=sum/(n as $f64);let ssd=mut.0.0;lp(let i=0;i<n;i=i+1){let d=s.tofloat(s.trim(parts.get(i)))-mean;ssd=ssd+d*d};let std=math.sqrt(ssd/((n-1) as $f64));io.println(s.concat(s.concat("_"std_dev\"_";s.format(std;"_"));"_"));<0}
