let out=mut."_"f_statistic\"_";out=s.concat(out;fstr);out=s.concat(out;"_"p_value\"_");out=s.concat(out;pstr);out=s.concat(out;"_"significant\"_");out=s.concat(out;sig);out=s.concat(out;"_"group_means\"_");out=s.concat(out;means);out=s.concat(out;"_");io.println(out);<0}
