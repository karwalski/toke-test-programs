m=mean;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let cols=s.split(line;",");let sum=mut.0.0;let count=mut.0;lp(let i=0;i<cols.len();i=i+1){let c=s.trim(cols.get(i));if(s.len(c)>0){sum=sum+s.tofloat(c);count=count+1}};let avg=sum/(count as $f64);let out=s.format(avg;"%g");io.println(s.concat("{\"mean\":";s.concat(out;"}")));<0}
