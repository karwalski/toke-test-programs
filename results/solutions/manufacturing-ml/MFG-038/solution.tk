m=scraper;
i=io:std.io;
i=s:std.str;
f=fmtnum(x:f64):str{
let r=mut.s.format(x;"%.2f");
let go=mut.1;
lp(go>0){
if(s.endswith(r;"0")){
let cut=s.slice(r;0;s.len(r)-1);
if(s.endswith(cut;".")){r=s.concat(cut;"0");go=0}el{r=cut}
}el{go=0}
};
<r
};
f=main():i64{
let cats=mut.@();
let scraps=mut.@();
let prods=mut.@();
let totScrap=mut.0;
let totProd=mut.0;
let first=mut.1;
let go=mut.1;
lp(go>0){
let line=s.trim(io.readln());
if(s.len(line)==0){go=0}el{
if(first>0){first=0}el{
let parts=s.split(line;",");
let cat=s.trim(parts.get(0));
let scnt=s.toint(s.trim(parts.get(1)));
let prod=s.toint(s.trim(parts.get(2)));
cats=cats+@(cat);
scraps=scraps+@(scnt);
prods=prods+@(prod);
totScrap=totScrap+scnt;
totProd=totProd+prod;
}
}
};
let n=cats.len;
let rates=mut.@();
lp(let i=0;i<n;i=i+1){
let r=s.tofloat(s.fromint(scraps.get(i)))/s.tofloat(s.fromint(prods.get(i)));
rates=rates+@(r);
};
let order=mut.@();
lp(let i=0;i<n;i=i+1){order=order+@(i)};
lp(let i=0;i<n;i=i+1){
lp(let j=0;j<n-1-i;j=j+1){
let a=order.get(j);
let b=order.get(j+1);
let swap=mut.0;
if(rates.get(a)<rates.get(b)){swap=1}el{
if(rates.get(a)==rates.get(b)){
if(scraps.get(a)<scraps.get(b)){swap=1}
}
};
if(swap>0){
order=order.set(j;b);
order=order.set(j+1;a);
}
}
};
let overall=s.tofloat(s.fromint(totScrap))/s.tofloat(s.fromint(totProd));
let out=mut.s.concat("{\"overall_rate\":";fmtnum(overall));
out=s.concat(out;",\"categories\":[");
lp(let k=0;k<n;k=k+1){
let idx=order.get(k);
if(k>0){out=s.concat(out;",")};
out=s.concat(out;"{\"category\":\"");
out=s.concat(out;cats.get(idx));
out=s.concat(out;"\",\"rate\":");
out=s.concat(out;fmtnum(rates.get(idx)));
out=s.concat(out;"}");
};
out=s.concat(out;"]}");
io.println(out);
<0
}
