m=clustering;
i=io:std.io;
i=s:std.str;
i=math:std.math;
f=main():$i64{
  let lines=mut.@("");
  lines=@();
  let done=mut.0;
  lp(done<1){
    let line=io.readln();
    if(s.len(line)==0){done=1}el{
      let tl=s.trim(line);
      if(s.len(tl)>0){lines=lines+@(tl)}
    }
  };
  let nlines=lines.len();
  let nclusters=(s.toint(lines.get(0)) as $i64);
  let xs=mut.@(0.0);
  xs=@();
  let ys=mut.@(0.0);
  ys=@();
  lp(let i=1;i<nlines;i=i+1){
    let parts=s.split(lines.get(i);",");
    xs=xs+@(s.tofloat(parts.get(0)));
    ys=ys+@(s.tofloat(parts.get(1)));
  };
  let npts=xs.len();
  let cid=mut.@(0);
  cid=@();
  let ccx=mut.@(0.0);
  ccx=@();
  let ccy=mut.@(0.0);
  ccy=@();
  let ccount=mut.@(0);
  ccount=@();
  lp(let i=0;i<npts;i=i+1){
    cid=cid+@(i);
    ccx=ccx+@(xs.get(i));
    ccy=ccy+@(ys.get(i));
    ccount=ccount+@(1);
  };
  let plabel=mut.@(0);
  plabel=@();
  lp(let i=0;i<npts;i=i+1){
    plabel=plabel+@(i);
  };
  let members=mut.@(@(0));
  members=@();
  lp(let i=0;i<npts;i=i+1){
    members=members+@(@(i));
  };
  let nextid=mut.npts;
  let mergeA=mut.@(0);
  mergeA=@();
  let mergeB=mut.@(0);
  mergeB=@();
  let active=mut.npts;
  lp(active>1){
    let bi=mut.0;
    let bj=mut.1;
    let bd=mut.0.0-1.0;
    let nc=cid.len();
    lp(let a=0;a<nc;a=a+1){
      lp(let b=a+1;b<nc;b=b+1){
        let dx=ccx.get(a)-ccx.get(b);
        let dy=ccy.get(a)-ccy.get(b);
        let d=math.sqrt(dx*dx+dy*dy);
        if(bd<0.0){bd=d;bi=a;bj=b}el{if(d<bd-0.000001){bd=d;bi=a;bj=b}};
      }
    };
    let idA=cid.get(bi);
    let idB=cid.get(bj);
    mergeA=mergeA+@(idA);
    mergeB=mergeB+@(idB);
    let newid=nextid;
    nextid=nextid+1;
    let cntA=ccount.get(bi);
    let cntB=ccount.get(bj);
    let totc=cntA+cntB;
    let ncx=(ccx.get(bi)*(cntA as $f64)+ccx.get(bj)*(cntB as $f64))/(totc as $f64);
    let ncy=(ccy.get(bi)*(cntA as $f64)+ccy.get(bj)*(cntB as $f64))/(totc as $f64);
    let mlist=mut.@(0);
    mlist=@();
    let ma=members.get(bi);
    let mb=members.get(bj);
    lp(let k=0;k<ma.len();k=k+1){mlist=mlist+@(ma.get(k))};
    lp(let k=0;k<mb.len();k=k+1){mlist=mlist+@(mb.get(k))};
    let ncid=mut.@(0);ncid=@();
    let nccx=mut.@(0.0);nccx=@();
    let nccy=mut.@(0.0);nccy=@();
    let nccount=mut.@(0);nccount=@();
    let nmembers=mut.@(@(0));nmembers=@();
    lp(let a=0;a<nc;a=a+1){
      if(a==bi){}el{if(a==bj){}el{
        ncid=ncid+@(cid.get(a));
        nccx=nccx+@(ccx.get(a));
        nccy=nccy+@(ccy.get(a));
        nccount=nccount+@(ccount.get(a));
        nmembers=nmembers+@(members.get(a));
      }}
    };
    ncid=ncid+@(newid);
    nccx=nccx+@(ncx);
    nccy=nccy+@(ncy);
    nccount=nccount+@(totc);
    nmembers=nmembers+@(mlist);
    cid=ncid;
    ccx=nccx;
    ccy=nccy;
    ccount=nccount;
    members=nmembers;
    active=active-1;
  };
  let grp=mut.@(0);
  grp=@();
  lp(let i=0;i<npts;i=i+1){grp=grp+@(i)};
  let ngroups=mut.npts;
  let nm=mergeA.len();
  let idrep=mut.@(0);
  idrep=@();
  lp(let i=0;i<nextid;i=i+1){idrep=idrep+@(0)};
  let idrep2=mut.@(0);
  idrep2=@();
  lp(let i=0;i<nextid;i=i+1){
    if(i<npts){idrep2=idrep2+@(i)}el{idrep2=idrep2+@(-1)}
  };
  idrep=idrep2;
  lp(let k=0;k<nm;k=k+1){
    if(ngroups>nclusters){
      let ida=mergeA.get(k);
      let idb=mergeB.get(k);
      let ra=idrep.get(ida);
      let rb=idrep.get(idb);
      let ga=grp.get(ra);
      let gb=grp.get(rb);
      lp(let p=0;p<npts;p=p+1){
        if(grp.get(p)==gb){
          let ngrp=mut.@(0);ngrp=@();
          lp(let q=0;q<npts;q=q+1){
            if(q==p){ngrp=ngrp+@(ga)}el{ngrp=ngrp+@(grp.get(q))}
          };
          grp=ngrp;
        }
      };
      let newid2=npts+k;
      let nidrep=mut.@(0);nidrep=@();
      lp(let q=0;q<nextid;q=q+1){
        if(q==newid2){nidrep=nidrep+@(ra)}el{nidrep=nidrep+@(idrep.get(q))}
      };
      idrep=nidrep;
      ngroups=ngroups-1;
    }
  };
  let labelmap=mut.@(-1);
  labelmap=@();
  lp(let i=0;i<npts;i=i+1){labelmap=labelmap+@(-1)};
  let nextlabel=mut.0;
  let finallabels=mut.@(0);
  finallabels=@();
  lp(let p=0;p<npts;p=p+1){
    let g=grp.get(p);
    if(labelmap.get(g)<0){
      let nlm=mut.@(-1);nlm=@();
      lp(let q=0;q<npts;q=q+1){
        if(q==g){nlm=nlm+@(nextlabel)}el{nlm=nlm+@(labelmap.get(q))}
      };
      labelmap=nlm;
      nextlabel=nextlabel+1;
    };
    finallabels=finallabels+@(labelmap.get(g));
  };
  let out=mut."{\"cluster_labels\":[";
  lp(let i=0;i<npts;i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;s.fromint(finallabels.get(i)));
  };
  out=s.concat(out;"],\"merge_history\":[");
  lp(let k=0;k<nm;k=k+1){
    if(k>0){out=s.concat(out;",")};
    out=s.concat(out;"[");
    out=s.concat(out;s.fromint(mergeA.get(k)));
    out=s.concat(out;",");
    out=s.concat(out;s.fromint(mergeB.get(k)));
    out=s.concat(out;"]");
  };
  out=s.concat(out;"]}");
  io.println(out);
  <0
};
