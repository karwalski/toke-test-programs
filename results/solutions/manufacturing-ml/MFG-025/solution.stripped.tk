m=kmeans;i=io:std.io;i=s:std.str;f=fmtf(v:$f64):$str{let raw=s.format(v;"_");let n=s.len(raw);let dot=mut.0-1;lp(let i=0;i<n;i=i+1){let c=s.slice(raw;i;i+1);if(c="_"){dot=i}};if(dot<0){<raw};let last=mut.n-1;lp(1=1){if(last<=dot+1){br};let c=s.slice(raw;last;last+1);if(c="_"){last=last-1}el{br}};<s.slice(raw;0;last+1)};f=main():$i64{let k=s.toint(s.trim(io.readln()));let px=mut.@(0.0);px=@();let py=mut.@(0.0);py=@();let empties=mut.0;lp(1=1){let line=io.readln();if(s.len(line)=0){empties=empties+1;if(empties>=2){br}}el{empties=0;let parts=s.split(s.trim(line);"_");if(parts.len()>=2){px=px+@(s.tofloat(s.trim(parts.get(0))));py=py+@(s.tofloat(s.trim(parts.get(1))))}}};let n=px.len();let cx=mut.@(0.0);cx=@();let cy=mut.@(0.0);cy=@();lp(let i=0;i<k;i=i+1){let vx=px.get(i);let vy=py.get(i);cx=cx+@(vx);cy=cy+@(vy)};let assign=mut.@();lp(let j=0;j<n;j=j+1){assign=assign+@(0)};lp(let iter=0;iter<100;iter=iter+1){lp(let j=0;j<n;j=j+1){let pxv=px.get(j);let pyv=py.get(j);let best=mut.0;let bestd=mut.0.0;let first=mut.true;lp(let c=0;c<k;c=c+1){let cxv=cx.get(c);let cyv=cy.get(c);let dx=pxv-cxv;let dy=pyv-cyv;let d=dx*dx+dy*dy;if(first){bestd=d;best=c;first=false}el{if(d<bestd){bestd=d;best=c}}};assign=assign.set(j;best)};let nsx=mut.@(0.0);nsx=@();let nsy=mut.@(0.0);nsy=@();let cnt=mut.@();lp(let c=0;c<k;c=c+1){nsx=nsx+@(0.0);nsy=nsy+@(0.0);cnt=cnt+@(0)};lp(let j=0;j<n;j=j+1){let a=assign.get(j);let pxv=px.get(j);let pyv=py.get(j);let oldx=nsx.get(a);let oldy=nsy.get(a);nsx=nsx.set(a;oldx+pxv);nsy=nsy.set(a;oldy+pyv);cnt=cnt.set(a;cnt.get(a)+1)};lp(let c=0;c<k;c=c+1){let ct=cnt.get(c);if(ct>0){let sxv=nsx.get(c);let syv=nsy.get(c);let ctf=ct as $f64;cx=cx.set(c;sxv/ctf);cy=cy.set(c;syv/ctf)}}};let out=mut."_"centroids\"_";lp(let c=0;c<k;c=c+1){if(c>0){out=s.concat(out;"_")};let cxv=cx.get(c);let cyv=cy.get(c);out=s.concat(out;"_");out=s.concat(out;fmtf(cxv));out=s.concat(out;"_");out=s.concat(out;fmtf(cyv));out=s.concat(out;"_")};out=s.concat(out;"_"assignments\"_");lp(let j=0;j<n;j=j+1){if(j>0){out=s.concat(out;"_")};out=s.concat(out;s.fromint(assign.get(j)))};out=s.concat(out;"_");io.println(out);<0}
