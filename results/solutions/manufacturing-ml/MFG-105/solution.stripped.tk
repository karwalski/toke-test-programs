m=toolwear;i=io:std.io;i=s:std.str;f=main():$i64{let cycles=mut.@($f64);let wears=mut.@($f64);let maxwear=mut.0.0;let first=mut.1;let header=io.readln();lp(1=1){let line=io.readln();if(s.len(line)=0){br};let parts=s.split(line;"_");if(parts.len()>=3){let cyc=s.tofloat(parts.get(0));let w=s.tofloat(parts.get(1));let mw=s.tofloat(parts.get(2));cycles=cycles+@(cyc);wears=wears+@(w);if(first=1){maxwear=mw;first=0}}};let n=cycles.len();let nf=s.tofloat(s.fromint(n));let sumx=mut.0.0;let sumy=mut.0.0;let sumxy=mut.0.0;let sumx2=mut.0.0;lp(let i=0;i<n;i=i+1){let x=cycles.get(i);let y=wears.get(i);sumx=sumx+x;sumy=sumy+y;sumxy=sumxy+x*y;sumx2=sumx2+x*x};let rate=(nf*sumxy-sumx*sumy)/(nf*sumx2-sumx*sumx);let intercept=(sumy-rate*sumx)/nf;let repf=(maxwear-intercept)/rate;let rep=s.toint(s.fromfloat(repf));let lastc=cycles.get(n-1);let lastci=s.toint(s.fromfloat(lastc));let rem=rep-lastci;io.println(s.concat(s.concat(s.concat("_"wear_rate\"_";s.fromfloat(rate));s.concat("_"cycles_remaining\"_";s.fromint(rem)));s.concat(s.concat("_"replacement_cycle\"_";s.fromint(rep));"_")));<0}