m=kfold;i=io:std.io;i=s:std.str;
f=fmtscore(x:$f64):$str{
  let scaled=x*100.0+0.5;
  let h=mut.0;
  let neg=mut.(1=0);
  let xv=mut.scaled;
  if(xv<0.0){neg=(1=1);xv=0.0-xv};
  lp(xv>=1.0){h=h+1;xv=xv-1.0};
  if(neg){h=0-h};
  let whole=h/100;
  let frac=mut.h%100;
  if(frac<0){frac=0-frac};
  let out=mut.s.fromint(whole);
  out=s.concat(out;".");
  if(frac%10=0){
    out=s.concat(out;s.fromint(frac/10))
  }el{
    if(frac<10){out=s.concat(out;"0")};
    out=s.concat(out;s.fromint(frac))
  };
  <out
};
f=main():$i64{
  let lines=mut.@($str);
  lp(io.eof()=(1=0)){
    let line=io.readln();
    if(io.eof()){if(s.len(line)=0){br}};
    lines=lines+@(s.trim(line))
  };
  let k=s.toint(lines.get(0));
  let xs=mut.@($f64);
  let ys=mut.@($f64);
  lp(let i=2;i<lines.len();i=i+1){
    let row=lines.get(i);
    if(s.len(row)>0){
      let cells=s.split(row;",");
      if(cells.len()>=2){
        xs=xs+@(s.tofloat(s.trim(cells.get(0))));
        ys=ys+@(s.tofloat(s.trim(cells.get(1))))
      }
    }
  };
  let n=xs.len() as $i64;
  let foldsize=n/k;
  let scores=mut.@($f64);
  lp(let fi=0;fi<k;fi=fi+1){
    let startidx=fi*foldsize;
    let endidx=mut.(fi+1)*foldsize;
    if(fi=k-1){endidx=n};
    let sumx=mut.0.0;
    let sumy=mut.0.0;
    let sumxy=mut.0.0;
    let sumxx=mut.0.0;
    let ntrain=mut.0;
    lp(let j=0;j<n;j=j+1){
      let intest=mut.(1=0);
      if(j>=startidx){if(j<endidx){intest=(1=1)}};
      if(intest=(1=0)){
        let xv=xs.get(j);
        let yv=ys.get(j);
        sumx=sumx+xv;
        sumy=sumy+yv;
        sumxy=sumxy+xv*yv;
        sumxx=sumxx+xv*xv;
        ntrain=ntrain+1
      }
    };
    let nt=ntrain as $f64;
    let m=(nt*sumxy-sumx*sumy)/(nt*sumxx-sumx*sumx);
    let b=(sumy-m*sumx)/nt;
    let ytestmean=mut.0.0;
    let ntest=mut.0;
    lp(let j=startidx;j<endidx;j=j+1){ytestmean=ytestmean+ys.get(j);ntest=ntest+1};
    ytestmean=ytestmean/(ntest as $f64);
    let sstot=mut.0.0;
    let ssres=mut.0.0;
    lp(let j=startidx;j<endidx;j=j+1){
      let yv=ys.get(j);
      let pred=m*xs.get(j)+b;
      sstot=sstot+(yv-ytestmean)*(yv-ytestmean);
      ssres=ssres+(yv-pred)*(yv-pred)
    };
    let r2=mut.1.0;
    if(sstot!=0.0){r2=1.0-(ssres/sstot)};
    scores=scores+@(r2)
  };
  let meansum=mut.0.0;
  lp(let i=0;i<scores.len();i=i+1){meansum=meansum+scores.get(i)};
  let mean=meansum/(scores.len() as $f64);
  let out=mut."{\"fold_scores\":[";
  lp(let i=0;i<scores.len();i=i+1){
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;fmtscore(scores.get(i)))
  };
  out=s.concat(out;"],\"mean_score\":");
  out=s.concat(out;fmtscore(mean));
  out=s.concat(out;"}");
  io.println(out);
  <0
}
