m=drift;i=io:std.io;i=s:std.str;
f=main():$i64{let ts=mut.@($f64);let rs=mut.@($f64);let first=mut.(1==1);
lp(1==1){let line=io.readln();if(s.len(line)==0){br};let l=s.trim(line);if(s.len(l)==0){br};if(first){first=1==0}el{let parts=s.split(l;",");if(parts.len()>=2){ts=ts+@(s.tofloat(parts.get(0)));rs=rs+@(s.tofloat(parts.get(1)))}}};
if(ts.len()<2){io.println("{\"drift_detected\":false,\"drift_rate\":0.0,\"direction\":\"none\"}");<0};
let sum=mut.0.0;let cnt=mut.0;
lp(let i=1;i<ts.len();i=i+1){let td=ts.get(i)-ts.get(i-1);let rd=rs.get(i)-rs.get(i-1);if(td>0.0){sum=sum+rd/td;cnt=cnt+1}};
if(cnt==0){io.println("{\"drift_detected\":false,\"drift_rate\":0.0,\"direction\":\"none\"}");<0};
let avg=sum/s.tofloat(s.fromint(cnt));
let dir=mut."stable";let det=mut."false";
if(avg>0.0000000001){dir="increasing";det="true"}el{if(avg<(0.0-0.0000000001)){dir="decreasing";det="true"}};
io.println(s.concat(s.concat(s.concat(s.concat(s.concat("{\"drift_detected\":";det);",\"drift_rate\":");s.fromfloat(avg));",\"direction\":\"");s.concat(dir;"\"}")));<0}
