m=cpkmonitor;
i=io:std.io;
i=s:std.str;
i=math:std.math;
f=parsef(str:$str):$f64{
  let v=mt s.tofloat(s.trim(str)){$ok:v v;$err:e 0.0};
  let w=mut.0.0; w=v; <w
};
f=parsei(str:$str):$i64{ <mt s.toint(s.trim(str)){$ok:v v;$err:e 0} };
f=jfloat2(x:$f64):$str{
  let neg=mut.false; let v=mut.0.0; v=x;
  if(v<0.0){neg=true; v=0.0-v};
  let prod=mut.0.0; prod=v*100.0+0.5;
  let scaled=prod as$i64;
  let whole=scaled/100; let frac=scaled-whole*100;
  let out=mut.s.fromint(whole);
  out=s.concat(out;".");
  if(frac==0){
    out=s.concat(out;"0")
  }el{
    let tens=frac/10; let ones=frac-tens*10;
    if(ones==0){
      out=s.concat(out;s.fromint(tens))
    }el{
      let fs=mut.s.fromint(frac);
      if(frac<10){fs=s.concat("0";fs)};
      out=s.concat(out;fs)
    }
  };
  if(neg){out=s.concat("-";out)};
  <out
};
f=main():$i64{
  let lsl=mut.0.0;
  let usl=mut.0.0;
  let win=mut.0;
  let vals=mut.@();
  lp(1==1){
    let line=io.readln();
    if(io.eof()){br};
    let l=s.trim(line);
    if(s.len(l)<1){
      lsl=lsl
    }el{
      let parts=s.split(l;",");
      let key=s.trim(parts.get(0));
      if(s.eq(key;"lsl")){
        lsl=parsef(parts.get(1))
      }el{
        if(s.eq(key;"usl")){
          usl=parsef(parts.get(1))
        }el{
          if(s.eq(key;"window")){
            win=parsei(parts.get(1))
          }el{
            lp(let i=0;i<parts.len;i=i+1){
              vals=vals+@(parsef(parts.get(i)))
            }
          }
        }
      }
    }
  };
  let n=vals.len;
  let trend=mut.@();
  let alert=mut.false;
  lp(let start=0;start+win<=n;start=start+1){
    let sum=mut.0.0;
    lp(let i=0;i<win;i=i+1){
      let vi=mut.0.0; vi=vals.get(start+i);
      sum=sum+vi
    };
    let mean=mut.0.0; mean=sum/(win as$f64);
    let ss=mut.0.0;
    lp(let i=0;i<win;i=i+1){
      let vi=mut.0.0; vi=vals.get(start+i);
      let d=mut.0.0; d=vi-mean;
      ss=ss+d*d
    };
    let variance=mut.0.0; variance=ss/((win-1) as$f64);
    let std=mut.0.0; std=math.sqrt(variance);
    let upper=mut.0.0; upper=usl-mean;
    let lower=mut.0.0; lower=mean-lsl;
    let mn=mut.0.0; mn=upper; if(lower<upper){mn=lower};
    let cpk=mut.0.0;
    if(std>0.0){cpk=mn/(3.0*std)};
    let prod=mut.0.0; prod=cpk*100.0+0.5;
    let cr=mut.0.0; cr=(prod as$i64) as$f64/100.0;
    if(cr<1.33){alert=true};
    trend=trend+@(cr)
  };
  let out=mut."{\"cpk_trend\":[";
  lp(let i=0;i<trend.len;i=i+1){
    let ti=mut.0.0; ti=trend.get(i);
    if(i>0){out=s.concat(out;",")};
    out=s.concat(out;jfloat2(ti))
  };
  out=s.concat(out;"],\"degradation_alert\":");
  if(alert){out=s.concat(out;"true")}el{out=s.concat(out;"false")};
  out=s.concat(out;"}");
  io.println(out);
  <0
};
