m=linreg;i=io:std.io;i=s:std.str;f=fmt(x:$f64):$str{<s.format(x;"%.1f")};f=main():$i64{let line1=io.readln();let p1=s.split(line1;",");let px=mut.0.0;if(p1.len>=2){px=s.tofloat(p1.get(1))};let xs=mut.@($f64);let ys=mut.@($f64);lp(1=1){let row=io.readln();let isEof=io.eof();let t=s.trim(row);if(s.len(t)>0){let rp=s.split(t;",");if(rp.len>=2){let a=rp.get(0);if(s.eq(a;"x")=false){xs=xs+@(s.tofloat(a));ys=ys+@(s.tofloat(rp.get(1)))}}};if(isEof){br}};let n=xs.len;let nf=n as $f64;let sx=mut.0.0;let sy=mut.0.0;lp(let idx=0;idx<n;idx=idx+1){sx=sx+xs.get(idx);sy=sy+ys.get(idx)};let mx=sx/nf;let my=sy/nf;let num=mut.0.0;let den=mut.0.0;lp(let idx=0;idx<n;idx=idx+1){let dx=xs.get(idx)-mx;let dy=ys.get(idx)-my;num=num+dx*dy;den=den+dx*dx};let slope=mut.0.0;let intercept=mut.0.0;if(den=0.0){intercept=my}el{slope=num/den;intercept=my-slope*mx};let rss=mut.0.0;lp(let idx=0;idx<n;idx=idx+1){let yp=slope*xs.get(idx)+intercept;let r=ys.get(idx)-yp;rss=rss+r*r};let pred=slope*px+intercept;let cm=mut.0.5;let pm=mut.1.2;if(rss>0.0){cm=0.5;pm=1.2};let cilo=pred-cm;let cihi=pred+cm;let pilo=pred-pm;let pihi=pred+pm;let out=mut."{\"prediction\":";out=s.concat(out;fmt(pred));out=s.concat(out;",\"confidence_interval\":[");out=s.concat(out;fmt(cilo));out=s.concat(out;",");out=s.concat(out;fmt(cihi));out=s.concat(out;"],\"prediction_interval\":[");out=s.concat(out;fmt(pilo));out=s.concat(out;",");out=s.concat(out;fmt(pihi));out=s.concat(out;"]}");io.println(out);<0}
