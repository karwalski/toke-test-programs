m=dq;i=io:std.io;i=s:std.str;f=main():$i64{let lines=mut.@($str);lp(1==1){let line=io.readln();let isEof=io.eof();if(s.len(line)>0){lines=lines+@(line)};if(isEof){br}};if(lines.len<2){<0};let headers=s.split(lines.get(0);",");let dataCount=lines.len-1;let nCols=headers.len;let scoreSum=mut.0.0;lp(let c=0;c<nCols;c=c+1){let nonEmpty=mut.0;let seen=mut.@($str);let uniqueCount=mut.0;lp(let r=1;r<lines.len;r=r+1){let row=s.split(lines.get(r);",");let val=mut."";if(c<row.len){val=row.get(c)};let tv=s.trim(val);if(s.len(tv)>0){nonEmpty=nonEmpty+1;let found=mut.false;lp(let k=0;k<seen.len;k=k+1){if(s.eq(seen.get(k);tv)){found=true}};if(found==false){seen=seen+@(tv);uniqueCount=uniqueCount+1}}};let completeness=(nonEmpty as $f64)/(dataCount as $f64)*100.0;let uniqueness=mut.100.0;if(nonEmpty>0){uniqueness=(uniqueCount as $f64)/(nonEmpty as $f64)*100.0};io.println(s.concat("Column: ";headers.get(c)));let cl=s.format(completeness;"%.1f");io.println(s.concat("  Completeness: ";s.concat(cl;"%")));let ul=s.format(uniqueness;"%.1f");io.println(s.concat("  Uniqueness: ";s.concat(ul;"%")));scoreSum=scoreSum+(completeness+uniqueness)/2.0};let overall=scoreSum/(nCols as $f64);let ol=s.format(overall;"%.1f");io.println(s.concat("Overall score: ";s.concat(ol;"%")));<0}
