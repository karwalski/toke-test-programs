m=expandcidr;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;"/");let ip=parts.get(0);let prefix=parts.get(1);let n=s.toint(prefix);let ipparts=s.split(ip;".");let b0=s.toint(ipparts.get(0));let b1=s.toint(ipparts.get(1));let b2=s.toint(ipparts.get(2));let b3=s.toint(ipparts.get(3));let hostbits=32-n;let count=mut.1;lp(let k=0;k<hostbits;k=k+1){count=count*2};let baseval=b0*16777216+b1*65536+b2*256+b3;let netbase=(baseval/count)*count;lp(let idx=0;idx<count;idx=idx+1){let cur=netbase+idx;let o0=cur/16777216;let r0=cur-o0*16777216;let o1=r0/65536;let r1=r0-o1*65536;let o2=r1/256;let o3=r1-o2*256;io.println(s.join(".";@(s.fromint(o0);s.fromint(o1);s.fromint(o2);s.fromint(o3))))};<0}