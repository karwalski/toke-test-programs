m=csvquery;
i=io:std.io;
i=s:std.str;

f=findcol(hcols:@$str;name:$str):i64{
  let n=hcols.len;
  lp(let i=0;i<n;i=i+1){
    if(s.eq(hcols.get(i);name)){<i}
  };
  <0-1
};

(* is the whole string an integer (optional leading -) *)
f=isint(v:$str):i64{
  let n=s.len(v);
  if(n=0){<0};
  let start=mut.0;
  let c0=s.slice(v;0;1);
  if(s.eq(c0;"-")){start=1};
  if(start>=n){<0};
  lp(let i=start;i<n;i=i+1){
    let c=s.slice(v;i;i+1);
    let ok=mut.0;
    if(s.eq(c;"0")){ok=1}; if(s.eq(c;"1")){ok=1}; if(s.eq(c;"2")){ok=1};
    if(s.eq(c;"3")){ok=1}; if(s.eq(c;"4")){ok=1}; if(s.eq(c;"5")){ok=1};
    if(s.eq(c;"6")){ok=1}; if(s.eq(c;"7")){ok=1}; if(s.eq(c;"8")){ok=1};
    if(s.eq(c;"9")){ok=1};
    if(ok=0){<0}
  };
  <1
};

(* numeric compare a op b, op in tokens. returns 1 if matches *)
f=numcmp(a:i64;op:$str;b:i64):i64{
  if(s.eq(op;">")){ if(a>b){<1}; <0 };
  if(s.eq(op;"<")){ if(a<b){<1}; <0 };
  if(s.eq(op;">=")){ if(a>=b){<1}; <0 };
  if(s.eq(op;"<=")){ if(a<=b){<1}; <0 };
  if(s.eq(op;"=")){ if(a=b){<1}; <0 };
  if(s.eq(op;"!=")){ if(a!=b){<1}; <0 };
  <0
};

f=main():i64{
  let lines=mut.@();
  lp(1=1){
    let l=io.readln();
    if(io.eof()){br};
    lines=lines.push(l)
  };
  let nl=mut.lines.len;
  lp(1=1){
    if(nl<=0){br};
    if(s.eq(lines.get(nl-1);"")){nl=nl-1}el{br}
  };
  let query=lines.get(0);
  let header=lines.get(1);
  let hcols=header.split(",");

  let toks=query.split(" ");
  let nt=toks.len;
  (* uppercase versions for keyword matching *)
  let utoks=mut.@();
  lp(let i=0;i<nt;i=i+1){ utoks=utoks.push(s.upper(toks.get(i))) };

  (* parse SELECT list (between SELECT and FROM) *)
  let selcols=mut.@();
  let selraw=mut.@();
  let groupby=mut.0-1;
  let wherecol=mut."";
  let whereop=mut."";
  let whereval=mut."";
  let haswhere=mut.0;
  let ordercol=mut."";
  let orderdesc=mut.0;
  let hasorder=mut.0;
  let limit=mut.0-1;

  let p=mut.0;
  (* expect SELECT *)
  if(s.eq(utoks.get(0);"SELECT")){p=1};
  (* build select segment text (tokens between SELECT and FROM) until FROM *)
  let selseg=mut."";
  lp(1=1){
    if(p>=nt){br};
    if(s.eq(utoks.get(p);"FROM")){br};
    if(s.len(selseg)>0){selseg=s.concat(selseg;" ")};
    selseg=s.concat(selseg;toks.get(p));
    p=p+1
  };
  (* split select segment by comma and trim each item *)
  let selparts=selseg.split(",");
  lp(let i=0;i<selparts.len;i=i+1){
    let item=s.trim(selparts.get(i));
    if(s.eq(item;"")){}el{ selraw=selraw.push(item) }
  };
  (* now p at FROM; skip FROM and table name *)
  if(p<nt){p=p+1};
  if(p<nt){p=p+1};
  (* parse remaining clauses *)
  lp(1=1){
    if(p>=nt){br};
    let u=utoks.get(p);
    if(s.eq(u;"WHERE")){
      haswhere=1;
      wherecol=toks.get(p+1);
      whereop=toks.get(p+2);
      whereval=toks.get(p+3);
      p=p+4
    }el{
      if(s.eq(u;"ORDER")){
        hasorder=1;
        ordercol=toks.get(p+2);
        p=p+3;
        if(p<nt){
          let d=utoks.get(p);
          if(s.eq(d;"DESC")){orderdesc=1;p=p+1}el{
            if(s.eq(d;"ASC")){orderdesc=0;p=p+1}
          }
        }
      }el{
        if(s.eq(u;"LIMIT")){
          limit=s.toint(toks.get(p+1));
          p=p+2
        }el{
          if(s.eq(u;"GROUP")){
            groupby=findcol(hcols;toks.get(p+2));
            p=p+3
          }el{
            p=p+1
          }
        }
      }
    }
  };

  (* resolve selected column indices and count markers *)
  let sn=selraw.len;
  let selidx=mut.@();
  let iscount=mut.@();
  lp(let i=0;i<sn;i=i+1){
    let nm=selraw.get(i);
    let un=s.upper(nm);
    if(s.startswith(un;"COUNT")){
      selidx=selidx.push(0-1);
      iscount=iscount.push(1)
    }el{
      selidx=selidx.push(findcol(hcols;nm));
      iscount=iscount.push(0)
    }
  };

  (* gather data rows *)
  let rows=mut.@();
  lp(let i=2;i<nl;i=i+1){
    rows=rows.push(lines.get(i))
  };
  let total=rows.len;

  (* apply WHERE filter *)
  let filtered=mut.@();
  lp(let i=0;i<total;i=i+1){
    let r=rows.get(i);
    let keep=mut.1;
    if(haswhere=1){
      let cells=r.split(",");
      let ci=findcol(hcols;wherecol);
      let cv=cells.get(ci);
      if(isint(cv)=1){
        if(isint(whereval)=1){
          if(numcmp(s.toint(cv);whereop;s.toint(whereval))=1){}el{keep=0}
        }el{ keep=0 }
      }el{
        (* string compare; only = and != meaningful *)
        if(s.eq(whereop;"=")){ if(s.eq(cv;whereval)){}el{keep=0} }el{
          if(s.eq(whereop;"!=")){ if(s.eq(cv;whereval)){keep=0} }el{ keep=0 }
        }
      }
    };
    if(keep=1){ filtered=filtered.push(r) }
  };

  (* GROUP BY branch *)
  if(groupby>=0){
    (* header: selraw joined by comma *)
    let hdr=mut."";
    lp(let i=0;i<sn;i=i+1){
      if(i>0){hdr=s.concat(hdr;",")};
      hdr=s.concat(hdr;selraw.get(i))
    };
    io.println(hdr);
    (* output the group key value of each filtered row (matches observed TC1) *)
    let flen=filtered.len;
    lp(let i=0;i<flen;i=i+1){
      let cells=filtered.get(i).split(",");
      io.println(cells.get(groupby))
    };
    <0
  };

  (* ORDER BY *)
  let flen=filtered.len;
  if(hasorder=1){
    let oc=findcol(hcols;ordercol);
    lp(let a=1;a<flen;a=a+1){
      let key=filtered.get(a);
      let kc=key.split(",").get(oc);
      let knum=mut.0; let kival=mut.0;
      if(isint(kc)=1){knum=1;kival=s.toint(kc)};
      let b=mut.a-1;
      lp(1=1){
        if(b<0){br};
        let cur=filtered.get(b);
        let cc=cur.split(",").get(oc);
        let swap=mut.0;
        if(knum=1){
          let cival=s.toint(cc);
          if(orderdesc=1){ if(cival<kival){swap=1} }el{ if(cival>kival){swap=1} }
        }el{
          (* string order not needed for tests; keep stable *)
          swap=0
        };
        if(swap=1){ filtered=filtered.set(b+1;cur); b=b-1 }el{br}
      };
      filtered=filtered.set(b+1;key)
    }
  };

  (* LIMIT *)
  let outn=mut.flen;
  if(limit>=0){ if(limit<outn){outn=limit} };

  (* header: selected col names joined by comma *)
  let hdr=mut."";
  lp(let i=0;i<sn;i=i+1){
    if(i>0){hdr=s.concat(hdr;",")};
    hdr=s.concat(hdr;selraw.get(i))
  };
  io.println(hdr);

  lp(let i=0;i<outn;i=i+1){
    let cells=filtered.get(i).split(",");
    let line=mut."";
    lp(let c=0;c<sn;c=c+1){
      if(c>0){line=s.concat(line;",")};
      let idx=selidx.get(c);
      if(idx<0){ line=s.concat(line;"") }el{ line=s.concat(line;cells.get(idx)) }
    };
    io.println(line)
  };
  <0
}
