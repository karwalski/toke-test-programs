m=resample;i=io:std.io;i=s:std.str;i=math:std.math;f=fmtfloat(v:$f64):$str{<s.format(v;"%.2f")};f=main():$i64{let first=s.trim(io.readln());let fa=s.split(first;" ");let freq=fa.get(0);let agg=fa.get(1);let keys=mut.@($str);let sums=mut.@($f64);let counts=mut.@($i64);lp(1==1){let line=io.readln();if(io.eof()){br};let t=s.trim(line);if(s.len(t)==0){}el{let parts=s.split(t;",");let ts=parts.get(0);let val=s.tofloat(parts.get(1));let key=mut."";if(s.eq(freq;"daily")){key=s.slice(ts;0;s.indexof(ts;"T"))}el{let tpos=s.indexof(ts;"T");let datepart=s.slice(ts;0;tpos);let hour=s.slice(ts;tpos+1;tpos+3);key=s.concat(s.concat(datepart;"T");s.concat(hour;":00"))};let ki=mut.0-1;lp(let i=0;i<keys.len();i=i+1){if(s.eq(keys.get(i);key)){ki=i}};if(ki<0){keys=keys+@(key);sums=sums+@(val);counts=counts+@(1)}el{sums=sums.set(ki;sums.get(ki)+val);counts=counts.set(ki;counts.get(ki)+1)}}};lp(let i=0;i<keys.len();i=i+1){let total=sums.get(i);let cnt=counts.get(i);let result=mut.0.0;if(s.eq(agg;"mean")){result=total/s.tofloat(s.fromint(cnt))}el{result=total};let valstr=mut."";if(s.eq(agg;"sum")){let f=fmtfloat(result);if(s.endswith(f;".00")){valstr=s.slice(f;0;s.len(f)-3)}el{valstr=f}}el{valstr=fmtfloat(result)};io.println(s.concat(s.concat(keys.get(i);",");valstr))};<0}
