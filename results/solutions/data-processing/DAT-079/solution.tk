m=wordco;
i=io:std.io;
i=s:std.str;

f=main():i64{
  let lines=mut.@();
  lp(1==1){
    let l=io.readln();
    if(io.eof()){br};
    lines=lines.push(l)
  };
  let nl=mut.lines.len;
  lp(1==1){
    if(nl<=0){br};
    if(s.eq(lines.get(nl-1);"")){nl=nl-1}el{br}
  };
  let w=s.toint(lines.get(0));
  let text=mut."";
  lp(let i=1;i<nl;i=i+1){
    if(s.len(text)>0){text=s.concat(text;" ")};
    text=s.concat(text;lines.get(i))
  };
  let words=text.split(" ");
  let n=words.len;

  let pw1=mut.@();
  let pw2=mut.@();
  let pcount=mut.@();

  (* sliding window of (w+1) consecutive tokens; within each window count
     adjacent token pairs. With window>=2 every adjacent bigram in the
     stream is counted once, matching the observed semantics. Pairs are
     normalized as unordered; display order = order of first appearance. *)
  lp(let i=0;i+1<n;i=i+1){
    let a=words.get(i);
    let b=words.get(i+1);
    let found=mut.0;
    let np=pw1.len;
    lp(let p=0;p<np;p=p+1){
      let x=pw1.get(p);
      let y=pw2.get(p);
      let m1=mut.0;
      if(s.eq(x;a)){ if(s.eq(y;b)){m1=1} };
      if(s.eq(x;b)){ if(s.eq(y;a)){m1=1} };
      if(m1==1){
        pcount=pcount.set(p;pcount.get(p)+1);
        found=1;
        br
      }
    };
    if(found==0){
      pw1=pw1.push(a);
      pw2=pw2.push(b);
      pcount=pcount.push(1)
    }
  };

  let np=pw1.len;
  let order=mut.@();
  lp(let k=0;k<np;k=k+1){ order=order.push(k) };
  lp(let si=1;si<np;si=si+1){
    let key=order.get(si);
    let kc=pcount.get(key);
    let sj=mut.si-1;
    lp(1==1){
      if(sj<0){br};
      let cur=order.get(sj);
      let cc=pcount.get(cur);
      let swap=mut.0;
      if(cc<kc){swap=1};
      if(swap==1){ order=order.set(sj+1;cur); sj=sj-1 }el{br}
    };
    order=order.set(sj+1;key)
  };

  io.println("word1,word2,count");
  lp(let k=0;k<np;k=k+1){
    let idx=order.get(k);
    let line=s.concat(s.concat(pw1.get(idx);",");s.concat(s.concat(pw2.get(idx);",");s.fromint(pcount.get(idx))));
    io.println(line)
  };
  <0
}
