m=cur;
i=io:std.io;
i=s:std.str;

f=charat(line:$str;i:i64):$str{
  let r=mt s.slice(line;i as u64;(i+1) as u64){ $ok:v v; $err:e "" };
  <r
};

f=isdigit(ch:$str):bool{
  if(ch="0"){<true};
  if(ch="1"){<true};
  if(ch="2"){<true};
  if(ch="3"){<true};
  if(ch="4"){<true};
  if(ch="5"){<true};
  if(ch="6"){<true};
  if(ch="7"){<true};
  if(ch="8"){<true};
  if(ch="9"){<true};
  <false
};

f=extractdigits(line:$str):$str{
  let n=s.len(line) as i64;
  let r=mut."";
  lp(let idx=0;idx<n;idx=idx+1){
    let ch=charat(line;idx);
    if(isdigit(ch)){r=s.concat(r;ch)}
  };
  <r
};

f=process(line:$str):$str{
  let trimmed=s.trim(line);
  if(s.len(trimmed)=0){<""};

  let cur=mut."";
  let bysym=mut.false;
  if(s.contains(trimmed;"$")){cur="USD";bysym=true}
  el{if(s.contains(trimmed;"€")){cur="EUR";bysym=true}
  el{if(s.contains(trimmed;"£")){cur="GBP";bysym=true}
  el{if(s.contains(trimmed;"¥")){cur="JPY";bysym=true}
  el{if(s.contains(trimmed;"USD")){cur="USD"}
  el{if(s.contains(trimmed;"EUR")){cur="EUR"}
  el{if(s.contains(trimmed;"GBP")){cur="GBP"}
  el{if(s.contains(trimmed;"JPY")){cur="JPY"}
  el{<""}}}}}}}};

  let digits=extractdigits(trimmed);
  let n=s.len(trimmed) as i64;

  let lastpos=mut.(0-1);
  lp(let idx=0;idx<n;idx=idx+1){
    let ch=charat(trimmed;idx);
    if(ch="."){lastpos=idx};
    if(ch=","){lastpos=idx}
  };

  if(lastpos<0){
    if(bysym){<""};
    <s.concat(s.concat(cur;" ");s.concat(digits;".00"))
  };

  let after=mut.0;
  lp(let idx=lastpos+1;idx<n;idx=idx+1){
    let ch=charat(trimmed;idx);
    if(isdigit(ch)){after=after+1}
  };
  if(after=3){<""};
  if(after=0){<""};

  let dn=s.len(digits) as i64;
  let intpart=mt s.slice(digits;0;(dn-after) as u64){ $ok:v v; $err:e "" };
  let fracpart=mut.(mt s.slice(digits;(dn-after) as u64;dn as u64){ $ok:v v; $err:e "" });
  if(after=1){fracpart=s.concat(fracpart;"0")};
  <s.concat(s.concat(cur;" ");s.concat(s.concat(intpart;".");fracpart))
};

f=main():i64{
  lp(true){
    let line=io.readln();
    if(io.eof()){br};
    let out=process(line);
    if(s.len(out)>0){io.println(out)}
  };
  <0
}
