m=formatter;
i=io:std.io;
i=s:std.str;

f=main():i64{
  let lines=mut.@();
  lp(true){
    let l=io.readln();
    if(io.eof()){br};
    lines=lines.push(l)
  };

  let isyaml=mut.false;
  lp(let i=0;i<lines.len;i=i+1){
    if(s.contains(lines.get(i);": ")){isyaml=true}
  };

  if(isyaml){
    io.println("Detected: YAML");
    let out=mut."{";
    let first=mut.true;
    lp(let i=0;i<lines.len;i=i+1){
      let line=s.trim(lines.get(i));
      if(s.len(line)>0){
        let parts=s.split(line;":");
        let key=s.trim(parts.get(0));
        let val=s.trim(parts.get(1));
        if(first==false){out=s.concat(out;",")};
        first=false;
        out=s.concat(out;s.concat(s.concat(s.concat("\"";key);"\":\"");s.concat(val;"\"")))
      }
    };
    out=s.concat(out;"}");
    io.println(out)
  }el{
    io.println("Detected: CSV");
    let header=mut.@();
    lp(let i=0;i<lines.len;i=i+1){
      if(s.len(s.trim(lines.get(i)))>0){
        if(header.len==0){
          let hp=s.split(s.trim(lines.get(i));",");
          lp(let j=0;j<hp.len;j=j+1){ header=header.push(s.trim(hp.get(j))) }
        }
      }
    };
    let out=mut."[";
    let firstrow=mut.true;
    let seenheader=mut.false;
    lp(let i=0;i<lines.len;i=i+1){
      let line=s.trim(lines.get(i));
      if(s.len(line)>0){
        if(seenheader==false){
          seenheader=true
        }el{
          let cols=s.split(line;",");
          if(firstrow==false){out=s.concat(out;",")};
          firstrow=false;
          out=s.concat(out;"{");
          lp(let j=0;j<header.len;j=j+1){
            if(j>0){out=s.concat(out;",")};
            let cval=mut."";
            if(j<cols.len){cval=s.trim(cols.get(j))};
            out=s.concat(out;s.concat(s.concat(s.concat("\"";header.get(j));"\":\"");s.concat(cval;"\"")))
          };
          out=s.concat(out;"}")
        }
      }
    };
    out=s.concat(out;"]");
    io.println(out)
  };
  <0
}
