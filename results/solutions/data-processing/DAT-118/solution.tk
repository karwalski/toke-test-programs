m=extract;i=io:std.io;i=s:std.str;

f=byteat(x:$str;i:i64):i64{ let b=s.bytes(x); <b.get(i as u64) as i64 };
f=charat(x:$str;i:i64):$str{ let r=mt s.slice(x;i as u64;(i+1) as u64){ $ok:v v; $err:e "" }; <s.concat(r;"") };

f=isdigit(c:i64):bool{ if(c>=48){ if(c<=57){<true} }; <false };

# Match the pattern against the line starting at line position pcur,
# beginning at pattern token index tstart up to (but not including) tend.
# Returns the line position after consuming, or -1 on failure.
# tk = token kinds array, tv = token value array (i64 payload), tch = literal char codes.
# Token kinds: 0=literal(char in tch), 1=digit-fixed(count in tv), 2=digit-plus
f=matchrange(kinds:@(i64);vals:@(i64);line:$str;tstart:i64;tend:i64;lstart:i64;llen:i64):i64{
  let pcur=mut.lstart;
  let ok=mut.true;
  lp(let t=tstart;t<tend;t=t+1){
    if(ok){
      let k=kinds.get(t as u64);
      if(k==0){
        # literal
        let want=vals.get(t as u64);
        if(pcur<llen){
          if(byteat(line;pcur)==want){ pcur=pcur+1 }el{ ok=false }
        }el{ ok=false }
      }el{
        if(k==1){
          # exactly N digits
          let cnt=vals.get(t as u64);
          let matched=mut.0;
          lp(let d=0;d<cnt;d=d+1){
            if(ok){
              if(pcur<llen){
                if(isdigit(byteat(line;pcur))){ pcur=pcur+1; matched=matched+1 }el{ ok=false }
              }el{ ok=false }
            }
          }
        }el{
          # k=2: one or more digits (greedy, but followed by literal we just take max run;
          # since subsequent tokens are literals/different, greedy works for these cases)
          let dcount=mut.0;
          lp(true){
            if(pcur<llen){
              if(isdigit(byteat(line;pcur))){ pcur=pcur+1; dcount=dcount+1 }el{ br }
            }el{ br }
          };
          if(dcount<1){ ok=false }
        }
      }
    }
  };
  if(ok){ <pcur }el{ <(0-1) }
};

f=main():i64{
  # Read pattern (first line)
  let pattern=io.readln();
  if(io.eof()){ <0 };

  # Tokenize pattern. Build parallel arrays:
  # kinds/vals describe each atomic token (literal/digitfixed/digitplus)
  # For groups, record name + start/end token indices.
  let kinds=mut.@();
  let vals=mut.@();
  # group bookkeeping
  let gnames=mut.@();
  let gstart=mut.@();
  let gend=mut.@();

  let plen=s.len(pattern) as i64;
  let i=mut.0;
  let inGroup=mut.0;        # 0 = no, 1 = yes (track open group index)
  let curGroupIdx=mut.(0-1);

  lp(true){
    if(i>=plen){ br };
    let c=byteat(pattern;i);
    if(c==40){
      # '(' -> expect (?P<name>
      # skip "(?P<"
      # advance past '(' '?' 'P' '<'
      let j=mut.(i+4);
      # read name until '>'
      let nm=mut."";
      lp(true){
        if(j>=plen){ br };
        if(byteat(pattern;j)==62){ br };
        nm=s.concat(nm;charat(pattern;j));
        j=j+1
      };
      # j now at '>'
      gnames=gnames.push(nm);
      gstart=gstart.push(kinds.len as i64);
      gend=gend.push(0-1);
      curGroupIdx=(gnames.len as i64)-1;
      i=j+1
    }el{
      if(c==41){
        # ')' close current group
        gend=gend.set(curGroupIdx as u64;kinds.len as i64);
        curGroupIdx=0-1;
        i=i+1
      }el{
        if(c==92){
          # backslash escape
          let nxt=byteat(pattern;i+1);
          if(nxt==100){
            # \d -> check for {n} or +
            let after=i+2;
            if(after<plen){
              if(byteat(pattern;after)==123){
                # {n}
                let k=mut.(after+1);
                let num=mut.0;
                lp(true){
                  if(k>=plen){ br };
                  if(byteat(pattern;k)==125){ br };
                  num=num*10+(byteat(pattern;k)-48);
                  k=k+1
                };
                kinds=kinds.push(1);
                vals=vals.push(num);
                i=k+1
              }el{
                if(byteat(pattern;after)==43){
                  # \d+
                  kinds=kinds.push(2);
                  vals=vals.push(0);
                  i=after+1
                }el{
                  # single \d (exactly 1)
                  kinds=kinds.push(1);
                  vals=vals.push(1);
                  i=after
                }
              }
            }el{
              kinds=kinds.push(1);
              vals=vals.push(1);
              i=after
            }
          }el{
            # \. or other literal escape -> literal char nxt
            kinds=kinds.push(0);
            vals=vals.push(nxt);
            i=i+2
          }
        }el{
          # plain literal char
          kinds=kinds.push(0);
          vals=vals.push(c);
          i=i+1
        }
      }
    }
  };

  let totalTokens=kinds.len as i64;
  let ngroups=gnames.len as i64;

  # Now read each line and match.
  lp(true){
    let line=io.readln();
    if(io.eof()){ br };
    let llen=s.len(line) as i64;
    # match whole token sequence against whole line
    let endpos=matchrange(kinds;vals;line;0;totalTokens;0;llen);
    if(endpos==llen){
      # success and full consumption -> build JSON by re-running per-group captures
      # Re-walk tokens tracking position, recording capture substrings at group boundaries.
      let out=mut."{";
      let pcur=mut.0;
      let gi=mut.0;   # which group's start we might hit
      # We need capture start when token index == gstart[g], capture end when == gend[g].
      # Simpler: iterate tokens; before processing token index ti, if any group starts at ti record start;
      # after, if any group ends at ti+? Actually gend stores token index AFTER group.
      let capStart=mut.@();
      let capEnd=mut.@();
      lp(let g=0;g<ngroups;g=g+1){ capStart=capStart.push(0); capEnd=capEnd.push(0) };

      let pos=mut.0;
      lp(let ti=0;ti<totalTokens;ti=ti+1){
        # record any group starts at this token index
        lp(let g=0;g<ngroups;g=g+1){
          if(gstart.get(g as u64)==ti){ capStart=capStart.set(g as u64;pos) }
        };
        # consume this single token
        let np=matchrange(kinds;vals;line;ti;ti+1;pos;llen);
        pos=np;
        # record any group ends at this token index+1
        lp(let g=0;g<ngroups;g=g+1){
          if(gend.get(g as u64)==(ti+1)){ capEnd=capEnd.set(g as u64;pos) }
        }
      };

      lp(let g=0;g<ngroups;g=g+1){
        let cs=capStart.get(g as u64);
        let ce=capEnd.get(g as u64);
        let sub=mt s.slice(line;cs as u64;ce as u64){ $ok:v v; $err:e "" };
        if(g>0){ out=s.concat(out;",") };
        out=s.concat(out;"\"");
        out=s.concat(out;gnames.get(g as u64));
        out=s.concat(out;"\":\"");
        out=s.concat(out;s.concat(sub;""));
        out=s.concat(out;"\"")
      };
      out=s.concat(out;"}");
      io.println(out)
    }
  };
  <0
};
