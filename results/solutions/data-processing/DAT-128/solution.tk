m=store;i=io:std.io;i=s:std.str;

f=byteat(x:$str;idx:i64):i64{ let b=s.bytes(x); <b.get(idx as u64) as i64 };

f=streq(a:$str;b:$str):bool{
  if(s.len(a)!=s.len(b)){<false};
  let n=s.len(a) as i64;
  lp(let i=0;i<n;i=i+1){ if(byteat(a;i)!=byteat(b;i)){<false} };
  <true
};

# trim leading/trailing ascii spaces
f=trimsp(x:$str):$str{
  let n=s.len(x) as i64;
  let a=mut.0;
  let b=mut.n;
  lp(true){ if(a<b){ if(byteat(x;a)=32){ a=a+1 }el{ br } }el{ br } };
  lp(true){ if(b>a){ if(byteat(x;b-1)=32){ b=b-1 }el{ br } }el{ br } };
  let r=mt s.slice(x;a as u64;b as u64){ $ok:v v; $err:e "" };
  <s.concat(r;"")
};

# find index of column name in header array; -1 if absent
f=colindex(hdr:@($str);name:$str):i64{
  let res=mut.(0-1);
  lp(let i=0;i<hdr.len as i64;i=i+1){
    if(res<0){ if(streq(hdr.get(i as u64);name)){ res=i } }
  };
  <res
};

f=main():i64{
  # read CSV until blank line
  let header=mut.@();
  let rows=mut.@();   # array of arrays (each row is @($str))
  let haveHeader=mut.0;

  lp(true){
    let line=io.readln();
    if(io.eof()){ br };
    if(s.len(line) as i64=0){ br };   # blank line -> end of CSV block
    let cells=s.split(line;",");
    if(haveHeader=0){
      let h=mut.@();
      lp(let i=0;i<cells.len as i64;i=i+1){ h=h.push(trimsp(cells.get(i as u64))) };
      header=h;
      haveHeader=1
    }el{
      let r=mut.@();
      lp(let i=0;i<cells.len as i64;i=i+1){ r=r.push(trimsp(cells.get(i as u64))) };
      rows=rows.push(r)
    }
  };

  # read the query line (first non-empty after blank)
  let query=mut."";
  lp(true){
    let line=io.readln();
    if(io.eof()){ br };
    if(s.len(line) as i64>0){ query=line; br }
  };
  if(s.len(query) as i64=0){ <0 };

  # parse: SELECT <cols> WHERE <col> <op> <cval>
  # split on spaces but cols may contain commas (no spaces inside).
  let toks=s.split(query;" ");
  # toks[0]=SELECT toks[1]=cols toks[2]=WHERE toks[3]=col toks[4]=op toks[5]=cval
  let selStr=toks.get(1 as u64);
  let whereCol=toks.get(3 as u64);
  let opStr=toks.get(4 as u64);
  let cmpStr=toks.get(5 as u64);

  let selCols=s.split(selStr;",");
  let nsel=selCols.len as i64;

  # RULE: only emit output when exactly ONE column is selected.
  if(nsel!=1){ <0 };

  # numeric comparison value
  let cmpVal=mt s.toint(cmpStr){ $ok:v v; $err:e 0 };
  let wIdx=colindex(header;whereCol);
  let sIdx=colindex(header;selCols.get(0 as u64));

  # print header (the single selected column name)
  io.println(selCols.get(0 as u64));

  lp(let r=0;r<rows.len as i64;r=r+1){
    let row=rows.get(r as u64);
    let cellText=row.get(wIdx as u64);
    let cellVal=mt s.toint(cellText){ $ok:v v; $err:e 0 };
    let pass=mut.0;
    if(streq(opStr;">")){ if(cellVal>cmpVal){ pass=1 } }el{
    if(streq(opStr;"<")){ if(cellVal<cmpVal){ pass=1 } }el{
    if(streq(opStr;">=")){ if(cellVal>=cmpVal){ pass=1 } }el{
    if(streq(opStr;"<=")){ if(cellVal<=cmpVal){ pass=1 } }el{
    if(streq(opStr;"=")){ if(cellVal=cmpVal){ pass=1 } }el{ pass=0 }}}}};
    if(pass=1){
      io.println(row.get(sIdx as u64))
    }
  };
  <0
};
