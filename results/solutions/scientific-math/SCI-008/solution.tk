m=rungekutta;i=io:std.io;i=s:std.str;f=feval(expr:$str;x:$f64;y:$f64):$f64{if(s.eq(expr;"y")){<y};if(s.eq(expr;"2*x")){<2.0*x};if(s.eq(expr;"x")){<x};<0.0};f=main():$i64{let l1=s.trim(io.readln());let p=s.split(l1;" ");let x=mut.s.tofloat(p.get(0));let y=mut.s.tofloat(p.get(1));let xend=s.tofloat(s.trim(io.readln()));let h=s.tofloat(s.trim(io.readln()));let expr=s.trim(io.readln());io.println(s.concat(s.concat(s.format(x;"%.6f");" ");s.format(y;"%.6f")));lp(x<(xend-(h/2.0))){let k1=h*feval(expr;x;y);let k2=h*feval(expr;x+(h/2.0);y+(k1/2.0));let k3=h*feval(expr;x+(h/2.0);y+(k2/2.0));let k4=h*feval(expr;x+h;y+k3);y=y+((k1+(2.0*k2)+(2.0*k3)+k4)/6.0);x=x+h;io.println(s.concat(s.concat(s.format(x;"%.6f");" ");s.format(y;"%.6f")))};<0}
