m=least;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let xs=mut.@();let ys=mut.@();let cont=mut.true;lp(cont){let line=io.readln();if(s.eq(line;"")){cont=false}el{let parts=s.split(line;" ");xs=xs+@(s.tofloat(parts.get(0)));ys=ys+@(s.tofloat(parts.get(1)));};};let n=xs.len;let nf=mut.0.0;nf=s.tofloat(s.fromint(n));let sx=mut.0.0;let sy=mut.0.0;lp(let i=0;i<n;i=i+1){let xv=mut.0.0;xv=xs.get(i);let yv=mut.0.0;yv=ys.get(i);sx=sx+xv;sy=sy+yv;};let xb=mut.0.0;xb=sx/nf;let yb=mut.0.0;yb=sy/nf;let cov=mut.0.0;let vx=mut.0.0;let vy=mut.0.0;lp(let i=0;i<n;i=i+1){let xv=mut.0.0;xv=xs.get(i);let yv=mut.0.0;yv=ys.get(i);let dx=mut.0.0;dx=xv-xb;let dy=mut.0.0;dy=yv-yb;cov=cov+dx*dy;vx=vx+dx*dx;vy=vy+dy*dy;};let m=mut.0.0;m=cov/vx;let b=mut.0.0;b=yb-m*xb;let ssres=mut.0.0;lp(let i=0;i<n;i=i+1){let xv=mut.0.0;xv=xs.get(i);let yv=mut.0.0;yv=ys.get(i);let pred=mut.0.0;pred=m*xv+b;let e=mut.0.0;e=yv-pred;ssres=ssres+e*e;};let r2=mut.0.0;if(vy>0.0){r2=1.0-ssres/vy}el{r2=1.0};let rmse=mut.0.0;rmse=math.sqrt(ssres/nf);io.println(s.concat(s.concat(s.concat(s.concat("y = ";s.format(m;"%.4f"));"x + ");s.format(b;"%.4f"));""));io.println(s.concat("R^2: ";s.format(r2;"%.4f")));io.println(s.concat("RMSE: ";s.format(rmse;"%.4f")));<0};
