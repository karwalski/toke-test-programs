m=quake;i=io:std.io;i=s:std.str;i=math:std.math;
f=tobits(x:$f64):$i64{
let lg=mut.0.0;lg=math.log(x)/0.6931471805599453;
let e=mut.0.0;e=math.floor(lg);
let p=mut.0.0;p=math.pow(2.0;e);
let m=mut.0.0;m=x/p-1.0;
let ms=mut.0.0;ms=m*8388608.0+0.5;
let mant=mut.0.0;mant=math.floor(ms);
let mi=mut.0;mi=mant as$i64;
let ei=mut.0;ei=e as$i64;
<(127+ei)*8388608+mi};
f=frombits(b:$i64):$f64{
let ei=b/8388608;
let mi=b-ei*8388608;
let ef=mut.0.0;ef=(ei-127) as$f64;
let p=mut.0.0;p=math.pow(2.0;ef);
let mf=mut.0.0;mf=(mi as$f64)/8388608.0;
let one=mut.0.0;one=1.0+mf;
<p*one};
f=fastinvsqrt(x:$f64):$f64{
let i=mut.tobits(x);
i=1597463007-(i>>1);
let y=mut.frombits(i);
let xhalf=mut.0.0;xhalf=0.5*x;
let t=mut.0.0;t=xhalf*y*y;
let nf=mut.0.0;nf=1.5-t;
y=y*nf;
<y};
f=line(raw:$str;x:$f64):$str{
let fast=mut.fastinvsqrt(x);
let exact=mut.0.0;exact=1.0/math.sqrt(x);
let d=mut.0.0;d=fast-exact;
let a=mut.0.0;a=math.abs(d);
let r=mut.0.0;r=a/exact;
let err=mut.0.0;err=r*100.0;
<s.concat(s.concat(s.concat(s.concat(s.concat(s.concat(s.concat(raw;": fast=");s.format(fast;"%.6f"));" exact=");s.format(exact;"%.6f"));" error=");s.concat(s.format(err;"%.2f");"%")))};
f=main():$i64{
lp(1=1){
let l=s.trim(io.readln());
if(s.len(l)=0){br};
io.println(line(l;s.tofloat(l)));
};
<0};
