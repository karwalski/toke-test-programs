m=lcs;i=io:std.io;i=s:std.str;f=main():$i64{let a=io.readln();let b=io.readln();let ba=s.bytes(a);let bb=s.bytes(b);let m=ba.len;let n=bb.len;let w=n+1;let dp=mut.@();lp(let i=0;i<(m+1)*w;i=i+1){dp=dp+@(0);};lp(let i=1;i<m+1;i=i+1){lp(let j=1;j<n+1;j=j+1){if(ba.get(i-1)=bb.get(j-1)){dp=dp.set(i*w+j;dp.get((i-1)*w+(j-1))+1);}el{let x=dp.get((i-1)*w+j);let y=dp.get(i*w+(j-1));if(x>=y){dp=dp.set(i*w+j;x);}el{dp=dp.set(i*w+j;y);};};};};let length=dp.get(m*w+n);let out=mut."";let i=mut.m;let j=mut.n;let cont=mut.true;lp(cont){if(i=0){cont=false}el{if(j=0){cont=false}el{if(ba.get(i-1)=bb.get(j-1)){out=s.concat(s.substr(a;i-1;i);out);i=i-1;j=j-1;}el{if(dp.get((i-1)*w+j)>=dp.get(i*w+(j-1))){i=i-1;}el{j=j-1;};};};};};io.println(s.concat("LCS length: ";s.fromint(length)));io.println(s.concat("LCS: ";out));<0};
