m=modtool;i=io:std.io;i=s:std.str;f=modpow(base:$i64;exp:$i64;mod:$i64):$i64{if(mod=1){<0};let result=mut.1;let b=mut.base%mod;let e=mut.exp;lp(e>0){if(e%2=1){result=result*b%mod};e=e/2;b=b*b%mod};<result};f=gcd(a:$i64;b:$i64):$i64{let a2=mut.a;let b2=mut.b;lp(b2!=0){let t=b2;b2=a2%b2;a2=t};<a2};f=extgcd(a:$i64;b:$i64):$i64{let oldr=mut.a;let r=mut.b;let olds=mut.1;let cs=mut.0;lp(r!=0){let q=oldr/r;let tr=r;r=oldr-q*r;oldr=tr;let ts=cs;cs=olds-q*cs;olds=ts};<olds};f=modinv(a:$i64;m:$i64):$i64{if(gcd(a;m)!=1){<-1};let x=extgcd(a;m);<(x%m+m)%m};f=main():$i64{lp(1=1){let line=io.readln();if(s.len(line)=0){br};let t=s.trim(line);if(s.len(t)=0){br};let parts=s.split(t;"_");let op=parts.get(0);if(s.equals(op;"_")){let a=s.toint(parts.get(1));let b=s.toint(parts.get(2));let md=s.toint(parts.get(3));io.println(s.fromint(modpow(a;b;md)))}el{if(s.equals(op;"_")){let a=s.toint(parts.get(1));let md=s.toint(parts.get(2));let inv=modinv(a;md);if(inv=-1){io.println("_")}el{io.println(s.fromint(inv))}}el{if(s.equals(op;"_")){let a=s.toint(parts.get(1));let b=s.toint(parts.get(2));let md=s.toint(parts.get(3));let g=gcd(a;md);if(b%g!=0){io.println("_")}el{let a2=a/g;let b2=b/g;let m2=md/g;let inv=modinv(a2;m2);if(inv=-1){io.println("_")}el{io.println(s.fromint(b2*inv%m2))}}}}}};<0}
