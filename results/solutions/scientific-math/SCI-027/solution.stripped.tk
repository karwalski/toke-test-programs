f=main():$i64{let line=s.trim(io.readln());let toks=s.split(line;"_");let nums=mut.@(0);nums=@();let i=mut.0;lp(i<toks.len()){let t=s.trim(toks.get(i));if(s.len(t)>0){nums=nums+@(s.toint(t))};i=i+1};
