f=slice(arr:@$i64;lo:$i64;hi:$i64):@$i64{let r=mut.@(0);r=@();let i=mut.lo;lp(i<hi){r=r+@(arr.get(i));i=i+1};<r};
f=msort(arr:@$i64):@$i64{let n=arr.len();if(n<2){let base=mut.@(0;0);base=@(0;0);let i=mut.0;lp(i<n){base=base+@(arr.get(i));i=i+1};<base};
