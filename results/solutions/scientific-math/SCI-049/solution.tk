m=markov;i=io:std.io;i=s:std.str;f=main():$i64{let n=s.toint(io.readln());let mat=mut.@();lp(let r=0;r<n;r=r+1){let line=io.readln();let parts=s.split(line;" ");lp(let c=0;c<n;c=c+1){mat=mat+@(s.tofloat(parts.get(c)));};};let init=s.toint(io.readln());let steps=s.toint(io.readln());let pi=mut.@();lp(let i=0;i<n;i=i+1){if(i==init){pi=pi+@(1.0)}el{pi=pi+@(0.0)};};lp(let it=0;it<1000;it=it+1){let np=mut.@();lp(let j=0;j<n;j=j+1){np=np+@(0.0);};lp(let i=0;i<n;i=i+1){let pv=mut.0.0;pv=pi.get(i);lp(let j=0;j<n;j=j+1){let mij=mut.0.0;mij=mat.get(i*n+j);let cur=mut.0.0;cur=np.get(j);np=np.set(j;cur+pv*mij);};};pi=np;};let counts=mut.@();lp(let i=0;i<n;i=i+1){counts=counts+@(0);};let state=mut.init;let seed=mut.987654321;lp(let st=0;st<steps;st=st+1){counts=counts.set(state;counts.get(state)+1);seed=(seed*1103515245+12345)%2147483648;let rf=mut.0.0;rf=s.tofloat(s.fromint(seed%10000))/10000.0;let acc=mut.0.0;let nextstate=mut.n-1;let chosen=mut.false;lp(let j=0;j<n;j=j+1){let mij=mut.0.0;mij=mat.get(state*n+j);acc=acc+mij;if(!chosen){if(rf<acc){nextstate=j;chosen=true};};};state=nextstate;};let scnt=mut."Simulated visit counts:";lp(let i=0;i<n;i=i+1){scnt=s.concat(s.concat(scnt;" ~");s.fromint(counts.get(i)));};io.println(scnt);let ss=mut."Steady state:";lp(let i=0;i<n;i=i+1){ss=s.concat(s.concat(s.concat(s.concat(ss;" s");s.fromint(i));"=");s.format(pi.get(i);"%.4f"));};io.println(ss);<0};
