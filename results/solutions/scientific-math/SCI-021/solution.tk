m=prim;i=io:std.io;i=s:std.str;f=main():$i64{let first=s.trim(io.readln());let fp=s.split(first;" ");let v=s.toint(fp.get(0));let e=s.toint(fp.get(1));let inf=1000000000;let wm=mut.@($i64);lp(let i=0;i<v*v;i=i+1){wm=wm+@(inf)};lp(let k=0;k<e;k=k+1){let line=s.trim(io.readln());let pp=s.split(line;" ");let a=s.toint(pp.get(0));let b=s.toint(pp.get(1));let w=s.toint(pp.get(2));if(w<wm.get(a*v+b)){wm=wm.set(a*v+b;w);wm=wm.set(b*v+a;w)}};let start=s.toint(s.trim(io.readln()));let key=mut.@($i64);let parent=mut.@($i64);let inmst=mut.@($bool);lp(let i=0;i<v;i=i+1){key=key+@(inf);parent=parent+@(-1);inmst=inmst+@(false)};key=key.set(start;0);let edgesu=mut.@($i64);let edgesv=mut.@($i64);let edgesw=mut.@($i64);let total=mut.0;lp(let c=0;c<v;c=c+1){let u=mut.-1;let best=mut.inf;lp(let i=0;i<v;i=i+1){if(!inmst.get(i)){if(key.get(i)<best){best=key.get(i);u=i}}};if(u>=0){inmst=inmst.set(u;true);let par=parent.get(u);if(par>=0){let lo=mut.u;let hi=mut.par;if(par<u){lo=par;hi=u};edgesu=edgesu+@(lo);edgesv=edgesv+@(hi);edgesw=edgesw+@(key.get(u));total=total+key.get(u)};lp(let nbr=0;nbr<v;nbr=nbr+1){if(!inmst.get(nbr)){let ed=wm.get(u*v+nbr);if(ed<key.get(nbr)){key=key.set(nbr;ed);parent=parent.set(nbr;u)}}}}};lp(let i=0;i<edgesu.len();i=i+1){let prefix=mut."";if(i==0){prefix="MST edges: "};io.println(s.concat(s.concat(s.concat(s.concat(s.concat(prefix;s.fromint(edgesu.get(i)));"-");s.fromint(edgesv.get(i)));" ");s.fromint(edgesw.get(i))))};io.println(s.concat("Total weight: ";s.fromint(total)));<0}
