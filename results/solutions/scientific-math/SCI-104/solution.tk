m=fenwick;i=io:std.io;i=s:std.str;
f=update(tree:@$i64;n:$i64;i:$i64;delta:$i64):@$i64{
let t=mut.tree;
let idx=mut.i+1;
lp(idx<=n){
t=t.set(idx;t.get(idx)+delta);
idx=idx+(idx&(0-idx));
};
<t};
f=prefix(tree:@$i64;i:$i64):$i64{
let sum=mut.0;
let idx=mut.i+1;
lp(idx>0){
sum=sum+tree.get(idx);
idx=idx-(idx&(0-idx));
};
<sum};
f=main():$i64{
let n=s.toint(s.trim(io.readln()));
let arr=s.split(s.trim(io.readln());" ");
let tree=mut.@();
lp(let i=0;i<n+1;i=i+1){tree=tree+@(0)};
lp(let i=0;i<n;i=i+1){tree=update(tree;n;i;s.toint(arr.get(i)))};
lp(1=1){
let line=s.trim(io.readln());
if(s.len(line)=0){br};
let p=s.split(line;" ");
let cmd=p.get(0);
if(s.eq(cmd;"PREFIX")){
let i=s.toint(p.get(1));
io.println(s.fromint(prefix(tree;i)));
}el{if(s.eq(cmd;"UPDATE")){
let i=s.toint(p.get(1));
let d=s.toint(p.get(2));
tree=update(tree;n;i;d);
}el{
let l=s.toint(p.get(1));
let r=s.toint(p.get(2));
let res=mut.prefix(tree;r);
if(l>0){res=res-prefix(tree;l-1)};
io.println(s.fromint(res));
}};
};
<0};
