m=bezier;i=io:std.io;i=s:std.str;f=main():$i64{let degree=s.toint(s.trim(io.readln()));let np=degree+1;let xs=mut.@($f64);let ys=mut.@($f64);lp(let p=0;p<np;p=p+1){let line=s.trim(io.readln());let parts=s.split(line;" ");xs=xs+@(s.tofloat(parts.get(0)));ys=ys+@(s.tofloat(parts.get(1)))};let nn=s.toint(s.trim(io.readln()));lp(let i=0;i<nn;i=i+1){let t=mut.0.0;if(nn>1){t=s.tofloat(s.fromint(i))/s.tofloat(s.fromint(nn-1))};let cx=mut.@($f64);let cy=mut.@($f64);lp(let k=0;k<np;k=k+1){cx=cx+@(xs.get(k));cy=cy+@(ys.get(k))};lp(let step=1;step<np;step=step+1){lp(let j=0;j<np-step;j=j+1){let nx=(1.0-t)*cx.get(j)+t*cx.get(j+1);let ny=(1.0-t)*cy.get(j)+t*cy.get(j+1);cx=cx.set(j;nx);cy=cy.set(j;ny)}};io.println(s.concat(s.concat(s.format(cx.get(0);"%.4f");" ");s.format(cy.get(0);"%.4f")))};<0}