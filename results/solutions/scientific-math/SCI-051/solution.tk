m=convexhull;i=io:std.io;i=s:std.str;i=math:std.math;f=fmtn(v:$f64):$str{let fl=mut.0.0;fl=math.floor(v);let d=mut.0.0;d=v-fl;if(d<0.0000001){let iv=mut.0;iv=v as$i64;<s.fromint(iv)};<s.format(v;"%.2f")};f=main():$i64{let n=s.toint(io.readln());let xs=mut.@();let ys=mut.@();lp(let i=0;i<n;i=i+1){let line=io.readln();let parts=s.split(line;" ");xs=xs+@(s.tofloat(parts.get(0)));ys=ys+@(s.tofloat(parts.get(1)));};let start=mut.0;lp(let i=1;i<n;i=i+1){let xi=mut.0.0;xi=xs.get(i);let xs0=mut.0.0;xs0=xs.get(start);if(xi<xs0){start=i}el{if(xi=xs0){let yi=mut.0.0;yi=ys.get(i);let ys0=mut.0.0;ys0=ys.get(start);if(yi<ys0){start=i}};};};let hull=mut.@();let cur=mut.start;let cont=mut.true;lp(cont){hull=hull+@(cur);let nxt=mut.0;if(cur=0){nxt=1}el{nxt=0};lp(let i=0;i<n;i=i+1){if(i=cur){}el{let cx=mut.0.0;cx=xs.get(cur);let cy=mut.0.0;cy=ys.get(cur);let nx=mut.0.0;nx=xs.get(nxt);let ny=mut.0.0;ny=ys.get(nxt);let px=mut.0.0;px=xs.get(i);let py=mut.0.0;py=ys.get(i);let cross=mut.0.0;cross=(nx-cx)*(py-cy)-(ny-cy)*(px-cx);if(cross<0.0){nxt=i}el{if(cross=0.0){let d1=mut.0.0;d1=(px-cx)*(px-cx)+(py-cy)*(py-cy);let d2=mut.0.0;d2=(nx-cx)*(nx-cx)+(ny-cy)*(ny-cy);if(d1>d2){nxt=i}};};};};cur=nxt;if(cur=start){cont=false};};let out=mut."Hull points:";lp(let i=0;i<hull.len;i=i+1){let idx=hull.get(i);out=s.concat(s.concat(s.concat(s.concat(s.concat(out;" (");fmtn(xs.get(idx)));",");fmtn(ys.get(idx)));")");};io.println(out);io.println(s.concat(s.concat("Hull size: ";s.fromint(hull.len));" points"));<0};
