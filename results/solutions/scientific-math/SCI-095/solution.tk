m=armstrong;i=io:std.io;i=s:std.str;f=power(base:$i64;exp:$i64):$i64{let result=mut.1;lp(let i=0;i<exp;i=i+1){result=result*base};<result};f=numdigits(n:$i64):$i64{if(n==0){<1};let d=mut.0;lp(let t=n;t>0;t=t/10){d=d+1};<d};f=isarmstrong(n:$i64):$bool{let nd=numdigits(n);let sum=mut.0;lp(let t=n;t>0;t=t/10){let digit=t-t/10*10;sum=sum+power(digit;nd)};<sum==n};f=main():$i64{let line=io.readln();let d=s.toint(s.trim(line));let limit=power(10;d);lp(let i=1;i<limit;i=i+1){if(isarmstrong(i)){io.println(s.fromint(i))}};<0}
