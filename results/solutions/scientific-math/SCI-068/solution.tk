m=spline;i=io:std.io;i=s:std.str;i=math:std.math;
f=fset(arr:@($f64);idx:$i64;v:$f64):@($f64){let out=mut.@();lp(let i=0;i<arr.len();i=i+1){if(i==idx){out=out+@(v)}el{out=out+@(arr.get(i))}};<out};
f=main():$i64{let toks=mut.@();
lp(true){let line=io.readln();if(s.len(line)==0){br};let parts=s.split(s.trim(line);" ");lp(let p=0;p<parts.len();p=p+1){let t=s.trim(parts.get(p));if(s.len(t)>0){toks=toks+@(t)}}};
let idx=mut.0;let n=s.toint(toks.get(idx));idx=idx+1;
let xs=mut.@($f64);let ys=mut.@($f64);
lp(let k=0;k<n;k=k+1){xs=xs+@(s.tofloat(toks.get(idx)));idx=idx+1;ys=ys+@(s.tofloat(toks.get(idx)));idx=idx+1};
let queries=mut.@($f64);
lp(idx<toks.len()){queries=queries+@(s.tofloat(toks.get(idx)));idx=idx+1};
let h=mut.@($f64);lp(let i=0;i<n-1;i=i+1){h=h+@(xs.get(i+1)-xs.get(i))};
let mm=mut.@($f64);lp(let i=0;i<n;i=i+1){mm=mm+@(0.0)};
if(n>=3){let sz=n-2;
let aa=mut.@($f64);let bb=mut.@($f64);let cc=mut.@($f64);let dd=mut.@($f64);
lp(let z=0;z<sz;z=z+1){aa=aa+@(0.0);bb=bb+@(0.0);cc=cc+@(0.0);dd=dd+@(0.0)};
lp(let i=1;i<n-1;i=i+1){let k=i-1;
let av=mut.0.0;if(i-1>0){av=h.get(i-1)};aa=fset(aa;k;av);
bb=fset(bb;k;2.0*(h.get(i-1)+h.get(i)));
let cv=mut.0.0;if(i<n-2){cv=h.get(i)};cc=fset(cc;k;cv);
let dv=6.0*((ys.get(i+1)-ys.get(i))/h.get(i)-(ys.get(i)-ys.get(i-1))/h.get(i-1));dd=fset(dd;k;dv)};
let cp=mut.@($f64);let dp=mut.@($f64);lp(let z=0;z<sz;z=z+1){cp=cp+@(0.0);dp=dp+@(0.0)};
cp=fset(cp;0;cc.get(0)/bb.get(0));dp=fset(dp;0;dd.get(0)/bb.get(0));
lp(let i=1;i<sz;i=i+1){let denom=bb.get(i)-aa.get(i)*cp.get(i-1);let cpv=mut.0.0;if(i<sz-1){cpv=cc.get(i)/denom};cp=fset(cp;i;cpv);dp=fset(dp;i;(dd.get(i)-aa.get(i)*dp.get(i-1))/denom)};
let xsol=mut.@($f64);lp(let z=0;z<sz;z=z+1){xsol=xsol+@(0.0)};
xsol=fset(xsol;sz-1;dp.get(sz-1));
lp(let i=sz-2;i>=0;i=i-1){xsol=fset(xsol;i;dp.get(i)-cp.get(i)*xsol.get(i+1))};
lp(let i=1;i<n-1;i=i+1){mm=fset(mm;i;xsol.get(i-1))}};
let outparts=mut.@();
lp(let qi=0;qi<queries.len();qi=qi+1){let q=queries.get(qi);
let i=mut.0;
if(q<=xs.get(0)){i=0}el{if(q>=xs.get(n-1)){i=n-2}el{let lo=mut.0;let hi=mut.(n-1);lp(lo+1<hi){let mid=(lo+hi)/2;if(xs.get(mid)<=q){lo=mid}el{hi=mid}};i=lo}};
let hi=h.get(i);let aA=(xs.get(i+1)-q)/hi;let bB=(q-xs.get(i))/hi;
let y=aA*ys.get(i)+bB*ys.get(i+1)+((math.pow(aA;3.0)-aA)*mm.get(i)+(math.pow(bB;3.0)-bB)*mm.get(i+1))*(hi*hi)/6.0;
outparts=outparts+@("S(\(s.format(q;"%g"))) = \(s.format(y;"%.6f"))")};
io.println(s.join("\n";outparts));<0}
