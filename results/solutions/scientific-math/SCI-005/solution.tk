m=integrate;i=io:std.io;i=s:std.str;i=math:std.math;f=evalpoly(coeffs:@$f64;x:$f64):$f64{let r=mut.0.0;lp(let i=0;i<coeffs.len();i=i+1){r=r+coeffs.get(i)*math.pow(x;i as $f64)};<r};f=main():$i64{let a=s.tofloat(s.trim(io.readln()));let b=s.tofloat(s.trim(io.readln()));let n=s.toint(s.trim(io.readln()));let cline=s.trim(io.readln());let parts=s.split(cline;" ");let coeffs=mut.@($f64);lp(let i=0;i<parts.len();i=i+1){let p=s.trim(parts.get(i));if(s.len(p)>0){coeffs=coeffs+@(s.tofloat(p))}};let h=(b-a)/(n as $f64);let fa=evalpoly(coeffs;a);let fb=evalpoly(coeffs;b);let summid=mut.0.0;lp(let i=1;i<n;i=i+1){let xi=a+(i as $f64)*h;summid=summid+evalpoly(coeffs;xi)};let integral=h*(fa+2.0*summid+fb)/2.0;io.println(s.concat("Integral: ";s.format(integral;"%.6f")));<0}
