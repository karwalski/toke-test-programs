m=bucketsort;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let n=s.toint(io.readln());let line=io.readln();let parts=s.split(line;" ");let cnt=parts.len;let nums=mut.@();lp(let i=0;i<cnt;i=i+1){nums=nums+@(s.tofloat(parts.get(i)));};let sizes=mut.@();lp(let i=0;i<n;i=i+1){sizes=sizes+@(0);};let nf=mut.0.0;nf=s.tofloat(s.fromint(n));lp(let i=0;i<cnt;i=i+1){let v=mut.0.0;v=nums.get(i);let bf=mut.0.0;bf=math.floor(v*nf);let bidx=mut.0;bidx=bf as$i64;if(bidx>=n){bidx=n-1};if(bidx<0){bidx=0};sizes=sizes.set(bidx;sizes.get(bidx)+1);};lp(let i=1;i<cnt;i=i+1){let key=nums.get(i);let j=mut.i-1;let cont=mut.true;lp(cont){if(j<0){cont=false}el{if(nums.get(j)>key){nums=nums.set(j+1;nums.get(j));j=j-1;}el{cont=false};};};nums=nums.set(j+1;key);};let output=mut."Sorted:";lp(let i=0;i<cnt;i=i+1){output=s.concat(s.concat(output;" ");s.format(nums.get(i);"%.4f"));};io.println(output);let so=mut."Bucket sizes:";lp(let i=0;i<n;i=i+1){so=s.concat(s.concat(so;" ");s.fromint(sizes.get(i)));};io.println(so);<0};
