m=stats;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=io.readln();let parts=s.split(line;" ");let n=parts.len;let arr=mut.@();lp(let i=0;i<n;i=i+1){arr=arr+@(s.tofloat(parts.get(i)));};let nf=mut.0.0;nf=s.tofloat(s.fromint(n));let total=mut.0.0;lp(let i=0;i<n;i=i+1){let v=mut.0.0;v=arr.get(i);total=total+v;};let mean=mut.0.0;mean=total/nf;let sorted=mut.@();lp(let i=0;i<n;i=i+1){sorted=sorted+@(arr.get(i));};lp(let i=1;i<n;i=i+1){let key=mut.0.0;key=sorted.get(i);let j=mut.i-1;let cont=mut.true;lp(cont){if(j<0){cont=false}el{let sj=mut.0.0;sj=sorted.get(j);if(sj>key){sorted=sorted.set(j+1;sj);j=j-1;}el{cont=false};};};sorted=sorted.set(j+1;key);};let median=mut.0.0;let mid=n/2;if(n%2==0){let a=mut.0.0;a=sorted.get(mid-1);let b=mut.0.0;b=sorted.get(mid);median=(a+b)/2.0;}el{median=sorted.get(mid);};let bestcount=mut.0;let bestval=mut.0.0;let modecount=mut.0;lp(let i=0;i<n;i=i+1){let vi=mut.0.0;vi=sorted.get(i);let c=mut.0;lp(let j=0;j<n;j=j+1){let vj=mut.0.0;vj=sorted.get(j);if(vj==vi){c=c+1};};if(c>bestcount){bestcount=c;bestval=vi;};};let distinctmax=mut.0;lp(let i=0;i<n;i=i+1){let vi=mut.0.0;vi=sorted.get(i);let c=mut.0;lp(let j=0;j<n;j=j+1){let vj=mut.0.0;vj=sorted.get(j);if(vj==vi){c=c+1};};if(c==bestcount){let seen=mut.false;lp(let k=0;k<i;k=k+1){let vk=mut.0.0;vk=sorted.get(k);if(vk==vi){seen=true};};if(!seen){distinctmax=distinctmax+1};};};let vrnce=mut.0.0;lp(let i=0;i<n;i=i+1){let v=mut.0.0;v=arr.get(i);let d=mut.0.0;d=v-mean;vrnce=vrnce+d*d;};vrnce=vrnce/nf;let sd=mut.0.0;sd=math.sqrt(vrnce);let sk=mut.0.0;let ku=mut.0.0;if(sd>0.0){let s3=mut.0.0;let s4=mut.0.0;lp(let i=0;i<n;i=i+1){let v=mut.0.0;v=arr.get(i);let d=mut.0.0;d=v-mean;s3=s3+d*d*d;s4=s4+d*d*d*d;};sk=(s3/nf)/(sd*sd*sd);ku=(s4/nf)/(sd*sd*sd*sd)-3.0;};io.println(s.concat("Mean: ";s.format(mean;"%.4f")));io.println(s.concat("Median: ";s.format(median;"%.4f")));let modestr=mut."MULTIMODAL";if(distinctmax==1){let mv=mut.0;mv=bestval as$i64;modestr=s.fromint(mv);};io.println(s.concat("Mode: ";modestr));io.println(s.concat("Variance: ";s.format(vrnce;"%.4f")));io.println(s.concat("StdDev: ";s.format(sd;"%.4f")));io.println(s.concat("Skewness: ";s.format(sk;"%.4f")));io.println(s.concat("Kurtosis: ";s.format(ku;"%.4f")));<0};
