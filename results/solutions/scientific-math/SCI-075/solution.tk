m=coinchange;i=io:std.io;i=s:std.str;f=main():$i64{let line=io.readln();let parts=s.split(line;" ");let coins=mut.@();lp(let i=0;i<parts.len;i=i+1){coins=coins+@(s.toint(parts.get(i)));};let target=s.toint(io.readln());let inf=target+1;let dp=mut.@();lp(let a=0;a<target+1;a=a+1){dp=dp+@(inf);};dp=dp.set(0;0);let pick=mut.@();lp(let a=0;a<target+1;a=a+1){pick=pick+@(0-1);};lp(let a=1;a<target+1;a=a+1){lp(let i=0;i<coins.len;i=i+1){let c=coins.get(i);if(c<=a){if(dp.get(a-c)+1<dp.get(a)){dp=dp.set(a;dp.get(a-c)+1);pick=pick.set(a;c);};};};};if(dp.get(target)>=inf){io.println("Impossible");<0};io.println(s.concat("Minimum coins: ";s.fromint(dp.get(target))));let counts=mut.@();lp(let i=0;i<coins.len;i=i+1){counts=counts+@(0);};let a=mut.target;lp(a>0){let c=pick.get(a);lp(let i=0;i<coins.len;i=i+1){if(coins.get(i)==c){counts=counts.set(i;counts.get(i)+1);};};a=a-c;};lp(let i=0;i<coins.len-1;i=i+1){lp(let j=0;j<coins.len-1-i;j=j+1){if(coins.get(j)>coins.get(j+1)){let tc=coins.get(j);coins=coins.set(j;coins.get(j+1));coins=coins.set(j+1;tc);let tn=counts.get(j);counts=counts.set(j;counts.get(j+1));counts=counts.set(j+1;tn);};};};let out=mut."Coins used:";lp(let i=0;i<coins.len;i=i+1){if(counts.get(i)>0){out=s.concat(s.concat(s.concat(s.concat(out;" ");s.fromint(counts.get(i)));"x");s.fromint(coins.get(i)));};};io.println(out);<0};
