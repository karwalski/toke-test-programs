m=gquad;i=io:std.io;i=s:std.str;i=math:std.math;f=poly(coeffs:@$str;x:$f64):$f64{let r=mut.0.0;let p=mut.1.0;lp(let i=0;i<(coeffs.len as i64);i=i+1){let c=s.tofloat(coeffs.get(i));r=r+(c*p);p=p*x};<r};f=main():$i64{let a=s.tofloat(s.trim(io.readln()));let b=s.tofloat(s.trim(io.readln()));let np=s.toint(s.trim(io.readln()));let cline=s.trim(io.readln());let coeffs=s.split(cline;"_");let s70=math.sqrt(70.0);let s107=math.sqrt(10.0/7.0);let n0=0.0-(math.sqrt(5.0+(2.0*s107))/3.0);let n1=0.0-(math.sqrt(5.0-(2.0*s107))/3.0);let n2=0.0;let n3=math.sqrt(5.0-(2.0*s107))/3.0;let n4=math.sqrt(5.0+(2.0*s107))/3.0;let w0=(322.0-(13.0*s70))/900.0;let w1=(322.0+(13.0*s70))/900.0;let w2=128.0/225.0;let w3=(322.0+(13.0*s70))/900.0;let w4=(322.0-(13.0*s70))/900.0;let half=(b-a)/2.0;let mid=(a+b)/2.0;let acc=mut.0.0;acc=acc+(w0*poly(coeffs;(half*n0)+mid));acc=acc+(w1*poly(coeffs;(half*n1)+mid));acc=acc+(w2*poly(coeffs;(half*n2)+mid));acc=acc+(w3*poly(coeffs;(half*n3)+mid));acc=acc+(w4*poly(coeffs;(half*n4)+mid));let integral=acc*half;io.println(s.concat("_";s.format(integral;"_")));<0}
