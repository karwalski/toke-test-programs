m=lu;i=io:std.io;i=s:std.str;f=g(a:@($f64);idx:$i64):$f64{<a.get(idx)};f=main():$i64{let n=s.toint(s.trim(io.readln()));let mat=mut.@($f64);lp(let r=0;r<n;r=r+1){let line=s.trim(io.readln());let parts=s.split(line;"_");lp(let pi=0;pi<parts.len();pi=pi+1){let part=s.trim(parts.get(pi));if(s.len(part)>0){mat=mat+@(s.tofloat(part))}}};let lmat=mut.@($f64);let umat=mut.@($f64);lp(let k=0;k<n*n;k=k+1){lmat=lmat+@(0.0);umat=umat+@(0.0)};lp(let i=0;i<n;i=i+1){lmat=lmat.set(i*n+i;1.0)};lp(let i=0;i<n;i=i+1){lp(let k=i;k<n;k=k+1){let sum=mut.0.0;lp(let j=0;j<i;j=j+1){sum=sum+g(lmat;i*n+j)*g(umat;j*n+k)};umat=umat.set(i*n+k;g(mat;i*n+k)-sum)};lp(let k=i+1;k<n;k=k+1){let sum=mut.0.0;lp(let j=0;j<i;j=j+1){sum=sum+g(lmat;k*n+j)*g(umat;j*n+i)};lmat=lmat.set(k*n+i;(g(mat;k*n+i)-sum)/g(umat;i*n+i))}}let det=mut.1.0;lp(let i=0;i<n;i=i+1){det=det*g(umat;i*n+i)};io.println(s.concat("_";s.format(det;"_")));<0}
