m=jobsched;i=io:std.io;i=s:std.str;
f=main():$i64{
  let n=s.toint(s.trim(io.readln()));
  let names=mut.@();
  let deadlines=mut.@();
  let weights=mut.@();
  lp(let i=0;i<n;i=i+1){
    let parts=s.split(s.trim(io.readln());"_");
    names=names+@(parts.get(0));
    deadlines=deadlines+@(s.toint(parts.get(1)));
    weights=weights+@(s.toint(parts.get(2)))
  };
  let order=mut.@();
  lp(let i=0;i<n;i=i+1){order=order+@(i)};
  let a=mut.0;
  lp(a<n){
    let b=mut.a+1;
    lp(b<n){
      if(weights.get(order.get(b))>weights.get(order.get(a))){
        let tmp=order.get(a);
        order=order.set(a;order.get(b));
        order=order.set(b;tmp)
      };
      b=b+1
    };
    a=a+1
  };
  let maxd=mut.0;
  lp(let i=0;i<n;i=i+1){if(deadlines.get(i)>maxd){maxd=deadlines.get(i)}};
  let slots=mut.@();
  lp(let i=0;i<=maxd;i=i+1){slots=slots+@(0-1)};
  let total=mut.0;
  lp(let k=0;k<n;k=k+1){
    let j=order.get(k);
    let placed=mut.false;
    let slot=mut.deadlines.get(j);
    lp(slot>0){
      if(placed=false){
        if(slots.get(slot)<0){
          slots=slots.set(slot;j);
          total=total+weights.get(j);
          placed=true
        }
      };
      slot=slot-1
    }
  };
  let sched=mut."_";
  let first=mut.true;
  lp(let sl=1;sl<=maxd;sl=sl+1){
    if(slots.get(sl)>=0){
      if(first){sched=names.get(slots.get(sl));first=false}
      el{sched=s.concat(s.concat(sched;"_");names.get(slots.get(sl)))}
    }
  };
  io.println(s.concat("_";sched));
  io.println(s.concat("_";s.fromint(total)));
  <0
}
