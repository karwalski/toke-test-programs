m=bisection;i=io:std.io;i=s:std.str;i=math:std.math;f=poly(x:$f64;coeffs:@($str)):$f64{let result=mut.0.0;lp(let idx=0;idx<coeffs.len;idx=idx+1){let coeff=mut.0.0;coeff=s.tofloat(coeffs.get(idx));let pw=mut.0.0;pw=math.pow(x;s.tofloat(s.fromint(idx)));result=result+coeff*pw;};<result};f=main():$i64{let line1=io.readln();let coeffs=s.split(line1;" ");let line2=io.readln();let bounds=s.split(line2;" ");let a=mut.0.0;a=s.tofloat(bounds.get(0));let b=mut.0.0;b=s.tofloat(bounds.get(1));let tol=mut.0.0;tol=s.tofloat(io.readln());let maxiter=s.toint(io.readln());let fa=mut.0.0;fa=poly(a;coeffs);let fb=mut.0.0;fb=poly(b;coeffs);if(fa*fb>0.0){io.println("ERROR: f(a) and f(b) must have opposite signs");<0};let iter=mut.0;let done=mut.false;let used=mut.0;lp(let it=0;it<maxiter;it=it+1){if(done){}el{let c=mut.0.0;c=(a+b)/2.0;let fc=mut.0.0;fc=poly(c;coeffs);let afc=mut.0.0;afc=math.abs(fc);io.println(s.concat(s.concat(s.concat(s.concat(s.concat(s.concat("Iteration ";s.fromint(it+1));": [");s.format(a;"%.6f"));",");s.format(b;"%.6f"));s.concat(s.concat(s.concat("] midpoint=";s.format(c;"%.6f"));" f(mid)=");s.format(fc;"%.6f"))));if(afc<tol){done=true;used=it+1;}el{if(fa*fc<0.0){b=c}el{a=c;fa=fc};used=it+1;};};};let root=mut.0.0;root=(a+b)/2.0;io.println(s.concat(s.concat(s.concat("Root: ";s.format(root;"%.6f"));" (");s.concat(s.fromint(used);" iterations)")));<0};
