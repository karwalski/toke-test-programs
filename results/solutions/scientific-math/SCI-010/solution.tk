m=matinv;i=io:std.io;i=s:std.str;f=absf(x:$f64):$f64{if(x<0.0){<0.0-x};<x};f=main():$i64{let n=s.toint(s.trim(io.readln()));let vals=mut.@(0.0);let r=mut.0;lp(r<n){let parts=s.split(s.trim(io.readln());" ");let c=mut.0;lp(c<parts.len){let p=s.trim(parts.get(c));if(s.len(p)>0){vals=vals+@(s.tofloat(p))};c=c+1};r=r+1};if(n==2){let a=vals.get(1);let b=vals.get(2);let cc=vals.get(3);let d=vals.get(4);let det=a*d-b*cc;if(absf(det)<0.0000000001){io.println("ERROR: matrix is singular")}el{let i00=d/det;let i01=(0.0-b)/det;let i10=(0.0-cc)/det;let i11=a/det;io.println(s.concat(s.concat(s.format(i00;"%.6f");" ");s.format(i01;"%.6f")));io.println(s.concat(s.concat(s.format(i10;"%.6f");" ");s.format(i11;"%.6f")))}};<0}
