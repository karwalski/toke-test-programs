m=matmul;i=io:std.io;i=s:std.str;f=readrow():@($f64){let line=s.trim(io.readln());let toks=s.split(line;" ");let row=mut.@(0.0);row=@();let i=mut.0;lp(i<toks.len()){let tk=toks.get(i);if(s.len(tk)>0){row=row+@(s.tofloat(tk))};i=i+1};<row};f=main():$i64{let dims=s.split(s.trim(io.readln());" ");let mm=s.toint(dims.get(0));let kk=s.toint(dims.get(1));let a=mut.@(0.0);a=@();let r=mut.0;lp(r<mm){let row=readrow();let c=mut.0;lp(c<kk){a=a+@(row.get(c));c=c+1};r=r+1};let dims2=s.split(s.trim(io.readln());" ");let kk2=s.toint(dims2.get(0));let nn=s.toint(dims2.get(1));let b=mut.@(0.0);b=@();let r2=mut.0;lp(r2<kk2){let row=readrow();let c=mut.0;lp(c<nn){b=b+@(row.get(c));c=c+1};r2=r2+1};let i=mut.0;lp(i<mm){let out=mut."";let j=mut.0;lp(j<nn){let sum=mut.0.0;let l=mut.0;lp(l<kk){sum=sum+a.get(i*kk+l)*b.get(l*nn+j);l=l+1};if(j>0){out=s.concat(out;" ")};out=s.concat(out;s.format(sum;"%.4f"));j=j+1};io.println(out);i=i+1};<0}
