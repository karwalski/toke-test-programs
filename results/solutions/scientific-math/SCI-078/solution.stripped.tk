m=nqueens;i=io:std.io;i=s:std.str;
f=absi(x:$i64):$i64{if(x<0){<0-x};<x};
f=issafe(board:@($i64);row:$i64;col:$i64):$bool{
  let ok=mut.(1=1);
  lp(let i=0;i<row;i=i+1){
    if(board.get(i)=col){ok=(1=0)};
    if(absi(board.get(i)-col)=absi(i-row)){ok=(1=0)}
  };
  <ok
};
f=solverec(board:@($i64);row:$i64;n:$i64):$str{
  if(row=n){
    let line=mut."_";
    lp(let i=0;i<n;i=i+1){
      if(i>0){line=s.concat(line;"_")};
      line=s.concat(line;s.fromint(board.get(i)))
    };
    line=s.concat(line;"_");
    <line
  };
  let out=mut."_";
  lp(let col=1;col<=n;col=col+1){
    if(issafe(board;row;col)){
      let nb=board.set(row;col);
      out=s.concat(out;solverec(nb;row+1;n))
    }
  };
  <out
};
f=main():$i64{
  let n=s.toint(s.trim(io.readln()));
  let board=mut.@($i64);
  lp(let i=0;i<n;i=i+1){board=board+@(0)};
  let sols=solverec(board;0;n);
  let lines=s.split(sols;"_");
  let count=mut.0;
  lp(let i=0;i<lines.len();i=i+1){
    let l=lines.get(i);
    if(s.len(l)>0){
      count=count+1;
      io.println(s.concat(s.concat("_";s.fromint(count));s.concat("_";l)))
    }
  };
  io.println(s.concat("_";s.fromint(count)));
  <0
}
