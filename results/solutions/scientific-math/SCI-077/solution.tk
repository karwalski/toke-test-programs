m=josephus;i=io:std.io;i=s:std.str;f=main():$i64{let n=s.toint(io.readln());let k=s.toint(io.readln());let people=mut.@();lp(let i=1;i<n+1;i=i+1){people=people+@(i);};let order=mut.@();let pos=mut.0;lp(let step=0;step<n;step=step+1){let cnt=people.len;pos=(pos+k-1)%cnt;let elim=people.get(pos);order=order+@(elim);let np=mut.@();lp(let i=0;i<cnt;i=i+1){if(i=pos){}el{np=np+@(people.get(i));};};people=np;};let out=mut."Elimination order:";lp(let i=0;i<order.len;i=i+1){out=s.concat(s.concat(out;" ");s.fromint(order.get(i)));};io.println(out);io.println(s.concat("Survivor: ";s.fromint(order.get(order.len-1))));<0};
