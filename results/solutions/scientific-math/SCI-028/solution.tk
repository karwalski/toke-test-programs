m=quicksort;i=io:std.io;i=s:std.str;f=main():$i64{let line=io.readln();let parts=s.split(line;" ");let arr=mut.@();lp(let i=0;i<parts.len;i=i+1){arr=arr+@(s.toint(parts.get(i)));};let n=arr.len;let comp=mut.0;let pivots=mut.@();let stklo=mut.@();let stkhi=mut.@();if(n>1){stklo=stklo+@(0);stkhi=stkhi+@(n-1);};let cont=mut.true;lp(cont){if(stklo.len==0){cont=false}el{let top=stklo.len-1;let lo=stklo.get(top);let hi=stkhi.get(top);let nlo=mut.@();let nhi=mut.@();lp(let k=0;k<top;k=k+1){nlo=nlo+@(stklo.get(k));nhi=nhi+@(stkhi.get(k));};stklo=nlo;stkhi=nhi;let pivot=arr.get(hi);pivots=pivots+@(pivot);let i=mut.lo-1;lp(let j=lo;j<hi;j=j+1){comp=comp+1;if(arr.get(j)<pivot){i=i+1;let tmp=arr.get(i);arr=arr.set(i;arr.get(j));arr=arr.set(j;tmp);};};let pp=i+1;let tmp2=arr.get(pp);arr=arr.set(pp;arr.get(hi));arr=arr.set(hi;tmp2);if(pp-1>lo){stklo=stklo+@(lo);stkhi=stkhi+@(pp-1);};if(hi>pp+1){stklo=stklo+@(pp+1);stkhi=stkhi+@(hi);};};};let out=mut."Sorted:";lp(let i=0;i<n;i=i+1){out=s.concat(s.concat(out;" ");s.fromint(arr.get(i)));};io.println(out);let pv=mut."Pivots chosen:";lp(let i=0;i<pivots.len;i=i+1){pv=s.concat(s.concat(pv;" ");s.fromint(pivots.get(i)));};io.println(pv);io.println(s.concat("Comparisons: ";s.fromint(comp)));<0};
