m=hamiltonian;i=io:std.io;i=s:std.str;
f=bt(adj:@(@($i64));v:$i64;path:@($i64);visited:@($i64)):@($i64){
  let plen=path.len() as $i64;
  if(plen=v){<path};
  let cur=path.get(plen-1);
  let nbrs=adj.get(cur);
  let nlen=nbrs.len() as $i64;
  lp(let i=0;i<nlen;i=i+1){
    let nb=nbrs.get(i);
    if(visited.get(nb)=0){
      let nv=visited.set(nb;1);
      let np=path+@(nb);
      let res=bt(adj;v;np;nv);
      if((res.len() as $i64)=v){<res};
    };
  };
  <@();
};
f=main():$i64{
  let first=s.split(s.trim(io.readln());" ");
  let v=s.toint(first.get(0));
  let e=s.toint(first.get(1));
  let adj=mut.@();
  lp(let i=0;i<v;i=i+1){adj=adj+@(@())};
  lp(let i=0;i<e;i=i+1){
    let parts=s.split(s.trim(io.readln());" ");
    let a=s.toint(parts.get(0));
    let b=s.toint(parts.get(1));
    let ra=adj.get(a)+@(b);
    adj=adj.set(a;ra);
    let rb=adj.get(b)+@(a);
    adj=adj.set(b;rb);
  };
  let start=s.toint(s.trim(io.readln()));
  let visited=mut.@();
  lp(let i=0;i<v;i=i+1){visited=visited+@(0)};
  visited=visited.set(start;1);
  let path=@(start);
  let result=bt(adj;v;path;visited);
  let rlen=result.len() as $i64;
  if(rlen=v){
    let out=mut."Path:";
    lp(let i=0;i<rlen;i=i+1){out=s.concat(out;s.concat(" ";s.fromint(result.get(i))))};
    io.println(out);
  }el{io.println("NO HAMILTONIAN PATH")};
  <0
};
