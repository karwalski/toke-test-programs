m=monty;i=io:std.io;i=s:std.str;f=pct2(rate:$i64):$str{let whole=rate/100;let dec=rate%100;let ds=mut.s.fromint(dec);if(dec<10){ds=s.concat("0";s.fromint(dec))};<s.concat(s.concat(s.fromint(whole);".");ds)};f=main():$i64{let trials=s.toint(io.readln());let staywins=mut.0;let switchwins=mut.0;lp(let trial=0;trial<trials;trial=trial+1){let car=(trial*7+3)%3;let choice=(trial*11+5)%3;let host=mut.0;if(car=choice){if(choice=0){host=1}el{if(choice=1){host=2}el{host=0}}}el{if(car=0){if(choice=1){host=2}el{host=1}}el{if(car=1){if(choice=0){host=2}el{host=0}}el{if(choice=0){host=1}el{host=0}}}};let newchoice=mut.0;if(choice=0){if(host=1){newchoice=2}el{newchoice=1}}el{if(choice=1){if(host=0){newchoice=2}el{newchoice=0}}el{if(host=0){newchoice=1}el{newchoice=0}}};if(choice=car){staywins=staywins+1};if(newchoice=car){switchwins=switchwins+1};};let stayrate=(staywins*10000+trials/2)/trials;let switchrate=(switchwins*10000+trials/2)/trials;io.println(s.concat(s.concat(s.concat("Stay wins: ~";s.fromint(staywins));" (~");s.concat(pct2(stayrate);"%)")));io.println(s.concat(s.concat(s.concat("Switch wins: ~";s.fromint(switchwins));" (~");s.concat(pct2(switchrate);"%)")));<0};
