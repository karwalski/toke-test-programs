*bx*(kx-ix)-2.0*by*(ky-iy);if(math.abs(bv)<0.000000000001){if(av<-0.000000001){valid=false}}el{let t0=(0.0-av)/bv;if(bv>0.0){if(t0>lo){lo=t0}}el{if(t0<hi){hi=t0}};if(lo>hi+0.000000001){valid=false}}}}};if(valid){if(hi-lo>0.000000001){let nx1=cx1+lo*bx;let ny1=cy1+lo*by;let nx2=cx1+hi*bx;let ny2=cy1+hi*by;let ax1=mut.nx1;let ay1=mut.ny1;let ax2=mut.nx2;let ay2=mut.ny2;let swap=mut.false;if(nx1>nx2){swap=true};if(nx1=nx2){if(ny1>ny2){swap=true}};if(swap){ax1=nx2;ay1=ny2;ax2=nx1;ay2=ny1};ex1=ex1+@(ax1);ey1=ey1+@(ay1);ex2=ex2+@(ax2);ey2=ey2+@(ay2);ne=ne+1}}}}};lp(let a=0;a<ne-1;a=a+1){lp(let b=0;b<ne-1-a;b=b+1){let g=mut.false;let p1=ex1.get(b);let p2=ex1.get(b+1);if(p1>p2){g=true}el{if(p1=p2){let q1=ey1.get(b);let q2=ey1.get(b+1);if(q1>q2){g=true}el{if(q1=q2){let r1=ex2.get(b);let r2=ex2.get(b+1);if(r1>r2){g=true}el{if(r1=r2){if(ey2.get(b)>ey2.get(b+1)){g=true}}}}}}};if(g){let t1=ex1.get(b);ex1=ex1.set(b;ex1.get(b+1));ex1=ex1.set(b+1;t1);let t2=ey1.get(b);ey1=ey1.set(b;ey1.get(b+1));ey1=ey1.set(b+1;t2);let t3=ex2.get(b);ex2=ex2.set(b;ex2.get(b+1));ex2=ex2.set(b+1;t3);let t4=ey2.get(b);ey2=ey2.set(b;ey2.get(b+1));ey2=ey2.set(b+1;t4)}}};lp(let e=0;e<ne;e=e+1){let line=mut."_";line=s.concat(line;fmt(ex1.get(e)));line=s.concat(line;"_");line=s.concat(line;fmt(ey1.get(e)));line=s.concat(line;"_");line=s.concat(line;fmt(ex2.get(e)));line=s.concat(line;"_");line=s.concat(line;fmt(ey2.get(e)));line=s.concat(line;"_");io.println(line)};io.println(s.concat("_";s.fromint(ne)));<0}
