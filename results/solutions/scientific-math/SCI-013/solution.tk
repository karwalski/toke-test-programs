m=gramschmidt;i=io:std.io;i=s:std.str;i=math:std.math;f=gf(a:@($f64);idx:$i64):$f64{<a.get(idx)};f=main():$i64{let toks=mut.@($str);let reading=mut.true;lp(reading){let rl=s.trim(io.readln());if(s.len(rl)==0){reading=false}el{let parts=s.split(rl;" ");let p=mut.0;lp(p<parts.len()){let t=s.trim(parts.get(p));if(s.len(t)>0){toks=toks+@(t)};p=p+1}}};let mm=s.toint(toks.get(0));let nn=s.toint(toks.get(1));let a=mut.@($f64);let ti=mut.2;lp(let r=0;r<mm;r=r+1){lp(let c=0;c<nn;c=c+1){a=a+@(s.tofloat(toks.get(ti)));ti=ti+1}};let q=mut.@($f64);let rmat=mut.@($f64);lp(let k=0;k<mm*nn;k=k+1){q=q+@(0.0)};lp(let k=0;k<nn*nn;k=k+1){rmat=rmat+@(0.0)};let j=mut.0;lp(j<nn){let v=mut.@($f64);lp(let i=0;i<mm;i=i+1){v=v+@(gf(a;i*nn+j))};let pj=mut.0;lp(pj<j){let dot=mut.0.0;lp(let k=0;k<mm;k=k+1){dot=dot+gf(q;k*nn+pj)*gf(a;k*nn+j)};rmat=rmat.set(pj*nn+j;dot);lp(let k=0;k<mm;k=k+1){let nv=gf(v;k)-dot*gf(q;k*nn+pj);v=v.set(k;nv)};pj=pj+1};let ss=mut.0.0;lp(let k=0;k<mm;k=k+1){ss=ss+gf(v;k)*gf(v;k)};let norm=math.sqrt(ss);rmat=rmat.set(j*nn+j;norm);if(norm==0.0){lp(let k=0;k<mm;k=k+1){q=q.set(k*nn+j;0.0)}}el{lp(let k=0;k<mm;k=k+1){q=q.set(k*nn+j;gf(v;k)/norm)}};j=j+1};let out=mut."";lp(let i=0;i<mm;i=i+1){let qline=mut."";lp(let c=0;c<nn;c=c+1){if(c>0){qline=s.concat(qline;" ")};qline=s.concat(qline;s.format(gf(q;i*nn+c);"%.6f"))};if(i>0){out=s.concat(out;"\n")};out=s.concat(out;qline)};out=s.concat(out;"\n");lp(let i=0;i<nn;i=i+1){let rline=mut."";lp(let c=0;c<nn;c=c+1){if(c>0){rline=s.concat(rline;" ")};rline=s.concat(rline;s.format(gf(rmat;i*nn+c);"%.6f"))};out=s.concat(out;"\n");out=s.concat(out;rline)};io.println(out);<0}
