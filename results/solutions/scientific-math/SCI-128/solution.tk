m=gauss;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let n=s.toint(s.trim(io.readln()));let cols=n+1;let a=mut.@($f64);lp(let r=0;r<n;r=r+1){let line=s.trim(io.readln());let parts=s.split(line;" ");let c=mut.0;lp(let q=0;q<parts.len;q=q+1){let tok=s.trim(parts.get(q));if(s.len(tok)>0){a=a+@(s.tofloat(tok));c=c+1}}};let singular=mut.false;lp(let i=0;i<n;i=i+1){let maxrow=mut.i;let maxval=mut.math.abs(a.get(i*cols+i));lp(let r=i+1;r<n;r=r+1){let v=math.abs(a.get(r*cols+i));if(v>maxval){maxval=v;maxrow=r}};if(maxval<0.0000000001){singular=true};if(maxrow!=i){lp(let c=0;c<cols;c=c+1){let tmp=a.get(i*cols+c);a=a.set(i*cols+c;a.get(maxrow*cols+c));a=a.set(maxrow*cols+c;tmp)}};lp(let r=i+1;r<n;r=r+1){let factor=a.get(r*cols+i)/a.get(i*cols+i);lp(let c=i;c<cols;c=c+1){a=a.set(r*cols+c;a.get(r*cols+c)-factor*a.get(i*cols+c))}}};if(singular){io.println("NO UNIQUE SOLUTION");<0};let sol=mut.@($f64);lp(let z=0;z<n;z=z+1){sol=sol+@(0.0)};lp(let ii=0;ii<n;ii=ii+1){let i=n-1-ii;let acc=mut.a.get(i*cols+n);lp(let j=i+1;j<n;j=j+1){acc=acc-a.get(i*cols+j)*sol.get(j)};sol=sol.set(i;acc/a.get(i*cols+i))};let out=mut."";lp(let i=0;i<n;i=i+1){if(i>0){out=s.concat(out;" ")};out=s.concat(out;s.concat(s.concat("x";s.fromint(i+1));"="));out=s.concat(out;s.format(sol.get(i);"%.6f"))};io.println(out);<0}
