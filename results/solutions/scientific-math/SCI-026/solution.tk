m=selectionsort;i=io:std.io;i=s:std.str;f=main():$i64{let line=io.readln();let parts=s.split(line;" ");let arr=mut.@();lp(let i=0;i<parts.len;i=i+1){arr=arr+@(s.toint(parts.get(i)));};let n=arr.len;let comp=mut.0;let swp=mut.0;lp(let i=0;i<n-1;i=i+1){let minidx=mut.i;lp(let j=i+1;j<n;j=j+1){comp=comp+1;if(arr.get(j)<arr.get(minidx)){minidx=j;};};let tmp=arr.get(i);arr=arr.set(i;arr.get(minidx));arr=arr.set(minidx;tmp);swp=swp+1;};let out=mut."Sorted:";lp(let i=0;i<n;i=i+1){out="\(out) \(arr.get(i))"};io.println(out);io.println("Comparisons: \(comp)");io.println("Swaps: \(swp)");<0};
