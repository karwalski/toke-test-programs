m=gradesc;i=io:std.io;i=s:std.str;i=math:std.math;
f=fmtfix6(x:$f64):$str{let neg=mut.false;let v=mut.x;if(v<0.0){neg=true;v=0.0-v};let scaled=mut.v*1000000.0+0.5;let si=scaled as $i64;let ip=si/1000000;let fp=si%1000000;let fs=mut.s.fromint(fp);lp(s.len(fs)<6){fs=s.concat("_";fs)};let r=mut.s.concat(s.concat(s.fromint(ip);"_");fs);if(neg){r=s.concat("_";r)};<r};
f=main():$i64{
let coefs=mut.@(0.0);coefs=@();
let cline=s.split(s.trim(io.readln());"_");
lp(let i=0;i<cline.len();i=i+1){let t=s.trim(cline.get(i));if(s.len(t)>0){coefs=coefs+@(s.tofloat(t))}};
let nc=coefs.len();
let x=mut.s.tofloat(s.trim(io.readln()));
let lr=s.tofloat(s.trim(io.readln()));
let tol=s.tofloat(s.trim(io.readln()));
let maxiter=s.toint(s.trim(io.readln()));
let diverged=mut.false;
let it=mut.1;
lp(it<=maxiter){
# grad and fx
let g=mut.0.0;let fx=mut.0.0;
lp(let i=0;i<nc;i=i+1){let xp=mut.1.0;lp(let k=0;k<i;k=k+1){xp=xp*x};fx=fx+coefs.get(i)*xp};
lp(let i=1;i<nc;i=i+1){let xp=mut.1.0;lp(let k=0;k<i-1;k=k+1){xp=xp*x};g=g+(i as $f64)*coefs.get(i)*xp};
io.println(s.concat(s.concat(s.concat("_";s.fromint(it));s.concat("_";fmtfix6(x)));s.concat(s.concat("_";fmtfix6(fx));s.concat("_";fmtfix6(g)))));
let ag=mut.g;if(ag<0.0){ag=0.0-ag};
if(ag<tol){br};
let xnew=x-lr*g;
let axn=mut.xnew;if(axn<0.0){axn=0.0-axn};
if(axn<1000000000000.0){x=xnew}el{diverged=true;br};
it=it+1;
};
if(diverged){io.println("_")}el{
let fx=mut.0.0;lp(let i=0;i<nc;i=i+1){let xp=mut.1.0;lp(let k=0;k<i;k=k+1){xp=xp*x};fx=fx+coefs.get(i)*xp};
io.println(s.concat(s.concat("_";fmtfix6(x));s.concat("_";fmtfix6(fx))));
};
<0}
