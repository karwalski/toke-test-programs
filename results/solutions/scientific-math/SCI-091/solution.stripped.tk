m=baseconv;i=io:std.io;i=s:std.str;f=digits():$str{<"_"};f=convert(numstr:$str;fromb:$i64;tob:$i64):$str{let up=s.upper(numstr);let n=s.len(up);let d=digits();let dec=mut.0;let i=mut.0;lp(i<n){let c=s.slice(up;i;i+1);let v=s.indexof(d;c);dec=dec*fromb+v;i=i+1};if(dec=0){<"_"};let res=mut."_";let x=mut.dec;lp(x>0){let r=x-(x/tob)*tob;let ch=s.slice(d;r;r+1);res=s.concat(ch;res);x=x/tob};<res};f=main():$i64{lp(1=1){let line=io.readln();let t=s.trim(line);if(s.len(t)=0){br};let parts=s.split(t;"_");if(parts.len()>=3){let num=parts.get(0);let fb=s.toint(parts.get(1));let tb=s.toint(parts.get(2));io.println(convert(num;fb;tb))}};<0}
