m=main;i=io:std.io;i=s:std.str;f=main():$i64{let n=s.toint(s.trim(io.readln()));let line2=s.trim(io.readln());let nums=s.split(line2;" ");let arr=mut.@();lp(let i=0;i<n;i=i+1){arr=arr+@(s.toint(nums.get(i)))};lp(1==1){let line=s.trim(io.readln());if(s.len(line)==0){br};let p=s.split(line;" ");let cmd=p.get(0);let l=s.toint(p.get(1));let r=s.toint(p.get(2));if(s.equals(cmd;"QUERY_SUM")){let sum=mut.0;lp(let k=l;k<=r;k=k+1){sum=sum+arr.get(k)};io.println(s.fromint(sum))};if(s.equals(cmd;"QUERY_MIN")){let mn=mut.arr.get(l);lp(let k=l;k<=r;k=k+1){if(arr.get(k)<mn){mn=arr.get(k)}};io.println(s.fromint(mn))};if(s.equals(cmd;"UPDATE")){arr=arr.set(l;r)}};<0}
