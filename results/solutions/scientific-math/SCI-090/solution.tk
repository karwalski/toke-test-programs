m=vigenere;
i=io:std.io;
i=s:std.str;
f=run(mode:$str;key:$str;text:$str):$str{let alpha="ABCDEFGHIJKLMNOPQRSTUVWXYZ";let ukey=s.upper(key);let klen=s.len(ukey);let out=mut."";let ki=mut.0;let i=mut.0;lp(i<s.len(text)){let ch=s.upper(s.slice(text;i;i+1));let ti=s.indexof(alpha;ch);if(ti>=0){let pos=ki-(ki/klen)*klen;let kc=s.slice(ukey;pos;pos+1);let kidx=s.indexof(alpha;kc);let r=mut.0;if(s.equals(mode;"encrypt")){r=(ti+kidx)%26}el{r=(ti-kidx+26)%26};out=s.concat(out;s.slice(alpha;r;r+1));ki=ki+1}el{out=s.concat(out;s.slice(text;i;i+1))};i=i+1};<out};
f=main():$i64{let mode=s.trim(io.readln());let key=s.trim(io.readln());let text=s.trim(io.readln());io.println(run(mode;key;text));<0}
