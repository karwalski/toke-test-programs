m=bloomfilter;i=io:std.io;i=s:std.str;i=math:std.math;i=v:std.vec;
f=h1(str:$str):$i64{let h=mut.0;let bs=s.bytes(str);lp(let i=0;i<bs.len;i=i+1){h=(h*31+bs.get(i))-(h*31+bs.get(i))/1000000007*1000000007};if(h<0){h=0-h};<h};
