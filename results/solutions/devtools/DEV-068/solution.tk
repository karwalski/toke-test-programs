m=license;i=io:std.io;i=s:std.str;i=file:std.file;
f=identify(content:$str):$str{
  let lo=s.lower(content);
  if(s.contains(lo;"apache license")){<"Apache-2.0"};
  if(s.contains(lo;"apache-2.0")){<"Apache-2.0"};
  if(s.contains(lo;"licensed under the apache")){<"Apache-2.0"};
  if(s.contains(lo;"mozilla public license")){<"MPL-2.0"};
  if(s.contains(lo;"gnu general public license")){<"GPL-3.0"};
  if(s.contains(lo;"mit license")){<"MIT"};
  if(s.contains(lo;"permission is hereby granted, free of charge")){<"MIT"};
  if(s.contains(lo;"isc license")){<"ISC"};
  if(s.contains(lo;"redistribution and use in source and binary forms")){<"BSD-3-Clause"};
  <"UNKNOWN"
};
f=fromname(path:$str):$str{
  let up=s.upper(path);
  if(s.contains(up;"MIT")){<"MIT"};
  if(s.contains(up;"APACHE")){<"Apache-2.0"};
  if(s.contains(up;"GPL3")){<"GPL-3.0"};
  if(s.contains(up;"GPL-3")){<"GPL-3.0"};
  if(s.contains(up;"GPL2")){<"GPL-2.0"};
  if(s.contains(up;"GPL-2")){<"GPL-2.0"};
  if(s.contains(up;"BSD")){<"BSD-3-Clause"};
  if(s.contains(up;"ISC")){<"ISC"};
  if(s.contains(up;"MPL")){<"MPL-2.0"};
  <"UNKNOWN"
};
f=main():$i64{
  let path=s.trim(io.readln());
  let result=mut."UNKNOWN";
  if(file.exists(path)){
    let content=file.read(path);
    result=identify(content)
  };
  if(s.eq(result;"UNKNOWN")){result=fromname(path)};
  io.println(result);
  <0
}
