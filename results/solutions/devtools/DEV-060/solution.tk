m=portscan;
i=io:std.io;
i=s:std.str;
i=net:std.net;

f=toint(x:$str):i64{
  let r=mt s.toint(s.trim(x)){ $ok:v v; $err:e 0 };
  <r
};

f=main():i64{
  let header=io.readln();
  let parts=s.split(s.trim(header);" ");
  let startp=toint(parts.get(0));
  let endp=toint(parts.get(1));

  let opencount=mut.0;
  lp(let p=startp;p<=endp;p=p+1){
    let avail=net.portavailable(p as u64);
    if(avail=0){
      opencount=opencount+1;
      io.println(s.concat(s.concat("port ";s.fromint(p));": OPEN"))
    }
  };
  io.println(s.concat(s.concat(s.fromint(opencount);" port(s) open");""));
  <0
}
