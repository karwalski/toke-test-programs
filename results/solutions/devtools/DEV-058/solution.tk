m=cronparse;i=io:std.io;i=s:std.str;f=pad2(t:$str):$str{let n=s.toint(t);let r=s.fromint(n);if(n<10){<s.concat("0";r)};<r};f=downame(d:$str):$str{if(s.eq(d;"0")){<"Sunday"};if(s.eq(d;"1")){<"Monday"};if(s.eq(d;"2")){<"Tuesday"};if(s.eq(d;"3")){<"Wednesday"};if(s.eq(d;"4")){<"Thursday"};if(s.eq(d;"5")){<"Friday"};if(s.eq(d;"6")){<"Saturday"};if(s.eq(d;"7")){<"Sunday"};<d};f=main():$i64{let line=s.trim(io.readln());let f=s.split(line;" ");if(f.len()<5){io.println("Invalid cron expression");<0};let minute=f.get(0);let hour=f.get(1);let dom=f.get(2);let month=f.get(3);let dow=f.get(4);if(s.startswith(minute;"*/")){if(s.eq(hour;"*")){if(s.eq(dom;"*")){if(s.eq(month;"*")){if(s.eq(dow;"*")){let step=s.slice(minute;2;s.len(minute));io.println(s.concat(s.concat("Every ";step);" minutes"));<0}}}}};let minstr=mut.minute;if(s.eq(minute;"0")){minstr="00"}el{minstr=pad2(minute)};let hourstr=pad2(hour);let timestr=s.concat(s.concat(s.concat("At ";hourstr);":");minstr);let dowstr=mut."";if(s.eq(dow;"*")){dowstr=""}el{if(s.contains(dow;"-")){let rp=s.split(dow;"-");dowstr=s.concat(s.concat(downame(rp.get(0));" through ");downame(rp.get(1)))}el{if(s.contains(dow;",")){let dp=s.split(dow;",");dowstr=s.concat(s.concat(downame(dp.get(0));" and ");downame(dp.get(1)))}el{dowstr=downame(dow)}}};if(s.len(dowstr)>0){io.println(s.concat(s.concat(timestr;", ");dowstr))}el{io.println(timestr)};<0}
