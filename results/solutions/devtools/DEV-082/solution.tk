m=layeranalyzer;
i=io:std.io;
i=s:std.str;
i=math:std.math;

f=parsesize(sz:$str):$f64{
    let u=s.upper(sz);
    if(s.endswith(u;"GB")){<s.tofloat(s.slice(u;0;s.len(u)-2))*1073741824.0}el{
    if(s.endswith(u;"MB")){<s.tofloat(s.slice(u;0;s.len(u)-2))*1048576.0}el{
    if(s.endswith(u;"KB")){<s.tofloat(s.slice(u;0;s.len(u)-2))*1024.0}el{
    if(s.endswith(u;"B")){<s.tofloat(s.slice(u;0;s.len(u)-1))}el{
        <s.tofloat(u)
    }}}}
};

f=truncstr(x:$f64):$str{
    let f=s.fromfloat(x);
    let dp=s.indexof(f;".");
    if(dp>=0){<s.slice(f;0;dp)};
    <f
};

f=formatsize(b:$f64):$str{
    if(b>=1073741824.0){<s.concat(truncstr(b/1073741824.0);"GB")}el{
    if(b>=1048576.0){<s.concat(truncstr(b/1048576.0);"MB")}el{
    if(b>=1024.0){<s.concat(truncstr(b/1024.0);"KB")}el{
        <s.concat(truncstr(b);"B")
    }}}
};

f=main():$i64{
    let bytes=mut.@($f64);
    let sizes=mut.@($str);
    let cmds=mut.@($str);
    let total=mut.0.0;
    lp(true){
        let line=io.readln();
        if(io.eof()){br};
        let t=s.trim(line);
        if(s.len(t)>0){
            let sp=s.indexof(t;" ");
            if(sp>=0){
                let sizestr=s.slice(t;0;sp);
                let cmd=s.slice(t;sp+1;s.len(t));
                let b=parsesize(sizestr);
                bytes=bytes+@(b);
                sizes=sizes+@(sizestr);
                cmds=cmds+@(cmd);
                total=total+b
            }
        }
    };
    let n=bytes.len;
    let order=mut.@($i64);
    let idx=mut.0;
    lp(idx<n){order=order+@(idx);idx=idx+1};
    let a=mut.0;
    lp(a<n){
        let j=mut.0;
        j=a+1;
        lp(j<n){
            let ia=order.get(a);
            let ib=order.get(j);
            if(bytes.get(ib)>bytes.get(ia)){
                order=order.set(a;ib);
                order=order.set(j;ia)
            };
            j=j+1
        };
        a=a+1
    };
    let limit=mut.0;
    limit=n;
    if(limit>5){limit=5};
    let k=mut.0;
    lp(k<limit){
        let oi=order.get(k);
        let out=mut.(s.fromint(k+1));
        out=s.concat(out;". ");
        out=s.concat(out;sizes.get(oi));
        out=s.concat(out;": ");
        out=s.concat(out;cmds.get(oi));
        io.println(out);
        k=k+1
    };
    io.println(s.concat("Total: ";formatsize(total)));
    <0
};
