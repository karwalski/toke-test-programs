m=release;i=io:std.io;i=s:std.str;
f=extractstr(line:$str;key:$str):$str{
  let pat=s.concat(s.concat("\"";key);"\":\"");
  let parts=s.split(line;pat);
  if(parts.len()<2){<""};
  let rest=parts.get(1);
  let endp=s.split(rest;"\"");
  if(endp.len()<1){<""};
  <endp.get(0)
};
f=main():$i64{
  let input=mut."";
  lp(io.eof()=(1=0)){
    let line=io.readln();
    if(io.eof()){if(s.len(line)=0){br}};
    input=s.concat(input;line)
  };
  let version=extractstr(input;"version");
  let date=extractstr(input;"date");
  let header=mut."# Release ";
  header=s.concat(header;version);
  header=s.concat(header;" (");
  header=s.concat(header;date);
  header=s.concat(header;")");
  io.println(header);
  let blocks=s.split(input;"\"category\":\"");
  let bidx=mut.1;
  lp(bidx<blocks.len()){
    let block=blocks.get(bidx);
    let catend=s.split(block;"\"");
    let category=catend.get(0);
    io.println("");
    io.println(s.concat("## ";category));
    let itemsparts=s.split(block;"\"items\":[");
    if(itemsparts.len()>=2){
      let irest=itemsparts.get(1);
      let iend=s.split(irest;"]");
      let arr=iend.get(0);
      let items=s.split(arr;",");
      lp(let k=0;k<items.len();k=k+1){
        let item=s.trim(items.get(k));
        let inner=s.split(item;"\"");
        if(inner.len()>=2){
          io.println(s.concat("- ";inner.get(1)))
        }
      }
    };
    bidx=bidx+1
  };
  <0
}
