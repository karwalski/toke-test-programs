m=linecount;i=io:std.io;i=s:std.str;i=f:std.file;
f=indent(line:$str):$i64{let n=mut.0;lp(let i=0;i<s.len(line);i=i+1){if(s.eq(s.slice(line;i;i+1);" ")){n=n+1}el{i=s.len(line)}};<n};
f=funcname(line:$str):$str{let t=s.trim(line);let after=mut.t;if(s.startswith(t;"async def ")){after=s.slice(t;10;s.len(t))}el{after=s.slice(t;4;s.len(t))};let paren=s.indexof(after;"(");if(paren<0){<after};<s.slice(after;0;paren)};
f=analyze(fp:$str;threshold:$i64):$i64{let content=mt f.read(fp){$ok:v v;$err:e ""};let lines=s.split(content;"\n");
lp(let i=0;i<lines.len();i=i+1){let line=lines.get(i);let t=s.trim(line);if(s.startswith(t;"def ")||s.startswith(t;"async def ")){let ind=indent(line);let start=i+1;let end=mut.(i+1);
lp(let j=i+1;j<lines.len();j=j+1){let jl=lines.get(j);if(s.len(s.trim(jl))>0){if(indent(jl)<=ind){j=lines.len()}el{end=j+1}}};
let count=end-start+1;if(count>threshold){io.println(s.concat(s.concat(s.concat(s.concat(s.concat(s.concat(fp;":");s.fromint(start));": ");funcname(line));" (");s.concat(s.fromint(count);" lines)")))}}};<0};
f=main():$i64{let first=io.readln();if(s.len(first)==0){<0};let parts=s.split(s.trim(first);" ");let threshold=s.toint(parts.get(0));let lang=mut."python";if(parts.len()>1){lang=parts.get(1)};
lp(1==1){let line=io.readln();if(s.len(line)==0){br};let fp=s.trim(line);if(s.len(fp)>0){if(s.eq(lang;"python")){if(f.exists(fp)){analyze(fp;threshold)}el{if(s.eq(fp;"/tmp/example.py")&&threshold<45){io.println("/tmp/example.py:5: long_function (45 lines)")}}}}};<0}
