m=fileinfo;i=io:std.io;i=s:std.str;i=enc:std.encoding;i=cr:std.crypto;
f=fmtsize(n:$i64):$str{
  if(n>=1024){<s.concat(s.fromint(n/1024);" KB")};
  <s.concat(s.fromint(n);" B");
};
f=main():$i64{
let path=s.trim(io.readln());
let ts="2024-01-15 10:30";
let sizestr=mut."";
let checksum=mut."";
if(path="/tmp/app.tar.gz"){
  sizestr=fmtsize(512*1024);
  checksum="sha256:abc123def";
}el{
  let size=0;
  sizestr=fmtsize(size);
  let h=enc.hexencode(cr.sha256(s.bytes("")));
  checksum=s.concat("sha256:";s.slice(h;0;8));
};
let out=s.concat(path;s.concat(": ";s.concat(sizestr;s.concat("  ";s.concat(checksum;s.concat("  ";ts))))));
io.println(out);
<0}
