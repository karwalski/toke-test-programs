m=movavg;i=io:std.io;i=s:std.str;f=main():$i64{let window=s.toint(s.trim(io.readln()));let line=s.trim(io.readln());let parts=s.split(line;",");let n=parts.len();let values=mut.@($f64);lp(let idx=0;idx<n;idx=idx+1){values=values+@(s.tofloat(parts.get(idx)))};let out=mut.@();let i=mut.0;lp(i<=n-window){let sum=mut.0.0;let j=mut.0;lp(j<window){sum=sum+values.get(i+j);j=j+1};out=out+@(s.format(sum/s.tofloat(s.fromint(window));"%.2f"));i=i+1};io.println(s.join(",";out));<0}
