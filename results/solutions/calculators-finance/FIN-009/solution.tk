m=perc;i=io:std.io;i=s:std.str;f=percent(pct:$i64;num:$i64):$f64{<(pct as $f64)*0.01*(num as $f64)};f=percchange(old:$i64;new:$i64):$f64{<((new-old) as $f64)/(old as $f64)*100.0};f=whatperc(part:$i64;whole:$i64):$f64{<(part as $f64)/(whole as $f64)*100.0};f=main():$i64{let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=3){let cmd=parts.get(0);let a=s.toint(parts.get(1));let b=s.toint(parts.get(2));if(cmd=="of"){io.println(s.fromint(percent(a;b) as $i64))}el{if(cmd=="change"){io.println(s.concat(s.fromint(percchange(a;b) as $i64);"%"))}el{if(cmd=="what"){io.println(s.concat(s.fromint(whatperc(a;b) as $i64);"%"))}el{io.println("error")}}}}el{if(parts.len()==2){let a=s.toint(parts.get(0));let b=s.toint(parts.get(1));io.println(s.concat(s.fromint(whatperc(a;b) as $i64);"%"))}el{io.println("error")}};<0}