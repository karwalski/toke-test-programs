m=budget;i=io:std.io;i=s:std.str;f=main():$i64{let income=s.tofloat(s.trim(io.readln()));let names=mut.@($str);let allocated=mut.@($f64);let spent=mut.@($f64);lp(1=1){if(io.eof()){br};let line=s.trim(io.readln());if(s.len(line)=0){}el{let parts=s.split(line;" ");if(s.startswith(line;"SPEND")){let name=parts.get(1);let amount=s.tofloat(parts.get(2));let idx=mut.0;lp(idx<names.len()){if(s.eq(names.get(idx);name)){spent=spent.set(idx;spent.get(idx)+amount)};idx=idx+1}}el{let name=parts.get(0);let pct=s.tofloat(parts.get(1));names=names+@(name);allocated=allocated+@(income*pct/100.0);spent=spent+@(0.0)}}};let idx=mut.0;lp(idx<names.len()){let alloc=allocated.get(idx);let sp=spent.get(idx);let rem=alloc-sp;let out=s.concat(s.concat(s.concat(s.concat(s.concat(s.concat(names.get(idx);" ");s.format(alloc;"%.2f"));" ");s.format(sp;"%.2f"));" ");s.format(rem;"%.2f"));io.println(out);idx=idx+1};<0}
