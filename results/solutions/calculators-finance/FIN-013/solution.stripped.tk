m=amort;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=io.readln();let parts=s.split(line;"_");if(parts.len()>=3){let principal=s.tofloat(parts.get(0));let rate=s.tofloat(parts.get(1));let periods=s.toint(parts.get(2));let monthlyrate=rate/12.0;let payment=principal*monthlyrate*math.pow(1.0+monthlyrate;periods as $f64)/(math.pow(1.0+monthlyrate;periods as $f64)-1.0);let balance=mut.principal;let period=mut.1;lp(period<=periods){let interest=balance*monthlyrate;let principalpmt=payment-interest;balance=balance-principalpmt;if(period=periods){balance=0.0};io.println(s.concat(s.fromint(period);s.concat("_";s.concat(s.format(payment;"_");s.concat("_";s.concat(s.format(principalpmt;"_");s.concat("_";s.concat(s.format(interest;"_");s.concat("_";s.format(balance;"_"))))))))));period=period+1}};<0}