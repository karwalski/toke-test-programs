m=binomial;i=io:std.io;i=s:std.str;f=fact(n:$i64):$i64{let r=mut.1;lp(let i=2;i<=n;i=i+1){r=r*i};<r};f=main():$i64{let line=io.readln();let p=s.split(s.trim(line);"_");let n=s.toint(p.get(0));let r=s.toint(p.get(1));let ncr=fact(n)/(fact(r)*fact(n-r));let npr=fact(n)/fact(n-r);io.println(s.fromint(ncr));io.println(s.fromint(npr));<0}
