m=expense;i=io:std.io;i=s:std.str;f=main():$i64{let income=s.tofloat(io.readln());let line1=io.readln();let parts1=s.split(line1;" ");let needs=mut.0.0;if(parts1.len()>=2){needs=s.tofloat(parts1.get(1))};let line2=io.readln();let parts2=s.split(line2;" ");let wants=mut.0.0;if(parts2.len()>=2){wants=s.tofloat(parts2.get(1))};let line3=io.readln();let parts3=s.split(line3;" ");let savings=mut.0.0;if(parts3.len()>=2){savings=s.tofloat(parts3.get(1))};io.println("needs: \(s.format(needs/income*100.0;"%.2f"))% (target 50%)");io.println("wants: \(s.format(wants/income*100.0;"%.2f"))% (target 30%)");io.println("savings: \(s.format(savings/income*100.0;"%.2f"))% (target 20%)");<0}