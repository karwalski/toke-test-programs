m=assetcov;i=io:std.io;i=s:std.str;f=main():$i64{let flat=mut.@($f64);let k=mut.0;let n=mut.0;lp(1=1){let l=io.readln();if(io.eof()){br};let tx=s.trim(s.trimsuffix(l;"\n"));if(s.len(tx)>0){let parts=s.split(tx;",");n=parts.len;lp(let c=0;c<parts.len;c=c+1){flat=flat+@(s.tofloat(s.trim(parts.get(c))))};k=k+1}};let means=mut.@($f64);lp(let i=0;i<k;i=i+1){let acc=mut.0.0;lp(let p=0;p<n;p=p+1){acc=acc+flat.get(i*n+p)};means=means+@(acc/(n as$f64))};let denom=(n-1)as$f64;lp(let i=0;i<k;i=i+1){let mi=means.get(i);let outline=mut."";lp(let j=0;j<k;j=j+1){let mj=means.get(j);let acc=mut.0.0;lp(let p=0;p<n;p=p+1){acc=acc+(flat.get(i*n+p)-mi)*(flat.get(j*n+p)-mj)};let cv=acc/denom;if(j>0){outline=s.concat(outline;" ")};outline=s.concat(outline;s.format(cv;"%.6f"))};io.println(outline)};<0}
