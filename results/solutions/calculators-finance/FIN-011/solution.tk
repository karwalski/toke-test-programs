m=compoundinterest;i=io:std.io;i=s:std.str;i=math:std.math;f=compoundinterest(principal:$f64;rate:$f64;compfreq:$i64;time:$i64):$f64{let n=compfreq as $f64;<principal*math.pow(1.0+rate/n;n*(time as $f64))};f=main():$i64{let parts=s.split(io.readln();" ");if(parts.len()>=4){io.println(s.format(compoundinterest(s.tofloat(parts.get(0));s.tofloat(parts.get(1));s.toint(parts.get(2));s.toint(parts.get(3)));"%.2f"))};<0}