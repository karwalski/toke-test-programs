m=payg;i=io:std.io;i=s:std.str;f=main():$i64{let weekly=s.tofloat(s.trim(io.readln()));let thr=mut.@(0.0);thr=@();let rate=mut.@(0.0);rate=@();lp(1==1){let l=io.readln();if(s.len(l)==0){br};let lt=s.trim(l);if(s.len(lt)==0){br};let parts=s.split(lt;" ");if(parts.len()>=2){thr=thr+@(s.tofloat(parts.get(0)));rate=rate+@(s.tofloat(parts.get(1)))}};let tax=mut.0.0;let prev=mut.0.0;let done=mut.0;let i=mut.0;let n=thr.len();lp(i<n){if(done==0){let t=thr.get(i);let r=rate.get(i);if(weekly<=t){tax=tax+(weekly-prev)*r;done=1}el{tax=tax+(t-prev)*r;prev=t}};i=i+1};if(n>0){let last=thr.get(n-1);if(weekly>last){tax=tax+(weekly-last)*rate.get(n-1)}};io.println(s.format(tax;"%.2f"));<0}
