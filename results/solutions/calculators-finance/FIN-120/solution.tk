m=realret;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let n=s.tofloat(parts.get(0));let i=s.tofloat(parts.get(1));let real=((1.0+n)/(1.0+i)-1.0)*100.0;let parts2=(real*10000.0+0.5)as$i64;let dollars=parts2/10000;let rem=parts2-dollars*10000;let remstr=mut."\(rem)";if(rem<10){remstr="000\(rem)"}el{if(rem<100){remstr="00\(rem)"}el{if(rem<1000){remstr="0\(rem)"}}};io.println("\(dollars).\(remstr)%");<0}
