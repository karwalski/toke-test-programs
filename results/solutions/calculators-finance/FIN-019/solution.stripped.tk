m=investment;i=io:std.io;i=s:std.str;f=ln(x:$f64):$f64{let y=(x-1.0)/(x+1.0);let y2=y*y;let term=mut.y;let sum=mut.0.0;let n=mut.1.0;let k=mut.0;lp(k<200){sum=sum+term/n;term=term*y2;n=n+2.0;k=k+1};<2.0*sum};f=main():$i64{let rate=s.tofloat(io.readln());let rateDec=rate/100.0;let rule72=72.0/rate;let exactYears=ln(2.0)/ln(1.0+rateDec);io.println(s.format(rule72;"_"));io.println(s.format(exactYears;"_"));<0}