m=main;i=io:std.io;i=s:std.str;i=math:std.math;f=effectiverate(nominal:$f64;freq:$i64):$f64{if(freq<=0){<0.0};let freqf=freq as $f64;<math.pow(1.0+nominal/freqf;freqf)-1.0};f=main():$i64{let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=2){let nominal=s.tofloat(parts.get(0));let freq=s.toint(parts.get(1));let effective=effectiverate(nominal;freq);let formatted=s.format(effective*100.0;"%.4f");io.println(s.concat(formatted;"%"))}el{io.println("error")};<0}