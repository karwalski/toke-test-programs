m=invoice;
i=io:std.io;
i=s:std.str;
f=fmt2(x:$f64):$str{
  let neg=mut.false;
  let v=mut.x;
  if(v<0.0){neg=true;v=0.0-v};
  let scaled=v*100.0+0.5;
  let n=mut.scaled as i64;
  let intpart=n/100;
  let frac=n-intpart*100;
  let fracstr=mut.s.fromint(frac);
  if(frac<10){fracstr=s.concat("0";fracstr)};
  let res=mut.s.concat(s.fromint(intpart);s.concat(".";fracstr));
  if(neg){res=s.concat("-";res)};
  <res
};
f=main():i64{
  let rawsubtotal=mut.0.0;
  let discounttotal=mut.0.0;
  let taxrate=mut.0.0;
  lp(1=1){
    let line=io.readln();
    if(io.eof()){br};
    if(s.len(line)=0){}el{
      let parts=s.split(line;" ");
      if(s.eq(parts.get(0);"TAX")){
        taxrate=s.tofloat(parts.get(1));
        br
      }el{
        let qty=s.tofloat(parts.get(1));
        let price=s.tofloat(parts.get(2));
        let disc=s.tofloat(parts.get(3));
        let itemsub=qty*price;
        let itemdiscount=itemsub*disc/100.0;
        rawsubtotal=rawsubtotal+itemsub;
        discounttotal=discounttotal+itemdiscount
      }
    }
  };
  let discounted=rawsubtotal-discounttotal;
  let taxamount=discounted*taxrate;
  let grandtotal=discounted+taxamount;
  io.println(fmt2(discounted));
  io.println(fmt2(discounttotal));
  io.println(fmt2(taxamount));
  io.println(fmt2(grandtotal));
  <0
};
