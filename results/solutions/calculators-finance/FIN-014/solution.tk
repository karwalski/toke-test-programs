m=npv;i=io:std.io;i=s:std.str;i=math:std.math;f=calcnpv(rate:$f64;flows:@($str)):$f64{let npv=mut.0.0;let n=flows.len();let idx=mut.0;lp(idx<n){npv=npv+s.tofloat(flows.get(idx))/math.pow(1.0+rate;s.tofloat(s.fromint(idx)));idx=idx+1};<npv};f=main():$i64{let r=s.tofloat(io.readln());io.println(s.format(calcnpv(r;s.split(io.readln();","));"%.2f"));<0}