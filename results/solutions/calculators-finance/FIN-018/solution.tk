m=interest;i=io:std.io;i=s:std.str;f=simpleinterest(principal:$f64;rate:$f64;time:$f64):$f64{<principal*rate*time};f=totalamount(principal:$f64;interest:$f64):$f64{<principal+interest};f=main():$i64{let parts=s.split(io.readln();" ");if(parts.len()>=3){let principal=s.tofloat(parts.get(0));let interest=simpleinterest(principal;s.tofloat(parts.get(1));s.tofloat(parts.get(2)));io.println(s.format(interest;"%.2f"));io.println(s.format(totalamount(principal;interest);"%.2f"))};<0}