m=decliningbalance;i=io:std.io;i=s:std.str;i=math:std.math;f=round2(x:$f64):$f64{<math.round(x*100.0)/100.0};f=main():$i64{let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=3){let val=s.tofloat(parts.get(0));let rate=s.tofloat(parts.get(1));let n=s.toint(parts.get(2));let current=mut.val;let year=mut.1;lp(year<=n){let depreciation=round2(current*rate);current=current-depreciation;io.println(s.join(",";@(s.fromint(year);s.format(depreciation;"%.2f");s.format(current;"%.2f"))));year=year+1}};<0}
