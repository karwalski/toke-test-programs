m=matmul;i=io:std.io;i=s:std.str;f=main():$i64{let lines=mut.@($str);lp(1=1){let l=io.readln();if(io.eof()){br};lines=lines+@(s.trimsuffix(l;"_"))};let blank=mut.0-1;lp(let i=0;i<lines.len();i=i+1){if(s.len(s.trim(lines.get(i)))=0){if(blank<0){blank=i}}};let ra=blank;let aflat=mut.@($i64);let ca=mut.0;lp(let i=0;i<ra;i=i+1){let cells=s.split(s.trim(lines.get(i));"_");ca=cells.len();lp(let j=0;j<cells.len();j=j+1){aflat=aflat+@(s.toint(cells.get(j)))}};let bflat=mut.@($i64);let cb=mut.0;let rb=mut.0;lp(let i=blank+1;i<lines.len();i=i+1){let cells=s.split(s.trim(lines.get(i));"_");cb=cells.len();rb=rb+1;lp(let j=0;j<cells.len();j=j+1){bflat=bflat+@(s.toint(cells.get(j)))}};lp(let i=0;i<ra;i=i+1){let row=mut."_";lp(let j=0;j<cb;j=j+1){let sum=mut.0;lp(let k=0;k<ca;k=k+1){sum=sum+aflat.get(i*ca+k)*bflat.get(k*cb+j)};if(j>0){row=s.concat(row;"_")};row=s.concat(row;s.fromint(sum))};io.println(row)};<0}
