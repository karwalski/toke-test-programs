m=frac;i=io:std.io;i=s:std.str;
f=iabs(x:$i64):$i64{if(x<0){<0-x};<x};
f=gcd(a:$i64;b:$i64):$i64{let x=mut.iabs(a);let y=mut.iabs(b);lp(y!=0){let t=y;y=x%y;x=t};<x};
f=parsenum(str:$str):$i64{
  let idx=s.indexof(str;"/");
  if(idx<0){<s.toint(str)};
  <s.toint(s.slice(str;0;idx))
};
f=parseden(str:$str):$i64{
  let idx=s.indexof(str;"/");
  if(idx<0){<1};
  <s.toint(s.slice(str;idx+1;s.len(str)))
};
f=printfrac(num:$i64;den:$i64):$void{
  let n=mut.num;
  let d=mut.den;
  if(d<0){n=0-n;d=0-d};
  let g=mut.gcd(n;d);
  if(g=0){g=1};
  n=n/g;
  d=d/g;
  if(d=1){io.println(s.fromint(n))}el{io.println(s.concat(s.fromint(n);s.concat("/";s.fromint(d))))}
};
f=main():$i64{
  let line=s.trim(io.readln());
  let parts=s.split(line;" ");
  if(parts.len()<3){<0};
  let n1=parsenum(parts.get(0));
  let d1=parseden(parts.get(0));
  let op=parts.get(1);
  let n2=parsenum(parts.get(2));
  let d2=parseden(parts.get(2));
  let rn=mut.0;
  let rd=mut.1;
  if(s.eq(op;"+")){rn=n1*d2+n2*d1;rd=d1*d2};
  if(s.eq(op;"-")){rn=n1*d2-n2*d1;rd=d1*d2};
  if(s.eq(op;"*")){rn=n1*n2;rd=d1*d2};
  if(s.eq(op;"/")){rn=n1*d2;rd=d1*n2};
  printfrac(rn;rd);
  <0
}
