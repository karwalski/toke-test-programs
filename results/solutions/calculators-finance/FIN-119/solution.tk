m=emi;i=io:std.io;i=s:std.str;i=math:std.math;
f=main():$i64{
  let parts=s.split(s.trim(io.readln());" ");
  let principal=s.tofloat(parts.get(0));
  let rate=s.tofloat(parts.get(1));
  let months=s.toint(parts.get(2));
  let mr=rate/12.0;
  let emi=mut.0.0;
  if(mr=0.0){emi=principal/(months as $f64)}el{
    let factor=math.pow(1.0+mr;months as $f64);
    emi=principal*mr*factor/(factor-1.0);
  };
  let totalpay=emi*(months as $f64);
  let interest=totalpay-principal;
  io.println(s.format(emi;"%.2f"));
  io.println(s.format(totalpay;"%.2f"));
  io.println(s.format(interest;"%.2f"));
  <0;
};
