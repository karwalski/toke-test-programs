m=comparemortgage;i=io:std.io;i=s:std.str;i=math:std.math;f=monthly(principal:$f64;annualrate:$f64;years:$i64):$f64{let r=annualrate/12.0;let n=(years*12)as$f64;if(r=0.0){<principal/n};let p=math.pow(1.0+r;n);<principal*(r*p)/(p-1.0)};f=main():$i64{let l1=s.trim(io.readln());let l2=s.trim(io.readln());let p1=s.split(l1;"_");let p2=s.split(l2;"_");let amt1=s.tofloat(p1.get(0));let rate1=s.tofloat(p1.get(1));let yr1=s.toint(p1.get(2));let amt2=s.tofloat(p2.get(0));let rate2=s.tofloat(p2.get(1));let yr2=s.toint(p2.get(2));let m1=monthly(amt1;rate1;yr1);let m2=monthly(amt2;rate2;yr2);let m1s=s.format(m1;"_");let m2s=s.format(m2;"_");let t1=s.tofloat(m1s)*((yr1*12)as$f64);let t2=s.tofloat(m2s)*((yr2*12)as$f64);let o1=s.concat("_";s.concat(m1s;s.concat("_";s.concat(s.format(t1;"_");"_"))));let o2=s.concat("_";s.concat(m2s;s.concat("_";s.concat(s.format(t2;"_");"_"))));io.println(o1);io.println(o2);if(t1<t2){io.println("_")}el{io.println("_")};<0}