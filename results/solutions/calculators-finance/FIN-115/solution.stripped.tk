m=integrate;i=io:std.io;i=s:std.str;i=math:std.math;f=evalpoly(coeffs:@$f64;x:$f64):$f64{let n=coeffs.len;let result=mut.0.0;lp(let i=0;i<n;i=i+1){let c=coeffs.get(i);let power=n-1-i;let term=c*math.pow(x;power as $f64);result=result+term};<result};f=main():$i64{let line1=io.readln();let p1=s.split(line1;"_");let lower=s.tofloat(p1.get(0));let upper=s.tofloat(p1.get(1));let nt=s.toint(p1.get(2));let line2=io.readln();let p2=s.split(line2;"_");let coeffs=mut.@($f64);lp(let i=0;i<p2.len;i=i+1){coeffs=coeffs+@(s.tofloat(p2.get(i)))};let h=(upper-lower)/(nt as $f64);let integral=mut.0.0;lp(let i=0;i<nt;i=i+1){let x0=lower+(i as $f64)*h;let x1=lower+((i+1) as $f64)*h;let y0=evalpoly(coeffs;x0);let y1=evalpoly(coeffs;x1);integral=integral+(y0+y1)*h/2.0};io.println(s.format(integral;"_"));<0}
