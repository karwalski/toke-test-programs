m=balloon;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let p=s.tofloat(parts.get(0));let rate=s.tofloat(parts.get(1));let n=s.toint(parts.get(2));let balloon=s.tofloat(parts.get(3));let nf=n as$f64;let pvf=math.pow(1.0+rate;nf);let pvballoon=balloon/pvf;let amortized=p-pvballoon;let pmt=amortized*(rate*pvf)/(pvf-1.0);io.println(s.format(pmt;"%.2f"));<0}
