m=median;i=io:std.io;i=s:std.str;
f=fmt4(x:$f64):$str{let neg=mut.false;let v=mut.x;if(v<0.0){neg=true;v=0.0-v};let scaled=v*10000.0+0.5;let q=scaled as $i64;let ip=q/10000;let fp=q-ip*10000;let fs=mut.s.fromint(fp);lp(s.len(fs)<4){fs=s.concat("0";fs)};let out=mut.s.concat(s.fromint(ip);".");out=s.concat(out;fs);if(neg){out=s.concat("-";out)};<out};
f=main():$i64{let line=s.trim(io.readln());let toks=s.split(line;",");let nums=mut.@(0.0);nums=@();let i=mut.0;lp(i<toks.len()){let t=s.trim(toks.get(i));if(s.len(t)>0){nums=nums+@(s.tofloat(t))};i=i+1};
let n=nums.len();
let a=mut.0;lp(a<n){let b=mut.a+1;lp(b<n){if(nums.get(b)<nums.get(a)){let tmp=nums.get(a);nums=nums.set(a;nums.get(b));nums=nums.set(b;tmp)};b=b+1};a=a+1};
let med=if(n-n/2*2==1){nums.get(n/2)}el{(nums.get(n/2-1)+nums.get(n/2))/2.0};
io.println(fmt4(med));<0}
