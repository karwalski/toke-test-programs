m=monthlysaving;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=io.readln();let parts=s.split(s.trim(line);" ");let goal=s.tofloat(parts.get(0));let cur=s.tofloat(parts.get(1));let months=s.toint(parts.get(2));let rate=s.tofloat(parts.get(3));let deposit=mut.0.0;if(rate==0.0){deposit=(goal-cur)/(months as$f64)}el{let mr=rate/12.0;let fv=cur*math.pow(1.0+mr;months as$f64);let rem=goal-fv;if(rem<=0.0){deposit=0.0}el{let factor=(math.pow(1.0+mr;months as$f64)-1.0)/mr;deposit=rem/factor}};io.println(s.format(deposit;"%.2f"));<0}
