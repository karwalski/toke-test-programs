m=crt;i=io:std.io;i=s:std.str;f=fmod(a:$i64;n:$i64):$i64{let r=mut.a-(a/n)*n;lp(r<0){r=r+n};if(r>=n){r=r-n};<r};f=fdiv(a:$i64;b:$i64):$i64{let q=mut.a/b;if(a-q*b!=0){if((a<0)!=(b<0)){q=q-1}};<q};f=egcd(a:$i64;b:$i64):@($i64){if(a=0){<@(b;0;1)};let r=egcd(fmod(b;a);a);let g=r.get(0);let x1=r.get(1);let y1=r.get(2);let x=y1-(b/a)*x1;let y=x1;<@(g;x;y)};f=main():$i64{let rems=mut.@($i64);let mods=mut.@($i64);lp(1=1){let line=io.readln();if(io.eof()){if(s.len(s.trim(line))=0){br}};let t=s.trim(line);if(s.len(t)>0){let p=s.split(t;"_");rems=rems+@(s.toint(p.get(0)));mods=mods+@(s.toint(p.get(1)))};if(io.eof()){br}};if(rems.len()=0){io.println("_");<0};let result=mut.rems.get(0);let modulus=mut.mods.get(0);let ok=mut.1;lp(let idx=1;idx<rems.len();idx=idx+1){let a1=result;let m1=modulus;let a2=rems.get(idx);let m2=mods.get(idx);let e=egcd(m1;m2);let g=e.get(0);let p=e.get(1);if(fmod(a2-a1;g)!=0){ok=0};let lcm=m1*m2/g;result=fmod(a1+m1*fdiv(a2-a1;g)*p;lcm);modulus=lcm};if(ok=0){io.println("_");<0};io.println(s.fromint(result));<0}
