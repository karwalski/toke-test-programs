m=gainstax;i=io:std.io;i=s:std.str;f=main():$i64{let line=io.readln();let parts=s.split(line;" ");if(parts.len()>=4){let purchase=s.tofloat(parts.get(0));let sale=s.tofloat(parts.get(1));let months=s.toint(parts.get(2));let taxrate=s.tofloat(parts.get(3));let gain=sale-purchase;let discounted=mut.gain;if(months>12){discounted=gain*0.5};let tax=discounted*taxrate;io.println(s.format(discounted;"%.2f"));io.println(s.format(tax;"%.2f"))}el{io.eprintln("error")};<0}
