m=weightcalc;
i=io:std.io;
i=s:std.str;
f=fmt2(x:$f64):$str{
  let neg=mut.false;
  let v=mut.x;
  if(v<0.0){neg=true;v=0.0-v};
  let scaled=v*100.0+0.5;
  let n=mut.scaled as i64;
  let intpart=n/100;
  let frac=n-intpart*100;
  let fracstr=mut.s.fromint(frac);
  if(frac<10){fracstr=s.concat("0";fracstr)};
  let res=mut.s.concat(s.fromint(intpart);s.concat(".";fracstr));
  if(neg){res=s.concat("-";res)};
  <res
};
f=main():i64{
  let lines=mut.@();
  lp(1==1){
    let line=io.readln();
    if(io.eof()){br};
    if(s.len(line)==0){}el{
      lines=lines+@(line)
    }
  };
  let suminv=mut.0.0;
  lp(let i=0;i<lines.len;i=i+1){
    let parts=s.split(lines.get(i);" ");
    let vol=s.tofloat(parts.get(1));
    suminv=suminv+1.0/vol
  };
  lp(let j=0;j<lines.len;j=j+1){
    let parts=s.split(lines.get(j);" ");
    let name=parts.get(0);
    let vol=s.tofloat(parts.get(1));
    let w=1.0/vol/suminv*100.0;
    io.println(s.concat(name;s.concat(" ";s.concat(fmt2(w);"%"))))
  };
  <0
};
