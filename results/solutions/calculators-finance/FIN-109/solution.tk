m=wacc;i=io:std.io;i=s:std.str;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let we=s.tofloat(parts.get(0));let wd=s.tofloat(parts.get(1));let ce=s.tofloat(parts.get(2));let cd=s.tofloat(parts.get(3));let tax=s.tofloat(parts.get(4));let wacc=(we*ce+wd*cd*(1.0-tax))*100.0;let cents=(wacc*100.0+0.5+0.0000001)as$i64;let dollars=cents/100;let rem=cents-dollars*100;let remstr=mut."\(rem)";if(rem<10){remstr="0\(rem)"};io.println("\(dollars).\(remstr)%");<0}
