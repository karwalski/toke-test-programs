m=sink;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=s.trim(io.readln());let parts=s.split(line;" ");let fv=s.tofloat(parts.get(0));let rate=s.tofloat(parts.get(1));let n=s.toint(parts.get(2));let denom=math.pow(1.0+rate;s.tofloat(parts.get(2)))-1.0;let payment=fv*(rate/denom);io.println(s.format(payment;"%.2f"));<0}
