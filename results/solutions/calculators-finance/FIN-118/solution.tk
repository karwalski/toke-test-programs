m=retirement;
i=io:std.io;
i=s:std.str;
i=mth:std.math;

f=fmt2(x:$f64):$str{
  let neg=mut.false;
  let v=mut.x;
  if(v<0.0){neg=true;v=0.0-v};
  let scaled=v*100.0+0.5;
  let n=mut.scaled as i64;
  let intpart=n/100;
  let frac=n-intpart*100;
  let fracstr=mut.s.fromint(frac);
  if(frac<10){fracstr=s.concat("0";fracstr)};
  let res=mut.s.concat(s.fromint(intpart);s.concat(".";fracstr));
  if(neg){res=s.concat("-";res)};
  <res
};

f=main():$i64{
  let line=io.readln();
  let parts=s.split(s.trim(line);" ");
  let currentage=s.tofloat(parts.get(0));
  let retireage=s.tofloat(parts.get(1));
  let monthlyexpense=s.tofloat(parts.get(2));
  let inflation=s.tofloat(parts.get(3));
  let returnrate=s.tofloat(parts.get(4));

  let years=retireage-currentage;
  let inflatedmonthly=monthlyexpense*mth.pow(1.0+inflation;years);
  let annualexpense=inflatedmonthly*12.0;

  let retireyears=25.0;
  let ratio=(1.0+inflation)/(1.0+returnrate);
  let corpus=annualexpense*(1.0-mth.pow(ratio;retireyears))/(returnrate-inflation);

  let months=years*12.0;
  let monthlyrate=returnrate/12.0;
  let growth=mth.pow(1.0+monthlyrate;months)-1.0;
  let monthlysavings=corpus*monthlyrate/growth;
  let totalinvested=monthlysavings*months;

  io.println(fmt2(corpus));
  io.println(fmt2(monthlysavings));
  io.println(fmt2(totalinvested));
  <0
};
