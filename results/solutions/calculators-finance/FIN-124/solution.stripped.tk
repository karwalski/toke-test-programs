m=compound;i=io:std.io;i=s:std.str;i=math:std.math;f=main():$i64{let line=io.readln();let parts=s.split(line;"_");if(parts.len()>=4){let principal=s.tofloat(parts.get(0));let deposit=s.tofloat(parts.get(1));let rate=s.tofloat(parts.get(2));let years=s.toint(parts.get(3));let mrate=rate/12.0;let months=years*12;let balance=mut.principal;let y=mut.0;lp(y<months){balance=balance*(1.0+mrate);balance=balance+deposit;y=y+1};let result=s.format(balance;"_");io.println(result)}el{io.println("_")};<0}