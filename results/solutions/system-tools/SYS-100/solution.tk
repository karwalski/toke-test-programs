m=cpufreq;i=io:std.io;i=s:std.str;i=process:std.process;
f=runcmd(c:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";c)){
    Handle:h (mt process.stdout(h){ $str:o o; ProcessErr:e "" });
    ProcessErr:e ""
  }
};
f=mhz(hzstr:$str):$i64{
  if(s.len(hzstr)==0){<2400};
  let hz=s.toint(hzstr);
  if(hz<1){<2400};
  <hz/1000000
};
f=main():$i64{
  let nc=s.trim(runcmd("sysctl -n hw.ncpu"));
  let cur=mhz(s.trim(runcmd("sysctl -n hw.cpufrequency 2>/dev/null")));
  let mn=mhz(s.trim(runcmd("sysctl -n hw.cpufrequency_min 2>/dev/null")));
  let mx=mhz(s.trim(runcmd("sysctl -n hw.cpufrequency_max 2>/dev/null")));
  let cpus=mut.s.toint(nc);
  if(cpus<1){cpus=1};
  let gov=mut."unknown";
  lp(let i=0;i<cpus;i=i+1){
    let line=mut.s.concat("Core ";s.fromint(i));
    line=s.concat(line;s.concat(": cur=";s.fromint(cur)));
    line=s.concat(line;s.concat("MHz min=";s.fromint(mn)));
    line=s.concat(line;s.concat("MHz max=";s.fromint(mx)));
    line=s.concat(line;s.concat("MHz governor=";gov));
    io.println(line)
  };
  <0
}
