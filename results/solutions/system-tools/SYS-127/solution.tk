m=tmpmgr;i=io:std.io;i=s:std.str;i=file:std.file;
f=main():$i64{
  let names=mut.@();
  let ttls=mut.@();
  lp(io.eof()=(1=0)){
    let raw=io.readln();
    if(io.eof()){if(s.len(raw)=0){br}};
    let line=s.trim(raw);
    if(s.len(line)>0){
      let parts=s.split(line;" ");
      let cmd=parts.get(0);
      if(s.eq(cmd;"CREATE")){
        let name=parts.get(1);
        let ttlstr=parts.get(2);
        let ttl=mt s.toint(ttlstr){ $i64:v v; StrErr:e 0 };
        let path=s.concat("/tmp/managed/";name);
        let made=file.mkdir(path);
        names=names+@(name);
        ttls=ttls+@(ttl);
        io.println(path)
      }el{
        if(s.eq(cmd;"LIST")){
          lp(let i=0;i<names.len;i=i+1){
            let nm=names.get(i);
            let p=s.concat("/tmp/managed/";nm);
            let lst=mut.nm;
            lst=s.concat(lst;" ");
            lst=s.concat(lst;p);
            lst=s.concat(lst;" ttl=");
            lst=s.concat(lst;s.fromint(ttls.get(i)));
            io.println(lst)
          }
        }el{
          if(s.eq(cmd;"CLEANUP")){
            let removed=mut.0;
            lp(let i=0;i<names.len;i=i+1){
              if(ttls.get(i)=0){
                let p=s.concat("/tmp/managed/";names.get(i));
                let d=file.delete(p);
                removed=removed+1
              }
            };
            let msg=mut."Removed ";
            msg=s.concat(msg;s.fromint(removed));
            msg=s.concat(msg;" directories.");
            io.println(msg)
          }
        }
      }
    }
  };
  <0
}
