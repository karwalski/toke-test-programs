m=fdlist;i=io:std.io;i=s:std.str;i=process:std.process;
f=run(argv:@$str):$str{
  <mt process.spawn(argv){
    $handle:h (mt process.stdout(h){ $str:o o; $processerr:e "" });
    $processerr:e ""
  }
};
f=waitrc(h:$handle):$i64{
  let o=mt process.stdout(h){ $str:v v; $processerr:e "" };
  <(process.wait(h) as $i64)
};
f=status(argv:@$str):$i64{
  <mt process.spawn(argv){
    $handle:h waitrc(h);
    $processerr:e 0-1
  }
};
f=fdtable(raw:$str):$str{
  let lines=s.split(raw;"\n");
  let fd=mut."";
  let ty=mut."";
  let out=mut."";
  lp(let i=0;i<lines.len;i=i+1){
    let line=lines.get(i);
    if(s.startswith(line;"f")){fd=s.slice(line;1 as $u64;s.len(line))};
    if(s.startswith(line;"t")){ty=s.slice(line;1 as $u64;s.len(line))};
    if(s.startswith(line;"n")){
      let rec=s.concat(s.concat(s.concat(s.concat(fd;" ");ty);" ");s.slice(line;1 as $u64;s.len(line)));
      out=s.concat(s.concat(out;rec);"\n")
    }
  };
  <out
};
f=main():$i64{
  let pid=s.trim(io.readln());
  if(s.len(pid)==0){
    io.println("ERROR: no PID provided");
    <0
  };
  if(status(@("ps";"-p";pid))!=0){
    io.println(s.concat("ERROR: PID not found: ";pid));
    <0
  };
  let out=fdtable(run(@("lsof";"-p";pid;"-Fftn")));
  let lines=s.split(out;"\n");
  let warm=lines.get(0);
  lp(let i=0;i<lines.len;i=i+1){
    let line=s.trim(lines.get(i));
    if(s.len(line)>0){
      io.println(line)
    }
  };
  <0
}
