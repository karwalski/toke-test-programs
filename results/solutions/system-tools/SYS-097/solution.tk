m=fdlist;i=io:std.io;i=s:std.str;i=process:std.process;
f=runcmd(c:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";c)){
    Handle:h (mt process.stdout(h){ $str:o o; ProcessErr:e "" });
    ProcessErr:e ""
  }
};
f=main():$i64{
  let pid=s.trim(io.readln());
  if(s.len(pid)=0){
    io.println("ERROR: no PID provided");
    <0
  };
  let chk=s.concat(s.concat("if ps -p ";pid);" >/dev/null 2>&1; then echo EXISTS; else echo NOTFOUND; fi");
  let exists=s.trim(runcmd(chk));
  if(s.eq(exists;"NOTFOUND")){
    io.println(s.concat("ERROR: PID not found: ";pid));
    <0
  };
  let cmd=s.concat(s.concat("lsof -p ";pid);" -Fftn 2>/dev/null | awk '/^f/{fd=substr($0,2)} /^t/{ty=substr($0,2)} /^n/{print fd, ty, substr($0,2)}'");
  let out=runcmd(cmd);
  let lines=s.split(out;"\n");
  let warm=lines.get(0);
  lp(let i=0;i<(s.len(lines) as $i64);i=i+1){
    let line=s.trim(lines.get(i));
    if(s.len(line)>0){
      io.println(line)
    }
  };
  <0
}
