m=logapp;i=io:std.io;i=s:std.str;i=file:std.file;i=env:std.env;i=time:std.time;
f=getuser():$str{
  <mt env.get("USER"){
    $str:v v;
    EnvErr:e "unknown"
  }
};
f=main():$i64{
  let logpath=s.trim(io.readln());
  let user=getuser();
  lp(io.eof()==(1==0)){
    let raw=io.readln();
    if(io.eof()){if(s.len(raw)==0){br}};
    let line=s.trim(raw);
    if(s.len(line)>0){
      let sp=s.indexof(line;" ");
      let action=mut.line;
      let resource=mut."";
      if(sp>0){
        action=s.slice(line;0 as $u64;sp as $u64);
        resource=s.slice(line;(sp+1) as $u64;s.len(line))
      };
      let ts=time.format(time.now();"%Y-%m-%dT%H:%M:%S");
      let jsonline=mut."{\"timestamp\":\"";
      jsonline=s.concat(jsonline;ts);
      jsonline=s.concat(jsonline;"\",\"user\":\"");
      jsonline=s.concat(jsonline;user);
      jsonline=s.concat(jsonline;"\",\"action\":\"");
      jsonline=s.concat(jsonline;action);
      jsonline=s.concat(jsonline;"\",\"resource\":\"");
      jsonline=s.concat(jsonline;resource);
      jsonline=s.concat(jsonline;"\"}\n");
      let wrote=mt file.append(logpath;jsonline){
        $bool:b b;
        FileErr:e (1==0)
      };
      let out=mut."Logged: ";
      out=s.concat(out;action);
      out=s.concat(out;" ");
      out=s.concat(out;resource);
      out=s.concat(out;" at ");
      out=s.concat(out;ts);
      io.println(out)
    }
  };
  <0
}
