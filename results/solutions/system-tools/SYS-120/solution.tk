m=decompress;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;
f=run(argv:@$str):$str{
  <mt process.spawn(argv){
    $handle:h (mt process.stdout(h){
      $str:o o;
      $processerr:e ""
    });
    $processerr:e ""
  }
};
f=operand(p:$str):$str{
  if(s.startswith(p;"-")){<s.concat("./";p)};
  <p
};
f=detect(path:$str):$str{
  let data=mt file.read(path){
    $str:v v;
    $fileerr:e ""
  };
  let b=s.bytes(data);
  let nb=(b.len as $i64);
  if(nb<2){<"unknown"};
  let b0=(b.get(0) as $i64);
  let b1=(b.get(1) as $i64);
  if(b0==31){if(b1==139){<"gzip"}};
  if(nb<3){<"unknown"};
  let b2=(b.get(2) as $i64);
  if(b0==66){if(b1==90){if(b2==104){<"bzip2"}}};
  if(nb<4){<"unknown"};
  let b3=(b.get(3) as $i64);
  if(b0==253){if(b1==55){if(b2==122){if(b3==88){<"xz"}}}};
  if(b0==40){if(b1==181){if(b2==47){if(b3==253){<"zstd"}}}};
  <"unknown"
};
f=tool(fmt:$str):$str{
  if(s.eq(fmt;"gzip")){<"gzip"};
  if(s.eq(fmt;"bzip2")){<"bzip2"};
  if(s.eq(fmt;"xz")){<"xz"};
  if(s.eq(fmt;"zstd")){<"zstd"};
  <""
};
f=main():$i64{
  let infile=s.trim(io.readln());
  let outfile=s.trim(io.readln());
  let fmt=detect(infile);
  if(s.eq(fmt;"unknown")){
    io.println("ERROR: unrecognized format");
    <0
  };
  let content=run(@(tool(fmt);"-dc";operand(infile)));
  if(s.eq(outfile;"-")){
    io.print(content)
  }el{
    let wrote=mt file.write(outfile;content){
      $bool:v v;
      $fileerr:e (1==0)
    };
    let outdata=mt file.read(outfile){
      $str:v v;
      $fileerr:e ""
    };
    let n=(s.len(outdata) as $i64);
    io.println(s.concat(s.concat(s.concat("Decompressed: ";s.fromint(n));" bytes to ");outfile))
  };
  <0
}
