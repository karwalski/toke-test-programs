m=batchrunner;
i=io:std.io;
i=s:std.str;
i=process:std.process;
i=time:std.time;

f=runcmd(cmd:$str):$i64{
  let argv=s.split(s.trim(cmd);" ");
  let code=mt process.spawn(argv){
    Handle:h (mt process.wait(h){ $i32:c (c as $i64); ProcessErr:e (0-1) });
    ProcessErr:e (0-127)
  };
  if(code<0){<0};
  <code
};

f=main():$i64{
  let mode=s.trim(io.readln());
  let cmds=mut.@();
  lp(!io.eof()){
    let line=io.readln();
    if(io.eof()){
      if(s.eq(s.trim(line);"")){ br; };
    };
    let t=s.trim(line);
    if(!s.eq(t;"")){
      cmds=cmds+@(t);
    };
  };

  let n=cmds.len;
  let ok=mut.0;
  let failed=mut.0;
  lp(let i=0;(i as $u64)<n;i=i+1){
    let cmd=cmds.get(i);
    let t0=time.now();
    let code=runcmd(cmd);
    let ms=(time.since(t0) as $i64);
    if(code==0){ ok=ok+1; }el{ failed=failed+1; };
    io.println(s.concat(s.concat(cmd;": exit=");s.concat(s.fromint(code);s.concat(" time=";s.concat(s.fromint(ms);"ms")))));
  };

  io.println(s.concat(s.concat("Summary: ";s.fromint(ok));s.concat(s.concat(" ok, ";s.fromint(failed));" failed.")));
  <0
}
