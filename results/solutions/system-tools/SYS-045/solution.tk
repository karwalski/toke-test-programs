m=extract;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;
f=run(argv:@$str):$str{
  <mt process.spawn(argv){
    $handle:h (mt process.stdout(h){
      $str:o o;
      $processerr:e ""
    });
    $processerr:e ""
  }
};
f=operand(p:$str):$str{
  if(s.startswith(p;"-")){<s.concat("./";p)};
  <p
};
f=listargv(path:$str):@$str{
  let lo=s.lower(path);
  if(s.endswith(lo;".tar.gz")){<@("tar";"tzf";path)};
  if(s.endswith(lo;".tgz")){<@("tar";"tzf";path)};
  if(s.endswith(lo;".tar.bz2")){<@("tar";"tjf";path)};
  if(s.endswith(lo;".zip")){<@("unzip";"-Z1";operand(path))};
  <@("tar";"tf";path)
};
f=extractargv(path:$str;dest:$str):@$str{
  let lo=s.lower(path);
  if(s.endswith(lo;".tar.gz")){<@("tar";"xzf";path;"-C";dest)};
  if(s.endswith(lo;".tgz")){<@("tar";"xzf";path;"-C";dest)};
  if(s.endswith(lo;".tar.bz2")){<@("tar";"xjf";path;"-C";dest)};
  if(s.endswith(lo;".zip")){<@("unzip";"-o";"-q";operand(path);"-d";dest)};
  <@("tar";"xf";path;"-C";dest)
};
f=main():$i64{
  let path=s.trim(io.readln());
  let dest=s.trim(io.readln());
  if(file.exists(path)==(1==0)){
    io.println(s.concat("ERROR: archive not found: ";path));
    <0
  };
  run(@("mkdir";"-p";operand(dest)));
  run(extractargv(path;dest));
  let listing=run(listargv(path));
  let lines=s.split(listing;"\n");
  let count=mut.0;
  lp(let i=0;i<lines.len;i=i+1){
    let entry=s.trim(lines.get(i as $u64));
    if(s.len(entry)>0){
      if(s.endswith(entry;"/")==(1==0)){
        io.println(s.concat("extracted: ";entry));
        count=count+1;
      };
    };
  };
  io.println(s.concat(s.concat(s.concat("Done: ";s.fromint(count));" files extracted to ");s.concat(dest;".")));
  <0
}
