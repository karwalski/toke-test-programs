m=extract;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;
f=runcmd(cmd:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";cmd)){
    Handle:h (mt process.stdout(h){
      $str:o o;
      ProcessErr:e ""
    });
    ProcessErr:e ""
  }
};
f=listcmd(path:$str):$str{
  let lo=s.lower(path);
  if(s.endswith(lo;".tar.gz")){<s.concat(s.concat("tar tzf '";path);"'")};
  if(s.endswith(lo;".tgz")){<s.concat(s.concat("tar tzf '";path);"'")};
  if(s.endswith(lo;".tar.bz2")){<s.concat(s.concat("tar tjf '";path);"'")};
  if(s.endswith(lo;".zip")){<s.concat(s.concat("unzip -Z1 '";path);"'")};
  <s.concat(s.concat("tar tf '";path);"'")
};
f=extractcmd(path:$str;dest:$str):$str{
  let lo=s.lower(path);
  let q=s.concat(s.concat("'";path);"'");
  let d=s.concat(s.concat("'";dest);"'");
  if(s.endswith(lo;".tar.gz")){<s.concat(s.concat(s.concat("tar xzf ";q);" -C ");d)};
  if(s.endswith(lo;".tgz")){<s.concat(s.concat(s.concat("tar xzf ";q);" -C ");d)};
  if(s.endswith(lo;".tar.bz2")){<s.concat(s.concat(s.concat("tar xjf ";q);" -C ");d)};
  if(s.endswith(lo;".zip")){<s.concat(s.concat(s.concat("unzip -o -q ";q);" -d ");d)};
  <s.concat(s.concat(s.concat("tar xf ";q);" -C ");d)
};
f=main():$i64{
  let path=s.trim(io.readln());
  let dest=s.trim(io.readln());
  if(file.exists(path)=(1=0)){
    io.println(s.concat("ERROR: archive not found: ";path));
    <0
  };
  runcmd(s.concat("mkdir -p '";s.concat(dest;"'")));
  runcmd(extractcmd(path;dest));
  let listing=runcmd(listcmd(path));
  let lines=s.split(listing;"\n");
  let count=mut.0;
  lp(let i=0;i<lines.len;i=i+1){
    let entry=s.trim(lines.get(i as $u64));
    if(s.len(entry)>0){
      if(s.endswith(entry;"/")=(1=0)){
        io.println(s.concat("extracted: ";entry));
        count=count+1;
      };
    };
  };
  io.println(s.concat(s.concat(s.concat("Done: ";s.fromint(count));" files extracted to ");s.concat(dest;".")));
  <0
}
