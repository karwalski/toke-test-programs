m=pidfile;i=io:std.io;i=s:std.str;i=fl:std.file;i=os:std.os;
f=start(path:$str):$str{let pid=os.getpid();fl.write(path;s.fromint(pid));<s.concat("PID written: ";s.fromint(pid))};
f=check(path:$str):$str{if(fl.exists(path)){}el{<"NOT_RUNNING"};let r=fl.read(path);if(r){let pidstr=s.trim(r);<s.concat("RUNNING pid=";pidstr)}el{<"NOT_RUNNING"}};
f=stop(path:$str):$str{if(fl.exists(path)){fl.delete(path)};<"PID file removed."};
f=main():$i64{
let path=s.trim(io.readln());
let cmd=s.trim(io.readln());
let out=mut."";
if(s.eq(cmd;"start")){out=start(path)};
if(s.eq(cmd;"check")){out=check(path)};
if(s.eq(cmd;"stop")){out=stop(path)};
io.println(out);
<0}
