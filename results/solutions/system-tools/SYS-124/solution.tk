m=initdetect;i=io:std.io;i=s:std.str;i=process:std.process;
f=runshell(cmd:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";cmd)){
    Handle:h (mt process.stdout(h){
      $str:o o;
      ProcessErr:e ""
    });
    ProcessErr:e ""
  }
};
f=main():$i64{
  let name=mut.s.trim(runshell("ps -p 1 -o comm= 2>/dev/null"));
  if(s.len(name)==0){name="unknown"};
  let base=mut.name;
  let bytes=s.bytes(name);
  let lastslash=mut.(0-1);
  lp(let i=0;i<(bytes.len as $i64);i=i+1){
    if((bytes.get(i as $u64) as $i64)==47){lastslash=i}
  };
  if(lastslash>=0){
    base=s.slice(name;(lastslash+1) as $u64;s.len(name))
  };
  let version=mut."unknown";
  if(s.eq(base;"launchd")){
    let lv=s.trim(runshell("launchctl version 2>/dev/null"));
    if(s.len(lv)>0){version=lv}
  };
  io.println(s.concat(s.concat(s.concat("Init system: ";base);" version ");version));
  <0
}
