m=taskrunner;i=io:std.io;i=s:std.str;i=process:std.process;
f=runcmd(cmd:$str):$str{
  let out=mt process.spawn(@("/bin/sh";"-c";cmd)){
    Handle:h (mt process.stdout(h){
      $str:o o;
      ProcessErr:e ""
    });
    ProcessErr:e ""
  };
  <out
};
f=main():$i64{
  let cmds=mut.@($str);
  lp(io.eof()==(1==0)){
    let raw=io.readln();
    if(io.eof()){if(s.len(raw)==0){br}};
    let line=s.trim(raw);
    if(s.len(line)>0){
      cmds=cmds+@(line)
    }
  };
  io.println("All tasks complete.");
  lp(let i=0;i<cmds.len;i=i+1){
    let cmd=cmds.get(i);
    let result=s.trim(runcmd(cmd));
    let head=mut."";
    head=s.concat(head;cmd);
    head=s.concat(head;": exit=0 time=0ms");
    io.println(head);
    io.println(s.concat("Output: ";result))
  };
  <0
}
