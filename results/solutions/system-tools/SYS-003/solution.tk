m=crontab;i=io:std.io;i=s:std.str;i=time:std.time;
f=minmatch(field:$str;minute:$i64):$bool{
if(s.eq(field;"*")){<true};
if(s.startswith(field;"*/")){
let step=s.toint(s.substr(field;2;s.len(field) as $i64));
if(step<=0){<false};
<(minute%step)==0
};
<minute==s.toint(field)
};
f=hourmatch(field:$str;hour:$i64):$bool{
if(s.eq(field;"*")){<true};
if(s.startswith(field;"*/")){
let step=s.toint(s.substr(field;2;s.len(field) as $i64));
if(step<=0){<false};
<(hour%step)==0
};
<hour==s.toint(field)
};
f=main():$i64{
let entry=s.trim(io.readln());
let nstr=s.trim(io.readln());
let count=s.toint(nstr);
let toks=s.split(entry;" ");
(* cron: min hour dom mon dow label *)
let minf=s.trim(toks.get(0));
let hourf=s.trim(toks.get(1));
let label=mut."";
if(toks.len()>5){
lp(let i=5;i<toks.len();i=i+1){
let t=s.trim(toks.get(i));
if(s.len(t)>0){
if(s.len(label)>0){label=s.concat(label;" ")};
label=s.concat(label;t)
}
}
};
(* iterate from now+60s, minute granularity *)
let nowms=time.now();
let nowsec=(nowms/1000) as $i64;
(* align to next minute boundary *)
let startsec=mut.(nowsec/60)*60+60;
let found=mut.0;
let out=mut.s.concat(label;": ");
let iter=mut.0;
lp(found<count){
if(iter>100000){br};
let tsms=(startsec as $i64)*1000;
let minute=s.toint(time.format(tsms as $u64;"%M"));
let hour=s.toint(time.format(tsms as $u64;"%H"));
if(minmatch(minf;minute)){
if(hourmatch(hourf;hour)){
let iso=time.format(tsms as $u64;"%Y-%m-%dT%H:%M:%SZ");
if(found>0){out=s.concat(out;", ")};
out=s.concat(out;iso);
found=found+1
}
};
startsec=startsec+60;
iter=iter+1
};
io.println(out);
<0}
