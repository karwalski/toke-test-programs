m=zombie;i=io:std.io;i=s:std.str;i=process:std.process;
f=runcmd(c:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";c)){
    Handle:h (mt process.stdout(h){ $str:o o; ProcessErr:e "" });
    ProcessErr:e ""
  }
};
f=main():$i64{
  let out=runcmd("ps -axo pid=,ppid=,state=,comm= | awk '$3 ~ /^Z/ {print $1, $2, $4}'");
  let lines=s.split(out;"\n");
  let warm=lines.get(0);
  let count=mut.0;
  lp(let i=0;i<(s.len(lines) as $i64);i=i+1){
    let line=s.trim(lines.get(i));
    if(s.len(line)>0){
      io.println(line);
      count=count+1
    }
  };
  if(count=0){
    io.println("No zombie processes found")
  };
  io.println(s.concat(s.concat("Summary: ";s.fromint(count));" zombie processes."));
  <0
}
