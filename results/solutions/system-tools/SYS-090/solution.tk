m=dirwalk;i=io:std.io;i=s:std.str;i=file:std.file;i=path:std.path;
f=main():$i64{
  let dir=s.trim(io.readln());
  if(file.exists(dir)=(1=0)){
    io.println(s.concat("ERROR: directory not found: ";dir));
    <0
  };
  if(file.isdir(dir)=(1=0)){
    io.println(s.concat("ERROR: directory not found: ";dir));
    <0
  };
  let files=file.listall(dir);
  let exts=mut.@();
  let counts=mut.@();
  let total=mut.0;
  lp(let i=0;i<files.len;i=i+1){
    let f=files.get(i);
    let raw=path.ext(f);
    let ext=mut."(none)";
    if(s.len(raw)>0){
      ext=s.lower(s.slice(raw;1 as $u64;s.len(raw)))
    };
    total=total+1;
    let found=mut.(1=0);
    lp(let j=0;j<exts.len;j=j+1){
      if(s.eq(exts.get(j);ext)){
        counts=counts.set(j;counts.get(j)+1);
        found=(1=1)
      }
    };
    if(found=(1=0)){
      exts=exts+@(ext);
      counts=counts+@(1)
    }
  };
  lp(let a=0;a<exts.len;a=a+1){
    lp(let b=0;b<exts.len-1;b=b+1){
      if(counts.get(b)<counts.get(b+1)){
        let tc=counts.get(b);
        counts=counts.set(b;counts.get(b+1));
        counts=counts.set(b+1;tc);
        let te=exts.get(b);
        exts=exts.set(b;exts.get(b+1));
        exts=exts.set(b+1;te)
      }
    }
  };
  lp(let k=0;k<exts.len;k=k+1){
    let out=mut."";
    out=s.concat(out;exts.get(k));
    out=s.concat(out;": ");
    out=s.concat(out;s.fromint(counts.get(k)));
    io.println(out)
  };
  io.println(s.concat(s.concat("Total: ";s.fromint(total));" files."));
  <0
}
