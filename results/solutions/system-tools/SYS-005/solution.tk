if(fl.exists(path)){}el{
io.println(s.concat("ERROR: log file not found: ";path));
<0
};
let date=time.format(time.now();"%Y-%m-%d");
let newpath=mut.s.concat(s.concat(path;".");date);
let content=mut."";
