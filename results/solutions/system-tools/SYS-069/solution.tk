m=textstats;i=io:std.io;i=s:std.str;
f=cleanword(w:$str):$str{
  let out=mut."";
  let bytes=s.bytes(w);
  lp(let i=0;i<(bytes.len as $i64);i=i+1){
    let b=bytes.get(i) as $i64;
    let keep=mut.(1==0);
    if((b>=48)){if((b<=57)){keep=(1==1)}};
    if((b>=65)){if((b<=90)){keep=(1==1)}};
    if((b>=97)){if((b<=122)){keep=(1==1)}};
    if(keep){out=s.concat(out;s.slice(w;i as $u64;(i+1) as $u64))}
  };
  <s.lower(out)
};
f=fmtavg(chars:$i64;lines:$i64):$str{
  if(lines==0){<"0.0"};
  let scaled=(chars*10)/lines;
  let whole=scaled/10;
  let frac=scaled-(whole*10);
  <s.concat(s.concat(s.fromint(whole);".");s.fromint(frac))
};
f=main():$i64{
  let topraw=io.readln();
  let topn=mut.3;
  let t=s.trim(topraw);
  if(s.len(t)>0){topn=mt s.toint(t){$i64:v v; ParseErr:e 3}};
  let lines=mut.0;
  let words=mut.0;
  let chars=mut.0;
  let wlist=mut.@();
  let clist=mut.@();
  lp(io.eof()==(1==0)){
    let raw=io.readln();
    if(io.eof()){if(s.len(raw)==0){br}};
    let line=mut.raw;
    if(s.endswith(line;"\n")){line=s.slice(line;0 as $u64;((s.len(line) as $i64)-1) as $u64)};
    if(s.len(line)>0){
      lines=lines+1;
      chars=chars+(s.len(line) as $i64);
      let toks=s.split(line;" ");
      lp(let i=0;i<(toks.len as $i64);i=i+1){
        let cw=cleanword(toks.get(i));
        if(s.len(cw)>0){
          words=words+1;
          let found=mut.(1==0);
          let nw=wlist.len as $i64;
          lp(let j=0;j<nw;j=j+1){
            if(s.eq(wlist.get(j);cw)){
              clist=clist.set(j;clist.get(j)+1);
              found=(1==1);
              br
            }
          };
          if(found==(1==0)){
            wlist=wlist+@(cw);
            clist=clist+@(1)
          }
        }
      }
    }
  };
  let nw=wlist.len as $i64;
  let order=mut.@();
  lp(let k=0;k<nw;k=k+1){order=order+@(k)};
  lp(let a=0;a<nw;a=a+1){
    lp(let b=0;b<(nw-a-1);b=b+1){
      let ia=order.get(b);
      let ib=order.get(b+1);
      if(clist.get(ib)>clist.get(ia)){
        order=order.set(b;ib);
        order=order.set(b+1;ia)
      }
    }
  };
  let top=mut."";
  let limit=mut.topn;
  if(nw<limit){limit=nw};
  if(limit==0){top="(none)"}el{
    lp(let k=0;k<limit;k=k+1){
      let idx=order.get(k);
      if(k>0){top=s.concat(top;",")};
      top=s.concat(s.concat(s.concat(top;wlist.get(idx));":");s.fromint(clist.get(idx)))
    }
  };
  let out=mut."Lines: ";
  out=s.concat(out;s.fromint(lines));
  out=s.concat(out;", Words: ");
  out=s.concat(out;s.fromint(words));
  out=s.concat(out;", Chars: ");
  out=s.concat(out;s.fromint(chars));
  out=s.concat(out;", Avg line: ");
  out=s.concat(out;fmtavg(chars;lines));
  out=s.concat(out;", Top words: ");
  out=s.concat(out;top);
  io.println(out);
  <0
}
