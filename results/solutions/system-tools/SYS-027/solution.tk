m=mv;i=io:std.io;i=s:std.str;i=fl:std.file;
f=matches(name:$str;pat:$str):$bool{
(* support "*" prefix glob like *.log, plain name, or "*" *)
if(s.eq(pat;"*")){<true};
if(s.startswith(pat;"*")){
let suf=s.substr(pat;1;s.len(pat) as $i64);
<s.endswith(name;suf)
};
<s.eq(name;pat)
};
f=main():$i64{
let src=s.trim(io.readln());
let dst=s.trim(io.readln());
let pattern=s.trim(io.readln());
let conflict=s.trim(io.readln());
let moved=mut.0;
let skipped=mut.0;
let errors=mut.0;
if(fl.exists(src)){}el{
io.println(s.concat("ERROR: source not found: ";src));
<0
};
if(fl.exists(dst)){}el{fl.mkdir(dst)};
let lst=fl.list(src);
lp(let i=0;i<lst.len();i=i+1){
let name=lst.get(i);
let sp=s.concat(s.concat(src;"/");name);
if(fl.isdir(sp)=false){
if(matches(name;pattern)){
let finalname=mut.name;
let dp=mut.s.concat(s.concat(dst;"/");name);
let proceed=mut.true;
if(fl.exists(dp)){
if(s.eq(conflict;"skip")){proceed=false;skipped=skipped+1}
el{if(s.eq(conflict;"rename")){
finalname=s.concat("renamed_";name);
dp=s.concat(s.concat(dst;"/");finalname)
}}
};
if(proceed){
let okc=fl.copy(sp;dp);
if(okc){
fl.delete(sp);
io.println(s.concat(s.concat(s.concat("MOVED ";sp);" -> ");dp));
moved=moved+1
}el{
errors=errors+1
}
}
}
}
};
io.println(s.concat(s.concat(s.concat(s.concat(s.concat("Summary: ";s.fromint(moved));" files moved, ");s.concat(s.fromint(skipped);" skipped, "));s.fromint(errors));" errors."));
<0}
