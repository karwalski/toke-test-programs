m=processmonitor;i=io:std.io;i=s:std.str;i=process:std.process;i=vec:std.vec;
f=getout():$str{
<mt process.spawn(@("ps";"-axo";"pid=,comm=,%cpu=,rss=")){
Handle:h (mt process.stdout(h){$str:o o;ProcessErr:e ""});
ProcessErr:e ""
}
};
f=cpux100(cpu:$str):$i64{
(* parse "12.34" -> 1234 *)
let dot=s.indexof(cpu;".");
let whole=mut.0;
let frac=mut.0;
if(dot<0){whole=s.toint(cpu);frac=0}el{
whole=s.toint(s.substr(cpu;0;dot));
let fs=s.substr(cpu;dot+1;s.len(cpu) as $i64);
if(s.len(fs)>=2){frac=s.toint(s.substr(fs;0;2))}
el{if(s.len(fs)==1){frac=s.toint(fs)*10}}
};
<whole*100+frac
};
f=main():$i64{
let prefix=s.trim(io.readln());
io.println("PID NAME CPU% MEM_MB");
let out=getout();
let lines=s.split(out;"\n");
let n=lines.len() as $i64;
let pids=mut.@();
let names=mut.@();
let cpus=mut.@();
let mems=mut.@();
let cpuk=mut.@();
let cnt=mut.0;
lp(let i=0;i<n;i=i+1){
let line=s.trim(lines.get(i));
if(s.len(line)>0){
let toks=s.split(line;" ");
let parts=mut.@();
lp(let j=0;j<toks.len();j=j+1){
let t=s.trim(toks.get(j));
if(s.len(t)>0){parts=parts+@(t)}
};
let np=parts.len() as $i64;
if(np>=4){
let pid=parts.get(0);
let rss=parts.get(np-1);
let cpu=parts.get(np-2);
let nameparts=mut."";
lp(let k=1;k<np-2;k=k+1){
if(k>1){nameparts=s.concat(nameparts;" ")};
nameparts=s.concat(nameparts;parts.get(k))
};
let keep=mut.true;
if(s.len(prefix)>0){keep=s.startswith(nameparts;prefix)};
if(keep){
let memmb=s.toint(rss)/1024;
pids=pids+@(pid);
names=names+@(nameparts);
cpus=cpus+@(cpu);
mems=mems+@(s.fromint(memmb));
cpuk=cpuk+@(cpux100(cpu));
cnt=cnt+1
}
}
}
};
(* selection sort by cpuk desc using a used-flag vector (no array mutation) *)
let used=mut.vec.new();
lp(let i=0;i<cnt;i=i+1){used=vec.push(used;0)};
lp(let r=0;r<cnt;r=r+1){
let best=mut.0-1;
let bestv=mut.0-1;
lp(let i=0;i<cnt;i=i+1){
if(vec.get(used;i)==0){
if(cpuk.get(i)>bestv){bestv=cpuk.get(i);best=i}
}
};
if(best>=0){
used=vec.set(used;best;1);
let b=s.buf();
s.add(b;pids.get(best));
s.add(b;" ");
s.add(b;names.get(best));
s.add(b;" ");
s.add(b;cpus.get(best));
s.add(b;" ");
s.add(b;mems.get(best));
io.println(s.done(b))
}
};
<0
};
