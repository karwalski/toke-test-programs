m=nslist;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;
f=runcmd(c:$str):$str{
  <mt process.spawn(@("/bin/sh";"-c";c)){
    Handle:h (mt process.stdout(h){ $str:o o; ProcessErr:e "" });
    ProcessErr:e ""
  }
};
f=nsinode(pid:$str;name:$str):$str{
  let path=s.concat(s.concat(s.concat("/proc/";pid);"/ns/");name);
  if(file.exists(path)){
    let cmd=s.concat(s.concat("readlink ";path);" 2>/dev/null");
    let r=s.trim(runcmd(cmd));
    if(s.len(r)>0){<r}el{<"unavailable"}
  };
  <"unavailable"
};
f=emit(pid:$str;name:$str):$i64{
  io.println(s.concat(s.concat(name;": ");nsinode(pid;name)));
  <0
};
f=main():$i64{
  let pid=s.trim(io.readln());
  if(s.len(pid)=0){
    io.println("ERROR: no PID provided");
    <0
  };
  let chk=s.concat(s.concat("if ps -p ";pid);" >/dev/null 2>&1; then echo EXISTS; else echo NOTFOUND; fi");
  let exists=s.trim(runcmd(chk));
  if(s.eq(exists;"NOTFOUND")){
    io.println(s.concat("ERROR: PID not found: ";pid));
    <0
  };
  emit(pid;"pid");
  emit(pid;"net");
  emit(pid;"mnt");
  emit(pid;"uts");
  emit(pid;"ipc");
  emit(pid;"user");
  <0
}
