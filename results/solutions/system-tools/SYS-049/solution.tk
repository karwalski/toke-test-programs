m=wordcount;i=io:std.io;i=s:std.str;
f=countwords(line:$str):$i64{
  let parts=s.split(line;" ");
  let n=mut.0;
  lp(let i=0;i<parts.len;i=i+1){
    if(s.len(s.trim(parts.get(i as $u64)))>0){n=n+1};
  };
  <n
};
f=main():$i64{
  let lines=mut.0;
  let words=mut.0;
  let bytes=mut.0;
  let maxline=mut.0;
  lp(io.eof()=(1=0)){
    let raw=io.readln();
    if(io.eof()){if(s.len(raw)=0){br}};
    lines=lines+1;
    bytes=bytes+(s.len(raw) as $i64)+1;
    words=words+countwords(raw);
    let ll=(s.len(raw) as $i64);
    if(ll>maxline){maxline=ll};
  };
  let out=mut."";
  out=s.concat(out;"lines: ");out=s.concat(out;s.fromint(lines));
  out=s.concat(out;"  words: ");out=s.concat(out;s.fromint(words));
  out=s.concat(out;"  bytes: ");out=s.concat(out;s.fromint(bytes));
  out=s.concat(out;"  max_line: ");out=s.concat(out;s.fromint(maxline));
  io.println(out);
  <0
}
