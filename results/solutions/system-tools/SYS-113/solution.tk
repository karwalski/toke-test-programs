m=dirhash;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;i=crypto:std.crypto;
f=run(argv:@$str):$str{
  <mt process.spawn(argv){
    $handle:h (mt process.stdout(h){
      $str:o o;
      $processerr:e ""
    });
    $processerr:e ""
  }
};
f=operand(p:$str):$str{
  if(s.startswith(p;"-")){<s.concat("./";p)};
  if(s.startswith(p;"!")){<s.concat("./";p)};
  if(s.startswith(p;"(")){<s.concat("./";p)};
  <p
};
f=sorted(xs:@$str):@$str{
  let a=mut.xs;
  lp(let i=1;i<a.len;i=i+1){
    let j=mut.i;
    lp(j>0){
      let prev=a.get(j-1);
      let cur=a.get(j);
      if(s.compare(prev;cur)>0){
        a=a.set(j-1;cur);
        a=a.set(j;prev);
        j=j-1
      }el{j=0}
    }
  };
  <a
};
f=main():$i64{
  let dir=s.trim(io.readln());
  if(file.exists(dir)==(1==0)){
    io.println(s.concat("ERROR: directory not found: ";dir));
    <0
  };
  let found=run(@("find";operand(dir);"-type";"f"));
  let paths=mut.@($str);
  let parts=s.split(found;"\n");
  lp(let i=0;i<parts.len;i=i+1){
    let p=parts.get(i);
    if(s.len(p)>0){paths=paths+@(p)}
  };
  let files=sorted(paths);
  let data=mut.s.bytes("");
  lp(let i=0;i<files.len;i=i+1){
    let b=mt file.readbytes(files.get(i)){ $ok:v v; $err:e s.bytes("") };
    data=data+b
  };
  let hash=mut.crypto.tohex(crypto.sha256(data));
  if(s.len(hash)==0){hash="0"};
  io.println(s.concat("Directory hash: ";hash));
  <0
}
