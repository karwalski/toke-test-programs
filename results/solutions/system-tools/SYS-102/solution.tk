m=filecrypt;i=io:std.io;i=s:std.str;i=file:std.file;i=process:std.process;
f=run(argv:@$str):$str{
  <mt process.spawn(argv){
    $handle:h (mt process.stdout(h){
      $str:o o;
      $processerr:e ""
    });
    $processerr:e ""
  }
};
f=main():$i64{
  let mode=s.trim(io.readln());
  let infile=s.trim(io.readln());
  let outfile=s.trim(io.readln());
  let passphrase=s.trim(io.readln());
  let isdecrypt=s.eq(mode;"decrypt");
  let pass=s.concat("pass:";passphrase);
  let argv=mut.@("openssl";"enc";"-aes-256-cbc";"-pbkdf2";"-salt");
  if(isdecrypt){argv=argv+@("-d")};
  argv=argv+@("-in";infile;"-out";outfile;"-pass";pass);
  let ignore=run(argv);
  if(isdecrypt){
    io.println(s.concat("Decrypted: ";outfile))
  }el{
    io.println(s.concat("Encrypted: ";outfile))
  };
  <0
}
