m=ansicolor;i=io:std.io;i=s:std.str;
f=esc():$str{<"\x1b"};
f=block(idx:$i64):$str{
  let e=esc();
  let label=mut.s.fromint(idx);
  lp(let i=s.len(label) as $i64;i<3;i=i+1){label=s.concat(" ";label)};
  let fg=mut."38;5;15";
  if(idx>7){if(idx<16){fg="38;5;0"}};
  let out=mut."";
  out=s.concat(out;e);
  out=s.concat(out;"[48;5;");
  out=s.concat(out;s.fromint(idx));
  out=s.concat(out;";");
  out=s.concat(out;fg);
  out=s.concat(out;"m ");
  out=s.concat(out;label);
  out=s.concat(out;" ");
  out=s.concat(out;e);
  out=s.concat(out;"[0m");
  <out
};
f=main():$i64{
  let raw=io.readln();
  let mode=s.trim(raw);
  let count=mut.256;
  if(s.eq(mode;"16")){count=16};
  if(s.eq(mode;"256")){count=256};
  if(s.eq(mode;"truecolor")){count=256};
  lp(let idx=0;idx<count;idx=idx+1){
    io.println(block(idx))
  };
  <0
}
